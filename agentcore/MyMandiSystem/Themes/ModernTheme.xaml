<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!-- ══════════════════════════════════════════════════════════ -->
    <!--                   COLOR PALETTE TOKENS                     -->
    <!-- ══════════════════════════════════════════════════════════ -->

    <!-- Primary & Accent Brand Colors -->
    <Color x:Key="ColorPrimaryNavy">#0F172A</Color>
    <Color x:Key="ColorPrimaryDark">#1E293B</Color>
    <Color x:Key="ColorPrimarySlate">#334155</Color>
    <Color x:Key="ColorAccentTeal">#0D9488</Color>
    <Color x:Key="ColorAccentTealLight">#14B8A6</Color>
    <Color x:Key="ColorAccentTealDark">#0F766E</Color>
    <Color x:Key="ColorAccentIndigo">#4F46E5</Color>
    <Color x:Key="ColorAccentIndigoDark">#3730A3</Color>
    <Color x:Key="ColorAccentEmerald">#10B981</Color>
    <Color x:Key="ColorAccentEmeraldDark">#047857</Color>
    <Color x:Key="ColorAccentAmber">#F59E0B</Color>
    <Color x:Key="ColorAccentRose">#F43F5E</Color>
    <Color x:Key="ColorAccentSky">#0284C7</Color>
    <Color x:Key="ColorAccentCyan">#06B6D4</Color>
    <Color x:Key="ColorAccentPurple">#8B5CF6</Color>

    <!-- Surfaces & Neutrals -->
    <Color x:Key="ColorSurfaceBg">#F1F5F9</Color>
    <Color x:Key="ColorSurfaceCard">#FFFFFF</Color>
    <Color x:Key="ColorSurfaceCardHover">#F8FAFC</Color>
    <Color x:Key="ColorSurfaceBorder">#E2E8F0</Color>
    <Color x:Key="ColorSurfaceBorderDark">#CBD5E1</Color>
    <Color x:Key="ColorTextPrimary">#0F172A</Color>
    <Color x:Key="ColorTextSecondary">#64748B</Color>
    <Color x:Key="ColorTextMuted">#94A3B8</Color>

    <!-- Solid Brushes -->
    <SolidColorBrush x:Key="BrushPrimaryNavy" Color="{StaticResource ColorPrimaryNavy}" />
    <SolidColorBrush x:Key="BrushPrimaryDark" Color="{StaticResource ColorPrimaryDark}" />
    <SolidColorBrush x:Key="BrushPrimarySlate" Color="{StaticResource ColorPrimarySlate}" />
    <SolidColorBrush x:Key="BrushAccentTeal" Color="{StaticResource ColorAccentTeal}" />
    <SolidColorBrush x:Key="BrushAccentTealLight" Color="{StaticResource ColorAccentTealLight}" />
    <SolidColorBrush x:Key="BrushAccentTealDark" Color="{StaticResource ColorAccentTealDark}" />
    <SolidColorBrush x:Key="BrushAccentIndigo" Color="{StaticResource ColorAccentIndigo}" />
    <SolidColorBrush x:Key="BrushAccentIndigoDark" Color="{StaticResource ColorAccentIndigoDark}" />
    <SolidColorBrush x:Key="BrushAccentEmerald" Color="{StaticResource ColorAccentEmerald}" />
    <SolidColorBrush x:Key="BrushAccentEmeraldDark" Color="{StaticResource ColorAccentEmeraldDark}" />
    <SolidColorBrush x:Key="BrushAccentAmber" Color="{StaticResource ColorAccentAmber}" />
    <SolidColorBrush x:Key="BrushAccentRose" Color="{StaticResource ColorAccentRose}" />
    <SolidColorBrush x:Key="BrushAccentSky" Color="{StaticResource ColorAccentSky}" />
    <SolidColorBrush x:Key="BrushAccentCyan" Color="{StaticResource ColorAccentCyan}" />
    <SolidColorBrush x:Key="BrushAccentPurple" Color="{StaticResource ColorAccentPurple}" />
    <SolidColorBrush x:Key="BrushSurfaceBg" Color="{StaticResource ColorSurfaceBg}" />
    <SolidColorBrush x:Key="BrushSurfaceCard" Color="{StaticResource ColorSurfaceCard}" />
    <SolidColorBrush x:Key="BrushSurfaceBorder" Color="{StaticResource ColorSurfaceBorder}" />
    <SolidColorBrush x:Key="BrushSurfaceBorderDark" Color="{StaticResource ColorSurfaceBorderDark}" />
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}" />

    <!-- Gradient Brushes for Highlights & Badges -->
    <LinearGradientBrush x:Key="BrushGradientTeal" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0D9488" Offset="0"/>
        <GradientStop Color="#059669" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushGradientIndigo" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6366F1" Offset="0"/>
        <GradientStop Color="#4F46E5" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushGradientEmerald" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#10B981" Offset="0"/>
        <GradientStop Color="#059669" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushGradientRose" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F43F5E" Offset="0"/>
        <GradientStop Color="#E11D48" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushGradientAmber" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F59E0B" Offset="0"/>
        <GradientStop Color="#D97706" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushGradientSky" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0284C7" Offset="0"/>
        <GradientStop Color="#2563EB" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushGradientPurple" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8B5CF6" Offset="0"/>
        <GradientStop Color="#7C3AED" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushSidebarBg" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0F172A" Offset="0"/>
        <GradientStop Color="#1E293B" Offset="1"/>
    </LinearGradientBrush>

    <!-- ══════════════════════════════════════════════════════════ -->
    <!--                     SHADOW EFFECTS                         -->
    <!-- ══════════════════════════════════════════════════════════ -->

    <DropShadowEffect x:Key="EffectCardShadow" BlurRadius="16" ShadowDepth="2" Direction="270" Color="#0F172A" Opacity="0.07" RenderingBias="Performance"/>
    <DropShadowEffect x:Key="EffectCardElevated" BlurRadius="20" ShadowDepth="4" Direction="270" Color="#0F172A" Opacity="0.10" RenderingBias="Performance"/>
    <DropShadowEffect x:Key="EffectCardHoverShadow" BlurRadius="24" ShadowDepth="6" Direction="270" Color="#0F172A" Opacity="0.13" RenderingBias="Performance"/>
    <DropShadowEffect x:Key="EffectModalShadow" BlurRadius="40" ShadowDepth="10" Direction="270" Color="#000000" Opacity="0.25" RenderingBias="Performance"/>
    <DropShadowEffect x:Key="EffectGlowTeal" BlurRadius="16" ShadowDepth="0" Color="#0D9488" Opacity="0.4" RenderingBias="Performance"/>
    <DropShadowEffect x:Key="EffectGlowIndigo" BlurRadius="16" ShadowDepth="0" Color="#6366F1" Opacity="0.4" RenderingBias="Performance"/>

    <!-- ══════════════════════════════════════════════════════════ -->
    <!--               MODERN SIDEBAR RADIO BUTTON                  -->
    <!-- ══════════════════════════════════════════════════════════ -->

    <Style x:Key="ModernSidebarNavButton" TargetType="RadioButton">
        <Setter Property="Height" Value="52"/>
        <Setter Property="Margin" Value="10,4"/>
        <Setter Property="Foreground" Value="#94A3B8"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="ContainerBorder" CornerRadius="10" Background="Transparent" Padding="14,0" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Selection Accent Indicator (Pill) -->
                            <Border x:Name="ActiveIndicator" Width="4" Height="22" CornerRadius="2" 
                                    Background="{StaticResource BrushAccentTealLight}" 
                                    HorizontalAlignment="Left" Visibility="Collapsed" Margin="-10,0,0,0"/>

                            <ContentPresenter Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ContainerBorder" Property="Background" Value="#2A374A"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ContainerBorder" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#1E293B" Offset="0"/>
                                        <GradientStop Color="#0D9488" Offset="1.8"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════ -->
    <!--               MODERN SIDEBAR ACTION BUTTON                 -->
    <!-- ══════════════════════════════════════════════════════════ -->

    <Style x:Key="ModernSidebarActionButton" TargetType="Button">
        <Setter Property="Height" Value="48"/>
        <Setter Property="Margin" Value="10,3"/>
        <Setter Property="Foreground" Value="#94A3B8"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ContainerBorder" CornerRadius="10" Background="Transparent" Padding="14,0" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ContainerBorder" Property="Background" Value="#2A374A"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ContainerBorder" Property="Background" Value="#1E293B"/>
                            <Setter Property="Foreground" Value="{StaticResource BrushAccentTealLight}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════ -->
    <!--               MODERN DASHBOARD ACTION TILE                 -->
    <!-- ══════════════════════════════════════════════════════════ -->

    <Style x:Key="ModernDashboardActionTile" TargetType="Button">
        <Setter Property="Height" Value="85"/>
        <Setter Property="Margin" Value="8"/>
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#E2E8F0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- Shadow Border -->
                        <Border x:Name="ShadowBorder" CornerRadius="14" Background="White" Effect="{StaticResource EffectCardShadow}"/>
                        
                        <!-- Main Card -->
                        <Border x:Name="CardBorder" CornerRadius="14" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" 
                                Padding="16,10" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CardBorder" Property="Background" Value="#F8FAFC"/>
                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="#0D9488"/>
                            <Setter TargetName="ShadowBorder" Property="Effect" Value="{StaticResource EffectCardHoverShadow}"/>
                            <Setter TargetName="CardBorder" Property="Margin" Value="0,-2,0,2"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="CardBorder" Property="Margin" Value="0,1,0,-1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════ -->
    <!--                    MODERN BUTTON STYLES                    -->
    <!-- ══════════════════════════════════════════════════════════ -->

    <!-- Primary Brand Button -->
    <Style x:Key="ModernPrimaryButton" TargetType="Button">
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="18,0"/>
        <Setter Property="Background" Value="{StaticResource BrushAccentTeal}"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="BtnBorder" CornerRadius="8" Background="{TemplateBinding Background}" 
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BtnBorder" Property="Background" Value="#0F766E"/>
                            <Setter TargetName="BtnBorder" Property="Effect" Value="{StaticResource EffectGlowTeal}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="BtnBorder" Property="Background" Value="#115E59"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="BtnBorder" Property="Background" Value="#CBD5E1"/>
                            <Setter Property="Foreground" Value="#94A3B8"/>
                            <Setter Property="Cursor" Value="No"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Success Emerald Button -->
    <Style x:Key="ModernSuccessButton" TargetType="Button">
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="18,0"/>
        <Setter Property="Background" Value="{StaticResource BrushAccentEmerald}"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="BtnBorder" CornerRadius="8" Background="{TemplateBinding Background}" 
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BtnBorder" Property="Background" Value="#059669"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="BtnBorder" Property="Background" Value="#047857"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Danger/Close Button -->
    <Style x:Key="ModernDangerButton" TargetType="Button">
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="18,0"/>
        <Setter Property="Background" Value="#FEE2E2"/>
        <Setter Property="Foreground" Value="#DC2626"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#FECACA"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="BtnBorder" CornerRadius="8" Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BtnBorder" Property="Background" Value="#DC2626"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="BtnBorder" Property="Background" Value="#B91C1C"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Outlined Secondary Button -->
    <Style x:Key="ModernSecondaryButton" TargetType="Button">
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="18,0"/>
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushSurfaceBorderDark}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="BtnBorder" CornerRadius="8" Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BtnBorder" Property="Background" Value="#F1F5F9"/>
                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#94A3B8"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="BtnBorder" Property="Background" Value="#E2E8F0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════ -->
    <!--                     MODERN DATAGRID                        -->
    <!-- ══════════════════════════════════════════════════════════ -->

    <Style x:Key="ModernDataGrid" TargetType="DataGrid">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushSurfaceBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9"/>
        <Setter Property="RowHeight" Value="36"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
        <Setter Property="ColumnHeaderStyle">
            <Setter.Value>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#F1F5F9"/>
                    <Setter Property="Foreground" Value="{StaticResource BrushPrimarySlate}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Padding" Value="12,8"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="BorderBrush" Value="{StaticResource BrushSurfaceBorder}"/>
                    <Setter Property="Height" Value="38"/>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="RowStyle">
            <Setter.Value>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#EEF2FF"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#E0E7FF"/>
                            <Setter Property="Foreground" Value="#1E1B4B"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
