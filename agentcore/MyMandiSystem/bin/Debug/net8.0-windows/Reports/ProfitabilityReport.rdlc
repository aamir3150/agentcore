<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <Body>
    <ReportItems>
      <Tablix Name="Tablix1">
        <TablixBody>
          <TablixColumns>
            <TablixColumn><Width>1.5in</Width></TablixColumn>
            <TablixColumn><Width>1.5in</Width></TablixColumn>
            <TablixColumn><Width>1.5in</Width></TablixColumn>
            <TablixColumn><Width>1.5in</Width></TablixColumn>
          </TablixColumns>
          <TablixRows>
            <TablixRow>
              <Height>0.3in</Height>
              <TablixCells>
                <TablixCell><CellContents><Textbox Name="Textbox1"><Value>Total Sales (+Comm)</Value><Style><FontWeight>Bold</FontWeight></Style></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="Textbox2"><Value>Total Purchases</Value><Style><FontWeight>Bold</FontWeight></Style></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="Textbox3"><Value>Operational Comm.</Value><Style><FontWeight>Bold</FontWeight></Style></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="Textbox4"><Value>GROSS PROFIT</Value><Style><FontWeight>Bold</FontWeight><BackgroundColor>Silver</BackgroundColor></Style></Textbox></CellContents></TablixCell>
              </TablixCells>
            </TablixRow>
            <TablixRow>
              <Height>0.3in</Height>
              <TablixCells>
                <TablixCell><CellContents><Textbox Name="Sales"><Value>=Fields!Sales.Value</Value></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="Purchases"><Value>=Fields!Purchases.Value</Value></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="Commissions"><Value>=Fields!Commissions.Value</Value></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="GrossProfit"><Value>=Fields!GrossProfit.Value</Value><Style><FontWeight>Bold</FontWeight></Style></Textbox></CellContents></TablixCell>
              </TablixCells>
            </TablixRow>
          </TablixRows>
        </TablixBody>
        <TablixColumnHierarchy><TablixMembers><TablixMember /><TablixMember /><TablixMember /><TablixMember /></TablixMembers></TablixColumnHierarchy>
        <TablixRowHierarchy>
          <TablixMembers>
            <TablixMember><KeepWithGroup>After</KeepWithGroup></TablixMember>
            <TablixMember><Group Name="Details" /></TablixMember>
          </TablixMembers>
        </TablixRowHierarchy>
        <DataSetName>DataSet1</DataSetName>
      </Tablix>
      <Textbox Name="Title">
        <Value>PROFITABILITY FORENSICS REPORT</Value>
        <Style><FontSize>16pt</FontSize><FontWeight>Bold</FontWeight></Style>
        <Top>0in</Top><Height>0.5in</Height><Width>6in</Width>
      </Textbox>
    </ReportItems>
    <Height>2.5in</Height>
  </Body>
  <DataSets>
    <DataSet Name="DataSet1">
      <Fields>
        <Field Name="Sales"><DataField>Sales</DataField></Field>
        <Field Name="Purchases"><DataField>Purchases</DataField></Field>
        <Field Name="Commissions"><DataField>Commissions</DataField></Field>
        <Field Name="GrossProfit"><DataField>GrossProfit</DataField></Field>
      </Fields>
    </DataSet>
  </DataSets>
</Report>
