<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <Body>
    <ReportItems>
      <Tablix Name="Tablix1">
        <TablixBody>
          <TablixColumns>
            <TablixColumn><Width>1.5in</Width></TablixColumn>
            <TablixColumn><Width>2in</Width></TablixColumn>
            <TablixColumn><Width>1in</Width></TablixColumn>
            <TablixColumn><Width>1in</Width></TablixColumn>
            <TablixColumn><Width>1in</Width></TablixColumn>
          </TablixColumns>
          <TablixRows>
            <TablixRow>
              <Height>0.25in</Height>
              <TablixCells>
                <TablixCell><CellContents><Textbox Name="Textbox1"><Value>Batch #</Value></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="Textbox2"><Value>Product</Value></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="Textbox3"><Value>Production</Value></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="Textbox4"><Value>Expiry</Value></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="Textbox5"><Value>Days Left</Value></Textbox></CellContents></TablixCell>
              </TablixCells>
            </TablixRow>
            <TablixRow>
              <Height>0.25in</Height>
              <TablixCells>
                <TablixCell><CellContents><Textbox Name="BatchNo"><Value>=Fields!BatchNo.Value</Value></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="ProductName"><Value>=Fields!ProductName.Value</Value></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="ProductionDate"><Value>=Fields!ProductionDate.Value</Value></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="ExpiryDate"><Value>=Fields!ExpiryDate.Value</Value></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="DaysRemaining"><Value>=Fields!DaysRemaining.Value</Value></Textbox></CellContents></TablixCell>
              </TablixCells>
            </TablixRow>
          </TablixRows>
        </TablixBody>
        <TablixColumnHierarchy><TablixMembers><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /></TablixMembers></TablixColumnHierarchy>
        <TablixRowHierarchy>
          <TablixMembers>
            <TablixMember><KeepWithGroup>After</KeepWithGroup></TablixMember>
            <TablixMember><Group Name="Details" /></TablixMember>
          </TablixMembers>
        </TablixRowHierarchy>
        <DataSetName>DataSet1</DataSetName>
      </Tablix>
      <Textbox Name="Title">
        <Value>PESTRO EXPIRY FORECAST</Value>
        <Style><FontSize>14pt</FontSize><FontWeight>Bold</FontWeight><Color>Red</Color></Style>
        <Top>0in</Top><Height>0.4in</Height><Width>6.5in</Width>
      </Textbox>
    </ReportItems>
    <Height>2in</Height>
  </Body>
  <DataSets>
    <DataSet Name="DataSet1">
      <Fields>
        <Field Name="BatchNo"><DataField>BatchNo</DataField></Field>
        <Field Name="ProductName"><DataField>ProductName</DataField></Field>
        <Field Name="ProductionDate"><DataField>ProductionDate</DataField></Field>
        <Field Name="ExpiryDate"><DataField>ExpiryDate</DataField></Field>
        <Field Name="DaysRemaining"><DataField>DaysRemaining</DataField></Field>
