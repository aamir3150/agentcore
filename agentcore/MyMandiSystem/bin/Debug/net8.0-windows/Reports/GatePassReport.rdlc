                <TablixCell><CellContents><Textbox Name="Textbox2"><Value>Date</Value></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="Textbox3"><Value>Party / Driver</Value></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="Textbox4"><Value>Product</Value></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="Textbox5"><Value>Net Weight</Value></Textbox></CellContents></TablixCell>
              </TablixCells>
            </TablixRow>
            <TablixRow>
              <Height>0.25in</Height>
              <TablixCells>
                <TablixCell><CellContents><Textbox Name="GatePassNo"><Value>=Fields!GatePassNo.Value</Value></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="GatePassDate"><Value>=Fields!GatePassDate.Value</Value></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="PartyName"><Value>=Fields!PartyName.Value</Value></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="ProductName"><Value>=Fields!ProductName.Value</Value></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="NetWeight"><Value>=Fields!NetWeight.Value</Value></Textbox></CellContents></TablixCell>
              </TablixCells>
            </TablixRow>
          </TablixRows>
        </TablixBody>
        <TablixColumnHierarchy><TablixMembers><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /></TablixMembers></TablixColumnHierarchy>
        <TablixRowHierarchy>
          <TablixMembers>
