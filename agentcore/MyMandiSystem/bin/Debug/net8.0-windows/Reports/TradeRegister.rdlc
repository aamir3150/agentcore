<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <Body>
    <ReportItems>
      <Tablix Name="Tablix1">
        <TablixBody>
          <TablixColumns>
            <TablixColumn><Width>1in</Width></TablixColumn>
            <TablixColumn><Width>1in</Width></TablixColumn>
            <TablixColumn><Width>2.5in</Width></TablixColumn>
            <TablixColumn><Width>1in</Width></TablixColumn>
            <TablixColumn><Width>1in</Width></TablixColumn>
          </TablixColumns>
          <TablixRows>
            <TablixRow>
              <Height>0.25in</Height>
              <TablixCells>
                <TablixCell><CellContents><Textbox Name="Textbox1"><Value>Invoice #</Value></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="Textbox2"><Value>Date</Value></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="Textbox3"><Value>Party/Company</Value></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="Textbox4"><Value>Tax</Value></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="Textbox5"><Value>Net Amount</Value></Textbox></CellContents></TablixCell>
              </TablixCells>
            </TablixRow>
            <TablixRow>
              <Height>0.25in</Height>
              <TablixCells>
                <TablixCell><CellContents><Textbox Name="InvoiceNo"><Value>=Fields!InvoiceNo.Value</Value></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="InvoiceDate"><Value>=Fields!InvoiceDate.Value</Value></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="PartyName"><Value>=Fields!PartyName.Value</Value></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="TaxAmount"><Value>=Fields!TaxAmount.Value</Value></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="NetAmount"><Value>=Fields!NetAmount.Value</Value></Textbox></CellContents></TablixCell>
              </TablixCells>
            </TablixRow>
          </TablixRows>
        </TablixBody>
        <TablixColumnHierarchy><TablixMembers><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /></TablixMembers></TablixColumnHierarchy>
        <TablixRowHierarchy>
          <TablixMembers>
            <TablixMember><KeepWithGroup>After</KeepWithGroup></TablixMember>
            <TablixMember><Group Name="Details" /></TablixMember>
          </TablixMembers>
        </TablixRowHierarchy>
        <DataSetName>DataSet1</DataSetName>
      </Tablix>
      <Textbox Name="Title">
        <Value>TRADE REGISTER REPORT</Value>
        <Top>0in</Top><Height>0.4in</Height><Width>6.5in</Width>
      </Textbox>
    </ReportItems>
    <Height>2in</Height>
  </Body>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties><DataProvider>System.Data.DataSet</DataProvider><ConnectString>/* Local Connection */</ConnectString></ConnectionProperties>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query><DataSourceName>DataSource1</DataSourceName><CommandText>/* Local Query */</CommandText></Query>
      <Fields>
        <Field Name="InvoiceNo"><DataField>InvoiceNo</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="InvoiceDate"><DataField>InvoiceDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field>
        <Field Name="PartyName"><DataField>PartyName</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="TaxAmount"><DataField>TaxAmount</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="NetAmount"><DataField>NetAmount</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
      </Fields>
    </DataSet>
  </DataSets>
</Report>
