                                        </StackPanel>
                                    </Grid>

                                    <!-- 9 Action Tiles -->
                                    <!-- 9 Action Tiles -->
                                    <UniformGrid Columns="3">
                                        <!-- 1. Account Ledger -->
                                        <Button Style="{StaticResource ModernDashboardActionTile}" Command="{Binding RptAccountLedgerCommand}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Width="48" Height="48" CornerRadius="12" Background="{StaticResource BrushGradientTeal}" Margin="0,0,14,0">
                                                    <materialDesign:PackIcon Kind="Printer" Width="26" Height="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="ACCOUNT LEDGER" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryNavy}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>

                                        <!-- 2. Account Payable -->
                                        <Button Style="{StaticResource ModernDashboardActionTile}" Command="{Binding RptAccountsPayableCommand}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Width="48" Height="48" CornerRadius="12" Background="{StaticResource BrushGradientRose}" Margin="0,0,14,0">
                                                    <materialDesign:PackIcon Kind="Printer" Width="26" Height="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="ACCOUNT PAYABLE" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryNavy}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>

                                        <!-- 3. Account Receivable -->
                                        <Button Style="{StaticResource ModernDashboardActionTile}" Command="{Binding RptAccountsReceivableCommand}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Width="48" Height="48" CornerRadius="12" Background="{StaticResource BrushGradientEmerald}" Margin="0,0,14,0">
                                                    <materialDesign:PackIcon Kind="Printer" Width="26" Height="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="ACCOUNT RECEIVABLE" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryNavy}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>

                                        <!-- 4. Bank Statement -->
                                        <Button Style="{StaticResource ModernDashboardActionTile}" Command="{Binding RptBankStatementCommand}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Width="48" Height="48" CornerRadius="12" Background="{StaticResource BrushGradientSky}" Margin="0,0,14,0">
                                                    <materialDesign:PackIcon Kind="Printer" Width="26" Height="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="BANK STATEMENT" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryNavy}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>

                                        <!-- 5. Cash Book -->
                                        <Button Style="{StaticResource ModernDashboardActionTile}" Command="{Binding RptCashBookCommand}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Width="48" Height="48" CornerRadius="12" Background="{StaticResource BrushGradientIndigo}" Margin="0,0,14,0">
                                                    <materialDesign:PackIcon Kind="Printer" Width="26" Height="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="CASH BOOK" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryNavy}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>

                                        <!-- 6. Daily Voucher Details -->
                                        <Button Style="{StaticResource ModernDashboardActionTile}" Command="{Binding RptDailyVouchersDetailCommand}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Width="48" Height="48" CornerRadius="12" Background="{StaticResource BrushGradientAmber}" Margin="0,0,14,0">
                                                    <materialDesign:PackIcon Kind="TicketPercentOutline" Width="26" Height="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="DAILY VOCHURE DETAILS" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryNavy}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>

                                        <!-- 7. Trail Balance -->
                                        <Button Style="{StaticResource ModernDashboardActionTile}" Command="{Binding RptTrialBalanceCommand}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Width="48" Height="48" CornerRadius="12" Background="{StaticResource BrushGradientPurple}" Margin="0,0,14,0">
                                                    <materialDesign:PackIcon Kind="ScaleBalance" Width="26" Height="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="TRAIL BALANCE" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryNavy}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>

                                        <!-- 8. Profit & Loss Statements -->
                                        <Button Style="{StaticResource ModernDashboardActionTile}" Command="{Binding RptProfitLossStatementCommand}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Width="48" Height="48" CornerRadius="12" Background="{StaticResource BrushGradientEmerald}" Margin="0,0,14,0">
                                                    <materialDesign:PackIcon Kind="CurrencyUsd" Width="26" Height="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="PROFIT &amp; LOSS STATEMENTS" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryNavy}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>

                                        <!-- 9. Balance Sheet -->
                                        <Button Style="{StaticResource ModernDashboardActionTile}" Command="{Binding RptBalanceSheetCommand}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Width="48" Height="48" CornerRadius="12" Background="{StaticResource BrushGradientIndigo}" Margin="0,0,14,0">
                                                    <materialDesign:PackIcon Kind="Scale" Width="26" Height="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="BALANCE SHEET" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryNavy}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </UniformGrid>
                                </StackPanel>

                                <!-- ── MODULE 3: BROKERAGE ── -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentView}" Value="Brokerage">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <!-- Section Header -->
                                    <Grid Margin="4,0,4,16">
                                        <StackPanel>
                                            <TextBlock Text="Brokerage &amp; Commodity Trade" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryNavy}"/>
                                            <TextBlock Text="Trade contracts, gate passes, and multi-invoicing" FontSize="12.5" Foreground="{StaticResource BrushTextSecondary}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Action Tiles -->
                                    <UniformGrid Columns="3">
                                        <Button Style="{StaticResource ModernDashboardActionTile}" Command="{Binding BrokeragePurchaseInvoiceCommand}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Width="48" Height="48" CornerRadius="12" Background="{StaticResource BrushGradientAmber}" Margin="0,0,14,0">
                                                    <materialDesign:PackIcon Kind="FileDocumentEditOutline" Width="26" Height="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="PURCHASE INVOICE" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryNavy}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>

                                        <Button Style="{StaticResource ModernDashboardActionTile}" Command="{Binding BrokerageSaleInvoiceCommand}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Width="48" Height="48" CornerRadius="12" Background="{StaticResource BrushGradientTeal}" Margin="0,0,14,0">
                                                    <materialDesign:PackIcon Kind="FileCheckOutline" Width="26" Height="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="SALE INVOICE" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryNavy}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>

                                        <Button Style="{StaticResource ModernDashboardActionTile}" Command="{Binding BrokerageMultiInvoiceCommand}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Width="48" Height="48" CornerRadius="12" Background="{StaticResource BrushGradientPurple}" Margin="0,0,14,0">
                                                    <materialDesign:PackIcon Kind="FolderMultipleOutline" Width="26" Height="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="MULTI INVOICE" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryNavy}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </UniformGrid>
                                </StackPanel>

                                <!-- ── MODULE 4: GENERAL ── -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentView}" Value="General">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <!-- Section Header -->
                                    <Grid Margin="4,0,4,16">
                                        <StackPanel>
                                            <TextBlock Text="General Trade &amp; Invoices" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryNavy}"/>
                                            <TextBlock Text="Standard goods purchase, sales, and return management" FontSize="12.5" Foreground="{StaticResource BrushTextSecondary}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Action Tiles -->
                                    <UniformGrid Columns="3">
                                        <Button Style="{StaticResource ModernDashboardActionTile}" Command="{Binding GeneralPurchaseInvoiceCommand}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Width="48" Height="48" CornerRadius="12" Background="{StaticResource BrushGradientRose}" Margin="0,0,14,0">
                                                    <materialDesign:PackIcon Kind="CartArrowDown" Width="26" Height="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="PURCHASE INVOICE" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryNavy}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>

                                        <Button Style="{StaticResource ModernDashboardActionTile}" Command="{Binding GeneralSaleInvoiceCommand}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Width="48" Height="48" CornerRadius="12" Background="{StaticResource BrushGradientEmerald}" Margin="0,0,14,0">
                                                    <materialDesign:PackIcon Kind="CartArrowUp" Width="26" Height="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="SALE INVOICE" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryNavy}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>

                                        <Button Style="{StaticResource ModernDashboardActionTile}" Command="{Binding GeneralPurchaseMultiInvoiceCommand}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Width="48" Height="48" CornerRadius="12" Background="{StaticResource BrushGradientSky}" Margin="0,0,14,0">
                                                    <materialDesign:PackIcon Kind="FileMultipleOutline" Width="26" Height="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="MULTI INVOICE" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryNavy}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </UniformGrid>
                                </StackPanel>

                                <!-- ── MODULE 5: PESTRO ── -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentView}" Value="Pestro">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <!-- Section Header -->
                                    <Grid Margin="4,0,4,16">
                                        <StackPanel>
                                            <TextBlock Text="Pestro &amp; Agricultural Chemicals" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryNavy}"/>
                                            <TextBlock Text="Pesticide batch tracking, expiry dates, and automated sales" FontSize="12.5" Foreground="{StaticResource BrushTextSecondary}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Action Tiles -->
                                    <UniformGrid Columns="3">
                                        <Button Style="{StaticResource ModernDashboardActionTile}" Command="{Binding PestroPurchaseCommand}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Width="48" Height="48" CornerRadius="12" Background="{StaticResource BrushGradientTeal}" Margin="0,0,14,0">
                                                    <materialDesign:PackIcon Kind="BottleTonicPlusOutline" Width="26" Height="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="PESTRO PURCHASE" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryNavy}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>

                                        <Button Style="{StaticResource ModernDashboardActionTile}" Command="{Binding PestroSaleInvoiceAutoBatchCommand}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Width="48" Height="48" CornerRadius="12" Background="{StaticResource BrushGradientIndigo}" Margin="0,0,14,0">
                                                    <materialDesign:PackIcon Kind="FileSyncOutline" Width="26" Height="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="SALE AUTO BATCH" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryNavy}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>

                                        <Button Style="{StaticResource ModernDashboardActionTile}" Command="{Binding PestroSaleInvoiceManualBatchCommand}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Width="48" Height="48" CornerRadius="12" Background="{StaticResource BrushGradientAmber}" Margin="0,0,14,0">
                                                    <materialDesign:PackIcon Kind="FileCogOutline" Width="26" Height="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="SALE MANUAL BATCH" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryNavy}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </UniformGrid>
                                </StackPanel>

                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </DockPanel>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--            MODERN GLASSMORPHIC TRIAL / DAILY MODAL         -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Border Background="#800F172A" Visibility="{Binding IsTrialVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding DismissTrialCommand}"/>
            </Border.InputBindings>

            <Grid>
                <Border Width="560" Background="#FFFFFF" CornerRadius="20" VerticalAlignment="Center" HorizontalAlignment="Center" Effect="{StaticResource EffectModalShadow}">
                    <Grid Margin="28">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Modal Header -->
                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource BrushGradientTeal}" Margin="0,0,12,0">
                                    <materialDesign:PackIcon Kind="ChartTimelineVariant" Width="20" Height="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Daily Activity Control" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryNavy}"/>
                                    <TextBlock Text="Current fiscal day snapshot" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                                </StackPanel>
                            </StackPanel>

                            <Button Command="{Binding DismissTrialCommand}" Style="{StaticResource MaterialDesignFlatButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="4">
                                <materialDesign:PackIcon Kind="Close" Width="20" Height="20" Foreground="{StaticResource BrushTextMuted}"/>
                            </Button>
                        </Grid>

                        <Border Grid.Row="1" Height="1" Background="{StaticResource BrushSurfaceBorder}" Margin="0,16,0,16"/>

                        <!-- Metrics Table -->
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="CashMultiple" Width="18" Height="18" Foreground="{StaticResource BrushAccentEmerald}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Cash in Hand" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource BrushPrimaryNavy}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding CashInHand}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryNavy}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="ArrowUpBoldCircleOutline" Width="18" Height="18" Foreground="{StaticResource BrushAccentRose}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Cash Paid" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource BrushPrimaryNavy}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding CashPaid}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushAccentRose}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="ArrowDownBoldCircleOutline" Width="18" Height="18" Foreground="{StaticResource BrushAccentTeal}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Cash Received" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource BrushPrimaryNavy}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding CashReceived}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushAccentTeal}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border Grid.Row="3" Background="#FFFFFF" CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="TicketOutline" Width="18" Height="18" Foreground="{StaticResource BrushAccentIndigo}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Cheque Issued" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource BrushPrimaryNavy}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ChequeIssued}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushAccentIndigo}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border Grid.Row="4" Background="#F8FAFC" CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="BankTransferIn" Width="18" Height="18" Foreground="{StaticResource BrushAccentSky}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Cheque Deposited" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource BrushPrimaryNavy}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ChequeDeposited}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryNavy}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border Grid.Row="5" Background="#FFFFFF" CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="BankTransfer" Width="18" Height="18" Foreground="{StaticResource BrushAccentPurple}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Cash Deposited" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource BrushPrimaryNavy}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding CashDeposited}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryNavy}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border Grid.Row="6" Background="#FEF3C7" CornerRadius="8" Padding="12,8">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="ClockAlertOutline" Width="18" Height="18" Foreground="{StaticResource BrushAccentAmber}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Uncleared Cheques" FontSize="13.5" FontWeight="Bold" Foreground="#92400E" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding UnclearedCheques}" FontSize="15" FontWeight="Black" Foreground="#92400E" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Dismiss Action -->
                        <Button Grid.Row="3" Style="{StaticResource ModernPrimaryButton}" Margin="0,18,0,0" Command="{Binding DismissTrialCommand}">
                            <TextBlock Text="Continue to Dashboard" FontWeight="Bold"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

    </Grid>
</Window>
