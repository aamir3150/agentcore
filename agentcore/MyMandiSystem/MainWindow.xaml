                            <MenuItem.Icon><materialDesign:PackIcon Kind="Warehouse" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="_Purchase Invoice" Command="{Binding PestroPurchaseInvoiceCommand}">
