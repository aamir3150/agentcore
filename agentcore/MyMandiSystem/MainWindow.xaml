<Window x:Class="MyMandiSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MyMandiSystem"
        xmlns:viewmodels="clr-namespace:MyMandiSystem.ViewModels"
        xmlns:views="clr-namespace:MyMandiSystem.Views"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="agentcore - Enterprise Management System" 
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Height="720" Width="1200" MinHeight="550" MinWidth="950"
        Background="{StaticResource BrushSurfaceBg}"
        TextElement.Foreground="{StaticResource BrushTextPrimary}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <!-- APP SHELL CONTAINER -->
        <DockPanel LastChildFill="True">

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                   TOP APP HEADER & BRANDING                -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="{StaticResource BrushSurfaceBorder}" BorderThickness="0,0,0,1" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Brand / App Logo -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="42" Height="42" CornerRadius="10" Background="{StaticResource BrushGradientTeal}" Margin="0,0,12,0">
                            <materialDesign:PackIcon Kind="HexagonMultiple" Width="24" Height="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="AGENTCORE" FontSize="18" FontWeight="Black" Foreground="{StaticResource BrushPrimaryNavy}"/>
                                <Border Background="{StaticResource BrushAccentIndigo}" CornerRadius="4" Margin="6,2,0,2" Padding="6,1">
                                    <TextBlock Text="ERP" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Commodity Trade &amp; Financial Management System" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" FontWeight="Medium"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Center Search / Quick Info Pill -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                        <Border Background="#F1F5F9" BorderBrush="{StaticResource BrushSurfaceBorder}" BorderThickness="1" CornerRadius="20" Padding="14,6">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Magnify" Width="16" Height="16" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Quick Search (Accounts, Vouchers, Invoices...)" FontSize="12" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Top Right Quick Info Chips -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        
                        <!-- Financial Year Chip -->
                        <Border Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" CornerRadius="8" Padding="10,5" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="CalendarRange" Width="15" Height="15" Foreground="{StaticResource BrushAccentIndigo}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding CurrentYearDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushAccentIndigoDark}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Live Digital Clock Chip -->
                        <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="10,5" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="ClockOutline" Width="15" Height="15" Foreground="{StaticResource BrushAccentEmerald}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding CurrentTime}" FontSize="12" FontWeight="Bold" Foreground="#047857" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Archive Warning Chip (If Any) -->
                        <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="10,5" Margin="0,0,8,0"
                                Visibility="{Binding IsArchiveMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding ArchiveWarning}" FontSize="11" FontWeight="Bold" Foreground="#B45309" VerticalAlignment="Center"/>
                        </Border>

                        <!-- User Profile Chip -->
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BrushSurfaceBorder}" BorderThickness="1" CornerRadius="20" Padding="8,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource BrushGradientIndigo}" Margin="0,0,8,0">
                                    <materialDesign:PackIcon Kind="Account" Width="16" Height="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,4,0">
                                    <TextBlock Text="{Binding CurrentUser}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryNavy}"/>
                                    <TextBlock Text="Administrator" FontSize="10" Foreground="{StaticResource BrushTextMuted}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                   MODERN FLAT MENU BAR                     -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border DockPanel.Dock="Top" Background="#FAFAFA" BorderBrush="{StaticResource BrushSurfaceBorder}" BorderThickness="0,0,0,1">
                <Menu Background="Transparent" Padding="10,2" FontSize="13" Foreground="{StaticResource BrushPrimarySlate}">
                    
