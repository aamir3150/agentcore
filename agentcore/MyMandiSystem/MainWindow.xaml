                        </MenuItem>
                        <MenuItem Header="_Refresh System" Command="{Binding RefreshSystemCommand}">
                            <MenuItem.Icon><materialDesign:PackIcon Kind="Refresh" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Expense Type _Purchase" Command="{Binding ExpenseTypePurchaseCommand}">
                            <MenuItem.Icon><materialDesign:PackIcon Kind="CashSync" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Expense Type _Sale" Command="{Binding ExpenseTypeSaleCommand}">
                            <MenuItem.Icon><materialDesign:PackIcon Kind="CashFast" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="_Port Setting" Command="{Binding PortSettingCommand}">
                            <MenuItem.Icon><materialDesign:PackIcon Kind="SerialPort" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Re _Calculate Stock" Command="{Binding ReCalculateStockCommand}">
