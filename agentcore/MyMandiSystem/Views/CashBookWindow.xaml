<Window x:Class="MyMandiSystem.Views.CashBookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Cash Book" 
        Height="480" Width="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#EAEAEA"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <!-- Classic / ERP Styled Button -->
        <Style x:Key="ClassicReportButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Background" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="#707070"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="3" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="8,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#E0EEF8"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#0078D7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#CCE4F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <DockPanel LastChildFill="True">

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                       HEADER BANNER                        -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border DockPanel.Dock="Top" Height="82" Background="#0F172A">
                <Grid>
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0F172A" Offset="0"/>
                            <GradientStop Color="#1E293B" Offset="0.6"/>
                            <GradientStop Color="#1E3A8A" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>

                    <!-- Title Header -->
                    <StackPanel VerticalAlignment="Center" Margin="24,0,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="34" Height="34" CornerRadius="8" Background="#1E3A8A" Margin="0,0,10,0">
                                <materialDesign:PackIcon Kind="CashMultiple" Width="22" Height="22" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Cash Book" FontSize="21" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="روکڑ بہی (کیش بک روزانہ کھاتہ رپورٹ)" FontSize="14" Foreground="#94A3B8" FontFamily="{StaticResource FontJameelNooriNastaleeq}" Margin="44,2,0,0"/>
                    </StackPanel>

                    <!-- Right Graphic Emblem -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,24,0">
                        <Border Width="48" Height="48" CornerRadius="12" Background="#1E293B" BorderBrush="#334155" BorderThickness="1.5">
                            <materialDesign:PackIcon Kind="Tractor" Width="28" Height="28" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Border>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                     BOTTOM BUTTONS BAR                     -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border DockPanel.Dock="Bottom" Background="#DCDCDC" BorderBrush="#B8B8B8" BorderThickness="0,1,0,0" Padding="14,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <!-- Preview Button -->
                    <Button Style="{StaticResource ClassicReportButton}" Command="{Binding PreviewCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileEyeOutline" Width="16" Height="16" Foreground="#005A9E" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Preview" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Print Button -->
                    <Button Style="{StaticResource ClassicReportButton}" Command="{Binding PrintCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Printer" Width="16" Height="16" Foreground="#333333" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Print" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Close Button -->
                    <Button Style="{StaticResource ClassicReportButton}" Command="{Binding CloseCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CloseCircle" Width="16" Height="16" Foreground="#D13438" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Close" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                      FORM CONTROLS                         -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Grid Background="#F5F5F5" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Dates Area -->
                    <RowDefinition Height="Auto"/> <!-- Options Checkboxes Area -->
                </Grid.RowDefinitions>

                <!-- 1. Date Radios -->
                <StackPanel Grid.Row="0" Margin="0,0,0,24" Width="360">
                    <!-- All Dates -->
                    <RadioButton Content="All Dates" IsChecked="{Binding IsAllDates}" Margin="0,0,0,12" FontWeight="SemiBold" FontSize="13.5"/>

                    <!-- Single Date -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <RadioButton Content="Single Date" IsChecked="{Binding IsSingleDate}" FontWeight="SemiBold" FontSize="13.5" Width="130" VerticalAlignment="Center"/>
                        <DatePicker SelectedDate="{Binding SingleDate}" IsEnabled="{Binding IsSingleDate}" Width="150" Height="28" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Date Range -->
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Date Range" IsChecked="{Binding IsDateRange}" FontWeight="SemiBold" FontSize="13.5" Width="130" VerticalAlignment="Center"/>
                        <DatePicker SelectedDate="{Binding FromDate}" IsEnabled="{Binding IsDateRange}" Width="105" Height="28" VerticalContentAlignment="Center"/>
                        <TextBlock Text="To" VerticalAlignment="Center" Margin="6,0,6,0" IsEnabled="{Binding IsDateRange}"/>
                        <DatePicker SelectedDate="{Binding ToDate}" IsEnabled="{Binding IsDateRange}" Width="105" Height="28" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- 2. Options Checkboxes -->
                <StackPanel Grid.Row="1" Margin="0,0,0,10" Width="360">
                    <CheckBox Content="Show Default Cash Book View" IsChecked="{Binding ShowDefaultCashBookView}" Margin="0,0,0,10" FontWeight="SemiBold"/>
                    <CheckBox Content="Print Credit Only" IsChecked="{Binding PrintCreditOnly}" Margin="0,0,0,10" FontWeight="SemiBold"/>
                    <CheckBox Content="Print Debit Only" IsChecked="{Binding PrintDebitOnly}" Margin="0,0,0,10" FontWeight="SemiBold"/>
                    <CheckBox Content="Brokerage Invoice Seperate IDs" IsChecked="{Binding BrokerageInvoiceSeparateIDs}" FontWeight="SemiBold"/>
                </StackPanel>

            </Grid>
        </DockPanel>
    </Grid>
</Window>
