<Window x:Class="MyMandiSystem.Views.SmsSendingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="SMS Notification Dispatch - agentcore ERP" 
        Width="1020" 
        Height="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True">

    <Window.Resources>
        <Storyboard x:Key="FadeInStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:0.25"/>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource FadeInStoryboard}"/>
        </EventTrigger>
    </Window.Triggers>

    <Border Margin="16" CornerRadius="18" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1.5" Effect="{StaticResource EffectModalShadow}">
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="*"/>    <!-- Main Body -->
                <RowDefinition Height="Auto"/> <!-- Progress Status -->
                <RowDefinition Height="Auto"/> <!-- Footer Actions -->
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                       TOP TITLE BAR                        -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border Grid.Row="0" Background="{StaticResource BrushPrimaryNavy}" CornerRadius="18,18,0,0" Padding="22,14"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Cursor="SizeAll">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="#1E293B" Margin="0,0,12,0">
                        <materialDesign:PackIcon Kind="MessageTextClock" Width="24" Height="24" Foreground="{StaticResource BrushAccentTealLight}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Party SMS Notifications (ایس ایم ایس روانگی)" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="زمینداروں اور کسٹمرز کو کھاتہ بقایا جات اور نوٹسز بذریعہ ایس ایم ایس بھیجیں" 
                                   FontFamily="{StaticResource FontJameelNooriNastaleeq}" FontSize="15" Foreground="#94A3B8"/>
                    </StackPanel>

                    <Button Grid.Column="2" Click="CloseButton_Click" Cursor="Hand" Width="30" Height="30" 
                            Background="Transparent" BorderThickness="0" Padding="0">
                        <materialDesign:PackIcon Kind="Close" Width="20" Height="20" Foreground="#94A3B8"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                        MAIN BODY                           -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="1" Margin="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="380"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Parties Selection List -->
                <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Search Box -->
                        <TextBox Grid.Row="0" materialDesign:HintAssist.Hint="Search Party / تلاش برائے پارٹی..." 
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="10,6" FontSize="12" Margin="0,0,0,8"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" TextChanged="SearchText_Changed"/>

                        <!-- Select All / Clear All Bar -->
                        <Border Grid.Row="1" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="8,6" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button Command="{Binding SelectAllCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" 
                                            Height="24" Padding="8,0" Margin="0,0,6,0" FontSize="10">
                                        <TextBlock Text="Select All / سب منتخب"/>
                                    </Button>
                                    <Button Command="{Binding DeselectAllCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" 
                                            Height="24" Padding="8,0" FontSize="10">
                                        <TextBlock Text="Clear All / سب ختم"/>
                                    </Button>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding FilteredRecipients.Count, StringFormat='Total: {0}'}" 
                                           Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- DataGrid -->
                        <DataGrid Grid.Row="2" ItemsSource="{Binding FilteredRecipients}" AutoGenerateColumns="False" CanUserAddRows="False"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" BorderThickness="0"
                                  Background="Transparent" HeadersVisibility="Column" RowHeight="32">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Send" Binding="{Binding IsSelected}" Width="50"/>
                                <DataGridTextColumn Header="Party Name" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="اردو نام" Binding="{Binding UrduName}" Width="130" IsReadOnly="True"
                                                    ElementStyle="{StaticResource UrduDataGridTextStyle}"/>
                                <DataGridTextColumn Header="Mobile / فون" Binding="{Binding Phone}" Width="105" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Balance" Binding="{Binding CurrentBalance, StringFormat='{}{0:N0}'}" Width="85" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Foreground" Value="#0284C7"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Right Column: SMS Template Composer & Live Preview -->
                <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Template Selector -->
                        <ComboBox Grid.Row="0" materialDesign:HintAssist.Hint="Message Template / سانچہ منتخب کریں" 
                                  Style="{StaticResource MaterialDesignFloatingHintComboBox}" Margin="0,0,0,12"
                                  ItemsSource="{Binding TemplateTypes}" SelectedItem="{Binding SelectedTemplateType}"
                                  SelectionChanged="Template_SelectionChanged"/>

                        <!-- Template Editor Box -->
                        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Template Editor / پیغام میں ترمیم کریں:" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding MessageTemplate, UpdateSourceTrigger=PropertyChanged}" 
                                         AcceptsReturn="True" TextWrapping="Wrap" Height="100" BorderThickness="0" Background="Transparent"
                                         FontSize="12" TextChanged="MessageTemplate_TextChanged"/>
                                <TextBlock Text="Tags: [PartyName], [Balance], [Date]" FontSize="10" Foreground="#94A3B8" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Live SMS Phone Simulation Preview -->
                        <Border Grid.Row="2" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                    <materialDesign:PackIcon Kind="CellphoneMessage" Width="16" Height="16" Foreground="#0284C7" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="LIVE SMS PREVIEW / موبائل اسکرین نمائش" FontWeight="Bold" FontSize="11" Foreground="#0284C7" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Message Bubble -->
                                <Border Grid.Row="1" Background="#DCFCE7" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="10,10,0,10" 
                                        Padding="12,10" VerticalAlignment="Top" HorizontalAlignment="Right" MaxWidth="320">
                                    <TextBlock Text="{Binding PreviewText}" TextWrapping="Wrap" FontSize="12" Foreground="#14532D" LineHeight="18"
                                               FontFamily="{StaticResource FontJameelNooriNastaleeq}"/>
                                </Border>

                                <!-- Character & Parts Counter -->
                                <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding CharacterCount, StringFormat='Characters: {0}'}" FontSize="11" Foreground="#64748B"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SmsPartsCount, StringFormat='SMS Credits: {0}'}" FontSize="11" FontWeight="Bold" Foreground="#0284C7"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                      PROGRESS STATUS                       -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,10">
                <StackPanel>
                    <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                    <ProgressBar Value="{Binding ProgressValue}" Maximum="100" Height="8" 
                                 Foreground="{StaticResource BrushAccentTeal}"/>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                       FOOTER ACTIONS                       -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,14" CornerRadius="0,0,18,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}" Height="38" Padding="14,0" Margin="0,0,10,0"
                                Click="CloseButton_Click" Foreground="#64748B" BorderBrush="#CBD5E1">
                            <TextBlock Text="Close / بند کریں"/>
                        </Button>

                        <Button Command="{Binding SendSmsCommand}" IsEnabled="{Binding IsSending, Converter={x:Null}}"
                                Background="{StaticResource BrushPrimaryNavy}" Foreground="#FFFFFF" BorderThickness="0" Height="38" Padding="20,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Send" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Send SMS Messages / پیغامات بھیجیں" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
