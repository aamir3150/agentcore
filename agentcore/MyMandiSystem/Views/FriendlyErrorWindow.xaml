<Window x:Class="MyMandiSystem.Views.FriendlyErrorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="System Alert &amp; Guidance" 
        Width="680" 
        MaxHeight="800"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True">

    <Window.Resources>
        <Storyboard x:Key="FadeInStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:0.25"/>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource FadeInStoryboard}"/>
        </EventTrigger>
    </Window.Triggers>

    <!-- Main Container with Shadow -->
    <Border Margin="16" CornerRadius="18" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1.5" Effect="{StaticResource EffectModalShadow}">
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="*"/>    <!-- Content Body (Scrollable if needed) -->
                <RowDefinition Height="Auto"/> <!-- Footer Actions -->
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                       TOP TITLE BAR                        -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="18,18,0,0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" 
                    Padding="20,12" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Cursor="SizeAll">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Alert Badge -->
                    <Border Grid.Column="0" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="20" Padding="10,4">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AlertCircleOutline" Foreground="#E11D48" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding Category}" FontWeight="Bold" FontSize="12" Foreground="#991B1B" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Column="1" Text="agentcore ERP - رہنمائی و اطلاع" 
                               FontFamily="{StaticResource FontJameelNooriNastaleeq}" FontSize="16" 
                               Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>

                    <!-- Close Button -->
                    <Button Grid.Column="2" Click="CloseButton_Click" Cursor="Hand" Width="28" Height="28" 
                            Background="Transparent" BorderThickness="0" Padding="0">
                        <materialDesign:PackIcon Kind="Close" Width="18" Height="18" Foreground="#64748B"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                       CONTENT BODY                         -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="600" Padding="24,20,24,14">
                <StackPanel>
                    
                    <!-- Headline Section with Accent Icon -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icon Circle -->
                        <Border Grid.Column="0" Width="54" Height="54" CornerRadius="27" Background="#FFF1F2" BorderBrush="#FECDD3" BorderThickness="1.5" Margin="0,0,16,0" VerticalAlignment="Top">
                            <materialDesign:PackIcon Kind="{Binding IconKind}" Width="30" Height="30" Foreground="#E11D48" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Headline}" FontSize="17" FontWeight="Bold" Foreground="#0F172A" TextWrapping="Wrap" Margin="0,0,0,3"/>
                            <TextBlock Text="{Binding UrduHeadline}" FontFamily="{StaticResource FontJameelNooriNastaleeq}" FontSize="20" Foreground="#475569" FlowDirection="RightToLeft" TextAlignment="Right"/>
                        </StackPanel>
                    </Grid>

                    <!-- Card 1: Masla Kya Hua (What happened?) -->
                    <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <materialDesign:PackIcon Grid.Column="0" Kind="InformationOutline" Width="22" Height="22" Foreground="#D97706" VerticalAlignment="Top" Margin="0,2,12,0"/>
                            
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="مسئلہ کیا ہے؟ (Masla Kya Hua):" FontWeight="Bold" FontSize="13.5" Foreground="#92400E" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding WhatHappened}" FontSize="13.5" Foreground="#78350F" TextWrapping="Wrap" LineHeight="20"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Card 2: Tareeqa-e-Hal (How to solve / Guide) -->
                    <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <materialDesign:PackIcon Grid.Column="0" Kind="LightbulbOnOutline" Width="24" Height="24" Foreground="#16A34A" VerticalAlignment="Top" Margin="0,2,12,0"/>

                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="حل کی آسان رہنمائی (Tareeqa-e-Hal):" FontWeight="Bold" FontSize="14" Foreground="#166534"/>
                                    <TextBlock Text="— (Yeh steps follow karein)" FontSize="12.5" Foreground="#15803D" Margin="6,1,0,0"/>
                                </StackPanel>

                                <!-- Step-by-Step List -->
                                <ItemsControl ItemsSource="{Binding FormattedSteps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Step Number Pill -->
                                                <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11" Background="#22C55E" VerticalAlignment="Top" Margin="0,1,10,0">
                                                    <TextBlock Text="{Binding Number}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Step Description -->
                                                <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="13.5" Foreground="#14532D" TextWrapping="Wrap" LineHeight="19" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Expander: Technical Diagnostics for Developer/Support -->
                    <Expander Header="Takneeki Maloomat (Technical Details baraye Support/Developer)" 
                              FontWeight="SemiBold" FontSize="12" Foreground="#64748B" Margin="0,4,0,0">
                        <Border Margin="0,8,0,0" Background="#0F172A" CornerRadius="8" Padding="12">
                            <TextBox Text="{Binding TechnicalError, Mode=OneWay}" 
                                     IsReadOnly="True" 
                                     TextWrapping="Wrap" 
                                     MaxHeight="140" 
                                     VerticalScrollBarVisibility="Auto" 
                                     Background="Transparent" 
                                     Foreground="#38BDF8" 
                                     FontFamily="Consolas" 
                                     FontSize="11" 
                                     BorderThickness="0"/>
                        </Border>
                    </Expander>

                </StackPanel>
            </ScrollViewer>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                      FOOTER ACTIONS                        -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="0,0,18,18" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Copy Details Button -->
                    <Button Grid.Column="0" x:Name="CopyButton" Click="CopyButton_Click" Cursor="Hand" Height="36" Padding="14,0"
                            Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" ToolTip="Error ki tamam details copy kar ke WhatsApp ya developer ko bheinjein">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon x:Name="CopyIcon" Kind="ContentCopy" Width="16" Height="16" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="CopyText" Text="Copy Details (تفصیلات کاپی کریں)" FontSize="12" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Support Helpline Info -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Margin="10,0">
                        <materialDesign:PackIcon Kind="PhoneInTalk" Width="15" Height="15" Foreground="#0D9488" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding SupportPhone}" FontSize="11.5" FontWeight="SemiBold" Foreground="#0F766E" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Primary OK / Samajh Gaya Button -->
                    <Button Grid.Column="2" Click="OkButton_Click" Style="{StaticResource ModernPrimaryButton}" Height="36" Padding="24,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Check" Width="16" Height="16" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Theek Hai / سمجھ گیا" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
