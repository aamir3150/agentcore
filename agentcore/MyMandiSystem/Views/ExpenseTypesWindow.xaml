<Window x:Class="MyMandiSystem.Views.ExpenseTypesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Expense Types &amp; Mandi Deduction Schemes" 
        Width="1050" 
        Height="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True">

    <Window.Resources>
        <Storyboard x:Key="FadeInStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:0.25"/>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource FadeInStoryboard}"/>
        </EventTrigger>
    </Window.Triggers>

    <Border Margin="16" CornerRadius="18" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1.5" Effect="{StaticResource EffectModalShadow}">
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="Auto"/> <!-- Tabs Header -->
                <RowDefinition Height="*"/>    <!-- Master-Detail Content -->
                <RowDefinition Height="Auto"/> <!-- Bottom Actions -->
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                       TOP TITLE BAR                        -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border Grid.Row="0" Background="{StaticResource BrushPrimaryNavy}" CornerRadius="18,18,0,0" Padding="22,14"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Cursor="SizeAll">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="#1E293B" Margin="0,0,12,0">
                        <materialDesign:PackIcon Kind="CashSync" Width="24" Height="24" Foreground="{StaticResource BrushAccentTealLight}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Mandi Expense Types &amp; Deduction Schemes" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="خرید و فروخت کے اخراجات، آڑھت، کمیشن، کانٹا اور کٹوتیوں کے اصول" 
                                   FontFamily="{StaticResource FontJameelNooriNastaleeq}" FontSize="15" Foreground="#94A3B8"/>
                    </StackPanel>

                    <Button Grid.Column="2" Click="CloseButton_Click" Cursor="Hand" Width="30" Height="30" 
                            Background="Transparent" BorderThickness="0" Padding="0">
                        <materialDesign:PackIcon Kind="Close" Width="20" Height="20" Foreground="#94A3B8"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                        TABS HEADER                         -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border Grid.Row="1" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="20,8">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="خرید اخراجات (Purchase Expense Schemes)" Style="{StaticResource MaterialDesignTabRadioButton}" 
                                 IsChecked="{Binding SelectedTabIndex, Converter={x:Null}, ConverterParameter=0}" 
                                 FontSize="13" FontWeight="Bold" Margin="0,0,12,0" Checked="TabPurchase_Checked"/>
                    <RadioButton Content="فروخت اخراجات (Sale Expense Schemes)" Style="{StaticResource MaterialDesignTabRadioButton}" 
                                 IsChecked="{Binding SelectedTabIndex, Converter={x:Null}, ConverterParameter=1}" 
                                 FontSize="13" FontWeight="Bold" Checked="TabSale_Checked"/>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                   MASTER-DETAIL CONTENT                    -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="2" Margin="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Sidebar: Schemes List -->
                <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Search & Add New -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="Search Schemes..." 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="8,6" FontSize="12"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="1" Command="{Binding NewSchemeCommand}" ToolTip="Add New Scheme"
                                    Margin="6,0,0,0" Width="34" Height="34" Padding="0" Style="{StaticResource MaterialDesignRaisedButton}"
                                    Background="{StaticResource BrushPrimaryNavy}">
                                <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" Foreground="#FFFFFF"/>
                            </Button>
                        </Grid>

                        <!-- Scheme Items List -->
                        <ListBox Grid.Row="1" ItemsSource="{Binding PurchaseSchemes}" SelectedItem="{Binding SelectedScheme}"
                                 x:Name="SchemesListBox" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,2" Padding="10,8" CornerRadius="8" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="{Binding ExpanseType}" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                                            <TextBlock Text="{Binding SummaryText}" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Grid.Row="2" Text="{Binding PurchaseSchemes.Count, StringFormat='Total Schemes: {0}'}" 
                                   Foreground="#94A3B8" FontSize="11" Margin="4,8,4,0"/>
                    </Grid>
                </Border>

                <!-- Right Detail Panel: Expense Scheme Form -->
                <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="18">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Scheme Title Card -->
                            <Border Background="#F1F5F9" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Scheme Title / نام:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#334155" Margin="0,0,12,0"/>
                                    <TextBox Grid.Column="1" materialDesign:HintAssist.Hint="e.g. Standard Cotton Scheme 2025-26" 
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="10,6" FontSize="13" FontWeight="SemiBold"
                                             Text="{Binding SchemeName, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                            </Border>

                            <!-- Purchase Form Fields (Visible when Tab 0 is selected) -->
                            <StackPanel x:Name="PurchaseFieldsPanel">
                                <TextBlock Text="Purchase Rates &amp; Calculation Rules / خرید کٹوتیوں کی تفصیل" 
                                           FontWeight="Bold" FontSize="13" Foreground="#0F172A" Margin="0,0,0,10"/>

                                <!-- Row 1: Arhat & Commission -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Arhat -->
                                    <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="آڑھت (Arhat)" FontWeight="Bold" FontSize="12" Foreground="#0284C7"/>
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="100"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="Rate / Amount" 
                                                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                                         Text="{Binding PurArhatAmount, UpdateSourceTrigger=PropertyChanged}"/>
                                                <ComboBox Grid.Column="2" materialDesign:HintAssist.Hint="Type" 
                                                          Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                                          Text="{Binding PurArhatType}">
                                                    <ComboBoxItem Content="Per 100"/>
                                                    <ComboBoxItem Content="Calculator"/>
                                                    <ComboBoxItem Content="Fixed"/>
                                                </ComboBox>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Commission -->
                                    <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="کمیشن (Commission)" FontWeight="Bold" FontSize="12" Foreground="#0284C7"/>
                                            <TextBox materialDesign:HintAssist.Hint="Commission Rate / Amount" 
                                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,6,0,0"
                                                     Text="{Binding PurCommissionAmount, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Row 2: Mazdoori & Kanta Expense -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Mazdoori -->
                                    <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="مزدوری (Mazdoori)" FontWeight="Bold" FontSize="12" Foreground="#0284C7"/>
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="110"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="Mazdoori Rate" 
                                                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                                         Text="{Binding PurMazdooriAmount, UpdateSourceTrigger=PropertyChanged}"/>
                                                <ComboBox Grid.Column="2" materialDesign:HintAssist.Hint="Type" 
                                                          Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                                          Text="{Binding PurMazdooriType}">
                                                    <ComboBoxItem Content="Per Bag"/>
                                                    <ComboBoxItem Content="Per Mound"/>
                                                    <ComboBoxItem Content="Percent"/>
                                                </ComboBox>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Kanta Expense -->
                                    <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="کانٹا خرچہ (Weighbridge Fee)" FontWeight="Bold" FontSize="12" Foreground="#0284C7"/>
                                            <TextBox materialDesign:HintAssist.Hint="Kanta Expense (Rs.)" 
                                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,6,0,0"
                                                     Text="{Binding PurKantaExpense, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Row 3: Loading, Unloading & Dalali -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="Loading / لوڈنگ" 
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                             Text="{Binding PurLoadingAmount, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Grid.Column="2" materialDesign:HintAssist.Hint="Unloading / ان لوڈنگ" 
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                             Text="{Binding PurUnLoadingAmount, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Grid.Column="4" materialDesign:HintAssist.Hint="Dalali / دلاّلی" 
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                             Text="{Binding PurDalaliAmount, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>

                                <!-- Row 4: Munshiana, Market Fee & WHTax -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="منشیانہ (Munshiana)" 
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                             Text="{Binding PurMunshianaAmount, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Grid.Column="2" materialDesign:HintAssist.Hint="مارکیٹ فیس (Market Fees)" 
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                             Text="{Binding PurMarketFeesAmount, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Grid.Column="4" materialDesign:HintAssist.Hint="ودہولڈنگ ٹیکس (WHTax)" 
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                             Text="{Binding PurWhtAmount, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>

                                <!-- Row 5: Mandi Other Charges -->
                                <TextBlock Text="دیگر منڈی اخراجات (سلائی، گودام، باردانہ، ٹریکٹر)" FontWeight="SemiBold" FontSize="11" Foreground="#64748B" Margin="0,4,0,6"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="سلائی (Stitching)" 
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                             Text="{Binding PurStitching, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Grid.Column="2" materialDesign:HintAssist.Hint="گودام کرایہ" 
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                             Text="{Binding PurRentGodown, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Grid.Column="4" materialDesign:HintAssist.Hint="باردانہ (Bag Usage)" 
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                             Text="{Binding PurBagUsage, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Grid.Column="6" materialDesign:HintAssist.Hint="ٹریکٹر خرچہ" 
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                             Text="{Binding PurTractorExp, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                            </StackPanel>

                            <!-- Sale Form Fields (Visible when Tab 1 is selected) -->
                            <StackPanel x:Name="SaleFieldsPanel" Visibility="Collapsed">
                                <TextBlock Text="Sale Deductions &amp; Charges / فروخت کے اخراجات و کٹوتیاں" 
                                           FontWeight="Bold" FontSize="13" Foreground="#0F172A" Margin="0,0,0,10"/>

                                <!-- Row 1: Sale Commission & Mazdoori -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="کمیشن فروخت (Sale Commission)" FontWeight="Bold" FontSize="12" Foreground="#059669"/>
                                            <TextBox materialDesign:HintAssist.Hint="Commission Amount / Rate" 
                                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,6,0,0"
                                                     Text="{Binding SaleCommissionAmount, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="مزدوری فروخت (Sale Mazdoori)" FontWeight="Bold" FontSize="12" Foreground="#059669"/>
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="110"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="Mazdoori Rate" 
                                                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                                         Text="{Binding SaleMazdooriAmount, UpdateSourceTrigger=PropertyChanged}"/>
                                                <ComboBox Grid.Column="2" materialDesign:HintAssist.Hint="Type" 
                                                          Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                                          Text="{Binding SaleMazdooriType}">
                                                    <ComboBoxItem Content="Per Bag"/>
                                                    <ComboBoxItem Content="Per Mound"/>
                                                    <ComboBoxItem Content="Percent"/>
                                                </ComboBox>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Row 2: Kanta, Sootali & Market Fees -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="کانٹا خرچہ (Kanta Expense)" 
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                             Text="{Binding SaleKantaExpense, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Grid.Column="2" materialDesign:HintAssist.Hint="سوتلی فی بوری (Sootli)" 
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                             Text="{Binding SaleSootaliAmount, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Grid.Column="4" materialDesign:HintAssist.Hint="مارکیٹ فیس (Market Fees)" 
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                             Text="{Binding SaleMarketFeesAmount, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>

                                <!-- Row 3: Loading, Unloading, Dalali, Munshiana, WHT -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="لوڈنگ (Loading)" 
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                             Text="{Binding SaleLoadingAmount, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Grid.Column="2" materialDesign:HintAssist.Hint="ان لوڈنگ (Unloading)" 
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                             Text="{Binding SaleUnloadingAmount, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Grid.Column="4" materialDesign:HintAssist.Hint="دلاّلی (Dalali)" 
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                             Text="{Binding SaleDalaliAmount, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Grid.Column="6" materialDesign:HintAssist.Hint="ودہولڈنگ ٹیکس (WHT)" 
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                             Text="{Binding SaleWhtAmount, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                       FOOTER ACTIONS                       -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,14" CornerRadius="0,0,18,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Command="{Binding DeleteSchemeCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                            BorderBrush="#EF4444" Foreground="#EF4444" Height="38" Padding="14,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="DeleteOutline" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Delete Scheme / حذف کریں" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}" Height="38" Padding="14,0" Margin="0,0,10,0"
                                Click="CloseButton_Click" Foreground="#64748B" BorderBrush="#CBD5E1">
                            <TextBlock Text="Close / بند کریں"/>
                        </Button>

                        <Button Command="{Binding SaveSchemeCommand}"
                                Background="{StaticResource BrushPrimaryNavy}" Foreground="#FFFFFF" BorderThickness="0" Height="38" Padding="20,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSaveCheck" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Save Scheme / محفوظ کریں" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
