<Window x:Class="MyMandiSystem.Views.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="agentcore - Report Print &amp; Export Preview" 
        Height="840" Width="1160"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Action & Control Bar -->
            <RowDefinition Height="*"/>    <!-- Scrollable Printable Document Area -->
            <RowDefinition Height="Auto"/> <!-- Summary / Status Footer -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--                 1. TOP CONTROL & ACTION BAR                -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{StaticResource BrushPrimaryNavy}" Padding="20,12" Effect="{StaticResource EffectCardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Title & Quick Info -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="8" Background="#1E293B" Margin="0,0,12,0">
                        <materialDesign:PackIcon Kind="FileDocumentBoxOutline" Width="22" Height="22" Foreground="{StaticResource BrushAccentTealLight}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtReportTitle" Text="Report Preview" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="سٹی کمپیوٹرز مروٹ — جامع رپورٹ پرنٹ و پری ویو" 
                                   FontFamily="{StaticResource FontJameelNooriNastaleeq}" FontSize="14.5" Foreground="#94A3B8"/>
                    </StackPanel>
                </StackPanel>


                <!-- Right: Preview, Print, Export, Close Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Multi-Page Print Preview Button -->
                    <Button Click="PreviewButton_Click" Cursor="Hand" Height="38" Padding="14,0" Margin="0,0,10,0"
                            Background="#0284C7" Foreground="#FFFFFF" BorderThickness="0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="EyeOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Preview (پری ویو)" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Print Button -->
                    <Button Click="PrintButton_Click" Cursor="Hand" Height="38" Padding="16,0" Margin="0,0,10,0"
                            Style="{StaticResource ModernPrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Printer" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Print (پرنٹ)" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Export to CSV / Excel Button -->
                    <Button Click="ExportButton_Click" Cursor="Hand" Height="38" Padding="14,0" Margin="0,0,10,0"
                            Background="#334155" Foreground="#FFFFFF" BorderThickness="0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileExcel" Width="18" Height="18" Foreground="#22C55E" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Export CSV (ایکسپورٹ)" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Close Button -->
                    <Button Click="CloseButton_Click" Cursor="Hand" Height="38" Padding="14,0"
                            Background="#1E293B" Foreground="#CBD5E1" BorderBrush="#475569" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Close" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Close" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--           2. PRINTABLE DOCUMENT AREA (PRINT AREA)          -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" 
                      Background="#CBD5E1" Padding="12,18">
            <Border x:Name="PrintArea" Width="820" HorizontalAlignment="Center"
                    Background="#FFFFFF" CornerRadius="4" BorderBrush="#94A3B8" BorderThickness="1" 
                    Padding="26,22" MinHeight="1050" Effect="{StaticResource EffectCardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Row 0: Business Header -->
                        <RowDefinition Height="Auto"/> <!-- Row 1: Sub-Header -->
                        <RowDefinition Height="*"/>    <!-- Row 2: Main DataGrid -->
                    </Grid.RowDefinitions>

                    <!-- ═══ FORMAL BUSINESS PRINT HEADER ═══ -->
                    <Border Grid.Row="0" BorderBrush="#0F172A" BorderThickness="0,0,0,2.5" Padding="0,0,0,14" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Firm Logo / Emblem -->
                            <Border Grid.Column="0" Width="68" Height="68" CornerRadius="12" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1.5" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="OfficeBuilding" Width="40" Height="40" Foreground="{StaticResource BrushAccentTeal}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Center: Business Name (Urdu & English) + Address + Phone -->
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Firm Name (Urdu) -->
                                <TextBlock x:Name="TxtHeaderBusinessUrdu" Text="سٹی کمپیوٹرز مروٹ" 
                                           FontFamily="{StaticResource FontJameelNooriNastaleeq}" FontSize="26" FontWeight="Bold" 
                                           Foreground="#0F172A" HorizontalAlignment="Center" FlowDirection="RightToLeft" Margin="0,0,0,2"/>

                                <!-- Firm Name (English) -->
                                <TextBlock x:Name="TxtHeaderBusinessName" Text="City Computers Marot" 
                                           FontSize="16.5" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center" Margin="0,0,0,3"/>

                                <!-- Address / Mandi Location -->
                                <TextBlock x:Name="TxtHeaderAddress" Text="Grain Market, Marot (غلہ منڈی مروٹ)" 
                                           FontSize="12.5" Foreground="#475569" HorizontalAlignment="Center"/>

                                <!-- Phone Numbers & Malik / Proprietor -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3,0,0">
                                    <TextBlock x:Name="TxtHeaderPhone" Text="📞 0344-7436314" FontSize="12.5" FontWeight="Bold" Foreground="#0F766E"/>
                                    <TextBlock x:Name="TxtHeaderProprietor" Text="" FontSize="12.5" Foreground="#334155" Margin="10,0,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Right: Report Category & Generated Timestamp -->
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Border Background="#0F172A" CornerRadius="4" Padding="8,3" HorizontalAlignment="Right">
                                    <TextBlock x:Name="TxtHeaderReportBadge" Text="ACCOUNT LEDGER" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                                </Border>
                                <TextBlock x:Name="TxtHeaderTimestamp" Text="Date: Today" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                                <TextBlock x:Name="TxtHeaderRegNo" Text="" FontSize="10.5" Foreground="#94A3B8" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ═══ SUB-HEADER: TARGET ACCOUNT & FILTER INFO ═══ -->
                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="TxtAccountHeader" Text="Account: General Ledger" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock x:Name="TxtPeriodHeader" Text="Period: All Dates (تمام تاریخیں)" FontSize="12" Foreground="#475569" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Currency: PKR (روپے)" FontSize="11.5" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ═══ MAIN DATA GRID ═══ -->
                    <DataGrid Grid.Row="2" x:Name="ReportDataGrid"
                              Style="{StaticResource ModernDataGrid}"
                              AutoGenerateColumns="True"
                              IsReadOnly="True"
                              CanUserSortColumns="True"
                              AutoGeneratingColumn="ReportDataGrid_AutoGeneratingColumn"
                              GridLinesVisibility="All"
                              HorizontalGridLinesBrush="#E2E8F0"
                              VerticalGridLinesBrush="#E2E8F0"
                              HorizontalScrollBarVisibility="Disabled"
                              FontSize="13"
                              RowHeight="34"
                              ColumnHeaderHeight="38"
                              Background="#FFFFFF"
                              HorizontalAlignment="Stretch"/>

                </Grid>
            </Border>
        </ScrollViewer>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--                  3. SUMMARY / TOTALS FOOTER                -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Row Count -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Total Records:" FontWeight="SemiBold" FontSize="12.5" Foreground="#64748B"/>
                    <TextBlock x:Name="TxtRowCount" Text="0" FontWeight="Bold" FontSize="13" Foreground="#0F172A" Margin="6,0,0,0"/>
                </StackPanel>

                <!-- Totals (Debit, Credit, Balance) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Total Debit -->
                    <Border x:Name="BadgeDebit" Background="#FFF1F2" BorderBrush="#FECDD3" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,10,0" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Total Debit: Rs. " FontSize="12" FontWeight="SemiBold" Foreground="#9F1239"/>
                            <TextBlock x:Name="TxtTotalDebit" Text="0" FontSize="13" FontWeight="Bold" Foreground="#E11D48"/>
                        </StackPanel>
                    </Border>

                    <!-- Total Credit -->
                    <Border x:Name="BadgeCredit" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,10,0" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Total Credit: Rs. " FontSize="12" FontWeight="SemiBold" Foreground="#166534"/>
                            <TextBlock x:Name="TxtTotalCredit" Text="0" FontSize="13" FontWeight="Bold" Foreground="#16A34A"/>
                        </StackPanel>
                    </Border>

                    <!-- Net Balance -->
                    <Border x:Name="BadgeBalance" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,4" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Net Balance: Rs. " FontSize="12" FontWeight="SemiBold" Foreground="#334155"/>
                            <TextBlock x:Name="TxtNetBalance" Text="0" FontSize="13" FontWeight="Bold" Foreground="#0F172A"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
