<Window x:Class="MyMandiSystem.Views.DepositReconciliationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Deposit Reconciliation" 
        Height="760" Width="1160"
        MinHeight="550" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        FontFamily="Segoe UI" FontSize="12"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="ClassicButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="85"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="10,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#64748B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimarySaveButton" TargetType="Button" BasedOn="{StaticResource ClassicButton}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#1D4ED8"/>
            <Setter Property="MinWidth" Value="135"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="14,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderFilterRadio" TargetType="RadioButton">
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <DockPanel LastChildFill="True">

            <!-- ═══ 0. HEADER CARD ═══ -->
            <Border DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#1E3A8A" Margin="0,0,12,0" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="BankCheck" Width="20" Height="20" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Deposit Reconciliation" FontSize="16" FontWeight="Bold" Foreground="#1E3A8A"/>
                        <TextBlock Text="Reconcile bank deposits (both Cash Slips &amp; Cheque Deposits) with bank account statements" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Shortcut Legend -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="3,0">
                            <TextBlock Text="F5: Load" Foreground="#475569" FontSize="10.5" FontWeight="SemiBold"/>
                        </Border>
                        <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="3,0">
                            <TextBlock Text="F2: Save" Foreground="#475569" FontSize="10.5" FontWeight="SemiBold"/>
                        </Border>
                        <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="3,0">
                            <TextBlock Text="Esc: Close" Foreground="#475569" FontSize="10.5" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ 1. BANK SELECTION, STATUS FILTERS, AND BALANCES ═══ -->
            <Border DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Bank Account -->
                        <ColumnDefinition Width="320"/>
                        <!-- Filter Radios -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Spacer -->
                        <ColumnDefinition Width="*"/>
                        <!-- Balance Summary Cards -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Bank Selection -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Bank Account" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,2"/>
                        <ComboBox ItemsSource="{Binding BankAccounts}" 
                                  SelectedItem="{Binding SelectedBankAccount}"
                                  DisplayMemberPath="BankName"
                                  FontSize="12" Height="26"
                                  Background="#FFFFFF" BorderBrush="#94A3B8"/>
                        <TextBlock Text="{Binding BankAccountNo, StringFormat='A/C No: {0}'}" FontSize="10" Foreground="#2563EB" Margin="2,2,0,0" FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- Filter Radio Buttons -->
                    <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton Content="Un-Reconciled" IsChecked="{Binding IsUnReconciledFilter}" Style="{StaticResource HeaderFilterRadio}"/>
                            <RadioButton Content="Reconciled" IsChecked="{Binding IsReconciledFilter}" Style="{StaticResource HeaderFilterRadio}"/>
                            <RadioButton Content="All Deposits" IsChecked="{Binding IsAllFilter}" Style="{StaticResource HeaderFilterRadio}"/>
                        </StackPanel>
                    </Border>

                    <!-- Real-time Reconciliation Balance Cards -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Reconciled Balance -->
                        <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="4" Padding="10,4" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Reconciled Balance" FontSize="9.5" FontWeight="SemiBold" Foreground="#047857"/>
                                <TextBlock Text="{Binding ReconciledBalance, StringFormat='Rs. {0:N2}'}" FontSize="12.5" FontWeight="Bold" Foreground="#065F46"/>
                            </StackPanel>
                        </Border>

                        <!-- Un-Reconciled Balance -->
                        <Border Background="#FFF1F2" BorderBrush="#FECDD3" BorderThickness="1" CornerRadius="4" Padding="10,4">
                            <StackPanel>
                                <TextBlock Text="Un-Reconciled Balance" FontSize="9.5" FontWeight="SemiBold" Foreground="#BE123C"/>
                                <TextBlock Text="{Binding UnReconciledBalance, StringFormat='Rs. {0:N2}'}" FontSize="12.5" FontWeight="Bold" Foreground="#9F1239"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ 2. BATCH RECONCILE ACTION BAR ═══ -->
            <Border DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Batch Date Label & Picker -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Batch Reconcile Date:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <DatePicker SelectedDate="{Binding BatchReconcileDate}" Width="110" Height="26" FontSize="11.5" VerticalAlignment="Center" Background="#FFFFFF" BorderBrush="#94A3B8"/>
                    </StackPanel>

                    <!-- Apply Date Button -->
                    <Button Grid.Column="1" Command="{Binding ApplyBatchDateCommand}" Style="{StaticResource ClassicButton}"
                            Height="26" MinWidth="135" Margin="8,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CalendarCheck" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Apply Date to Checked" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <!-- Clear Date Button -->
                    <Button Grid.Column="2" Command="{Binding ClearSelectedDatesCommand}" Style="{StaticResource ClassicButton}"
                            Height="26" MinWidth="130" Margin="4,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CalendarRemove" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Clear Reconcile Date" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <!-- Counts Badge -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                            <TextBlock FontSize="10.5" Foreground="#334155">
                                <Run Text="Total: " FontWeight="Normal"/>
                                <Run Text="{Binding TotalDepositsCount}" FontWeight="Bold"/>
                            </TextBlock>
                        </Border>
                        <Border Background="#DBEAFE" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="6,2">
                            <TextBlock FontSize="10.5" Foreground="#1E40AF">
                                <Run Text="Selected: " FontWeight="Normal"/>
                                <Run Text="{Binding SelectedDepositsCount}" FontWeight="Bold"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ 4. BOTTOM ACTION BAR & STATUS ═══ -->
            <Border DockPanel.Dock="Bottom" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Status message -->
                        <ColumnDefinition Width="*"/>
                        <!-- Action buttons -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" 
                               FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <!-- Clear (F3) -->
                        <Button Command="{Binding ClearCommand}" Style="{StaticResource ClassicButton}" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Clear (F3)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Load / Refresh (F5) -->
                        <Button Command="{Binding LoadDepositsCommand}" Style="{StaticResource ClassicButton}" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="DatabaseRefresh" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Load (F5)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Save Reconciliations (F2) -->
                        <Button Command="{Binding SaveCommand}" Style="{StaticResource PrimarySaveButton}" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSaveCheck" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Save Reconcile (F2)" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Close (Esc) -->
                        <Button Command="{Binding CloseCommand}" Style="{StaticResource ClassicButton}">
                            <TextBlock Text="Close (Esc)" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ 3. MAIN DATA GRID ═══ -->
            <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6">
                <DataGrid ItemsSource="{Binding Deposits}"
                          AutoGenerateColumns="False" CanUserAddRows="False"
                          CanUserDeleteRows="False" SelectionMode="Single"
                          Background="White" BorderThickness="0"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                          RowHeight="28" FontSize="11.5" HeadersVisibility="Column">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#1E293B"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Height" Value="28"/>
                            <Setter Property="Padding" Value="8,0"/>
                            <Setter Property="BorderBrush" Value="#334155"/>
                            <Setter Property="BorderThickness" Value="0,0,1,0"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>
                        <!-- Select Checkbox with Header "Select All" -->
                        <DataGridTemplateColumn Width="45">
                            <DataGridTemplateColumn.Header>
                                <CheckBox IsChecked="{Binding DataContext.IsSelectAll, RelativeSource={RelativeSource AncestorType=Window}}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" 
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Voucher # -->
                        <DataGridTextColumn Header="Voucher #" Binding="{Binding VoucherNo}" Width="90" IsReadOnly="True"/>

                        <!-- Voucher Date -->
                        <DataGridTextColumn Header="Voucher Date" Binding="{Binding VoucherDateFormatted}" Width="95" IsReadOnly="True"/>

                        <!-- Deposit Type (Cheque vs Cash Slip) -->
                        <DataGridTemplateColumn Header="Type" Width="105" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="3" Padding="6,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCheque}" Value="True">
                                                        <Setter Property="Background" Value="#E0F2FE"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsCheque}" Value="False">
                                                        <Setter Property="Background" Value="#FEF3C7"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding DepositType}" FontSize="10.5" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCheque}" Value="True">
                                                            <Setter Property="Foreground" Value="#0369A1"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsCheque}" Value="False">
                                                            <Setter Property="Foreground" Value="#B45309"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Slip # -->
                        <DataGridTextColumn Header="Slip #" Binding="{Binding SlipNo}" Width="85" IsReadOnly="True"/>

                        <!-- Deposit Date -->
                        <DataGridTextColumn Header="Deposit Date" Binding="{Binding DepositedDateFormatted}" Width="95" IsReadOnly="True"/>

                        <!-- Cheque # (If Cheque Deposit) -->
                        <DataGridTextColumn Header="Cheque #" Binding="{Binding ChequeNo}" Width="95" IsReadOnly="True"/>

                        <!-- Account / Party Name -->
                        <DataGridTextColumn Header="Party / Credit Account" Binding="{Binding AccountName}" Width="*" IsReadOnly="True"/>

                        <!-- Amount -->
                        <DataGridTextColumn Header="Amount (Rs.)" Binding="{Binding Amount, StringFormat='N2'}" Width="110" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#0F172A"/>
                                    <Setter Property="Margin" Value="0,0,8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Reconcile Date (Editable DatePicker) -->
                        <DataGridTemplateColumn Header="Reconcile Date" Width="125">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <DatePicker SelectedDate="{Binding ReconcileDate, UpdateSourceTrigger=PropertyChanged}" 
                                                FontSize="11" Height="24" BorderThickness="0" Background="Transparent"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Status Badge -->
                        <DataGridTemplateColumn Header="Status" Width="105" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="3" Padding="6,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsReconciled}" Value="True">
                                                        <Setter Property="Background" Value="#DCFCE7"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsReconciled}" Value="False">
                                                        <Setter Property="Background" Value="#FEF3C7"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusBadge}" FontSize="10.5" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsReconciled}" Value="True">
                                                            <Setter Property="Foreground" Value="#15803D"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsReconciled}" Value="False">
                                                            <Setter Property="Foreground" Value="#B45309"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>
    </Grid>
</Window>
