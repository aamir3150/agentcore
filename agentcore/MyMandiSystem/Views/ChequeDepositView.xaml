<UserControl x:Class="MyMandiSystem.Views.ChequeDepositView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:MyMandiSystem.Helpers"
             mc:Ignorable="d"
             Background="#F1F5F9"
             d:DesignHeight="640" d:DesignWidth="850"
             FontFamily="Segoe UI" FontSize="12"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded"
             PreviewKeyDown="UserControl_PreviewKeyDown">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- AgentCore ClassicButton Style (Consistent across JournalVoucher, BankChequeIssue, CashPayment) -->
        <Style x:Key="ClassicButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="84"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="4" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="10,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#BFDBFE"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="ReadOnlyBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="FieldTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="BalanceTitle" TargetType="TextBlock" BasedOn="{StaticResource FieldTitle}">
            <Setter Property="Foreground" Value="#DC2626"/>
        </Style>

        <!-- Hidden Right-Click Context Menu matching AgenSoft MnuDef (Visible=False PopupMenu) -->
        <ContextMenu x:Key="AccountDefContextMenu"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Customers" Command="{Binding OpenCustomersDefinitionCommand}"/>
            <MenuItem Header="Vendors" Command="{Binding OpenVendorsDefinitionCommand}"/>
            <Separator/>
            <MenuItem Header="Others (Chart of Accounts)" Command="{Binding OpenOtherAccountsDefinitionCommand}"/>
        </ContextMenu>
    </UserControl.Resources>

    <Grid>
        <Grid Margin="12">
            <DockPanel LastChildFill="True">

                    <!-- TOP HEADER TITLE BAR (Exact AgentCore Style) -->
                    <Border DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#1E3A8A" Margin="0,0,12,0" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="BankTransferIn" Width="22" Height="22" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Bank Cheque Deposit" FontSize="16" FontWeight="Bold" Foreground="#1E3A8A"/>
                                    <Border CornerRadius="4" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FEF3C7"/>
                                                <Setter Property="BorderBrush" Value="#FDE68A"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsReconciled}" Value="True">
                                                        <Setter Property="Background" Value="#DCFCE7"/>
                                                        <Setter Property="BorderBrush" Value="#BBF7D0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding ReconcileStatusText}" FontSize="10.5" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#92400E"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsReconciled}" Value="True">
                                                            <Setter Property="Foreground" Value="#166534"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Record bank cheque deposits, clearance confirmation, bank reconciliation &amp; GL posting" FontSize="11" Foreground="#64748B"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Optional Branch Indicator -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0"
                                            Visibility="{Binding IsBranchVisible, Converter={StaticResource BoolToVis}}">
                                    <materialDesign:PackIcon Kind="StoreOutline" Width="15" Height="15" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <ComboBox ItemsSource="{Binding Branches}" SelectedItem="{Binding SelectedBranch}"
                                              DisplayMemberPath="BranchName" Width="140"/>
                                </StackPanel>

                                <!-- Live Time Display (DtVoucherTime) -->
                                <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="ClockOutline" Width="14" Height="14" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding VoucherTimeText, Mode=OneWay}" FontSize="11.5" FontWeight="SemiBold" Foreground="#1E293B"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- BOTTOM TOOLBAR BAR (Exact AgentCore Style with AgenSoft Actions) -->
                    <Border DockPanel.Dock="Bottom" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,8,0,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox Content="Send SMS" IsChecked="{Binding SendSms}" FontWeight="SemiBold" Foreground="#1E293B"
                                          VerticalAlignment="Center" Margin="0,0,14,0"
                                          Visibility="{Binding IsSmsVisible, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="F1: Lookup  |  F2: Save  |  F3: Clear  |  Ctrl+O: Open  |  Ctrl+P: Print  |  Esc: Close"
                                           FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Remove (Ctrl+R)" Command="{Binding DeleteVoucherCommand}" Style="{StaticResource ClassicButton}"
                                        Background="#DC2626" Foreground="#FFFFFF" BorderBrush="#B91C1C"/>
                                <Button Content="Open (Ctrl+O)" Command="{Binding OpenSearchModalCommand}" Style="{StaticResource ClassicButton}"/>
                                <Button Content="Print (Ctrl+P)" Command="{Binding PrintCommand}" Style="{StaticResource ClassicButton}"/>
                                <Button Content="Clear / New (F3)" Command="{Binding NewVoucherCommand}" Style="{StaticResource ClassicButton}"/>
                                <Button Content="Save (F2)" Command="{Binding SaveCommand}" Style="{StaticResource ClassicButton}"
                                        Background="#2563EB" Foreground="#FFFFFF" BorderBrush="#1D4ED8"/>
                                <Button Content="Close (Esc)" Click="CloseButton_Click" Style="{StaticResource ClassicButton}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- MAIN CONTENT: LEFT FRMCHEQUEDEPOSIT FIELDS CARD + OPTIONAL RIGHT MULTI-DEPOSIT GRID -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- FRMCHEQUEDEPOSIT EXACT FIELDS & LAYOUT INSIDE AGENTCORE CARD -->
                        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="16,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- ROW 1: Voucher No., Voucher Date, Slip No., Crop Season -->
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="135"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Voucher No." Style="{StaticResource FieldTitle}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding IdBranch, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="42" Margin="0,0,4,0" FontWeight="SemiBold"
                                                     Visibility="{Binding IsIdBranchVisible, Converter={StaticResource BoolToVis}}"
                                                     KeyDown="Input_KeyDown"/>
                                            <TextBox x:Name="TxtVoucherno" Grid.Column="1"
                                                     Text="{Binding VoucherNo, UpdateSourceTrigger=PropertyChanged}"
                                                     FontWeight="Bold" Foreground="#1E3A8A"
                                                     IsReadOnly="{Binding IsVoucherNoReadOnly}"
                                                     KeyDown="Input_KeyDown"/>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Voucher Date" Style="{StaticResource FieldTitle}"/>
                                        <DatePicker SelectedDate="{Binding VoucherDate}"
                                                    IsEnabled="{Binding IsVoucherDateEnabled}"
                                                    PreviewKeyDown="Input_KeyDown"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Slip No." Style="{StaticResource FieldTitle}"/>
                                        <TextBox x:Name="TxtSlipNo" Text="{Binding SlipNo, UpdateSourceTrigger=PropertyChanged}"
                                                 MaxLength="15" KeyDown="Input_KeyDown"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="6" Visibility="{Binding IsCropSeasonVisible, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Crop Season" Style="{StaticResource FieldTitle}"/>
                                        <ComboBox ItemsSource="{Binding Seasons}" SelectedItem="{Binding SelectedSeason}"
                                                  DisplayMemberPath="Name"/>
                                    </StackPanel>
                                </Grid>

                                <!-- ROW 2: Cheque Date, Cheque No., Reconcile, Deposit Confirmed -->
                                <Grid Grid.Row="1" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="135"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Cheque Date" Style="{StaticResource FieldTitle}"/>
                                        <DatePicker SelectedDate="{Binding ChequeDate}" PreviewKeyDown="Input_KeyDown"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Cheque No." Style="{StaticResource FieldTitle}"/>
                                        <TextBox x:Name="TxtChequeNo" Text="{Binding ChequeNo, UpdateSourceTrigger=PropertyChanged}"
                                                 MaxLength="15" FontWeight="SemiBold" KeyDown="Input_KeyDown"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,4">
                                        <CheckBox x:Name="ChkReconcile" Content="Reconcile this deposit now."
                                                  IsChecked="{Binding IsReconciled}" FontWeight="SemiBold" Foreground="#92400E"
                                                  Margin="0,0,18,0" KeyDown="Input_KeyDown"/>
                                        <CheckBox Content="Deposit Confirmed"
                                                  IsChecked="{Binding IsDepositConfirmed}" FontWeight="SemiBold" Foreground="#1E293B"
                                                  KeyDown="Input_KeyDown"/>
                                    </StackPanel>
                                </Grid>

                                <!-- ROW 3: Bank A/C No. + [...], Bank Account Name, Account Balance -->
                                <Grid Grid.Row="2" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="175"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Bank A/C No." Style="{StaticResource FieldTitle}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="30"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtBankAccountno" Grid.Column="0"
                                                     Text="{Binding BankAccountNo, UpdateSourceTrigger=PropertyChanged}"
                                                     FontWeight="Bold" Foreground="#1E3A8A"
                                                     ContextMenu="{StaticResource AccountDefContextMenu}"
                                                     ToolTip="Press F1 or click ... to search Bank Account (Right-click for Definitions)"
                                                     KeyDown="TxtBankAccountno_KeyDown"
                                                     LostFocus="TxtBankAccountno_LostFocus"/>
                                            <Button x:Name="BtnBankLookup" Grid.Column="1" Content="..."
                                                    Style="{StaticResource ClassicButton}" MinWidth="26" Height="26" Margin="4,0,0,0" Padding="0"
                                                    ToolTip="Search Bank Account (F1)" Click="BtnBankLookup_Click"/>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Bank Account Name" Style="{StaticResource FieldTitle}"/>
                                        <TextBox Text="{Binding BankAccountName}" Style="{StaticResource ReadOnlyBox}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Account Balance" Style="{StaticResource BalanceTitle}"/>
                                        <TextBox Text="{Binding BankAccountBalanceText, Mode=OneWay}"
                                                 Style="{StaticResource ReadOnlyBox}"
                                                 HorizontalContentAlignment="Right" Foreground="#1E3A8A"/>
                                    </StackPanel>
                                </Grid>

                                <!-- ROW 4: Received By + [...], Account Name, Account Balance -->
                                <Grid Grid.Row="3" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="175"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Received By" Style="{StaticResource FieldTitle}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="30"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtReceivedBy" Grid.Column="0"
                                                     Text="{Binding PartyAccountNo, UpdateSourceTrigger=PropertyChanged}"
                                                     FontWeight="Bold" Foreground="#0F766E"
                                                     ContextMenu="{StaticResource AccountDefContextMenu}"
                                                     ToolTip="Press F1 or click ... to search Account (Right-click for Definitions)"
                                                     KeyDown="TxtReceivedBy_KeyDown"
                                                     LostFocus="TxtReceivedBy_LostFocus"/>
                                            <Button x:Name="BtnPartyLookup" Grid.Column="1" Content="..."
                                                    Style="{StaticResource ClassicButton}" MinWidth="26" Height="26" Margin="4,0,0,0" Padding="0"
                                                    ToolTip="Search Accounts (F1)" Click="BtnPartyLookup_Click"/>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Account Name" Style="{StaticResource FieldTitle}"/>
                                        <TextBox Text="{Binding PartyAccountName}" Style="{StaticResource ReadOnlyBox}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Account Balance" Style="{StaticResource BalanceTitle}"/>
                                        <TextBox Text="{Binding PartyAccountBalanceText, Mode=OneWay}"
                                                 Style="{StaticResource ReadOnlyBox}"
                                                 HorizontalContentAlignment="Right" Foreground="#065F46"/>
                                    </StackPanel>
                                </Grid>

                                <!-- ROW 5: Amount, Amount in Words -->
                                <Grid Grid.Row="4" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Amount" Style="{StaticResource FieldTitle}"/>
                                        <TextBox x:Name="TxtAmount" Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="13.5" FontWeight="Bold" Foreground="#1E3A8A"
                                                 Background="#FFFBEB" HorizontalContentAlignment="Right"
                                                 KeyDown="Input_KeyDown"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Amount in Words" Style="{StaticResource FieldTitle}"/>
                                        <TextBox Text="{Binding AmountInWords, Mode=OneWay}"
                                                 Style="{StaticResource ReadOnlyBox}" FontStyle="Italic" Foreground="#334155"/>
                                    </StackPanel>
                                </Grid>

                                <!-- ROW 6: Narration, Deposited by, Narration In Urdu + Right-side Biometric/Thumb Panel -->
                                <Grid Grid.Row="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Narration" Style="{StaticResource FieldTitle}"/>
                                        <TextBox x:Name="TxtNarration" Text="{Binding Narration, UpdateSourceTrigger=PropertyChanged}"
                                                 MaxLength="1000" Margin="0,0,0,10" KeyDown="Input_KeyDown"/>

                                        <TextBlock Text="Deposited by" Style="{StaticResource FieldTitle}"/>
                                        <TextBox x:Name="TxtDepositedBy" Text="{Binding DepositedBy, UpdateSourceTrigger=PropertyChanged}"
                                                 MaxLength="30" Margin="0,0,0,10" KeyDown="Input_KeyDown"/>

                                        <StackPanel Visibility="{Binding IsUrduNarrationVisible, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Narration In Urdu:" Style="{StaticResource FieldTitle}"/>
                                            <TextBox x:Name="TxtNarrationUrdu" Text="{Binding NarrationUrdu, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource ModernUrduStandardTextBox}"
                                                     helpers:UrduHelper.IsUrduOnly="True"
                                                     MinHeight="34" Height="34" Background="#FFFFFF" BorderBrush="#94A3B8" Padding="6,1"
                                                     KeyDown="Input_KeyDown"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Biometric / Thumb Panel (Matches Debit Voucher / AgenSoft right block) -->
                                    <Border Grid.Column="1" Width="175" Margin="12,18,0,0" VerticalAlignment="Top"
                                            Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,8"
                                            Visibility="{Binding IsThumbSectionVisible, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="Thumb Impression" FontSize="11" FontWeight="Bold" Foreground="#475569"
                                                       HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                            <Border Height="86" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Margin="0,0,0,8">
                                                <Grid>
                                                    <TextBlock Text="{Binding ThumbStatusText}" FontSize="10.5" Foreground="#94A3B8"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="4"/>
                                                    <Image Source="{Binding ThumbImageSource}" Stretch="Uniform" Margin="2"
                                                           Visibility="{Binding ShowThumb, Converter={StaticResource BoolToVis}}"/>
                                                </Grid>
                                            </Border>
                                            <CheckBox Content="Show Thumb" IsChecked="{Binding ShowThumb}" FontSize="11.5" Foreground="#1E293B" Margin="0,0,0,8"/>
                                            <Button Content="Thumb Register" Command="{Binding ThumbRegisterCommand}"
                                                    Style="{StaticResource ClassicButton}" Margin="0" Height="26" FontSize="11"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- OPTIONAL RIGHT-SIDE MULTI-DEPOSIT GRID (Visible ONLY when UseBankDepositMulti = 1) -->
                        <Border Grid.Column="1" Width="370" Margin="10,0,0,0"
                                Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10"
                                Visibility="{Binding IsMultiGridVisible, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding VoucherDate, StringFormat='Deposits on {0:dd-MMM-yyyy}', Mode=OneWay}"
                                               FontSize="12.5" FontWeight="Bold" Foreground="#1E3A8A" VerticalAlignment="Center"/>
                                    <Button Content="Print Register" Command="{Binding PrintDayRegisterCommand}" HorizontalAlignment="Right"
                                            Style="{StaticResource ClassicButton}" MinWidth="80" Height="24" Margin="0" FontSize="11"/>
                                </DockPanel>

                                <DataGrid x:Name="TodayDepositsGrid" Grid.Row="1" ItemsSource="{Binding TodayDeposits}"
                                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                          SelectionMode="Single" HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0"
                                          RowHeight="24" FontSize="11"
                                          MouseDoubleClick="TodayDepositsGrid_MouseDoubleClick">
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#1E293B"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Height" Value="26"/>
                                            <Setter Property="Padding" Value="6,0"/>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="V No" Binding="{Binding VoucherNo}" Width="40"/>
                                        <DataGridTextColumn Header="Slip" Binding="{Binding SlipNo}" Width="55"/>
                                        <DataGridTextColumn Header="Bank" Binding="{Binding BankAccountName}" Width="*"/>
                                        <DataGridTextColumn Header="Deposited By" Binding="{Binding DepositedBy}" Width="*"/>
                                        <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat='{}{0:N0}'}" Width="70"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Border Grid.Row="2" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,8,0,0">
                                    <DockPanel>
                                        <TextBlock Text="Total Amount:" FontSize="12" FontWeight="Bold" Foreground="#1E3A8A" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding TodayTotalAmount, StringFormat='Rs. {0:#,##0.##}'}"
                                                   FontSize="13.5" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
            </DockPanel>
        </Grid>

        <!-- F1 ACCOUNT LOOKUP MODAL (AgentCore Style) -->
        <Grid Background="#770F172A" Visibility="{Binding IsAccountLookupOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#FFFFFF" Width="620" Height="450" CornerRadius="8" Padding="14"
                    BorderBrush="#CBD5E1" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding LookupTitle}" FontSize="15" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,0,0,10"/>

                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#94A3B8" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,0,10">
                        <Grid>
                            <materialDesign:PackIcon Kind="Magnify" Width="16" Height="16" Foreground="#2563EB" VerticalAlignment="Center" Margin="2,0,0,0"/>
                            <TextBox x:Name="TxtLookupSearch"
                                     Text="{Binding LookupSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="22,0,0,0" BorderThickness="0" Background="Transparent"
                                     KeyDown="TxtLookupSearch_KeyDown"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                        <DataGrid x:Name="LookupDataGrid" ItemsSource="{Binding FilteredAccounts}"
                                  SelectedItem="{Binding SelectedLookupAccount}"
                                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                  CanUserAddRows="False" RowHeight="26"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0"
                                  MouseDoubleClick="LookupDataGrid_MouseDoubleClick" KeyDown="LookupDataGrid_KeyDown">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#1E293B"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Height" Value="28"/>
                                    <Setter Property="Padding" Value="8,0"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Account No" Binding="{Binding AccountNo}" Width="95"/>
                                <DataGridTextColumn Header="Account Name" Binding="{Binding AccountName}" Width="*"/>
                                <DataGridTextColumn Header="Urdu Name" Binding="{Binding AccountNameUrdu}" Width="135"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding AccountType}" Width="60"/>
                                <DataGridTextColumn Header="Bank" Binding="{Binding Bank}" Width="95"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Cancel (Esc)" Command="{Binding CloseLookupCommand}" Style="{StaticResource ClassicButton}"/>
                        <Button Content="Select (Enter)" Click="BtnLookupSelect_Click" Style="{StaticResource ClassicButton}"
                                Background="#2563EB" Foreground="#FFFFFF" BorderBrush="#1D4ED8"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- SCHBANKDEPOSITS SEARCH MODAL (AgentCore Style with AgenSoft SchBankDeposits Filters & Columns) -->
        <Grid Background="#770F172A" Visibility="{Binding IsSearchListOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#FFFFFF" Width="780" Height="535" CornerRadius="8" Padding="14"
                    BorderBrush="#CBD5E1" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Search Bank Cash Deposits (SchBankDeposits)" FontSize="15" FontWeight="Bold" Foreground="#1E3A8A"/>
                            <TextBlock Text="Double click any deposit record to load and edit in form" FontSize="11" Foreground="#64748B"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Content="✕"
                                Command="{Binding CloseSearchModalCommand}"
                                Style="{StaticResource ClassicButton}" MinWidth="26" Width="26" Height="26" Padding="0"
                                BorderThickness="0" Background="Transparent" Foreground="#64748B"/>
                    </Grid>

                    <!-- Exact AgenSoft SchBankDeposits Filters -->
                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="95"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="115"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="115"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Voucher No" FontSize="11" FontWeight="Bold" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding SearchFilterVoucherNo, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="From Date" FontSize="11" FontWeight="Bold" Margin="0,0,0,2"/>
                                <DatePicker SelectedDate="{Binding SearchFromDate}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="To Date" FontSize="11" FontWeight="Bold" Margin="0,0,0,2"/>
                                <DatePicker SelectedDate="{Binding SearchToDate}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="6">
                                <TextBlock Text="Deposited By" FontSize="11" FontWeight="Bold" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding SearchFilterDepositedBy, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <Button Grid.Column="8" Content="Refresh" Command="{Binding RefreshSearchModalCommand}"
                                    Style="{StaticResource ClassicButton}" VerticalAlignment="Bottom"
                                    Background="#2563EB" Foreground="#FFFFFF" BorderBrush="#1D4ED8"/>
                        </Grid>
                    </Border>

                    <!-- Exact AgenSoft SchBankDeposits Columns -->
                    <Border Grid.Row="2" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                        <DataGrid x:Name="SearchDataGrid" ItemsSource="{Binding SearchListResults}"
                                  SelectedItem="{Binding SelectedSearchItem}"
                                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                  CanUserAddRows="False" RowHeight="25" FontSize="11.5"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0"
                                  MouseDoubleClick="SearchDataGrid_MouseDoubleClick">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#1E293B"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Height" Value="28"/>
                                    <Setter Property="Padding" Value="6,0"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Voucher No" Binding="{Binding VoucherNo}" Width="75"/>
                                <DataGridTextColumn Header="Voucher Date" Binding="{Binding VoucherDate, StringFormat='{}{0:dd/MM/yyyy}'}" Width="88"/>
                                <DataGridTextColumn Header="Slip No" Binding="{Binding SlipNo}" Width="68"/>
                                <DataGridTextColumn Header="Deposited By" Binding="{Binding DepositedBy}" Width="*"/>
                                <DataGridTextColumn Header="Deposit Date" Binding="{Binding ChequeDate, StringFormat='{}{0:dd/MM/yyyy}'}" Width="88"/>
                                <DataGridTextColumn Header="Bank A/C No" Binding="{Binding BankAccountNo}" Width="82"/>
                                <DataGridTextColumn Header="Cheque No" Binding="{Binding ChequeNo}" Width="82"/>
                                <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat='{}{0:N0}'}" Width="80"/>
                                <DataGridCheckBoxColumn Header="Posted" Binding="{Binding IsPosted, Mode=OneWay}" Width="54"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Cancel (Esc)" Command="{Binding CloseSearchModalCommand}" Style="{StaticResource ClassicButton}"/>
                        <Button Content="Select (Enter)" Command="{Binding SelectSearchItemCommand}" Style="{StaticResource ClassicButton}"
                                Background="#2563EB" Foreground="#FFFFFF" BorderBrush="#1D4ED8"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
