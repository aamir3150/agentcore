<Window x:Class="MyMandiSystem.Views.SaleContractWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Brokerage Sale Contract" 
        Height="740" Width="1100"
        MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        FontFamily="Segoe UI" FontSize="12">

    <Window.Resources>
        <Style x:Key="ClassicButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="85"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="10,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#64748B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimarySaveButton" TargetType="Button" BasedOn="{StaticResource ClassicButton}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#1D4ED8"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="14,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerDeleteButton" TargetType="Button" BasedOn="{StaticResource ClassicButton}">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#B91C1C"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="12,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#B91C1C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#991B1B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <DockPanel LastChildFill="True">

            <!-- ═══ 0. TOP HEADER CARD ═══ -->
            <Border DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#1E3A8A" Margin="0,0,12,0" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Certificate" Width="20" Height="20" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Brokerage Sale Contract" FontSize="16" FontWeight="Bold" Foreground="#1E3A8A"/>
                        <TextBlock Text="Record and manage commodity customer sales contracts" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Date:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Bold" Foreground="#475569"/>
                        <DatePicker SelectedDate="{Binding CDate}" Width="120"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ 4. BOTTOM ACTION FOOTER CARD ═══ -->
            <Border DockPanel.Dock="Bottom" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Buttons -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource PrimarySaveButton}" Command="{Binding SaveCommand}" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSaveOutline" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Save (Alt+S)" VerticalAlignment="Center" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource ClassicButton}" Command="{Binding ClearCommand}" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Clear (Alt+C)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource DangerDeleteButton}" Command="{Binding DeleteCommand}" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="DeleteOutline" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Delete (Alt+D)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource ClassicButton}" Click="Close_Click">
                            <TextBlock Text="Close (Esc)" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>

                    <!-- Right: Summary Totals -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,6,0">
                            <TextBlock FontSize="11" Foreground="#991B1B">
                                <Run Text="Total Gross: " FontWeight="Normal"/>
                                <Run Text="{Binding TotalGross, StringFormat=N2}" FontWeight="Bold"/>
                            </TextBlock>
                        </Border>
                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="8,4">
                            <TextBlock FontSize="11" Foreground="#1E40AF">
                                <Run Text="Total Mnds: " FontWeight="Normal"/>
                                <Run Text="{Binding TotalMoundsDisplay}" FontWeight="Bold"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ MAIN BODY CONTENT ═══ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- 1. IDENTIFIERS & CUSTOMER SECTION -->
                    <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="105"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>

                            <!-- Row 0: IDs & Status -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Contract ID:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ContractId}" FontWeight="Bold" Background="#F8FAFC" BorderBrush="#CBD5E1" IsReadOnly="True"/>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Sale Contract ID:" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold" Foreground="#475569"/>
                            <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding SaleContractId}" FontWeight="Bold" Background="#F8FAFC" BorderBrush="#CBD5E1" IsReadOnly="True"/>

                            <CheckBox Grid.Row="0" Grid.Column="5" Content="Is Completed" IsChecked="{Binding IsCompleted}" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="SemiBold" Foreground="#334155"/>
                            <CheckBox Grid.Row="0" Grid.Column="6" Grid.ColumnSpan="2" Content="Is Reached" IsChecked="{Binding IsReached}" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="SemiBold" Foreground="#334155"/>

                            <!-- Row 2: Customer Info -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Customer ID (F1):" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PartyId, UpdateSourceTrigger=PropertyChanged}" LostFocus="CustomerId_LostFocus"/>

                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Customer Name:" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold" Foreground="#475569"/>
                            <TextBox Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="3" Text="{Binding PartyName}" FontWeight="Bold"/>

                            <TextBlock Grid.Row="2" Grid.Column="6" Text="Phone:" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold" Foreground="#475569"/>
                            <TextBox Grid.Row="2" Grid.Column="7" Text="{Binding Phone}"/>

                            <!-- Row 4: Town, Sector, Broker -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Town / Sector:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Town}" IsReadOnly="True" Background="#F8FAFC" BorderBrush="#CBD5E1"/>
                            <TextBox Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="2" Text="{Binding Sector}" IsReadOnly="True" Background="#F8FAFC" BorderBrush="#CBD5E1" Margin="4,0,0,0"/>

                            <TextBlock Grid.Row="4" Grid.Column="4" Text="Broker:" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold" Foreground="#475569"/>
                            <Grid Grid.Row="4" Grid.Column="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding BrokerId, UpdateSourceTrigger=PropertyChanged}" LostFocus="BrokerId_LostFocus"/>
                                <TextBox Grid.Column="2" Text="{Binding BrokerName}"/>
                            </Grid>

                            <TextBlock Grid.Row="4" Grid.Column="6" Text="Address:" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold" Foreground="#475569"/>
                            <TextBox Grid.Row="4" Grid.Column="7" Text="{Binding Address}"/>
                        </Grid>
                    </Border>

                    <!-- 2. PRODUCT LINE ENTRY STRIP -->
                    <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="75"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="75"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="Item Code" FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding CurrentProductId, UpdateSourceTrigger=PropertyChanged}" LostFocus="ProductId_LostFocus"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,4,0">
                                <TextBlock Text="Product Name" FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding CurrentProductName}" IsReadOnly="True" Background="#F8FAFC" BorderBrush="#CBD5E1" FontWeight="SemiBold"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,4,0">
                                <TextBlock Text="Truck Qty" FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding CurrentTruckQty}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Margin="0,0,4,0">
                                <TextBlock Text="Bags Qty" FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding CurrentBagsQty, UpdateSourceTrigger=PropertyChanged}" LostFocus="LineCalc_LostFocus" FontWeight="Bold"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4" Margin="0,0,4,0">
                                <TextBlock Text="Wt/Bag" FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding CurrentWeightPerBag, UpdateSourceTrigger=PropertyChanged}" LostFocus="LineCalc_LostFocus"/>
                            </StackPanel>

                            <StackPanel Grid.Column="5" Margin="0,0,4,0">
                                <TextBlock Text="Extra Wt" FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding CurrentExtraWeight, UpdateSourceTrigger=PropertyChanged}" LostFocus="LineCalc_LostFocus"/>
                            </StackPanel>

                            <StackPanel Grid.Column="6" Margin="0,0,4,0">
                                <TextBlock Text="Total Kgs" FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding CurrentTotalKgs}" FontWeight="Bold" Background="#FEF3C7" BorderBrush="#FDE68A" Foreground="#92400E" IsReadOnly="True"/>
                            </StackPanel>

                            <StackPanel Grid.Column="7" Margin="0,0,4,0">
                                <TextBlock Text="Mnd Std" FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding CurrentMoundStd, UpdateSourceTrigger=PropertyChanged}" LostFocus="LineCalc_LostFocus"/>
                            </StackPanel>

                            <StackPanel Grid.Column="8" Margin="0,0,4,0">
                                <TextBlock Text="Rate/Mnd" FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding CurrentRatePerMound, UpdateSourceTrigger=PropertyChanged}" LostFocus="LineCalc_LostFocus"/>
                            </StackPanel>

                            <StackPanel Grid.Column="9" Margin="0,0,4,0">
                                <TextBlock Text="Bardana" FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding CurrentBardana}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="10" Margin="0,0,6,0">
                                <TextBlock Text="Total Value" FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding CurrentTotalValue, StringFormat=N2}" FontWeight="Bold" Background="#F0FDF4" BorderBrush="#A7F3D0" Foreground="#047857" IsReadOnly="True"/>
                            </StackPanel>

                            <Button Grid.Column="11" Style="{StaticResource PrimarySaveButton}" Command="{Binding AddItemCommand}" VerticalAlignment="Bottom" Height="26" MinWidth="75">
                                <TextBlock Text="Add (F2)" FontWeight="Bold"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- 3. GRID TABLE -->
                    <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Margin="0,0,0,8">
                        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                  Background="White" BorderThickness="0"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                                  RowHeight="26" FontSize="11.5" HeadersVisibility="Column" MinHeight="170">

                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#1E293B"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Height" Value="28"/>
                                    <Setter Property="Padding" Value="8,0"/>
                                    <Setter Property="BorderBrush" Value="#334155"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="S#" Binding="{Binding SerialNo}" Width="40" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Code" Binding="{Binding ProductId}" Width="70"/>
                                <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="*"/>
                                <DataGridTextColumn Header="Trucks" Binding="{Binding TruckQty}" Width="65"/>
                                <DataGridTextColumn Header="Bags" Binding="{Binding BagsQty}" Width="75"/>
                                <DataGridTextColumn Header="Wt/Bag" Binding="{Binding WeightPerBag, StringFormat=N1}" Width="70"/>
                                <DataGridTextColumn Header="Extra Wt" Binding="{Binding ExtraWeight, StringFormat=N1}" Width="70"/>
                                <DataGridTextColumn Header="Total Kgs" Binding="{Binding TotalKgs, StringFormat=N1}" Width="90"/>
                                <DataGridTextColumn Header="In Mounds" Binding="{Binding InMounds}" Width="85" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Rate/Mnd" Binding="{Binding RatePerMound, StringFormat=N2}" Width="80"/>
                                <DataGridTextColumn Header="Bardana" Binding="{Binding Bardana}" Width="65"/>
                                <DataGridTextColumn Header="Total Value" Binding="{Binding TotalValue, StringFormat=N2}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- 4. TOTALS & EXPENSES SUMMARY -->
                    <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="95"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="95"/>
                                <ColumnDefinition Width="85"/>
                                <ColumnDefinition Width="105"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Row 0: Grid Totals -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Trucks:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TotalTrucks}" IsReadOnly="True" Background="#F8FAFC" BorderBrush="#CBD5E1"/>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Total Bags:" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold" Foreground="#475569"/>
                            <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding TotalBags}" IsReadOnly="True" Background="#F8FAFC" BorderBrush="#CBD5E1"/>

                            <TextBlock Grid.Row="0" Grid.Column="4" Text="Total Kgs:" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold" Foreground="#475569"/>
                            <TextBox Grid.Row="0" Grid.Column="5" Text="{Binding TotalKgs, StringFormat=N1}" IsReadOnly="True" Background="#F8FAFC" BorderBrush="#CBD5E1"/>

                            <TextBlock Grid.Row="0" Grid.Column="6" Text="In Mounds:" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold" Foreground="#475569"/>
                            <TextBox Grid.Row="0" Grid.Column="7" Text="{Binding TotalMoundsDisplay}" IsReadOnly="True" Background="#FEF3C7" BorderBrush="#FDE68A" Foreground="#92400E" FontWeight="Bold"/>

                            <TextBlock Grid.Row="0" Grid.Column="8" Text="Total Value:" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold" Foreground="#475569"/>
                            <TextBox Grid.Row="0" Grid.Column="9" Text="{Binding TotalContractAmount, StringFormat=N2}" IsReadOnly="True" Background="#F0FDF4" BorderBrush="#A7F3D0" Foreground="#047857" FontWeight="Bold"/>

                            <!-- Row 2: Advance, Expenses, Commission -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Advance:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Advance, UpdateSourceTrigger=PropertyChanged}" LostFocus="RecalcTotal_LostFocus"/>

                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Vehicle Chg:" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold" Foreground="#475569"/>
                            <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding VehicalCharges, UpdateSourceTrigger=PropertyChanged}" LostFocus="RecalcTotal_LostFocus"/>

                            <TextBlock Grid.Row="2" Grid.Column="4" Text="Other Exp:" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold" Foreground="#475569"/>
                            <TextBox Grid.Row="2" Grid.Column="5" Text="{Binding OtherExpence, UpdateSourceTrigger=PropertyChanged}" LostFocus="RecalcTotal_LostFocus"/>

                            <TextBlock Grid.Row="2" Grid.Column="6" Text="Commission:" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold" Foreground="#475569"/>
                            <TextBox Grid.Row="2" Grid.Column="7" Text="{Binding BrokerCommission}"/>

                            <TextBlock Grid.Row="2" Grid.Column="8" Text="Total Gross:" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="Bold" Foreground="#991B1B"/>
                            <TextBox Grid.Row="2" Grid.Column="9" Text="{Binding TotalGross, StringFormat=N2}" FontWeight="Bold" Background="#FEF2F2" BorderBrush="#FECACA" Foreground="#991B1B" IsReadOnly="True"/>
                        </Grid>
                    </Border>

                    <!-- 5. NARRATION -->
                    <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="75"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Narration:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569"/>
                            <TextBox Grid.Column="1" Text="{Binding Narration}" Height="26"/>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
