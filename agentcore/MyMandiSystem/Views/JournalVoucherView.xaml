<UserControl x:Class="MyMandiSystem.Views.JournalVoucherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:MyMandiSystem.Helpers"
             mc:Ignorable="d" 
             Background="{StaticResource BrushSurfaceBg}"
             d:DesignHeight="700" d:DesignWidth="980"
             TextElement.Foreground="{StaticResource BrushTextPrimary}"
             FontFamily="{DynamicResource MaterialDesignFont}">
    
    <Border Margin="10" Background="#FFFFFF" BorderBrush="{StaticResource BrushSurfaceBorder}" BorderThickness="1" CornerRadius="16" Effect="{StaticResource EffectCardShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Modern Header -->
                <RowDefinition Height="Auto"/>  <!-- Top Metadata Row -->
                <RowDefinition Height="Auto"/>  <!-- Entry Fields Row -->
                <RowDefinition Height="*"/>     <!-- DataGrid -->
                <RowDefinition Height="Auto"/>  <!-- Urdu + Totals -->
                <RowDefinition Height="Auto"/>  <!-- Action Footer -->
            </Grid.RowDefinitions>

            <!-- ═══ 1. MODERN HEADER BANNER (INDIGO/SAPPHIRE) ═══ -->
            <Border Grid.Row="0" CornerRadius="16,16,0,0" Background="{StaticResource BrushGradientIndigo}" Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="40" Height="40" CornerRadius="10" Background="#30FFFFFF" Margin="0,0,14,0" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="NotebookEditOutline" Width="22" Height="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Journal Voucher (General JV)" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Double entry financial adjustments and inter-account transfers" FontSize="11.5" Foreground="#E0E7FF"/>
                    </StackPanel>

                    <!-- Status Pill -->
                    <Border Grid.Column="2" Background="#20FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="10" Padding="12,6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="ScaleBalance" Width="14" Height="14" Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="DOUBLE ENTRY" FontSize="11.5" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ═══ 2. TOP METADATA ROW ═══ -->
            <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="{StaticResource BrushSurfaceBorder}" BorderThickness="0,0,0,1" Padding="18,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Voucher No -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Voucher Number" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding VoucherNo}" IsReadOnly="True" FontSize="13" FontWeight="Bold" Background="#FFFFFF" Padding="8,4" BorderBrush="{StaticResource BrushSurfaceBorderDark}"/>
                    </StackPanel>

                    <!-- Voucher Date -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Posting Date" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding VoucherDate}" FontSize="13" Background="#FFFFFF" Padding="6,2"/>
                    </StackPanel>

                    <!-- Crop Season -->
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Crop Season" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Seasons}" SelectedItem="{Binding SelectedSeason}" 
                                  DisplayMemberPath="Name" FontSize="13" Background="#FFFFFF"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ 3. QUICK ENTRY FIELDS ROW ═══ -->
            <Border Grid.Row="2" Background="#FFFFFF" Padding="18,12" BorderBrush="{StaticResource BrushSurfaceBorder}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- A/c No -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="A/c Code" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding AccountNo, UpdateSourceTrigger=PropertyChanged}" FontSize="12.5" Padding="6,4" BorderBrush="{StaticResource BrushSurfaceBorderDark}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding LookupAccountCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </StackPanel>

                    <!-- A/c Name + Lookup -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Account Title" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"/>
                        <Grid>
                            <TextBox Text="{Binding AccountName}" IsReadOnly="True" Background="#F8FAFC" FontSize="12.5" Padding="6,4,28,4" BorderBrush="{StaticResource BrushSurfaceBorderDark}"/>
                            <Button Content="..." HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="26" Margin="1"
                                    Command="{Binding LookupAccountCommand}" FontWeight="Bold" Style="{StaticResource MaterialDesignFlatButton}" Padding="0"/>
                        </Grid>
                    </StackPanel>

                    <!-- Debit -->
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Debit (PKR)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushAccentRose}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Debit}" HorizontalContentAlignment="Right" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource BrushAccentRose}" Padding="6,4" BorderBrush="{StaticResource BrushSurfaceBorderDark}"/>
                    </StackPanel>

                    <!-- Credit -->
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Credit (PKR)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushAccentEmerald}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Credit}" HorizontalContentAlignment="Right" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource BrushAccentEmerald}" Padding="6,4" BorderBrush="{StaticResource BrushSurfaceBorderDark}"/>
                    </StackPanel>

                    <!-- Narration -->
                    <StackPanel Grid.Column="8">
                        <TextBlock Text="Transaction Narration" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Narration}" FontSize="12.5" Padding="6,4" BorderBrush="{StaticResource BrushSurfaceBorderDark}"/>
                    </StackPanel>

                    <!-- Add Button -->
                    <Button Grid.Column="10" Command="{Binding AddDetailCommand}" VerticalAlignment="Bottom" 
                            Style="{StaticResource ModernPrimaryButton}" Height="34" Padding="12,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Add" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ═══ 4. TRANSACTION DATAGRID ═══ -->
            <Border Grid.Row="3" Margin="18,12,18,8" CornerRadius="10" BorderBrush="{StaticResource BrushSurfaceBorder}" BorderThickness="1" ClipToBounds="True">
                <DataGrid ItemsSource="{Binding Details}" AutoGenerateColumns="False" CanUserAddRows="False"
                          Style="{StaticResource ModernDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="A/C CODE" Binding="{Binding AccountNo}" Width="110"/>
                        <DataGridTextColumn Header="ACCOUNT TITLE" Binding="{Binding AccountName}" Width="240"/>
                        <DataGridTextColumn Header="NARRATION" Binding="{Binding Narration}" Width="*"/>
                        <DataGridTextColumn Header="DEBIT (PKR)" Binding="{Binding Debit, StringFormat=N2}" Width="140">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="{StaticResource BrushAccentRose}"/>
                                    <Setter Property="Padding" Value="0,0,10,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="CREDIT (PKR)" Binding="{Binding Credit, StringFormat=N2}" Width="140">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="{StaticResource BrushAccentEmerald}"/>
                                    <Setter Property="Padding" Value="0,0,10,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.RemoveDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                                        <materialDesign:PackIcon Kind="TrashCanOutline" Foreground="{StaticResource BrushAccentRose}" Width="18" Height="18"/>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- ═══ 5. URDU NARRATION + TOTALS PANEL ═══ -->
            <Border Grid.Row="4" Background="#F8FAFC" BorderBrush="{StaticResource BrushSurfaceBorder}" BorderThickness="0,1,0,1" Padding="18,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Urdu Narration -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Urdu Narration (تفصیل)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding NarrationUrdu}" Style="{StaticResource ModernUrduStandardTextBox}" helpers:UrduHelper.IsUrduOnly="True" Height="38" Background="#FFFFFF" BorderBrush="{StaticResource BrushSurfaceBorderDark}"/>
                    </StackPanel>

                    <!-- Double-Entry Totals Box -->
                    <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="{StaticResource BrushSurfaceBorder}" BorderThickness="1" CornerRadius="10" Padding="14,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Total Debit:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}"/>
                            <Border Grid.Column="1" Background="#FFF1F2" CornerRadius="6" Padding="8,4">
                                <TextBlock Text="{Binding TotalDebit, StringFormat=N2}" HorizontalAlignment="Right" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource BrushAccentRose}"/>
                            </Border>

                            <TextBlock Grid.Column="3" Text="Total Credit:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}"/>
                            <Border Grid.Column="4" Background="#ECFDF5" CornerRadius="6" Padding="8,4">
                                <TextBlock Text="{Binding TotalCredit, StringFormat=N2}" HorizontalAlignment="Right" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource BrushAccentEmerald}"/>
                            </Border>

                            <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Diff: " FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Difference, StringFormat=N2}" FontSize="14" FontWeight="Black" VerticalAlignment="Center"
                                           Foreground="{Binding Difference, Converter={StaticResource DifferenceToColorConverter}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ═══ 6. ACTIONS FOOTER ═══ -->
            <Border Grid.Row="5" Background="#F1F5F9" Padding="14,10" CornerRadius="0,0,16,16" BorderBrush="{StaticResource BrushSurfaceBorder}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding SaveCommand}" Style="{StaticResource ModernPrimaryButton}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSaveCheckOutline" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Save Journal Voucher" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ClearCommand}" Style="{StaticResource ModernSecondaryButton}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Reset / Clear" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding CloseCommand}" 
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                            Style="{StaticResource ModernDangerButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CloseCircleOutline" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Close Window" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
