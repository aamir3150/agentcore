<UserControl x:Class="MyMandiSystem.Views.CashPaymentVoucherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:MyMandiSystem.Helpers"
             mc:Ignorable="d" 
             Background="#F1F5F9"
             d:DesignHeight="780" d:DesignWidth="1050"
             FontFamily="Segoe UI" FontSize="12"
             Loaded="UserControl_Loaded"
             PreviewKeyDown="UserControl_PreviewKeyDown">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Classic Button Style (Exact match to ChequeBookGenerationWindow) -->
        <Style x:Key="ClassicButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="85"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="10,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#BFDBFE"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <DockPanel LastChildFill="True">

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                     TOP HEADER TITLE BAR                   -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#1E3A8A" Margin="0,0,12,0" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="CashMinus" Width="22" Height="22" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FormTitle}" FontSize="16" FontWeight="Bold" Foreground="#1E3A8A"/>
                            <Border Visibility="{Binding IsWhtMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="WHT TAX MODE" FontSize="10.5" FontWeight="Bold" Foreground="#1E3A8A"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding FormSubtitle}" FontSize="11" Foreground="#64748B"/>
                    </StackPanel>

                    <!-- Top Voucher Navigation Toolbar -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- WHT Mode Checkbox -->
                        <CheckBox IsChecked="{Binding IsWhtMode}" Content="WHT Mode" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,12,0" VerticalAlignment="Center" ToolTip="Toggle Withholding Tax &amp; Freight Deduction Mode"/>

                        <!-- Branch Indicator -->
                        <materialDesign:PackIcon Kind="StoreOutline" Width="15" Height="15" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding BranchName, StringFormat='Branch: {0}'}" FontSize="11.5" Foreground="#475569" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>

                        <!-- Find Past Voucher -->
                        <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Find #:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox Text="{Binding SearchVoucherNo, UpdateSourceTrigger=PropertyChanged}" Width="70" Height="22" FontSize="11.5" FontWeight="Bold"
                                         Background="#FFFFFF" BorderBrush="#94A3B8" Padding="4,1" VerticalContentAlignment="Center" Margin="0,0,4,0">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding SearchVoucherCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                                
                                <Button Command="{Binding SearchVoucherCommand}" ToolTip="Search Voucher"
                                        Style="{StaticResource ClassicButton}" MinWidth="26" Width="26" Height="22" Padding="0" Margin="0,0,2,0">
                                    <materialDesign:PackIcon Kind="Magnify" Width="14" Height="14" Foreground="#1E293B"/>
                                </Button>

                                <Button Command="{Binding PreviousVoucherCommand}" ToolTip="Previous Voucher (&lt;)"
                                        Style="{StaticResource ClassicButton}" MinWidth="26" Width="26" Height="22" Padding="0" Margin="0,0,2,0">
                                    <materialDesign:PackIcon Kind="ChevronLeft" Width="16" Height="16" Foreground="#1E293B"/>
                                </Button>
                                <Button Command="{Binding NextVoucherCommand}" ToolTip="Next Voucher (&gt;)"
                                        Style="{StaticResource ClassicButton}" MinWidth="26" Width="26" Height="22" Padding="0">
                                    <materialDesign:PackIcon Kind="ChevronRight" Width="16" Height="16" Foreground="#1E293B"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--              METADATA & FAST KEYBOARD ENTRY CARD           -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: Metadata Info & Real-Time Balances -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Voucher # -->
                        <TextBlock Grid.Column="0" Text="Voucher #:" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Grid.Column="1" Text="{Binding VoucherNo}" IsReadOnly="True" FontWeight="Bold" Foreground="#1E3A8A" Background="#F8FAFC" Width="85"/>

                        <!-- Payment Date -->
                        <TextBlock Grid.Column="2" Text="Date:" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" Margin="14,0,6,0"/>
                        <DatePicker Grid.Column="3" SelectedDate="{Binding VoucherDate}" Width="115"/>

                        <!-- Crop Season -->
                        <TextBlock Grid.Column="4" Text="Crop Season:" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" Margin="14,0,6,0"/>
                        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                            <ComboBox ItemsSource="{Binding CropSeasons}" SelectedItem="{Binding CropSeason}" Width="130"/>
                            <Button Command="{Binding ManageCropSeasonsCommand}" ToolTip="Add/Edit Crop Seasons"
                                    Style="{StaticResource ClassicButton}" MinWidth="26" Width="26" Height="26" Padding="0" Margin="4,0,0,0">
                                <materialDesign:PackIcon Kind="CogOutline" Width="14" Height="14" Foreground="#1E3A8A"/>
                            </Button>
                        </StackPanel>

                        <!-- Real-time Balances Pills -->
                        <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Cash in Hand -->
                            <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Cash in Hand: " FontSize="11" FontWeight="SemiBold" Foreground="#92400E" VerticalAlignment="Center"/>
                                    <TextBlock Text="Rs. " FontSize="11" FontWeight="Bold" Foreground="#B45309" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding CashInHand}" FontSize="13" FontWeight="Bold" Foreground="#B45309" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Account Balance -->
                            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="8,2">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Account Balance: " FontSize="11" FontWeight="SemiBold" Foreground="#1E3A8A" VerticalAlignment="Center"/>
                                    <TextBlock Text="Rs. " FontSize="11" FontWeight="Bold" Foreground="#2563EB" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding AccountBalance}" FontSize="13" FontWeight="Bold" Foreground="#2563EB" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding AccountBalanceStatus, StringFormat=' ({0})'}" FontSize="10.5" FontWeight="Bold" Foreground="#1D4ED8" VerticalAlignment="Center"
                                               Visibility="{Binding HasSelectedAccount, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Divider -->
                    <Rectangle Grid.Row="1" Height="1" Fill="#E2E8F0" Margin="0,8,0,8"/>

                    <!-- Row 2: Fast Keyboard Entry Fields -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- A/c Code -->
                        <TextBlock Grid.Column="0" Text="A/c Code:" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="AccountNoBox" Grid.Column="1" Text="{Binding AccountNo, UpdateSourceTrigger=PropertyChanged}" 
                                 FontWeight="SemiBold" KeyDown="AccountNoBox_KeyDown"
                                 ToolTip="Type account code and press Enter (or F1 to search)"/>

                        <!-- Account Title -->
                        <TextBlock Grid.Column="2" Text="Account Title:" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" Margin="10,0,6,0"/>
                        <Grid Grid.Column="3">
                            <TextBox x:Name="AccountTitleBox" Text="{Binding AccountName, UpdateSourceTrigger=PropertyChanged}" 
                                     Padding="6,2,28,2" KeyDown="AccountTitleBox_KeyDown"
                                     ToolTip="Type name or press F1 to search accounts"/>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Width="24" Height="24" Margin="0,0,2,0"
                                    Command="{Binding OpenAccountLookupCommand}" ToolTip="Search Account (F1)"
                                    Style="{StaticResource ClassicButton}" MinWidth="24" Padding="0" BorderThickness="0" Background="Transparent">
                                <materialDesign:PackIcon Kind="Magnify" Width="15" Height="15" Foreground="#2563EB"/>
                            </Button>
                        </Grid>

                        <!-- Narration -->
                        <TextBlock Grid.Column="4" Text="Narration:" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" Margin="10,0,6,0"/>
                        <TextBox x:Name="NarrationBox" Grid.Column="5" Text="{Binding Narration}" 
                                 KeyDown="NarrationBox_KeyDown"
                                 ToolTip="Transaction details (Press Enter to move to Amount)"/>

                        <!-- Amount (PKR) -->
                        <TextBlock Grid.Column="6" Text="Amount (PKR):" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" Margin="10,0,6,0"/>
                        <TextBox x:Name="AmountBox" Grid.Column="7" Text="{Binding Amount}" HorizontalContentAlignment="Right" 
                                 FontWeight="Bold" Foreground="#1E3A8A" KeyDown="AmountBox_KeyDown"
                                 ToolTip="Debit Amount in PKR (Press Enter to Add)"/>

                        <!-- Add Button -->
                        <Button x:Name="AddButton" Grid.Column="8" Command="{Binding AddDetailCommand}" 
                                Content="+ Add (Enter)" Style="{StaticResource ClassicButton}"
                                Background="#2563EB" Foreground="#FFFFFF" BorderBrush="#1D4ED8" Margin="8,0,0,0"
                                ToolTip="Add Line Item (Enter)"/>
                    </Grid>

                    <!-- Row 3: WHT & Freight Deduction Panel (Visible when IsWhtMode == true) -->
                    <Border Grid.Row="3" Visibility="{Binding IsWhtMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="75"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="95"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- WHT Badge -->
                            <Border Grid.Column="0" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="6,3" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FilePercentOutline" Width="14" Height="14" Foreground="#1E3A8A" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="WHT &amp; Freight" FontSize="11" FontWeight="Bold" Foreground="#1E3A8A" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Linked CRV # -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Linked CRV #" FontSize="10.5" FontWeight="SemiBold" Foreground="#475569"/>
                                <TextBox Text="{Binding CreditVoucherNo}" IsReadOnly="True" FontSize="11.5" FontWeight="Bold" Padding="4,1" Background="#F1F5F9" HorizontalContentAlignment="Center"/>
                            </StackPanel>

                            <!-- WHT % -->
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="WHT %" FontSize="10.5" FontWeight="SemiBold" Foreground="#475569"/>
                                <TextBox Text="{Binding WhtRatio, UpdateSourceTrigger=PropertyChanged}" FontSize="11.5" FontWeight="Bold" Padding="4,1" Background="#FFFFFF" HorizontalContentAlignment="Center"/>
                            </StackPanel>

                            <!-- WHT Amount -->
                            <StackPanel Grid.Column="6">
                                <TextBlock Text="WHT Tax Rs." FontSize="10.5" FontWeight="SemiBold" Foreground="#475569"/>
                                <TextBox Text="{Binding WhtAmount, UpdateSourceTrigger=PropertyChanged}" FontSize="11.5" FontWeight="Bold" Padding="4,1" Background="#FFFFFF" HorizontalContentAlignment="Right"/>
                            </StackPanel>

                            <!-- WHT Option (Minus / Plus) -->
                            <StackPanel Grid.Column="8" VerticalAlignment="Center" Margin="0,2,0,0">
                                <RadioButton Content="Deduct (Minus)" IsChecked="{Binding IsWhtMinus}" FontSize="10" FontWeight="SemiBold" Foreground="#1E293B" GroupName="WhtOpt"/>
                                <RadioButton Content="Add WHT (Plus)" IsChecked="{Binding IsWhtPlus}" FontSize="10" FontWeight="SemiBold" Foreground="#1E293B" GroupName="WhtOpt"/>
                            </StackPanel>

                            <!-- Freight -->
                            <StackPanel Grid.Column="10">
                                <TextBlock Text="Freight Rs." FontSize="10.5" FontWeight="SemiBold" Foreground="#475569"/>
                                <TextBox Text="{Binding Freight, UpdateSourceTrigger=PropertyChanged}" FontSize="11.5" FontWeight="Bold" Padding="4,1" Background="#FFFFFF" HorizontalContentAlignment="Right"/>
                            </StackPanel>

                            <!-- Freight Option (Minus / Plus) -->
                            <StackPanel Grid.Column="12" VerticalAlignment="Center" Margin="0,2,0,0">
                                <RadioButton Content="Freight (Minus)" IsChecked="{Binding IsFreightMinus}" FontSize="10" FontWeight="SemiBold" Foreground="#1E293B" GroupName="FreightOpt"/>
                                <RadioButton Content="Freight (Plus)" IsChecked="{Binding IsFreightPlus}" FontSize="10" FontWeight="SemiBold" Foreground="#1E293B" GroupName="FreightOpt"/>
                            </StackPanel>

                            <!-- Net Cash Disbursed Badge -->
                            <Border Grid.Column="13" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <StackPanel HorizontalAlignment="Right">
                                    <TextBlock Text="Net Cash Disbursed:" FontSize="9.5" FontWeight="Bold" Foreground="#1E3A8A"/>
                                    <TextBlock Text="{Binding NetCashPaid, StringFormat='Rs. {0:N0}'}" FontSize="13" FontWeight="Black" Foreground="#2563EB" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                   BOTTOM TOOLBAR BAR                       -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border DockPanel.Dock="Bottom" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,6,0,0">
                <Grid>
                    <!-- Left: Checkboxes -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox IsChecked="{Binding SendSms}" Content="Send SMS" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <CheckBox IsChecked="{Binding AutoPrint}" Content="Print on Save" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Right: Action Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- Delete Button (Only visible for existing voucher) -->
                        <Button Content="Delete (F4)" Command="{Binding DeleteVoucherCommand}" Style="{StaticResource ClassicButton}"
                                Background="#DC2626" Foreground="#FFFFFF" BorderBrush="#B91C1C"
                                Visibility="{Binding IsExistingVoucher, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <!-- Save Button (Prominent Blue) -->
                        <Button Content="Save Voucher (F2)" Command="{Binding SaveCommand}" Style="{StaticResource ClassicButton}"
                                Background="#2563EB" Foreground="#FFFFFF" BorderBrush="#1D4ED8"/>

                        <!-- Clear Button -->
                        <Button Content="Clear / New (F3)" Command="{Binding ClearCommand}" Style="{StaticResource ClassicButton}"/>

                        <!-- Print Button -->
                        <Button Content="Print (Ctrl+P)" Command="{Binding PrintCommand}" Style="{StaticResource ClassicButton}"/>

                        <!-- Close Button -->
                        <Button Content="Close (Esc)" Style="{StaticResource ClassicButton}" Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--         URDU NARRATION, DENOMINATIONS & TOTALS             -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border DockPanel.Dock="Bottom" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,6,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: Urdu Narration & Total Payment -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Urdu Narration -->
                        <Grid Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Narration (Urdu):" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" Text="{Binding NarrationUrdu}" Style="{StaticResource ModernUrduStandardTextBox}" 
                                     helpers:UrduHelper.IsUrduOnly="True" Height="28" Background="#FFFFFF" BorderBrush="#94A3B8" Padding="6,1"/>
                        </Grid>

                        <!-- Total Payment Pill -->
                        <Border Grid.Column="1" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="12,4" Margin="14,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Total Paid Amount: " FontWeight="Bold" Foreground="#1E3A8A" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding TotalAmount, StringFormat='{}{0:N0} PKR'}" FontWeight="Black" FontSize="16" Foreground="#2563EB" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Divider -->
                    <Rectangle Grid.Row="1" Height="1" Fill="#E2E8F0" Margin="0,6,0,6"/>

                    <!-- Row 2: Cash Denominations (Notes Count Bar) -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Denomination Headers -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="5,000" HorizontalAlignment="Center" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="1,000" HorizontalAlignment="Center" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="500" HorizontalAlignment="Center" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="100" HorizontalAlignment="Center" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBlock Grid.Row="0" Grid.Column="4" Text="50" HorizontalAlignment="Center" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBlock Grid.Row="0" Grid.Column="5" Text="20" HorizontalAlignment="Center" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBlock Grid.Row="0" Grid.Column="6" Text="10" HorizontalAlignment="Center" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBlock Grid.Row="0" Grid.Column="7" Text="5" HorizontalAlignment="Center" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBlock Grid.Row="0" Grid.Column="8" Text="2" HorizontalAlignment="Center" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBlock Grid.Row="0" Grid.Column="9" Text="1" HorizontalAlignment="Center" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B"/>

                        <!-- Denomination Input Fields -->
                        <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding Count5000}" HorizontalContentAlignment="Center" Margin="2,2" Height="22" FontSize="11" Padding="2,1" BorderBrush="#94A3B8"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Count1000}" HorizontalContentAlignment="Center" Margin="2,2" Height="22" FontSize="11" Padding="2,1" BorderBrush="#94A3B8"/>
                        <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Count500}" HorizontalContentAlignment="Center" Margin="2,2" Height="22" FontSize="11" Padding="2,1" BorderBrush="#94A3B8"/>
                        <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding Count100}" HorizontalContentAlignment="Center" Margin="2,2" Height="22" FontSize="11" Padding="2,1" BorderBrush="#94A3B8"/>
                        <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding Count50}" HorizontalContentAlignment="Center" Margin="2,2" Height="22" FontSize="11" Padding="2,1" BorderBrush="#94A3B8"/>
                        <TextBox Grid.Row="1" Grid.Column="5" Text="{Binding Count20}" HorizontalContentAlignment="Center" Margin="2,2" Height="22" FontSize="11" Padding="2,1" BorderBrush="#94A3B8"/>
                        <TextBox Grid.Row="1" Grid.Column="6" Text="{Binding Count10}" HorizontalContentAlignment="Center" Margin="2,2" Height="22" FontSize="11" Padding="2,1" BorderBrush="#94A3B8"/>
                        <TextBox Grid.Row="1" Grid.Column="7" Text="{Binding Count5}" HorizontalContentAlignment="Center" Margin="2,2" Height="22" FontSize="11" Padding="2,1" BorderBrush="#94A3B8"/>
                        <TextBox Grid.Row="1" Grid.Column="8" Text="{Binding Count2}" HorizontalContentAlignment="Center" Margin="2,2" Height="22" FontSize="11" Padding="2,1" BorderBrush="#94A3B8"/>
                        <TextBox Grid.Row="1" Grid.Column="9" Text="{Binding Count1}" HorizontalContentAlignment="Center" Margin="2,2" Height="22" FontSize="11" Padding="2,1" BorderBrush="#94A3B8"/>

                        <!-- Denominations Total & Apply Button -->
                        <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="10" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                            <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                                <StackPanel>
                                    <TextBlock Text="Notes Total:" FontSize="9.5" FontWeight="SemiBold" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding DenominationTotal, StringFormat='{}{0:N0} PKR'}" FontSize="11.5" FontWeight="Bold" Foreground="#1E293B"/>
                                </StackPanel>
                            </Border>
                            <Button Command="{Binding ApplyDenominationToAmountCommand}" ToolTip="Apply Notes Total to Amount"
                                    Style="{StaticResource ClassicButton}" MinWidth="26" Width="26" Height="26" Margin="4,0,0,0" Padding="0">
                                <materialDesign:PackIcon Kind="ArrowLeftBold" Width="14" Height="14" Foreground="#2563EB"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--       MAIN CONTENT: TRANSACTION DATAGRID & PARTY PANEL     -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Line Items DataGrid -->
                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- DataGrid Header Banner -->
                        <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="10,6">
                            <Grid>
                                <TextBlock Text="Voucher Line Items:" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Details.Count, StringFormat='Total Records: {0}'}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- DataGrid -->
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Details}" 
                                  AutoGenerateColumns="False" 
                                  CanUserAddRows="False"
                                  IsReadOnly="True" 
                                  SelectionMode="Single"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#E2E8F0"
                                  RowHeight="26">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#1E293B"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Height" Value="28"/>
                                    <Setter Property="Padding" Value="8,0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="A/C CODE" Binding="{Binding AccountNo}" Width="95">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="ACCOUNT TITLE" Binding="{Binding AccountName}" Width="210">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="#1E3A8A"/>
                                            <Setter Property="Padding" Value="6,0,0,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="NARRATION" Binding="{Binding Narration}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Padding" Value="6,0,0,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="DEBIT (PKR)" Binding="{Binding Debit, StringFormat=N0}" Width="140">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Padding" Value="0,0,10,0"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="#1E3A8A"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Action (Remove) Column -->
                                <DataGridTemplateColumn Header="Action" Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="🗑" 
                                                    Command="{Binding DataContext.RemoveDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Foreground="#DC2626" Background="Transparent" BorderThickness="0"
                                                    Padding="3,0" Cursor="Hand" ToolTip="Remove Line Item" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Right: Party Summary & Biometric Side Panel -->
                <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="6,4" Margin="0,0,0,8">
                            <TextBlock Text="Party Summary" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center"/>
                        </Border>

                        <!-- Party Details Info -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,10">
                            <TextBlock Text="{Binding AccountName, TargetNullValue='No Party Selected'}" FontSize="12" FontWeight="Bold" Foreground="#1E293B" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SelectedAccountUrduName}" FontSize="11" Foreground="#475569" Margin="0,2,0,0" 
                                       Visibility="{Binding HasSelectedAccount, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Text="{Binding SelectedAccountCity, StringFormat='City: {0}'}" FontSize="10.5" Foreground="#64748B" Margin="0,2,0,0" 
                                       Visibility="{Binding HasSelectedAccount, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <!-- Mini Balance Card -->
                            <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,6,0,0"
                                    Visibility="{Binding HasSelectedAccount, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Current Balance:" FontSize="9.5" FontWeight="SemiBold" Foreground="#991B1B"/>
                                    <TextBlock Text="{Binding AccountBalance, StringFormat='Rs. {0}'}" FontSize="12" FontWeight="Bold" Foreground="#DC2626"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Biometric Thumb Impression Box -->
                        <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="8" VerticalAlignment="Stretch">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Fingerprint" Width="36" Height="36" Foreground="#2563EB" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Biometric / Thumb" FontSize="11" FontWeight="SemiBold" Foreground="#1E293B" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>

                                <CheckBox Grid.Row="1" IsChecked="{Binding ShowThumb}" Content="Show Thumb" FontSize="10.5" 
                                          FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Center" Margin="0,6,0,0"
                                          ToolTip="Print thumb impression placeholder on receipt"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

        </DockPanel>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--        ACCOUNT LOOKUP & SEARCH MODAL OVERLAY (F1)          -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Grid Background="#800F172A" Visibility="{Binding IsAccountLookupOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="680" MaxHeight="500" Background="#FFFFFF" CornerRadius="6" BorderBrush="#CBD5E1" BorderThickness="1" 
                    VerticalAlignment="Center" HorizontalAlignment="Center" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Select Account" FontSize="16" FontWeight="Bold" Foreground="#1E3A8A"/>
                            <TextBlock Text="Search by Account Code, English Name, Urdu Name or Group" FontSize="11" Foreground="#64748B"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" 
                                Command="{Binding CloseAccountLookupCommand}"
                                Content="✕" Style="{StaticResource ClassicButton}" MinWidth="26" Width="26" Height="26" Padding="0"
                                Foreground="#64748B" BorderThickness="0" Background="Transparent"/>
                    </Grid>

                    <!-- Search Bar -->
                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#94A3B8" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,0,10">
                        <Grid>
                            <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18" Foreground="#2563EB" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Type code, customer name or city to filter..." 
                                       Foreground="#94A3B8" FontSize="12" Margin="26,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=AccountLookupSearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox x:Name="AccountLookupSearchBox"
                                     Text="{Binding LookupSearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                     Margin="24,0,0,0" FontSize="12" Background="Transparent" BorderThickness="0"
                                     IsVisibleChanged="AccountLookupSearchBox_IsVisibleChanged"
                                     KeyDown="AccountLookupSearchBox_KeyDown"/>
                        </Grid>
                    </Border>

                    <!-- Grid -->
                    <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" ClipToBounds="True" MaxHeight="280">
                        <DataGrid x:Name="AccountsLookupGrid"
                                  ItemsSource="{Binding FilteredAccounts}" 
                                  SelectedItem="{Binding SelectedAccount}"
                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                  IsReadOnly="True" SelectionMode="Single"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#E2E8F0"
                                  RowHeight="26"
                                  MouseDoubleClick="AccountsLookupGrid_MouseDoubleClick">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#1E293B"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Height" Value="28"/>
                                    <Setter Property="Padding" Value="8,0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="CODE" Binding="{Binding AccountNo}" Width="95">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="NAME (ENGLISH)" Binding="{Binding Name}" Width="200">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="#1E3A8A"/>
                                            <Setter Property="Padding" Value="6,0,0,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="NAME (URDU)" Binding="{Binding UrduName}" Width="160">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Padding" Value="6,0,0,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="GROUP" Binding="{Binding AccountGroup.Name}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Padding" Value="6,0,0,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Actions -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Cancel (Esc)" Command="{Binding CloseAccountLookupCommand}" Style="{StaticResource ClassicButton}"/>
                        <Button Content="Select Account (Enter)" Command="{Binding SelectAccountFromLookupCommand}" 
                                CommandParameter="{Binding SelectedAccount}"
                                Style="{StaticResource ClassicButton}" Background="#2563EB" Foreground="#FFFFFF" BorderBrush="#1D4ED8"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</UserControl>
