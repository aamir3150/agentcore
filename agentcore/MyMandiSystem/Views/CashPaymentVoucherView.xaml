<UserControl x:Class="MyMandiSystem.Views.CashPaymentVoucherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:MyMandiSystem.Helpers"
             mc:Ignorable="d" 
             Background="{StaticResource BrushSurfaceBg}"
             d:DesignHeight="780" d:DesignWidth="1050"
             TextElement.Foreground="{StaticResource BrushTextPrimary}"
             FontFamily="{DynamicResource MaterialDesignFont}"
             Loaded="UserControl_Loaded"
             PreviewKeyDown="UserControl_PreviewKeyDown">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Border Margin="10" Background="#FFFFFF" BorderBrush="{StaticResource BrushSurfaceBorder}" BorderThickness="1" CornerRadius="16" Effect="{StaticResource EffectCardShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- 0. Header Banner with Branch & Voucher Search -->
                <RowDefinition Height="Auto"/>  <!-- 1. Metadata & Balances (Cash in Hand & Account Balance) -->
                <RowDefinition Height="Auto"/>  <!-- 2. Fast Entry Fields Row -->
                <RowDefinition Height="*"/>     <!-- 3. Transaction DataGrid + Party/Biometric Side Panel -->
                <RowDefinition Height="Auto"/>  <!-- 4. Urdu Narration + Total Payment -->
                <RowDefinition Height="Auto"/>  <!-- 5. Denominations Grid (نوٹ شماری) -->
                <RowDefinition Height="Auto"/>  <!-- 6. Action Footer with SMS & Print Options -->
            </Grid.RowDefinitions>

            <!-- ═══ 0. MODERN HEADER BANNER (WITH BRANCH & VOUCHER SEARCH) ═══ -->
            <Border Grid.Row="0" CornerRadius="16,16,0,0" Background="{StaticResource BrushGradientRose}" Padding="18,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="40" Height="40" CornerRadius="10" Background="#30FFFFFF" Margin="0,0,12,0" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="CashMinus" Width="22" Height="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Debit Voucher (Cash Payment)" FontSize="18" FontWeight="Bold" Foreground="White"/>
                            <Border Background="#25FFFFFF" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="نقد ادائیگی واؤچر" FontSize="12.5" FontWeight="Bold" Foreground="#FFF1F2"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Record and disburse cash payments to vendor and expense accounts / کھاتے دار کو نقد ادائیگی" FontSize="11" Foreground="#FFE4E6" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Top Voucher Navigation Toolbar (AgenSoft Style) -->
                    <Border Grid.Column="2" Background="#20FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="10" Padding="10,4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Branch Label -->
                            <materialDesign:PackIcon Kind="StoreOutline" Width="15" Height="15" Foreground="#FFF1F2" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding BranchName}" FontSize="11" Foreground="#FFF1F2" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="SemiBold"/>

                            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Background="#40FFFFFF" Margin="0,2,10,2"/>

                            <!-- Search Past Voucher # -->
                            <TextBlock Text="Find #:" FontSize="11" Foreground="#FFF1F2" VerticalAlignment="Center" Margin="0,0,4,0" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding SearchVoucherNo, UpdateSourceTrigger=PropertyChanged}" Width="75" Height="26" FontSize="11.5" FontWeight="Bold"
                                     Background="#FFFFFF" Foreground="#0F172A" Padding="4,2" VerticalContentAlignment="Center" Margin="0,0,4,0">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SearchVoucherCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            
                            <Button Command="{Binding SearchVoucherCommand}" ToolTip="Search Voucher / واؤچر تلاش کریں"
                                    Style="{StaticResource MaterialDesignFlatButton}" Width="26" Height="26" Padding="0" Margin="0,0,4,0">
                                <materialDesign:PackIcon Kind="Magnify" Width="16" Height="16" Foreground="White"/>
                            </Button>

                            <!-- Previous / Next Navigation Buttons -->
                            <Button Command="{Binding PreviousVoucherCommand}" ToolTip="Previous Voucher / پچھلا واؤچر (&lt;)"
                                    Style="{StaticResource MaterialDesignFlatButton}" Width="26" Height="26" Padding="0" Margin="0,0,2,0">
                                <materialDesign:PackIcon Kind="ChevronLeft" Width="20" Height="20" Foreground="White"/>
                            </Button>
                            <Button Command="{Binding NextVoucherCommand}" ToolTip="Next Voucher / اگلا واؤچر (&gt;)"
                                    Style="{StaticResource MaterialDesignFlatButton}" Width="26" Height="26" Padding="0">
                                <materialDesign:PackIcon Kind="ChevronRight" Width="20" Height="20" Foreground="White"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ═══ 1. TOP METADATA & BALANCES ROW (AGENSOFT REAL-TIME ACCOUNT BALANCE) ═══ -->
            <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="{StaticResource BrushSurfaceBorder}" BorderThickness="0,0,0,1" Padding="18,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Voucher No -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Voucher Number" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding VoucherNo}" IsReadOnly="True" FontSize="13" FontWeight="Bold" Background="#FFFFFF" Padding="8,4" BorderBrush="{StaticResource BrushSurfaceBorderDark}"/>
                    </StackPanel>

                    <!-- Voucher Date -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Payment Date" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,3"/>
                        <DatePicker SelectedDate="{Binding VoucherDate}" FontSize="12.5" Background="#FFFFFF" Padding="6,2"/>
                    </StackPanel>

                    <!-- Crop Season -->
                    <StackPanel Grid.Column="4">
                        <Grid Margin="0,0,0,3">
                            <TextBlock Text="Crop Season" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}"/>
                            <TextBlock Text="+ Add/Edit" FontSize="10" FontWeight="SemiBold" Foreground="#E11D48" HorizontalAlignment="Right" Cursor="Hand" ToolTip="Add or change crop seasons">
                                <TextBlock.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding ManageCropSeasonsCommand}"/>
                                </TextBlock.InputBindings>
                            </TextBlock>
                        </Grid>
                        <Grid>
                            <ComboBox ItemsSource="{Binding CropSeasons}" SelectedItem="{Binding CropSeason}" FontSize="12.5" Background="#FFFFFF" Padding="6,4,26,4"/>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="24" Margin="1"
                                    Command="{Binding ManageCropSeasonsCommand}" 
                                    ToolTip="Add or Change Crop Seasons"
                                    Style="{StaticResource MaterialDesignFlatButton}" Padding="0"
                                    Cursor="Hand">
                                <materialDesign:PackIcon Kind="CogOutline" Width="14" Height="14" Foreground="#E11D48"/>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Prominent Real-time Status Balances (AgenSoft Exact Arrangement) -->
                    <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Cash In Hand Box (Red Header) -->
                        <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="8" Padding="12,6" Margin="0,0,10,0" MinWidth="135">
                            <StackPanel>
                                <TextBlock Text="Cash in Hand (روکڑ)" FontSize="10.5" FontWeight="Bold" Foreground="#DC2626"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="Rs. " FontSize="11" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding CashInHand}" FontSize="14.5" FontWeight="Black" Foreground="#0F172A" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Account Balance Box (Red Header - Crucial AgenSoft Feature!) -->
                        <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1.5" CornerRadius="8" Padding="12,6" MinWidth="160">
                            <StackPanel>
                                <TextBlock Text="Account Balance (کھاتے کا بقایا)" FontSize="10.5" FontWeight="Bold" Foreground="#DC2626"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="Rs. " FontSize="11" FontWeight="Bold" Foreground="#DC2626" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding AccountBalance}" FontSize="14.5" FontWeight="Black" Foreground="#B91C1C" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding AccountBalanceStatus}" FontSize="9.5" FontWeight="SemiBold" Foreground="#991B1B" Margin="0,1,0,0"
                                           Visibility="{Binding HasSelectedAccount, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ 2. FAST KEYBOARD ENTRY FIELDS ROW (100% KEYBOARD FLOW) ═══ -->
            <Border Grid.Row="2" Background="#FFFFFF" Padding="18,10" BorderBrush="{StaticResource BrushSurfaceBorder}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- A/c Code -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="A/c Code" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"/>
                        <TextBox x:Name="AccountNoBox" Text="{Binding AccountNo, UpdateSourceTrigger=PropertyChanged}" 
                                 FontSize="13" FontWeight="SemiBold" Padding="6,4" BorderBrush="{StaticResource BrushSurfaceBorderDark}"
                                 KeyDown="AccountNoBox_KeyDown"
                                 ToolTip="Type account number and press Enter (or press F1 to search)"/>
                    </StackPanel>

                    <!-- A/c Name + Search Button -->
                    <StackPanel Grid.Column="2">
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Account Title" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}"/>
                            <TextBlock Text="Search (F1) 🔍" FontSize="10.5" FontWeight="Bold" Foreground="#E11D48" HorizontalAlignment="Right" Cursor="Hand">
                                <TextBlock.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding OpenAccountLookupCommand}"/>
                                </TextBlock.InputBindings>
                            </TextBlock>
                        </Grid>
                        <Grid>
                            <TextBox x:Name="AccountTitleBox" Text="{Binding AccountName, UpdateSourceTrigger=PropertyChanged}" 
                                     FontSize="12.5" Padding="7,4,32,4" BorderBrush="{StaticResource BrushSurfaceBorderDark}"
                                     materialDesign:HintAssist.Hint="Type or press F1 to search..."
                                     KeyDown="AccountTitleBox_KeyDown"
                                     ToolTip="Type name, press Enter / F1 or click 🔍 to search accounts"/>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="28" Margin="1"
                                    Command="{Binding OpenAccountLookupCommand}" 
                                    ToolTip="Search Account / کھاتہ تلاش کریں (F1)"
                                    Style="{StaticResource MaterialDesignFlatButton}" Padding="0"
                                    Cursor="Hand">
                                <materialDesign:PackIcon Kind="AccountSearch" Width="18" Height="18" Foreground="#E11D48"/>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Narration -->
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Transaction Narration / Description" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"/>
                        <TextBox x:Name="NarrationBox" Text="{Binding Narration}" FontSize="12.5" Padding="6,4" BorderBrush="{StaticResource BrushSurfaceBorderDark}"
                                 KeyDown="NarrationBox_KeyDown"
                                 ToolTip="Transaction details (Press Enter to move to Amount)"/>
                    </StackPanel>

                    <!-- Amount -->
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Amount (PKR)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"/>
                        <TextBox x:Name="AmountBox" Text="{Binding Amount}" HorizontalContentAlignment="Right" FontSize="13.5" FontWeight="Bold" 
                                 Foreground="{StaticResource BrushAccentRose}" Padding="6,4" BorderBrush="{StaticResource BrushSurfaceBorderDark}"
                                 KeyDown="AmountBox_KeyDown"
                                 ToolTip="Debit Amount in PKR (Press Enter to Add into Grid)"/>
                    </StackPanel>

                    <!-- Add Line Item Button -->
                    <Button x:Name="AddButton" Grid.Column="8" VerticalAlignment="Bottom" Command="{Binding AddDetailCommand}" 
                            Style="{StaticResource ModernPrimaryButton}" Height="34" Padding="14,0"
                            ToolTip="Add Line Item (Enter)">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="+ Add" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ═══ 3. TRANSACTION DATAGRID + AGENSOFT STYLE SIDE PANEL ═══ -->
            <Grid Grid.Row="3" Margin="18,10,18,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="230"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Transaction DataGrid -->
                <Border Grid.Column="0" CornerRadius="10" BorderBrush="{StaticResource BrushSurfaceBorder}" BorderThickness="1" ClipToBounds="True">
                    <DataGrid ItemsSource="{Binding Details}" AutoGenerateColumns="False" CanUserAddRows="False"
                              Style="{StaticResource ModernDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="A/C CODE" Binding="{Binding AccountNo}" Width="95"/>
                            <DataGridTextColumn Header="ACCOUNT TITLE" Binding="{Binding AccountName}" Width="190"/>
                            <DataGridTextColumn Header="NARRATION" Binding="{Binding Narration}" Width="*"/>
                            <DataGridTextColumn Header="DEBIT (PKR)" Binding="{Binding Debit, StringFormat=N0}" Width="140">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{StaticResource BrushAccentRose}"/>
                                        <Setter Property="Padding" Value="0,0,12,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Width="45">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.RemoveDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                Padding="0" Width="26" Height="26" Foreground="{StaticResource BrushAccentRose}">
                                            <materialDesign:PackIcon Kind="TrashCanOutline" Width="15" Height="15"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Right Column: Party Info & Biometric/Thumb Panel (AgenSoft Exact Placement) -->
                <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="{StaticResource BrushSurfaceBorder}" BorderThickness="1" CornerRadius="10" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>  <!-- Header -->
                            <RowDefinition Height="Auto"/>  <!-- Party Details -->
                            <RowDefinition Height="*"/>     <!-- Biometric / Thumb Box -->
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0" Background="#E2E8F0" CornerRadius="6" Padding="8,4" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="CardAccountDetailsOutline" Width="15" Height="15" Foreground="#334155" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Party Summary / کھاتہ" FontSize="11" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Party Details Info -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,10">
                            <TextBlock Text="{Binding AccountName, TargetNullValue='No Party Selected'}" FontSize="12" FontWeight="Bold" Foreground="#0F172A" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SelectedAccountUrduName}" FontSize="11.5" Foreground="#475569" Margin="0,2,0,0" 
                                       Visibility="{Binding HasSelectedAccount, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Text="{Binding SelectedAccountCity, StringFormat='City: {0}'}" FontSize="10.5" Foreground="#64748B" Margin="0,2,0,0" 
                                       Visibility="{Binding HasSelectedAccount, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <!-- Mini Balance Card -->
                            <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,6,0,0"
                                    Visibility="{Binding HasSelectedAccount, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Current Balance:" FontSize="9.5" FontWeight="SemiBold" Foreground="#991B1B"/>
                                    <TextBlock Text="{Binding AccountBalance, StringFormat='Rs. {0}'}" FontSize="12.5" FontWeight="Black" Foreground="#DC2626"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Biometric Thumb Impression Box (AgenSoft Visual Equivalent) -->
                        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="8" Padding="8" VerticalAlignment="Stretch">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Fingerprint" Width="42" Height="42" Foreground="{StaticResource BrushAccentRose}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Biometric / Thumb" FontSize="10.5" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    <TextBlock Text="تصدیق انگھوٹا" FontSize="9.5" Foreground="#64748B" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <CheckBox Grid.Row="1" IsChecked="{Binding ShowThumb}" Content="Show Thumb / انگھوٹا" FontSize="10.5" 
                                          FontWeight="SemiBold" Foreground="#334155" HorizontalAlignment="Center" Margin="0,6,0,0"
                                          ToolTip="Print thumb impression placeholder on receipt"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ═══ 4. URDU NARRATION + TOTALS ═══ -->
            <Border Grid.Row="4" Background="#F8FAFC" BorderBrush="{StaticResource BrushSurfaceBorder}" BorderThickness="0,1,0,1" Padding="18,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="160"/>
                    </Grid.ColumnDefinitions>

                    <!-- Urdu Narration -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Urdu Narration (تفصیل)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding NarrationUrdu}" Style="{StaticResource ModernUrduStandardTextBox}" helpers:UrduHelper.IsUrduOnly="True" Height="36" Background="#FFFFFF" BorderBrush="{StaticResource BrushSurfaceBorderDark}"/>
                    </StackPanel>

                    <!-- Total Amount Display -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0">
                        <TextBlock Text="Total Payment Amount:" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryNavy}"/>
                        <TextBlock Text="روکڑ سے ادائیگی (Direct Cash Credit)" FontSize="10" Foreground="#BE123C" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Border Grid.Column="3" Background="#FFF1F2" BorderBrush="#FECDD3" BorderThickness="1.5" CornerRadius="8" Padding="10,6" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TotalAmount, StringFormat='{}{0:N0} PKR'}" HorizontalAlignment="Right" FontSize="16.5" FontWeight="Black" Foreground="{StaticResource BrushAccentRose}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ═══ 5. DENOMINATIONS GRID (نوٹ شماری) ═══ -->
            <Border Grid.Row="5" Background="#FFFFFF" Padding="18,8" BorderBrush="{StaticResource BrushSurfaceBorder}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="5,000" HorizontalAlignment="Center" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}"/>
                    <TextBlock Grid.Column="1" Text="1,000" HorizontalAlignment="Center" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}"/>
                    <TextBlock Grid.Column="2" Text="500" HorizontalAlignment="Center" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}"/>
                    <TextBlock Grid.Column="3" Text="100" HorizontalAlignment="Center" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}"/>
                    <TextBlock Grid.Column="4" Text="50" HorizontalAlignment="Center" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}"/>
                    <TextBlock Grid.Column="5" Text="20" HorizontalAlignment="Center" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}"/>
                    <TextBlock Grid.Column="6" Text="10" HorizontalAlignment="Center" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}"/>
                    <TextBlock Grid.Column="7" Text="5" HorizontalAlignment="Center" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}"/>
                    <TextBlock Grid.Column="8" Text="2" HorizontalAlignment="Center" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}"/>
                    <TextBlock Grid.Column="9" Text="1" HorizontalAlignment="Center" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}"/>

                    <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding Count5000}" HorizontalContentAlignment="Center" Margin="2,3" FontSize="11" Padding="2" BorderBrush="{StaticResource BrushSurfaceBorderDark}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Count1000}" HorizontalContentAlignment="Center" Margin="2,3" FontSize="11" Padding="2" BorderBrush="{StaticResource BrushSurfaceBorderDark}"/>
                    <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Count500}" HorizontalContentAlignment="Center" Margin="2,3" FontSize="11" Padding="2" BorderBrush="{StaticResource BrushSurfaceBorderDark}"/>
                    <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding Count100}" HorizontalContentAlignment="Center" Margin="2,3" FontSize="11" Padding="2" BorderBrush="{StaticResource BrushSurfaceBorderDark}"/>
                    <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding Count50}" HorizontalContentAlignment="Center" Margin="2,3" FontSize="11" Padding="2" BorderBrush="{StaticResource BrushSurfaceBorderDark}"/>
                    <TextBox Grid.Row="1" Grid.Column="5" Text="{Binding Count20}" HorizontalContentAlignment="Center" Margin="2,3" FontSize="11" Padding="2" BorderBrush="{StaticResource BrushSurfaceBorderDark}"/>
                    <TextBox Grid.Row="1" Grid.Column="6" Text="{Binding Count10}" HorizontalContentAlignment="Center" Margin="2,3" FontSize="11" Padding="2" BorderBrush="{StaticResource BrushSurfaceBorderDark}"/>
                    <TextBox Grid.Row="1" Grid.Column="7" Text="{Binding Count5}" HorizontalContentAlignment="Center" Margin="2,3" FontSize="11" Padding="2" BorderBrush="{StaticResource BrushSurfaceBorderDark}"/>
                    <TextBox Grid.Row="1" Grid.Column="8" Text="{Binding Count2}" HorizontalContentAlignment="Center" Margin="2,3" FontSize="11" Padding="2" BorderBrush="{StaticResource BrushSurfaceBorderDark}"/>
                    <TextBox Grid.Row="1" Grid.Column="9" Text="{Binding Count1}" HorizontalContentAlignment="Center" Margin="2,3" FontSize="11" Padding="2" BorderBrush="{StaticResource BrushSurfaceBorderDark}"/>

                    <!-- Denomination Total Pill + Sync Button -->
                    <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="10" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                            <StackPanel>
                                <TextBlock Text="Notes Total:" FontSize="9.5" FontWeight="SemiBold" Foreground="#64748B"/>
                                <TextBlock Text="{Binding DenominationTotal, StringFormat='{}{0:N0} PKR'}" FontSize="12" FontWeight="Bold" Foreground="#0F172A"/>
                            </StackPanel>
                        </Border>
                        <Button Command="{Binding ApplyDenominationToAmountCommand}" ToolTip="Apply Notes Total to Amount / رقم میں نوٹوں کا ٹوٹل درج کریں"
                                Style="{StaticResource MaterialDesignFlatButton}" Margin="4,0,0,0" Padding="4" Height="28">
                            <materialDesign:PackIcon Kind="ArrowLeftBold" Width="15" Height="15" Foreground="{StaticResource BrushAccentRose}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ 6. ACTIONS FOOTER (WITH SMS, AUTO-PRINT & SHORTCUTS) ═══ -->
            <Border Grid.Row="6" Background="#F1F5F9" Padding="14,10" CornerRadius="0,0,16,16">
                <Grid>
                    <!-- Left: Checkboxes (AgenSoft Style) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox IsChecked="{Binding SendSms}" Content="Send SMS (ایس ایم ایس)" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,14,0"/>
                        <CheckBox IsChecked="{Binding AutoPrint}" Content="Print on Save (خودکار پرنٹ)" FontSize="11" FontWeight="SemiBold" Foreground="#334155"/>
                    </StackPanel>

                    <!-- Right: Action Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- Delete Button (Only visible when viewing an existing saved voucher) -->
                        <Button Command="{Binding DeleteVoucherCommand}" Style="{StaticResource ModernDangerButton}" Margin="0,0,8,0"
                                Visibility="{Binding IsExistingVoucher, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="DeleteOutline" Width="16" Height="16" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Delete (حذف)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding SaveCommand}" Style="{StaticResource ModernPrimaryButton}" Margin="0,0,8,0" ToolTip="Save Voucher (F2)">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSaveCheckOutline" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Save Voucher (F2)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ClearCommand}" Style="{StaticResource ModernSecondaryButton}" Margin="0,0,8,0" ToolTip="New / Clear (F3)">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Reset / New (F3)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding PrintCommand}" Style="{StaticResource ModernSecondaryButton}" Margin="0,0,8,0" ToolTip="Print Voucher (Ctrl+P)">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="PrinterOutline" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Print (Ctrl+P)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding CloseCommand}" 
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                Style="{StaticResource ModernDangerButton}" ToolTip="Close (Esc)">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CloseCircleOutline" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Close (Esc)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ 7. ACCOUNT LOOKUP & SEARCH MODAL OVERLAY (F1) ═══ -->
            <Grid Grid.Row="0" Grid.RowSpan="7" Background="#800F172A"
                  Visibility="{Binding IsAccountLookupOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Width="680" MaxHeight="520" Background="White" CornerRadius="14" BorderBrush="#CBD5E1" BorderThickness="1" 
                        VerticalAlignment="Center" HorizontalAlignment="Center" Padding="20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="8" Color="#000000" Opacity="0.3"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>  <!-- Modal Header -->
                            <RowDefinition Height="Auto"/>  <!-- Search Box -->
                            <RowDefinition Height="*"/>     <!-- DataGrid -->
                            <RowDefinition Height="Auto"/>  <!-- Actions -->
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Select Account / کھاتہ منتخب کریں" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryNavy}"/>
                                <TextBlock Text="Search by Account Code, English Name, Urdu Name or Group" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Top" 
                                    Command="{Binding CloseAccountLookupCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}" Width="28" Height="28" Padding="0">
                                <materialDesign:PackIcon Kind="Close" Width="18" Height="18" Foreground="#64748B"/>
                            </Button>
                        </Grid>

                        <!-- Search Bar -->
                        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,12">
                            <Grid>
                                <materialDesign:PackIcon Kind="Magnify" Width="20" Height="20" Foreground="{StaticResource BrushAccentRose}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="AccountLookupSearchBox"
                                         Text="{Binding LookupSearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                         Margin="28,0,0,0" FontSize="13" Background="Transparent" BorderThickness="0"
                                         materialDesign:HintAssist.Hint="Type code, customer name or city to filter..."
                                         IsVisibleChanged="AccountLookupSearchBox_IsVisibleChanged"
                                         KeyDown="AccountLookupSearchBox_KeyDown"/>
                            </Grid>
                        </Border>

                        <!-- Grid -->
                        <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" ClipToBounds="True" MaxHeight="300">
                            <DataGrid x:Name="AccountsLookupGrid"
                                      ItemsSource="{Binding FilteredAccounts}" 
                                      SelectedItem="{Binding SelectedAccount}"
                                      AutoGenerateColumns="False" CanUserAddRows="False"
                                      IsReadOnly="True" SelectionMode="Single"
                                      Style="{StaticResource ModernDataGrid}"
                                      MouseDoubleClick="AccountsLookupGrid_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="CODE" Binding="{Binding AccountNo}" Width="100"/>
                                    <DataGridTextColumn Header="NAME (ENGLISH)" Binding="{Binding Name}" Width="200"/>
                                    <DataGridTextColumn Header="NAME (URDU)" Binding="{Binding UrduName}" Width="180"/>
                                    <DataGridTextColumn Header="GROUP" Binding="{Binding AccountGroup.Name}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- Actions -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                            <Button Command="{Binding CloseAccountLookupCommand}" Style="{StaticResource ModernSecondaryButton}" Margin="0,0,8,0">
                                <TextBlock Text="Cancel (Esc)"/>
                            </Button>
                            <Button Command="{Binding SelectAccountFromLookupCommand}" 
                                    CommandParameter="{Binding SelectedAccount}"
                                    Style="{StaticResource ModernPrimaryButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Check" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Select Account (Enter)" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
