<Window x:Class="MyMandiSystem.Views.GeneralMultiInvoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="GENERAL MULTI INVOICE (Back-to-Back Purchase &amp; Sale)" 
        Height="800" Width="1240"
        MinHeight="680" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        FontFamily="Segoe UI" FontSize="12">

    <Window.Resources>
        <Style x:Key="ClassicButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="8,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#4F46E5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#C7D2FE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <DockPanel LastChildFill="True">

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                   DUAL TRADING PARTNERS BAR                -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: VENDOR / PURCHASE INFO -->
                <Border Grid.Column="0" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="10,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="75"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Purchase ID:" FontWeight="Bold" Foreground="#1E3A8A" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding PurchaseId}" IsReadOnly="True" FontWeight="Bold" Foreground="#1E3A8A"/>

                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Crop Season:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <ComboBox Grid.Row="0" Grid.Column="4" ItemsSource="{Binding CropSeasons}" SelectedItem="{Binding SelectedCropSeason}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Vendor / Supplier:" FontWeight="Bold" Foreground="#1E3A8A" VerticalAlignment="Center" Margin="0,4,0,0"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" ItemsSource="{Binding AvailableVendors}" SelectedItem="{Binding SelectedVendor}"
                                  DisplayMemberPath="Name" IsEditable="True" Margin="0,4,0,0"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Address:" VerticalAlignment="Center" Margin="0,4,0,0"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding VendorAddress}" IsReadOnly="True" Margin="0,4,0,0"/>

                        <TextBlock Grid.Row="2" Grid.Column="3" Text="Prev. Balance:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,4,0,0"/>
                        <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding VendorPrevBalance, StringFormat={}{0:N0}}" IsReadOnly="True" 
                                 FontWeight="Bold" Foreground="#B91C1C" HorizontalContentAlignment="Right" Margin="0,4,0,0"/>
                    </Grid>
                </Border>

                <!-- RIGHT: CUSTOMER / SALE INFO -->
                <Border Grid.Column="2" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="10,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="75"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Sale ID:" FontWeight="Bold" Foreground="#047857" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SaleId}" IsReadOnly="True" FontWeight="Bold" Foreground="#047857"/>

                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Invoice Date:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <DatePicker Grid.Row="0" Grid.Column="4" SelectedDate="{Binding InvoiceDate}" Height="24"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Customer / Buyer:" FontWeight="Bold" Foreground="#047857" VerticalAlignment="Center" Margin="0,4,0,0"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" ItemsSource="{Binding AvailableCustomers}" SelectedItem="{Binding SelectedCustomer}"
                                  DisplayMemberPath="Name" IsEditable="True" Margin="0,4,0,0"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Address:" VerticalAlignment="Center" Margin="0,4,0,0"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CustomerAddress}" IsReadOnly="True" Margin="0,4,0,0"/>

                        <TextBlock Grid.Row="2" Grid.Column="3" Text="Prev. Balance:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,4,0,0"/>
                        <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding CustomerPrevBalance, StringFormat={}{0:N0}}" IsReadOnly="True" 
                                 FontWeight="Bold" Foreground="#B91C1C" HorizontalContentAlignment="Right" Margin="0,4,0,0"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                   SHARED ITEM ENTRY BAR                    -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="65"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="65"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="55"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="55"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="55"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Product / Item" FontWeight="Bold" Foreground="#4F46E5"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Unit" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="0" Grid.Column="4" Text="Multiplier" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="0" Grid.Column="6" Text="Quantity" FontWeight="Bold"/>
                    <TextBlock Grid.Row="0" Grid.Column="8" Text="Bonus" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="0" Grid.Column="10" Text="Pur Rate" FontWeight="Bold" Foreground="#1E3A8A"/>
                    <TextBlock Grid.Row="0" Grid.Column="12" Text="Pur Disc %" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="0" Grid.Column="14" Text="Sale Rate" FontWeight="Bold" Foreground="#047857"/>
                    <TextBlock Grid.Row="0" Grid.Column="16" Text="Sale Disc %" FontWeight="SemiBold"/>

                    <ComboBox Grid.Row="1" Grid.Column="0" ItemsSource="{Binding AvailableProducts}" SelectedItem="{Binding SelectedProduct}" DisplayMemberPath="Name" IsEditable="True"/>
                    <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding CurrentUnitName}" IsReadOnly="True" Background="#F8FAFC"/>
                    <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding CurrentMultiplier, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBox Grid.Row="1" Grid.Column="6" Text="{Binding CurrentQty, UpdateSourceTrigger=PropertyChanged}" FontWeight="Bold"/>
                    <TextBox Grid.Row="1" Grid.Column="8" Text="{Binding CurrentBonus, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBox Grid.Row="1" Grid.Column="10" Text="{Binding CurrentPurPrice, UpdateSourceTrigger=PropertyChanged}" FontWeight="Bold" Foreground="#1E3A8A"/>
                    <TextBox Grid.Row="1" Grid.Column="12" Text="{Binding CurrentPurDisc, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBox Grid.Row="1" Grid.Column="14" Text="{Binding CurrentSalePrice, UpdateSourceTrigger=PropertyChanged}" FontWeight="Bold" Foreground="#047857"/>
                    <TextBox Grid.Row="1" Grid.Column="16" Text="{Binding CurrentSaleDisc, UpdateSourceTrigger=PropertyChanged}"/>

                    <Button Grid.Row="1" Grid.Column="18" Content="+ Add Multi Item" Command="{Binding AddItemCommand}"
                            Background="#4F46E5" Foreground="#FFFFFF" FontWeight="Bold" BorderBrush="#4338CA" Height="24"/>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                   BOTTOM BUTTONS BAR                       -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border DockPanel.Dock="Bottom" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,6,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="Save Multi Invoice" Command="{Binding SaveCommand}" Style="{StaticResource ClassicButton}" Background="#4F46E5" Foreground="#FFFFFF" BorderBrush="#4338CA"/>
                        <Button Content="New" Command="{Binding NewCommand}" Style="{StaticResource ClassicButton}"/>
                        <Button Content="Print" Command="{Binding PrintCommand}" Style="{StaticResource ClassicButton}"/>
                    </StackPanel>

                    <Button Content="Close" HorizontalAlignment="Right" Style="{StaticResource ClassicButton}" Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                 DUAL SUMMARY & MARGIN BAR                  -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Grid DockPanel.Dock="Bottom" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: PURCHASE FINANCIAL SUMMARY -->
                <Border Grid.Column="0" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="8,6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Pur Gross:" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding PurGrossTotal, StringFormat={}{0:N0}}" IsReadOnly="True" HorizontalContentAlignment="Right"/>

                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Net Payable:" FontWeight="Bold" Foreground="#1E3A8A" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="4" Text="{Binding PurNetPayable, StringFormat={}{0:N0}}" IsReadOnly="True" FontWeight="Bold" Foreground="#1E3A8A" HorizontalContentAlignment="Right"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Freight / Exp:" VerticalAlignment="Center" Margin="0,3,0,0"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PurFreight, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Right" Margin="0,3,0,0"/>

                        <TextBlock Grid.Row="1" Grid.Column="3" Text="Paid Amount:" VerticalAlignment="Center" Margin="0,3,0,0"/>
                        <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding PurPaidAmount, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Right" Foreground="#15803D" FontWeight="Bold" Margin="0,3,0,0"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Com % / Val:" VerticalAlignment="Center" Margin="0,3,0,0"/>
                        <Grid Grid.Row="2" Grid.Column="1" Margin="0,3,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="35"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding PurComRatio, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Grid.Column="1" Text="{Binding PurCommission, StringFormat={}{0:N0}}" IsReadOnly="True" HorizontalContentAlignment="Right"/>
                        </Grid>

                        <TextBlock Grid.Row="2" Grid.Column="3" Text="Rem. Balance:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,3,0,0"/>
                        <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding PurRemBalance, StringFormat={}{0:N0}}" IsReadOnly="True" FontWeight="Bold" Foreground="#B91C1C" HorizontalContentAlignment="Right" Margin="0,3,0,0"/>
                    </Grid>
                </Border>

                <!-- CENTER: NET PROFIT MARGIN BADGE -->
                <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="8" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="TOTAL PROFIT SPREAD" FontSize="10" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                        <TextBlock Text="Margin Difference" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalProfitMargin, StringFormat={}{0:N0}}" FontSize="18" FontWeight="Bold" Foreground="#047857" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- RIGHT: SALE FINANCIAL SUMMARY -->
                <Border Grid.Column="4" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="8,6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Sale Gross:" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SaleGrossTotal, StringFormat={}{0:N0}}" IsReadOnly="True" HorizontalContentAlignment="Right"/>

                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Net Receivable:" FontWeight="Bold" Foreground="#047857" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="4" Text="{Binding SaleNetReceivable, StringFormat={}{0:N0}}" IsReadOnly="True" FontWeight="Bold" Foreground="#047857" HorizontalContentAlignment="Right"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Freight / Exp:" VerticalAlignment="Center" Margin="0,3,0,0"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SaleFreight, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Right" Margin="0,3,0,0"/>

                        <TextBlock Grid.Row="1" Grid.Column="3" Text="Received Amt:" VerticalAlignment="Center" Margin="0,3,0,0"/>
                        <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding SaleReceivedAmount, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Right" Foreground="#15803D" FontWeight="Bold" Margin="0,3,0,0"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Com % / Val:" VerticalAlignment="Center" Margin="0,3,0,0"/>
                        <Grid Grid.Row="2" Grid.Column="1" Margin="0,3,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="35"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding SaleComRatio, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Grid.Column="1" Text="{Binding SaleCommission, StringFormat={}{0:N0}}" IsReadOnly="True" HorizontalContentAlignment="Right"/>
                        </Grid>

                        <TextBlock Grid.Row="2" Grid.Column="3" Text="Rem. Balance:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,3,0,0"/>
                        <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding SaleRemBalance, StringFormat={}{0:N0}}" IsReadOnly="True" FontWeight="Bold" Foreground="#B91C1C" HorizontalContentAlignment="Right" Margin="0,3,0,0"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                   SHARED ITEMS GRID                        -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                <DataGrid ItemsSource="{Binding Items}" 
                          SelectedItem="{Binding SelectedGridItem}"
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E2E8F0"
                          RowHeight="32"
                          materialDesign:DataGridAssist.CellPadding="6,2,6,2">
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="6,2"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter VerticalAlignment="Center" SnapsToDevicePixels="True"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Height" Value="32"/>
                            <Setter Property="MinHeight" Value="32"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F8FAFC"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#E2E8F0"/>
                                    <Setter Property="Foreground" Value="#0F172A"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#1E293B"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Height" Value="30"/>
                            <Setter Property="Padding" Value="6,0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding SerialNo}" Width="35" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Code" Binding="{Binding ProductCode}" Width="75" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="6,0,0,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="*" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="6,0,0,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Unit" Binding="{Binding UnitName}" Width="80" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Multiplier" Binding="{Binding Multiplier}" Width="65">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="0,0,6,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="75">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="0,0,6,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Bonus" Binding="{Binding Bonus}" Width="55">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="0,0,6,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Purchase Side -->
                        <DataGridTextColumn Header="Pur Rate" Binding="{Binding PurPrice, StringFormat={}{0:N2}}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#1E3A8A"/>
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="0,0,6,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Pur Net" Binding="{Binding PurNetValue, StringFormat={}{0:N0}}" Width="95" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#1E3A8A"/>
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="0,0,6,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Sale Side -->
                        <DataGridTextColumn Header="Sale Rate" Binding="{Binding SalePrice, StringFormat={}{0:N2}}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#047857"/>
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="0,0,6,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Sale Net" Binding="{Binding SaleNetValue, StringFormat={}{0:N0}}" Width="95" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#047857"/>
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="0,0,6,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Margin -->
                        <DataGridTextColumn Header="Margin" Binding="{Binding Margin, StringFormat={}{0:N0}}" Width="90" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#D97706"/>
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="0,0,6,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Actions -->
                        <DataGridTemplateColumn Header="Action" Width="55">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="✕" 
                                            Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Foreground="#DC2626" Background="Transparent" BorderThickness="0" FontWeight="Bold"
                                            Padding="4,0" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Cursor="Hand" ToolTip="Remove Item"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

        </DockPanel>
    </Grid>
</Window>
