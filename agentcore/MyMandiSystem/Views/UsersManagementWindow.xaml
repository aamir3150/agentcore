<Window x:Class="MyMandiSystem.Views.UsersManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="User Security &amp; Access Permissions" 
        Width="1050" 
        Height="730"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True">

    <Window.Resources>
        <Storyboard x:Key="FadeInStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:0.25"/>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource FadeInStoryboard}"/>
        </EventTrigger>
    </Window.Triggers>

    <Border Margin="16" CornerRadius="18" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1.5" Effect="{StaticResource EffectModalShadow}">
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="*"/>    <!-- Content Body -->
                <RowDefinition Height="Auto"/> <!-- Footer Actions -->
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                       TOP TITLE BAR                        -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border Grid.Row="0" Background="{StaticResource BrushPrimaryNavy}" CornerRadius="18,18,0,0" Padding="22,14"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Cursor="SizeAll">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="#1E293B" Margin="0,0,12,0">
                        <materialDesign:PackIcon Kind="AccountShield" Width="24" Height="24" Foreground="{StaticResource BrushAccentTealLight}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="User Security &amp; Permissions Management" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="سسٹم صارفین، سیکیورٹی پاس ورڈ اور دفتری اختیارات کی تقسیم" 
                                   FontFamily="{StaticResource FontJameelNooriNastaleeq}" FontSize="15" Foreground="#94A3B8"/>
                    </StackPanel>

                    <Button Grid.Column="2" Click="CloseButton_Click" Cursor="Hand" Width="30" Height="30" 
                            Background="Transparent" BorderThickness="0" Padding="0">
                        <materialDesign:PackIcon Kind="Close" Width="20" Height="20" Foreground="#94A3B8"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                   MAIN CONTENT LAYOUT                      -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="1" Margin="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Users List -->
                <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Search & Add User Button -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="Search Users..." 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="8,6" FontSize="12"
                                     Text="{Binding UserSearchText, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="1" Command="{Binding NewUserCommand}" ToolTip="Add New User"
                                    Margin="6,0,0,0" Width="34" Height="34" Padding="0" Style="{StaticResource MaterialDesignRaisedButton}"
                                    Background="{StaticResource BrushPrimaryNavy}">
                                <materialDesign:PackIcon Kind="AccountPlus" Width="18" Height="18" Foreground="#FFFFFF"/>
                            </Button>
                        </Grid>

                        <!-- Users ListBox -->
                        <ListBox Grid.Row="1" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}"
                                 BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="UsersList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,3" Padding="10,8" CornerRadius="8" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="#E2E8F0" Margin="0,0,10,0">
                                                <materialDesign:PackIcon Kind="Account" Width="18" Height="18" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding UserName}" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                                                <TextBlock Text="{Binding FullName}" FontSize="11" Foreground="#64748B"/>
                                            </StackPanel>
                                            <Border Grid.Column="2" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                                    Background="{Binding IsAdministrator, Converter={x:Null}}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#F1F5F9"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAdministrator}" Value="True">
                                                                <Setter Property="Background" Value="#DCFCE7"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding RoleBadge}" FontSize="9" FontWeight="Bold"
                                                           Foreground="{Binding IsAdministrator, Converter={x:Null}}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#475569"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsAdministrator}" Value="True">
                                                                    <Setter Property="Foreground" Value="#16A34A"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Grid.Row="2" Text="{Binding Users.Count, StringFormat='Total Users: {0}'}" 
                                   Foreground="#94A3B8" FontSize="11" Margin="4,8,4,0"/>
                    </Grid>
                </Border>

                <!-- Right Column: User Credentials & Permissions Grid -->
                <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Credentials Card -->
                            <RowDefinition Height="Auto"/> <!-- Role Selector & Permissions Header -->
                            <RowDefinition Height="*"/>    <!-- Permissions Grouped List -->
                        </Grid.RowDefinitions>

                        <!-- Credentials Card -->
                        <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Username & Full Name -->
                                <TextBox Grid.Row="0" Grid.Column="0" materialDesign:HintAssist.Hint="Username (لاگ اِن نام)" 
                                         Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,8"
                                         Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Grid.Row="0" Grid.Column="2" materialDesign:HintAssist.Hint="Full Name / پورا نام" 
                                         Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,8"
                                         Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"/>

                                <!-- Password & Confirm Password -->
                                <TextBox Grid.Row="1" Grid.Column="0" materialDesign:HintAssist.Hint="Password (پاس ورڈ)" 
                                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                         Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Grid.Row="1" Grid.Column="2" materialDesign:HintAssist.Hint="Confirm Password (تصدیق پاس ورڈ)" 
                                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                         Text="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </Border>

                        <!-- Role Selector & Permissions Controls -->
                        <Border Grid.Row="1" Background="#F1F5F9" CornerRadius="8" Padding="14,8" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Role Radio Buttons -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="صلاحیت / Role:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#334155"/>
                                    <RadioButton Content="Administrator (مکمل اختیارات)" IsChecked="{Binding IsAdministrator}" 
                                                 FontWeight="SemiBold" Margin="0,0,12,0"/>
                                    <RadioButton Content="Standard User (مخصوص اجازت نامے)" IsChecked="{Binding IsAdministrator, Converter={x:Null}}"
                                                 FontWeight="SemiBold"/>
                                </StackPanel>

                                <!-- Select All / Deselect All for Standard Users -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Command="{Binding SelectAllTasksCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Height="28" Padding="10,0" Margin="0,0,6,0" FontSize="11">
                                        <TextBlock Text="Select All / سب منتخب"/>
                                    </Button>
                                    <Button Command="{Binding DeselectAllTasksCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Height="28" Padding="10,0" FontSize="11">
                                        <TextBlock Text="Clear All / سب ختم"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Grouped Permissions List -->
                        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding GroupedTasks}" Margin="8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,4,0,8" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Background="#FAFAFA">
                                                <Expander IsExpanded="True" Padding="10,6">
                                                    <Expander.Header>
                                                        <Grid Width="600">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <materialDesign:PackIcon Kind="FolderKeyOutline" Width="18" Height="18" Foreground="#0284C7" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding GroupName}" FontWeight="Bold" FontSize="13" Foreground="#0F172A" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding Tasks.Count, StringFormat=' ({0} Tasks)'}" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                            <CheckBox Grid.Column="1" Content="Group All" IsChecked="{Binding IsAllSelected}" 
                                                                      FontSize="11" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Expander.Header>

                                                    <ItemsControl ItemsSource="{Binding Tasks}" Margin="14,4,10,8">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel ItemWidth="280"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <CheckBox IsChecked="{Binding IsAssigned}" Margin="0,3,10,3">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding TaskName}" FontSize="12" Foreground="#334155"/>
                                                                    </StackPanel>
                                                                </CheckBox>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Expander>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                       FOOTER ACTIONS                       -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,14" CornerRadius="0,0,18,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Command="{Binding DeleteUserCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                            BorderBrush="#EF4444" Foreground="#EF4444" Height="38" Padding="14,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountRemove" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Delete User / صارف حذف کریں" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}" Height="38" Padding="14,0" Margin="0,0,10,0"
                                Click="CloseButton_Click" Foreground="#64748B" BorderBrush="#CBD5E1">
                            <TextBlock Text="Close / بند کریں"/>
                        </Button>

                        <Button Command="{Binding SaveUserCommand}"
                                Background="{StaticResource BrushPrimaryNavy}" Foreground="#FFFFFF" BorderThickness="0" Height="38" Padding="20,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountCheck" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Save User / محفوظ کریں" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
