<Window x:Class="MyMandiSystem.Views.PortSettingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Electronic Weighbridge Port Settings" 
        Width="780" 
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True">

    <Window.Resources>
        <Storyboard x:Key="FadeInStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:0.25"/>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource FadeInStoryboard}"/>
        </EventTrigger>
    </Window.Triggers>

    <Border Margin="16" CornerRadius="18" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1.5" Effect="{StaticResource EffectModalShadow}">
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="*"/>    <!-- Settings Body -->
                <RowDefinition Height="Auto"/> <!-- Live Digital Display -->
                <RowDefinition Height="Auto"/> <!-- Footer Actions -->
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                       TOP TITLE BAR                        -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border Grid.Row="0" Background="{StaticResource BrushPrimaryNavy}" CornerRadius="18,18,0,0" Padding="22,14"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Cursor="SizeAll">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="#1E293B" Margin="0,0,12,0">
                        <materialDesign:PackIcon Kind="Scale" Width="24" Height="24" Foreground="{StaticResource BrushAccentTealLight}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Electronic Weighbridge (کانٹا) Serial Port Setup" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="الیکٹرانک وزنی کانٹے کے سیریل پورٹ کا کنکشن و ترتیبات" 
                                   FontFamily="{StaticResource FontJameelNooriNastaleeq}" FontSize="15" Foreground="#94A3B8"/>
                    </StackPanel>

                    <Button Grid.Column="2" Click="CloseButton_Click" Cursor="Hand" Width="30" Height="30" 
                            Background="Transparent" BorderThickness="0" Padding="0">
                        <materialDesign:PackIcon Kind="Close" Width="20" Height="20" Foreground="#94A3B8"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                    SETTINGS BODY GRID                      -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="1" Margin="24,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: COM Port & Communication Specs -->
                <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Serial Port Parameters / سیریل پورٹ ترتیبات" FontWeight="SemiBold" FontSize="13" Foreground="#334155" Margin="0,0,0,12"/>

                        <!-- Port Name & Refresh -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" materialDesign:HintAssist.Hint="Port Name (COM Port)" 
                                      Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                      ItemsSource="{Binding AvailablePorts}" SelectedItem="{Binding SelectedPort}"/>
                            <Button Grid.Column="1" Command="{Binding RefreshAvailablePortsCommand}" ToolTip="Refresh Port List"
                                    Margin="8,0,0,0" Width="32" Height="32" Padding="0" Style="{StaticResource MaterialDesignOutlinedButton}">
                                <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16"/>
                            </Button>
                        </Grid>

                        <!-- Baud Rate -->
                        <ComboBox materialDesign:HintAssist.Hint="Baud Rate (Bits Per Second)" Margin="0,0,0,10"
                                  Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                  ItemsSource="{Binding AvailableBaudRates}" SelectedItem="{Binding SelectedBaudRate}"/>

                        <!-- Parity & Stop Bits -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" materialDesign:HintAssist.Hint="Parity" 
                                      Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                      ItemsSource="{Binding AvailableParity}" SelectedItem="{Binding SelectedParity}"/>
                            <ComboBox Grid.Column="2" materialDesign:HintAssist.Hint="Stop Bits" 
                                      Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                      ItemsSource="{Binding AvailableStopBits}" SelectedItem="{Binding SelectedStopBits}"/>
                        </Grid>

                        <!-- Data Bits -->
                        <ComboBox materialDesign:HintAssist.Hint="Data Bits" Margin="0,0,0,10"
                                  Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                  ItemsSource="{Binding AvailableDataBits}" SelectedItem="{Binding SelectedDataBits}"/>

                        <!-- RTS Toggle -->
                        <CheckBox Content="Enable RTS (Request to Send)" IsChecked="{Binding EnableRts}" Margin="0,6,0,0" FontSize="12"/>
                    </StackPanel>
                </Border>

                <!-- Right Column: Weight Parsing Rules -->
                <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Weight Parsing Rules / وزن پڑھنے کے اصول" FontWeight="SemiBold" FontSize="13" Foreground="#334155" Margin="0,0,0,12"/>

                        <!-- Data Direction -->
                        <ComboBox materialDesign:HintAssist.Hint="Data Direction (سمت)" Margin="0,0,0,10"
                                  Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                  ItemsSource="{Binding AvailableDirections}" SelectedItem="{Binding SelectedDirection}"/>

                        <!-- Length & Offset -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="Length (ہندسوں کی لمبائی)" 
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     Text="{Binding DataLength, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Grid.Column="2" materialDesign:HintAssist.Hint="Offset (شروع کی پوزیشن)" 
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     Text="{Binding DataOffset, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <!-- Flags -->
                        <StackPanel Margin="0,8,0,0">
                            <CheckBox Content="Is Reversed? (الٹی سمت میں وزن)" IsChecked="{Binding IsReversed}" Margin="0,0,0,8" FontSize="12"/>
                            <CheckBox Content="For Cotton Bales (گانٹھوں کے لیے)" IsChecked="{Binding ForBales}" Margin="0,0,0,8" FontSize="12"/>
                            <CheckBox Content="Enable Barcode Weighments" IsChecked="{Binding EnableBarcodeWeighment}" Margin="0,0,0,0" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--              LIVE DIGITAL WEIGHT INDICATOR BOX             -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border Grid.Row="2" Background="#0F172A" Margin="24,0,24,18" CornerRadius="12" Padding="20,16" BorderBrush="#334155" BorderThickness="1.5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Width="10" Height="10" CornerRadius="5" Background="{Binding IsConnected, Converter={x:Null}}" Margin="0,0,8,0"
                                    VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#EF4444"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Background" Value="#10B981"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <TextBlock Text="{Binding ConnectionStatus}" Foreground="#94A3B8" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>

                        <TextBlock Text="RAW STREAM:" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                        <TextBlock Text="{Binding RawStreamData}" Foreground="#38BDF8" FontFamily="Consolas" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Digital Weight LED Display -->
                    <Border Grid.Column="1" Background="#020617" CornerRadius="8" Padding="24,10" BorderBrush="#1E293B" BorderThickness="1" VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="CURRENT WEIGHT / موجودہ وزن" FontSize="9" Foreground="#64748B" HorizontalAlignment="Center" FontWeight="Bold"/>
                            <TextBlock Text="{Binding LiveWeightDisplay}" Foreground="#4ADE80" FontFamily="Consolas" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                       FOOTER ACTIONS                       -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,14" CornerRadius="0,0,18,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Command="{Binding TestPortCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                            BorderBrush="#0284C7" Foreground="#0284C7" Height="38" Padding="14,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Weight" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Test Reading / وزن ٹیسٹ کریں" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}" Height="38" Padding="14,0" Margin="0,0,10,0"
                                Click="CloseButton_Click" Foreground="#64748B" BorderBrush="#CBD5E1">
                            <TextBlock Text="Close / بند کریں"/>
                        </Button>

                        <Button Command="{Binding SaveSettingsCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                Background="{StaticResource BrushPrimaryNavy}" Foreground="#FFFFFF" BorderThickness="0" Height="38" Padding="18,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSaveCheck" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Save Settings / محفوظ کریں" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
