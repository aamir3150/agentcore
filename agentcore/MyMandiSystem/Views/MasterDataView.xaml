<UserControl x:Class="MyMandiSystem.Views.MasterDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MyMandiSystem.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1050"
             TextElement.Foreground="{StaticResource BrushTextPrimary}"
             TextElement.FontWeight="Regular"
             TextElement.FontSize="13"
             Background="{StaticResource BrushSurfaceBg}"
             FontFamily="{DynamicResource MaterialDesignFont}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Border Margin="12" Background="#FFFFFF" CornerRadius="16" BorderBrush="{StaticResource BrushSurfaceBorder}" BorderThickness="1" Effect="{StaticResource EffectCardShadow}">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Header Banner -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="10" Background="{StaticResource BrushGradientSky}" Margin="0,0,12,0" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="DatabaseSettingsOutline" Width="24" Height="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Master Configuration &amp; Geography" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryNavy}"/>
                    <TextBlock Text="Companies, measurement units, towns, and distribution sectors" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                </StackPanel>
            </Grid>

            <TabControl Grid.Row="1" BorderThickness="0" Background="Transparent">
                
                <!-- COMPANIES TAB -->
                <TabItem Header="Companies">
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="1.2*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0" CornerRadius="12" BorderBrush="{StaticResource BrushSurfaceBorder}" BorderThickness="1" ClipToBounds="True">
                            <DataGrid ItemsSource="{Binding Companies}" SelectedItem="{Binding SelectedCompany}" 
                                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single"
                                      Style="{StaticResource ModernDataGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                                    <DataGridTextColumn Header="COMPANY NAME" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="CODE / SHORT" Binding="{Binding ShortName}" Width="120"/>
                                    <DataGridCheckBoxColumn Header="ACTIVE" Binding="{Binding IsActive}" Width="70"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <StackPanel Grid.Column="2">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
                                <Button Content="+ Add Company" Command="{Binding AddCompanyCommand}" Style="{StaticResource ModernPrimaryButton}" Height="34" Margin="0,0,6,0"/>
                                <Button Content="Edit" Command="{Binding EditCompanyCommand}" CommandParameter="{Binding SelectedCompany}" Style="{StaticResource ModernSecondaryButton}" Height="34" Margin="0,0,6,0"/>
                                <Button Content="Delete" Command="{Binding DeleteCompanyCommand}" CommandParameter="{Binding SelectedCompany}" Style="{StaticResource ModernDangerButton}" Height="34"/>
                            </StackPanel>
                            
                            <Border CornerRadius="14" BorderBrush="{StaticResource BrushSurfaceBorder}" BorderThickness="1" Background="#F8FAFC" Padding="16" Visibility="{Binding IsCompanyFormVisible, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="Company Details" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryNavy}" Margin="0,0,0,12"/>
                                    <TextBox materialDesign:HintAssist.Hint="Company Full Name" Text="{Binding CurrentCompany.Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,10"/>
                                    <TextBox materialDesign:HintAssist.Hint="Short Code / Abbreviation" Text="{Binding CurrentCompany.ShortName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,10"/>
                                    <CheckBox Content="Active Status" IsChecked="{Binding CurrentCompany.IsActive}" Margin="0,0,0,14" FontWeight="SemiBold"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Cancel" Command="{Binding CancelCompanyCommand}" Style="{StaticResource ModernSecondaryButton}" Height="34" Margin="0,0,8,0"/>
                                        <Button Content="Save Company" Command="{Binding SaveCompanyCommand}" Style="{StaticResource ModernPrimaryButton}" Height="34"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- UNITS TAB -->
                <TabItem Header="Measurement Units">
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0" CornerRadius="12" BorderBrush="{StaticResource BrushSurfaceBorder}" BorderThickness="1" ClipToBounds="True">
                            <DataGrid ItemsSource="{Binding Units}" SelectedItem="{Binding SelectedUnit}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                      Style="{StaticResource ModernDataGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                                    <DataGridTextColumn Header="UNIT NAME" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="SYMBOL / SHORT" Binding="{Binding ShortName}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <StackPanel Grid.Column="2">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
                                <Button Content="+ Add Unit" Command="{Binding AddUnitCommand}" Style="{StaticResource ModernPrimaryButton}" Height="34" Margin="0,0,6,0"/>
                                <Button Content="Edit" Command="{Binding EditUnitCommand}" CommandParameter="{Binding SelectedUnit}" Style="{StaticResource ModernSecondaryButton}" Height="34" Margin="0,0,6,0"/>
                                <Button Content="Delete" Command="{Binding DeleteUnitCommand}" CommandParameter="{Binding SelectedUnit}" Style="{StaticResource ModernDangerButton}" Height="34"/>
                            </StackPanel>
                            <Border CornerRadius="14" BorderBrush="{StaticResource BrushSurfaceBorder}" BorderThickness="1" Background="#F8FAFC" Padding="16" Visibility="{Binding IsUnitFormVisible, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="Measurement Unit" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryNavy}" Margin="0,0,0,12"/>
                                    <TextBox materialDesign:HintAssist.Hint="Unit Name (e.g. Kilogram, Maund, Bag)" Text="{Binding CurrentUnit.Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,10"/>
                                    <TextBox materialDesign:HintAssist.Hint="Symbol (e.g. KG, MD, BG)" Text="{Binding CurrentUnit.ShortName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,14"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Cancel" Command="{Binding CancelUnitCommand}" Style="{StaticResource ModernSecondaryButton}" Height="34" Margin="0,0,8,0"/>
                                        <Button Content="Save Unit" Command="{Binding SaveUnitCommand}" Style="{StaticResource ModernPrimaryButton}" Height="34"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- TOWNS TAB -->
                <TabItem Header="Towns &amp; Cities">
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0" CornerRadius="12" BorderBrush="{StaticResource BrushSurfaceBorder}" BorderThickness="1" ClipToBounds="True">
                            <DataGrid ItemsSource="{Binding Towns}" SelectedItem="{Binding SelectedTown}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                      Style="{StaticResource ModernDataGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                                    <DataGridTextColumn Header="TOWN / CITY NAME" Binding="{Binding Name}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <StackPanel Grid.Column="2">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
                                <Button Content="+ Add Town" Command="{Binding AddTownCommand}" Style="{StaticResource ModernPrimaryButton}" Height="34" Margin="0,0,6,0"/>
                                <Button Content="Edit" Command="{Binding EditTownCommand}" CommandParameter="{Binding SelectedTown}" Style="{StaticResource ModernSecondaryButton}" Height="34" Margin="0,0,6,0"/>
                                <Button Content="Delete" Command="{Binding DeleteTownCommand}" CommandParameter="{Binding SelectedTown}" Style="{StaticResource ModernDangerButton}" Height="34"/>
                            </StackPanel>
                            <Border CornerRadius="14" BorderBrush="{StaticResource BrushSurfaceBorder}" BorderThickness="1" Background="#F8FAFC" Padding="16" Visibility="{Binding IsTownFormVisible, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="Town Details" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryNavy}" Margin="0,0,0,12"/>
                                    <TextBox materialDesign:HintAssist.Hint="Town / City Name" Text="{Binding CurrentTown.Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,14"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Cancel" Command="{Binding CancelTownCommand}" Style="{StaticResource ModernSecondaryButton}" Height="34" Margin="0,0,8,0"/>
                                        <Button Content="Save Town" Command="{Binding SaveTownCommand}" Style="{StaticResource ModernPrimaryButton}" Height="34"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- SECTORS TAB -->
                <TabItem Header="Sectors &amp; Zones">
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0" CornerRadius="12" BorderBrush="{StaticResource BrushSurfaceBorder}" BorderThickness="1" ClipToBounds="True">
                            <DataGrid ItemsSource="{Binding Sectors}" SelectedItem="{Binding SelectedSector}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                      Style="{StaticResource ModernDataGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                                    <DataGridTextColumn Header="SECTOR / ZONE NAME" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="PARENT TOWN" Binding="{Binding Town.Name}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <StackPanel Grid.Column="2">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
                                <Button Content="+ Add Sector" Command="{Binding AddSectorCommand}" Style="{StaticResource ModernPrimaryButton}" Height="34" Margin="0,0,6,0"/>
                                <Button Content="Edit" Command="{Binding EditSectorCommand}" CommandParameter="{Binding SelectedSector}" Style="{StaticResource ModernSecondaryButton}" Height="34" Margin="0,0,6,0"/>
                                <Button Content="Delete" Command="{Binding DeleteSectorCommand}" CommandParameter="{Binding SelectedSector}" Style="{StaticResource ModernDangerButton}" Height="34"/>
                            </StackPanel>
                            <Border CornerRadius="14" BorderBrush="{StaticResource BrushSurfaceBorder}" BorderThickness="1" Background="#F8FAFC" Padding="16" Visibility="{Binding IsSectorFormVisible, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="Sector Information" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryNavy}" Margin="0,0,0,12"/>
                                    <TextBox materialDesign:HintAssist.Hint="Sector Name" Text="{Binding CurrentSector.Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,10"/>
                                    <ComboBox materialDesign:HintAssist.Hint="Parent Town" ItemsSource="{Binding Towns}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding CurrentSector.TownId}" Style="{StaticResource MaterialDesignFloatingHintComboBox}" Margin="0,0,0,14"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Cancel" Command="{Binding CancelSectorCommand}" Style="{StaticResource ModernSecondaryButton}" Height="34" Margin="0,0,8,0"/>
                                        <Button Content="Save Sector" Command="{Binding SaveSectorCommand}" Style="{StaticResource ModernPrimaryButton}" Height="34"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </TabItem>

            </TabControl>
        </Grid>
    </Border>
</UserControl>
