<Window x:Class="MyMandiSystem.Views.BankStatementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Bank Statement" 
        Height="480" Width="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#EAEAEA"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Classic / ERP Styled Button -->
        <Style x:Key="ClassicReportButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Background" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="#707070"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="3" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="8,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#E0EEF8"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#0078D7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#CCE4F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <DockPanel LastChildFill="True">

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                       HEADER BANNER                        -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border DockPanel.Dock="Top" Height="78" Background="#3B7D23">
                <Grid>
                    <!-- Diagonal Overlay Texture Effect -->
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#4A9B2C" Offset="0"/>
                            <GradientStop Color="#2E681A" Offset="0.85"/>
                            <GradientStop Color="#1D4A0E" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>

                    <!-- Title Header -->
                    <StackPanel VerticalAlignment="Center" Margin="24,0,0,0">
                        <TextBlock Text="Bank Statement" FontSize="26" FontWeight="ExtraBold" Foreground="#112200" FontFamily="Georgia">
                            <TextBlock.Effect>
                                <DropShadowEffect ShadowDepth="1" BlurRadius="2" Color="#FFFFFF" Opacity="0.5"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>

                    <!-- Right Graphic Emblem -->
                    <Border HorizontalAlignment="Right" Width="100" Height="78" Margin="0,0,16,0" ClipToBounds="True">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Width="48" Height="48" CornerRadius="8" Background="#5BA832" BorderBrush="#8AD85F" BorderThickness="1.5">
                                <materialDesign:PackIcon Kind="Tractor" Width="30" Height="30" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                     BOTTOM BUTTONS BAR                     -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border DockPanel.Dock="Bottom" Background="#DCDCDC" BorderBrush="#B8B8B8" BorderThickness="0,1,0,0" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <!-- Preview Button -->
                        <Button Style="{StaticResource ClassicReportButton}" Command="{Binding PreviewCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileEyeOutline" Width="16" Height="16" Foreground="#005A9E" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Preview" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Print Button -->
                        <Button Style="{StaticResource ClassicReportButton}" Command="{Binding PrintCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Printer" Width="16" Height="16" Foreground="#333333" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Print" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Close Button -->
                        <Button Style="{StaticResource ClassicReportButton}" Command="{Binding CloseCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CloseCircle" Width="16" Height="16" Foreground="#D13438" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Close" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Urdu Print Checkbox -->
                    <CheckBox Grid.Column="1" Content="Urdu Print" IsChecked="{Binding UrduPrint}" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                      FORM CONTROLS                         -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Grid Background="#F5F5F5" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Date Row -->
                    <RowDefinition Height="Auto"/> <!-- Account Row -->
                    <RowDefinition Height="Auto"/> <!-- Checkbox Option -->
                </Grid.RowDefinitions>

                <!-- 1. From & To Dates -->
                <Grid Grid.Row="0" Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="From" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding FromDate}" Width="150" Height="28" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="To" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding ToDate}" Width="150" Height="28" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- 2. Account No & Name -->
                <Grid Grid.Row="1" Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>

                    <!-- Account No -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Account No" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding AccountNo, UpdateSourceTrigger=PropertyChanged}" Height="28" VerticalContentAlignment="Center" Padding="4" FontWeight="Bold" Foreground="#1E3A8A"/>
                    </StackPanel>

                    <!-- Lookup [...] -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="4,0,8,0">
                        <Button Style="{StaticResource ClassicReportButton}" Command="{Binding OpenAccountLookupCommand}" MinWidth="32" Height="28" ToolTip="Lookup Bank Accounts">
                            <TextBlock Text="..." FontWeight="Black" FontSize="14"/>
                        </Button>
                    </StackPanel>

                    <!-- Account Name -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Account Name" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding AccountName}" IsReadOnly="True" Background="#E8ECEF" Height="28" VerticalContentAlignment="Center" Padding="6,4" FontWeight="SemiBold" Foreground="#1F2937"/>
                    </StackPanel>
                </Grid>

                <!-- 3. Checkbox Options -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
                    <CheckBox Content="Include Journal, Debit &amp; Credit Vouchers also" IsChecked="{Binding IncludeAllVouchers}" FontWeight="SemiBold" FontSize="13.5"/>
                </StackPanel>

            </Grid>
        </DockPanel>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--                 ACCOUNT LOOKUP MODAL OVERLAY               -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Grid Background="#66000000" Visibility="{Binding IsAccountLookupOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="520" Height="420" Background="White" CornerRadius="8" BorderBrush="#707070" BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Select Bank Account" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" Foreground="#1E3A8A"/>

                    <!-- Search Box -->
                    <TextBox Grid.Row="1" Text="{Binding LookupSearchQuery, UpdateSourceTrigger=PropertyChanged}" Height="30" Padding="6,4" Margin="0,0,0,10"
                             materialDesign:HintAssist.Hint="Type account code or bank name to filter..."/>

                    <!-- Accounts List -->
                    <DataGrid Grid.Row="2" ItemsSource="{Binding FilteredAccounts}" SelectedItem="{Binding SelectedAccount}" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="28">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="A/c No." Binding="{Binding AccountNo}" Width="100"/>
                            <DataGridTextColumn Header="Bank / Account Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Balance" Binding="{Binding CurrentBalance, StringFormat=N2}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Modal Actions -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Style="{StaticResource ClassicReportButton}" Content="Select" Command="{Binding SelectAccountFromLookupCommand}" CommandParameter="{Binding SelectedAccount}" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource ClassicReportButton}" Content="Cancel" Command="{Binding CloseAccountLookupCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Window>
