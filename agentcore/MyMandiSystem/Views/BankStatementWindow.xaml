<Window x:Class="MyMandiSystem.Views.BankStatementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Bank Statement - بینک سٹیٹمنٹ" 
        Height="520" Width="680"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="#F1F5F9"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Action Button Style -->
        <Style x:Key="ModernActionButton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="12,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Button (Blue) -->
        <Style x:Key="ModernPrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernActionButton}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#1D4ED8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="14,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger/Close Button -->
        <Style x:Key="ModernDangerButton" TargetType="Button" BasedOn="{StaticResource ModernActionButton}">
            <Setter Property="Background" Value="#FFF1F2"/>
            <Setter Property="Foreground" Value="#E11D48"/>
            <Setter Property="BorderBrush" Value="#FECDD3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="12,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#FEE2E2"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#F87171"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#FCA5A5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <DockPanel LastChildFill="True">

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                       HEADER BANNER                        -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border DockPanel.Dock="Top" Height="82" Background="#0F172A">
                <Grid>
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0F172A" Offset="0"/>
                            <GradientStop Color="#1E293B" Offset="0.6"/>
                            <GradientStop Color="#1E3A8A" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>

                    <!-- Title Header -->
                    <StackPanel VerticalAlignment="Center" Margin="24,0,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="34" Height="34" CornerRadius="8" Background="#1E3A8A" Margin="0,0,10,0">
                                <materialDesign:PackIcon Kind="BankOutline" Width="22" Height="22" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Bank Statement" FontSize="21" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="بینک سٹیٹمنٹ رپورٹ (کھاتہ بینک تفصیلی)" FontSize="14" Foreground="#94A3B8" FontFamily="{StaticResource FontJameelNooriNastaleeq}" Margin="44,2,0,0"/>
                    </StackPanel>

                    <!-- Right Graphic Emblem -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,24,0">
                        <Border Width="48" Height="48" CornerRadius="12" Background="#1E293B" BorderBrush="#334155" BorderThickness="1.5">
                            <materialDesign:PackIcon Kind="Tractor" Width="28" Height="28" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Border>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                     BOTTOM BUTTONS BAR                     -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border DockPanel.Dock="Bottom" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <!-- Preview Button -->
                        <Button Style="{StaticResource ModernPrimaryButton}" Command="{Binding PreviewCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileEyeOutline" Width="16" Height="16" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Preview" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Print Button -->
                        <Button Style="{StaticResource ModernActionButton}" Command="{Binding PrintCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Printer" Width="16" Height="16" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Print" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Close Button -->
                        <Button Style="{StaticResource ModernDangerButton}" Command="{Binding CloseCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CloseCircleOutline" Width="16" Height="16" Foreground="#E11D48" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Close" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Urdu Print Checkbox -->
                    <CheckBox Grid.Column="1" IsChecked="{Binding UrduPrint}" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Urdu Print" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="(اردو پرنٹ)" FontFamily="{StaticResource FontJameelNooriNastaleeq}" FontSize="14" Foreground="#475569" VerticalAlignment="Center"/>
                        </StackPanel>
                    </CheckBox>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                      FORM CONTROLS                         -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border Background="#F8FAFC" Padding="32,24">
                <Border Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="28,24" VerticalAlignment="Center">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Date Row -->
                            <RowDefinition Height="Auto"/> <!-- Account Row -->
                            <RowDefinition Height="Auto"/> <!-- Checkbox Option -->
                        </Grid.RowDefinitions>

                        <!-- 1. From & To Dates -->
                        <Grid Grid.Row="0" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="From Date" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                                <DatePicker SelectedDate="{Binding FromDate}" Height="32" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="To Date" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                                <DatePicker SelectedDate="{Binding ToDate}" Height="32" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- 2. Account No & Name -->
                        <Grid Grid.Row="1" Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Account No -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Account No" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding AccountNo, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" Padding="8,2" FontWeight="Bold" Foreground="#1E3A8A" Background="#F8FAFC" BorderBrush="#CBD5E1"/>
                            </StackPanel>

                            <!-- Lookup [...] -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="6,0,10,0">
                                <Button Command="{Binding OpenAccountLookupCommand}" Width="36" Height="32" Background="#1E3A8A" Foreground="White" BorderThickness="0" ToolTip="Lookup Bank Accounts" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="5"/>
                                        </Style>
                                    </Button.Resources>
                                    <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18"/>
                                </Button>
                            </StackPanel>

                            <!-- Account Name -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Bank / Account Name" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding AccountName}" IsReadOnly="True" Background="#F1F5F9" BorderBrush="#E2E8F0" Height="32" VerticalContentAlignment="Center" Padding="8,4" FontWeight="SemiBold" Foreground="#0F172A"/>
                            </StackPanel>
                        </Grid>

                        <!-- 3. Checkbox Options -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,0">
                            <CheckBox Content="Include Journal, Debit &amp; Credit Vouchers also" IsChecked="{Binding IncludeAllVouchers}" FontWeight="SemiBold" FontSize="13" Foreground="#1E293B"/>
                        </StackPanel>

                    </Grid>
                </Border>
            </Border>
        </DockPanel>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--                 ACCOUNT LOOKUP MODAL OVERLAY               -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Grid Background="#800F172A" Visibility="{Binding IsAccountLookupOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="600" Height="480" Background="White" CornerRadius="12" BorderBrush="#CBD5E1" BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="6" Color="#000000" Opacity="0.25"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Modal Title Bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#EFF6FF" Width="36" Height="36" CornerRadius="8" Margin="0,0,10,0">
                                <materialDesign:PackIcon Kind="BankOutline" Width="20" Height="20" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Select Bank Account" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="بینک کھاتہ منتخب کریں" FontSize="13" Foreground="#64748B" FontFamily="{StaticResource FontJameelNooriNastaleeq}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Close X Button -->
                        <Button Grid.Column="1" Command="{Binding CloseAccountLookupCommand}" Width="28" Height="28" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Close">
                            <materialDesign:PackIcon Kind="Close" Width="18" Height="18" Foreground="#64748B"/>
                        </Button>
                    </Grid>

                    <!-- Search Box -->
                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Height="36" Margin="0,0,0,12" Padding="8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" Text="{Binding LookupSearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                     VerticalAlignment="Center" BorderThickness="0" Background="Transparent" FontSize="13"
                                     materialDesign:HintAssist.Hint="Type account code or bank name to filter..."/>
                        </Grid>
                    </Border>

                    <!-- Accounts List -->
                    <DataGrid x:Name="AccountsLookupGrid" Grid.Row="2" ItemsSource="{Binding FilteredAccounts}" SelectedItem="{Binding SelectedAccount}" 
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" 
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0"
                              Background="#FFFFFF" RowHeight="38" AlternatingRowBackground="#F8FAFC"
                              BorderBrush="#E2E8F0" BorderThickness="1" CanUserResizeRows="False"
                              FontSize="13" MouseDoubleClick="AccountsLookupGrid_MouseDoubleClick">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#334155"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="12.5"/>
                                <Setter Property="Height" Value="34"/>
                                <Setter Property="Padding" Value="10,0"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#E0F2FE"/>
                                        <Setter Property="Foreground" Value="#0F172A"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="A/c No." Binding="{Binding AccountNo}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#1E3A8A"/>
                                        <Setter Property="Padding" Value="10,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Bank / Account Name" Binding="{Binding Name}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="Normal"/>
                                        <Setter Property="Foreground" Value="#0F172A"/>
                                        <Setter Property="Padding" Value="10,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Urdu Name / نام" Binding="{Binding UrduName}" Width="160" ElementStyle="{StaticResource ModernUrduDataGridText}"/>

                            <DataGridTextColumn Header="Balance" Binding="{Binding CurrentBalance, StringFormat=N2}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#059669"/>
                                        <Setter Property="Padding" Value="10,0"/>
                                        <Setter Property="TextAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Modal Actions -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Command="{Binding SelectAccountFromLookupCommand}" CommandParameter="{Binding SelectedAccount}" 
                                Height="34" MinWidth="95" Background="#1E3A8A" Foreground="White" BorderThickness="0" Margin="0,0,10,0" FontWeight="SemiBold" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Check" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Select" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding CloseAccountLookupCommand}" 
                                Height="34" MinWidth="85" Background="#F1F5F9" Foreground="#475569" BorderBrush="#CBD5E1" BorderThickness="1" FontWeight="SemiBold" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <TextBlock Text="Cancel" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Window>
