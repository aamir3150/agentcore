<Window x:Class="MyMandiSystem.Views.SplashScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="agentcore - Starting" 
        Height="390" Width="660" 
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True">
    
    <Window.Resources>
        <Storyboard x:Key="FadeInStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:0.35"/>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource FadeInStoryboard}"/>
        </EventTrigger>
    </Window.Triggers>

    <!-- Main Container with Luxurious Ambient Shadow -->
    <Border Margin="18" CornerRadius="22" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1.5" Effect="{StaticResource EffectModalShadow}">
        <Grid ClipToBounds="True">
            
            <!-- Soft Pastel Ambient Glow Rings (Daytime Luxurious Feel) -->
            <Canvas HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False">
                <Ellipse Width="280" Height="280" Fill="#CCFBF1" Opacity="0.5" Canvas.Left="-80" Canvas.Top="-80">
                    <Ellipse.Effect>
                        <BlurEffect Radius="80"/>
                    </Ellipse.Effect>
                </Ellipse>
                <Ellipse Width="260" Height="260" Fill="#E0E7FF" Opacity="0.5" Canvas.Right="-60" Canvas.Bottom="-60">
                    <Ellipse.Effect>
                        <BlurEffect Radius="80"/>
                    </Ellipse.Effect>
                </Ellipse>
            </Canvas>

            <Grid Margin="32,28,32,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Top Brand Header -->
                    <RowDefinition Height="*"/>    <!-- Center Feature Showcase -->
                    <RowDefinition Height="Auto"/> <!-- Progress Status & Animated Track -->
                    <RowDefinition Height="Auto"/> <!-- Footer Developer Signature -->
                </Grid.RowDefinitions>

                <!-- ═══════════════════════════════════════════════════ -->
                <!--               TOP: BRAND & IDENTITY                 -->
                <!-- ═══════════════════════════════════════════════════ -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Glowing Emerald-Teal Hexagon Icon -->
                    <Border Width="60" Height="60" CornerRadius="16" Background="{StaticResource BrushGradientTeal}" VerticalAlignment="Center" Margin="0,0,16,0" Effect="{StaticResource EffectCardElevated}">
                        <materialDesign:PackIcon Kind="HexagonMultiple" Width="36" Height="36" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Brand Titles -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="AGENTCORE" FontSize="26" FontWeight="Black" Foreground="{StaticResource BrushPrimaryNavy}" FontFamily="{DynamicResource MaterialDesignFont}"/>
                            <Border Background="{StaticResource BrushAccentIndigo}" CornerRadius="5" Margin="10,3,0,3" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock Text="ERP" FontSize="11" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Commodity Trade &amp; Financial Management Enterprise" FontSize="12.5" Foreground="{StaticResource BrushTextSecondary}" FontWeight="SemiBold" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Luxury Edition Badge -->
                    <Border Grid.Column="2" VerticalAlignment="Top" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="10,5">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ShieldCheck" Width="14" Height="14" Foreground="{StaticResource BrushAccentEmeraldDark}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="v2.5 Enterprise" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushAccentEmeraldDark}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ═══════════════════════════════════════════════════ -->
                <!--            MIDDLE: FEATURE HIGHLIGHT PILLS          -->
                <!-- ═══════════════════════════════════════════════════ -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,18,0,18">
                    
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="12,7" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ScaleBalance" Width="15" Height="15" Foreground="{StaticResource BrushAccentEmeraldDark}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="General Ledgers" FontSize="11.5" Foreground="{StaticResource BrushPrimarySlate}" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="12,7" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="HandshakeOutline" Width="15" Height="15" Foreground="#B45309" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Mandi Brokerage" FontSize="11.5" Foreground="{StaticResource BrushPrimarySlate}" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="12,7" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Warehouse" Width="15" Height="15" Foreground="{StaticResource BrushAccentTealDark}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Pestro &amp; Batches" FontSize="11.5" Foreground="{StaticResource BrushPrimarySlate}" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="12,7">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ChartBoxOutline" Width="15" Height="15" Foreground="{StaticResource BrushAccentIndigoDark}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Financial Audit" FontSize="11.5" Foreground="{StaticResource BrushPrimarySlate}" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- ═══════════════════════════════════════════════════ -->
                <!--            BOTTOM: STATUS & PROGRESS BAR            -->
                <!-- ═══════════════════════════════════════════════════ -->
                <StackPanel Grid.Row="2" Margin="0,0,0,16">
                    <Grid Margin="0,0,0,8">
                        <TextBlock x:Name="TxtStatus" Text="Initializing system components..." FontSize="12.5" Foreground="{StaticResource BrushPrimaryNavy}" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtPercentage" Text="0%" FontSize="12.5" Foreground="{StaticResource BrushAccentTealDark}" FontWeight="Black" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- High-Definition Crisp Modern Progress Track -->
                    <Border Height="8" CornerRadius="4" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" ClipToBounds="True">
                        <ProgressBar x:Name="StartupProgressBar" Height="8" Minimum="0" Maximum="100" Value="15" 
                                     Foreground="{StaticResource BrushGradientTeal}" Background="Transparent" BorderThickness="0"/>
                    </Border>
                </StackPanel>

                <!-- ═══════════════════════════════════════════════════ -->
                <!--           FOOTER: DEVELOPER SIGNATURE               -->
                <!-- ═══════════════════════════════════════════════════ -->
                <Border Grid.Row="3" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="CodeTags" Width="15" Height="15" Foreground="{StaticResource BrushAccentTealDark}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Developed by " FontSize="11.5" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>
                            <TextBlock Text="City Computers Marot" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryNavy}" VerticalAlignment="Center"/>
                            <TextBlock Text="  •  " FontSize="11" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>
                            <TextBlock Text="03447436314" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource BrushAccentEmeraldDark}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border Width="7" Height="7" CornerRadius="3.5" Background="{StaticResource BrushAccentEmerald}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="SQL Server Database Engine" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </Grid>
        </Grid>
    </Border>
</Window>
