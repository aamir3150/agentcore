<Window x:Class="MyMandiSystem.Views.GatePassSaleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Gate Pass (Sale)" 
        Height="720" Width="1060"
        MinHeight="560" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        FontFamily="Segoe UI" FontSize="12">

    <Window.Resources>
        <Style x:Key="ClassicButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="85"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="10,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#64748B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimarySaveButton" TargetType="Button" BasedOn="{StaticResource ClassicButton}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#1D4ED8"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="14,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerDeleteButton" TargetType="Button" BasedOn="{StaticResource ClassicButton}">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#B91C1C"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="12,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#B91C1C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#991B1B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <DockPanel LastChildFill="True">

            <!-- ═══ 0. TOP HEADER CARD ═══ -->
            <Border DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#1E3A8A" Margin="0,0,12,0" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Gate" Width="20" Height="20" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Gate Pass (Sale)" FontSize="16" FontWeight="Bold" Foreground="#1E3A8A"/>
                        <TextBlock Text="Manage brokerage commodity gate passes and deliveries" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Date:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Bold" Foreground="#475569"/>
                        <DatePicker SelectedDate="{Binding GatePassDate}" Width="120"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ 4. BOTTOM ACTION FOOTER CARD ═══ -->
            <Border DockPanel.Dock="Bottom" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Action Buttons -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource PrimarySaveButton}" Command="{Binding SaveCommand}" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSaveOutline" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Save (Alt+S)" VerticalAlignment="Center" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource ClassicButton}" Command="{Binding ClearCommand}" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Clear (Alt+C)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource DangerDeleteButton}" Command="{Binding DeleteCommand}" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="DeleteOutline" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Delete (Alt+D)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource ClassicButton}" Click="Close_Click">
                            <TextBlock Text="Close (Esc)" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>

                    <!-- Right: Summary Totals -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,6,0">
                            <TextBlock FontSize="11" Foreground="#334155">
                                <Run Text="Total Bags: " FontWeight="Normal"/>
                                <Run Text="{Binding TotalBags}" FontWeight="Bold" Foreground="#1E3A8A"/>
                            </TextBlock>
                        </Border>
                        <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,6,0">
                            <TextBlock FontSize="11" Foreground="#047857">
                                <Run Text="Total Kgs: " FontWeight="Normal"/>
                                <Run Text="{Binding TotalKgs, StringFormat=N1}" FontWeight="Bold"/>
                            </TextBlock>
                        </Border>
                        <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="4" Padding="8,4">
                            <TextBlock FontSize="11" Foreground="#92400E">
                                <Run Text="Total Mnds: " FontWeight="Normal"/>
                                <Run Text="{Binding TotalMoundsDisplay}" FontWeight="Bold"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ MAIN BODY CONTENT ═══ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- 1. DETAILS CARD (Gate Pass Info, Party, Customer) -->
                    <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="85"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="75"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Row 0: Gate Pass ID, SGPID, Bill No, Gate Pass No -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Gate Pass ID:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding GatePassId}" IsReadOnly="True" FontWeight="Bold" Background="#F8FAFC" BorderBrush="#CBD5E1"/>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="SGP ID:" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold" Foreground="#475569"/>
                            <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding SgpId}" IsReadOnly="True" FontWeight="Bold" Background="#F8FAFC" BorderBrush="#CBD5E1"/>

                            <TextBlock Grid.Row="0" Grid.Column="4" Text="Bill No:" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold" Foreground="#475569"/>
                            <TextBox Grid.Row="0" Grid.Column="5" Text="{Binding BillNo}"/>

                            <TextBlock Grid.Row="0" Grid.Column="6" Text="Pass No:" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold" Foreground="#475569"/>
                            <TextBox Grid.Row="0" Grid.Column="7" Text="{Binding GatePassNo}"/>

                            <!-- Row 1: Vendor / Party Details -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Party ID:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PartyId, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Party Name:" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold" Foreground="#475569"/>
                            <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding PartyName}" FontWeight="Bold"/>

                            <TextBlock Grid.Row="2" Grid.Column="4" Text="Address:" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold" Foreground="#475569"/>
                            <TextBox Grid.Row="2" Grid.Column="5" Text="{Binding Address}" IsReadOnly="True" Background="#F8FAFC" BorderBrush="#CBD5E1"/>

                            <TextBlock Grid.Row="2" Grid.Column="6" Text="Phone:" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold" Foreground="#475569"/>
                            <TextBox Grid.Row="2" Grid.Column="7" Text="{Binding Phone}" IsReadOnly="True" Background="#F8FAFC" BorderBrush="#CBD5E1"/>

                            <!-- Row 2: Customer Details -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Customer ID:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding CustomerId, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="4" Grid.Column="2" Text="Cus Name:" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold" Foreground="#475569"/>
                            <TextBox Grid.Row="4" Grid.Column="3" Text="{Binding CustomerName}" FontWeight="Bold"/>

                            <TextBlock Grid.Row="4" Grid.Column="4" Text="Address:" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold" Foreground="#475569"/>
                            <TextBox Grid.Row="4" Grid.Column="5" Text="{Binding CusAddress}" IsReadOnly="True" Background="#F8FAFC" BorderBrush="#CBD5E1"/>

                            <TextBlock Grid.Row="4" Grid.Column="6" Text="Phone:" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold" Foreground="#475569"/>
                            <TextBox Grid.Row="4" Grid.Column="7" Text="{Binding CusPhone}" IsReadOnly="True" Background="#F8FAFC" BorderBrush="#CBD5E1"/>
                        </Grid>
                    </Border>

                    <!-- 2. LINE ITEM ENTRY BAR -->
                    <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="75"/>  <!-- Code -->
                                <ColumnDefinition Width="*"/>   <!-- Name -->
                                <ColumnDefinition Width="110"/> <!-- Vehicle -->
                                <ColumnDefinition Width="75"/>  <!-- Bags -->
                                <ColumnDefinition Width="65"/>  <!-- PQty -->
                                <ColumnDefinition Width="80"/>  <!-- Wt/Bag -->
                                <ColumnDefinition Width="90"/>  <!-- Total Kgs -->
                                <ColumnDefinition Width="85"/>  <!-- Rate/Mnd -->
                                <ColumnDefinition Width="Auto"/> <!-- Button -->
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Item Code" FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding CurrentProductId, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                <TextBlock Text="Product Name" FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding CurrentProductName}" FontWeight="SemiBold"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,6,0">
                                <TextBlock Text="Vehicle No." FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding CurrentVehicleNo}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Margin="0,0,6,0">
                                <TextBlock Text="Bags Qty" FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding CurrentBagsQty, UpdateSourceTrigger=PropertyChanged}" FontWeight="Bold"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4" Margin="0,0,6,0">
                                <TextBlock Text="P.Qty" FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding CurrentPQty}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="5" Margin="0,0,6,0">
                                <TextBlock Text="Wt/Bag (Kg)" FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding CurrentWeightPerBag, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="6" Margin="0,0,6,0">
                                <TextBlock Text="Total Kgs" FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding CurrentTotalKgs}" FontWeight="Bold" Background="#FEF3C7" BorderBrush="#FDE68A" Foreground="#92400E"/>
                            </StackPanel>

                            <StackPanel Grid.Column="7" Margin="0,0,6,0">
                                <TextBlock Text="Rate/Mnd" FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding CurrentRatePerMound}"/>
                            </StackPanel>

                            <Button Grid.Column="8" Style="{StaticResource PrimarySaveButton}" Command="{Binding AddItemCommand}" VerticalAlignment="Bottom" Height="26" MinWidth="75">
                                <TextBlock Text="Add (F2)" FontWeight="Bold"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- 3. GRID TABLE -->
                    <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Margin="0,0,0,8">
                        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                  Background="White" BorderThickness="0"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                                  RowHeight="26" FontSize="11.5" HeadersVisibility="Column" MinHeight="190">

                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#1E293B"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Height" Value="28"/>
                                    <Setter Property="Padding" Value="8,0"/>
                                    <Setter Property="BorderBrush" Value="#334155"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="S#" Binding="{Binding SerialNo}" Width="45" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Item Code" Binding="{Binding ProductId}" Width="85"/>
                                <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="*"/>
                                <DataGridTextColumn Header="Vehicle No." Binding="{Binding VehicleNo}" Width="110"/>
                                <DataGridTextColumn Header="Bags Qty" Binding="{Binding BagsQty}" Width="80"/>
                                <DataGridTextColumn Header="P.Qty" Binding="{Binding PQty}" Width="65"/>
                                <DataGridTextColumn Header="Wt/Bag" Binding="{Binding WeightPerBag, StringFormat=N1}" Width="75"/>
                                <DataGridTextColumn Header="Total Kgs" Binding="{Binding TotalKgs, StringFormat=N1}" Width="95"/>
                                <DataGridTextColumn Header="Rate/Mnd" Binding="{Binding RatePerMound, StringFormat=N2}" Width="85"/>
                                <DataGridTextColumn Header="In Mounds" Binding="{Binding InMounds}" Width="95" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- 4. NARRATION CARD -->
                    <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="75"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Narration:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569"/>
                            <TextBox Grid.Column="1" Text="{Binding Narration}" Height="26"/>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
