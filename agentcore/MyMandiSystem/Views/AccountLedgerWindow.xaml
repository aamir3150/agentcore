<Window x:Class="MyMandiSystem.Views.AccountLedgerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Account Ledger" 
        Height="490" Width="660"
        MinHeight="460" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        FontFamily="Segoe UI" FontSize="13"
        ResizeMode="CanMinimize">

    <Window.InputBindings>
        <KeyBinding Key="F1" Command="{Binding OpenAccountLookupCommand}"/>
        <KeyBinding Key="F4" Command="{Binding PreviewCommand}"/>
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding PrintCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Action Button Style -->
        <Style x:Key="ModernActionButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="14,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Button (Blue) -->
        <Style x:Key="ModernPrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernActionButton}">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#0369A1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="16,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#0369A1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#075985"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger/Close Button -->
        <Style x:Key="ModernDangerButton" TargetType="Button" BasedOn="{StaticResource ModernActionButton}">
            <Setter Property="Background" Value="#FFF1F2"/>
            <Setter Property="Foreground" Value="#E11D48"/>
            <Setter Property="BorderBrush" Value="#FECDD3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="14,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#FEE2E2"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#F87171"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#FCA5A5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <DockPanel LastChildFill="True">

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                       HEADER BANNER                        -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border DockPanel.Dock="Top" Height="62" Background="#0F172A">
                <Grid Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Title Header -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="36" Height="36" CornerRadius="8" Background="#1E293B" Margin="0,0,12,0">
                            <materialDesign:PackIcon Kind="BookAccountOutline" Width="20" Height="20" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Account Ledger" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="Account Statement &amp; General Ledger Report" FontSize="11" Foreground="#94A3B8"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Current Balance Badge (Right) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#1E293B" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="6" Padding="12,5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="A/C Balance: " FontSize="12" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding CurrentBalance, StringFormat='Rs. {0:N2}'}" FontSize="12" FontWeight="Bold" Foreground="#38BDF8"/>
                                <TextBlock Text="{Binding CurrentBalanceStatus}" FontSize="12" FontWeight="Bold" Foreground="#F59E0B" Margin="4,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                     BOTTOM BUTTONS BAR                     -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border DockPanel.Dock="Bottom" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Press F4 or Enter for Preview | Esc to Close" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center"/>

                    <!-- Action Buttons matching AgenSoft: CmdPreview, CmdPrint, CmdClose -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Preview (F4) -->
                        <Button Style="{StaticResource ModernPrimaryButton}" Command="{Binding PreviewCommand}" ToolTip="View formatted report statement (F4 / Enter)">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileEyeOutline" Width="16" Height="16" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Preview (F4)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Print (Ctrl+P) -->
                        <Button Style="{StaticResource ModernActionButton}" Command="{Binding PrintCommand}" ToolTip="Print report directly (Ctrl+P)">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Printer" Width="16" Height="16" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Print" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Close (Esc) -->
                        <Button Style="{StaticResource ModernDangerButton}" Command="{Binding CloseCommand}" ToolTip="Close window (Esc)">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CloseCircleOutline" Width="16" Height="16" Foreground="#E11D48" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Close" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                  MAIN CONTENT (AGENSOFT PARITY)            -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="18,14,18,14">

                    <!-- 1. AgenSoft GrpCropSeason / Frame1 -->
                    <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <!-- Crop Season Dropdown Row -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Crop Season:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding CropSeasons}" SelectedItem="{Binding SelectedCropSeason}" Height="32" Padding="8,4" Background="#F8FAFC"/>
                            </Grid>

                            <!-- Checkboxes Row: ChkWithoutOpening, ChkUrdu, ChkNewID -->
                            <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <CheckBox Content="Without Opening" IsChecked="{Binding WithoutOpening}" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,18,0"/>
                                <CheckBox Content="Urdu Print" IsChecked="{Binding IsUrduPrint}" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,18,0"/>
                                <CheckBox Content="Brokerage Invoice Seperate IDs" IsChecked="{Binding SeparateBrokerageInvoiceIds}" FontWeight="SemiBold" Foreground="#334155"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- 2. Account Selection Box (TxtAccountNo, BtnSearch, TxtaccountName) -->
                    <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Account Selection" FontSize="12.5" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,8"/>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Label: A/c #: -->
                                <TextBlock Grid.Column="0" Text="A/c #:" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center"/>

                                <!-- TxtAccountNo -->
                                <TextBox Grid.Column="1" Text="{Binding AccountNo, UpdateSourceTrigger=PropertyChanged}" 
                                         Height="32" VerticalContentAlignment="Center" Padding="8,2" FontWeight="Bold" Foreground="#0F172A" Background="#F8FAFC" BorderBrush="#94A3B8"/>

                                <!-- BtnSearch [...] -->
                                <Button Grid.Column="2" Command="{Binding OpenAccountLookupCommand}" Width="36" Height="32" Margin="6,0,10,0" 
                                        Background="#0F172A" Foreground="White" BorderThickness="0" ToolTip="Select Account (F1)" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="5"/>
                                        </Style>
                                    </Button.Resources>
                                    <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18"/>
                                </Button>

                                <!-- TxtaccountName (Read-only Account Title) -->
                                <TextBox Grid.Column="3" Text="{Binding AccountName}" IsReadOnly="True" Background="#F1F5F9" BorderBrush="#CBD5E1" Height="32" VerticalContentAlignment="Center" Padding="8,4" FontWeight="SemiBold" Foreground="#0F172A"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 3. Date Options Box (FrmDateRange: OptAllDates, OptDateRange, OptSingleDate, DtpFrom, DtpTo, DtpSingleDate) -->
                    <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Date Range Options" FontSize="12.5" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,8"/>

                            <!-- Radio Buttons Row -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                                <RadioButton Content="All Dates" IsChecked="{Binding IsAllDates}" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,24,0"/>
                                <RadioButton Content="Date Range" IsChecked="{Binding IsDateRange}" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,24,0"/>
                                <RadioButton Content="Single Date" IsChecked="{Binding IsSingleDate}" FontWeight="SemiBold" Foreground="#1E293B"/>
                            </StackPanel>

                            <!-- Date Pickers Row -->
                            <Grid Grid.Row="2">
                                <!-- Date Range Pickers (Active when IsDateRange is selected) -->
                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsDateRange, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="From:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,6,0"/>
                                    <DatePicker SelectedDate="{Binding FromDate}" Width="140" Height="30" VerticalAlignment="Center" Background="#F8FAFC"/>
                                    <TextBlock Text="To:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569" Margin="16,0,6,0"/>
                                    <DatePicker SelectedDate="{Binding ToDate}" Width="140" Height="30" VerticalAlignment="Center" Background="#F8FAFC"/>
                                </StackPanel>

                                <!-- Single Date Picker (Active when IsSingleDate is selected) -->
                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsSingleDate, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="Date:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,6,0"/>
                                    <DatePicker SelectedDate="{Binding SingleDate}" Width="150" Height="30" VerticalAlignment="Center" Background="#F8FAFC"/>
                                </StackPanel>

                                <!-- All Dates Label (Active when IsAllDates is selected) -->
                                <TextBlock Text="Report will include all historic transactions of the selected account." 
                                           FontStyle="Italic" Foreground="#64748B" VerticalAlignment="Center"
                                           Visibility="{Binding IsAllDates, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </Grid>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--                 ACCOUNT LOOKUP MODAL OVERLAY               -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Grid Background="#800F172A" Visibility="{Binding IsAccountLookupOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="560" Height="420" Background="White" CornerRadius="12" BorderBrush="#CBD5E1" BorderThickness="1" 
                    VerticalAlignment="Center" HorizontalAlignment="Center" Padding="18">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="6" Color="#000000" Opacity="0.25"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Modal Title Bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#EFF6FF" Width="34" Height="34" CornerRadius="8" Margin="0,0,10,0">
                                <materialDesign:PackIcon Kind="AccountSearchOutline" Width="18" Height="18" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Select Account" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Search by A/c number or title" FontSize="11.5" Foreground="#64748B"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Close Button -->
                        <Button Grid.Column="1" Command="{Binding CloseAccountLookupCommand}" Width="28" Height="28" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Close">
                            <materialDesign:PackIcon Kind="Close" Width="18" Height="18" Foreground="#64748B"/>
                        </Button>
                    </Grid>

                    <!-- Search Box -->
                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Height="36" Margin="0,0,0,10" Padding="8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="Type account number or name to search..." 
                                       Foreground="#94A3B8" FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=AccountLookupSearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox x:Name="AccountLookupSearchBox" Grid.Column="1" Text="{Binding LookupSearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                     VerticalAlignment="Center" BorderThickness="0" Background="Transparent" FontSize="13"/>
                        </Grid>
                    </Border>

                    <!-- Accounts List DataGrid -->
                    <DataGrid x:Name="AccountsLookupGrid" Grid.Row="2" ItemsSource="{Binding FilteredAccounts}" SelectedItem="{Binding SelectedAccount}" 
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" 
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0"
                              Background="#FFFFFF" RowHeight="34" AlternatingRowBackground="#F8FAFC"
                              BorderBrush="#E2E8F0" BorderThickness="1" CanUserResizeRows="False"
                              FontSize="13" MouseDoubleClick="AccountsLookupGrid_MouseDoubleClick">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#334155"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Height" Value="32"/>
                                <Setter Property="Padding" Value="10,0"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#E0F2FE"/>
                                        <Setter Property="Foreground" Value="#0F172A"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <!-- A/c No. Column -->
                            <DataGridTextColumn Header="A/c No." Binding="{Binding AccountNo}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#1E3A8A"/>
                                        <Setter Property="Padding" Value="10,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Account Name Column -->
                            <DataGridTextColumn Header="Account Name" Binding="{Binding Name}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="Normal"/>
                                        <Setter Property="Foreground" Value="#0F172A"/>
                                        <Setter Property="Padding" Value="10,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Modal Actions -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Command="{Binding SelectAccountFromLookupCommand}" CommandParameter="{Binding SelectedAccount}" 
                                Height="32" MinWidth="90" Background="#0F172A" Foreground="White" BorderThickness="0" Margin="0,0,10,0" FontWeight="SemiBold" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <TextBlock Text="Select"/>
                        </Button>
                        <Button Command="{Binding CloseAccountLookupCommand}" 
                                Height="32" MinWidth="80" Background="#F1F5F9" Foreground="#475569" BorderBrush="#CBD5E1" BorderThickness="1" FontWeight="SemiBold" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <TextBlock Text="Cancel"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
