<Window x:Class="MyMandiSystem.Views.TrialBalanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Trial Balance" 
        Height="540" Width="680"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#EAEAEA"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <!-- Classic / ERP Styled Button -->
        <Style x:Key="ClassicReportButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Background" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="#707070"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="3" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="8,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#E0EEF8"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#0078D7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#CCE4F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <DockPanel LastChildFill="True">

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                       HEADER BANNER                        -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border DockPanel.Dock="Top" Height="82" Background="#0F172A">
                <Grid>
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0F172A" Offset="0"/>
                            <GradientStop Color="#1E293B" Offset="0.6"/>
                            <GradientStop Color="#1E3A8A" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>

                    <!-- Title Header -->
                    <StackPanel VerticalAlignment="Center" Margin="24,0,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="34" Height="34" CornerRadius="8" Background="#1E3A8A" Margin="0,0,10,0">
                                <materialDesign:PackIcon Kind="ScaleBalance" Width="22" Height="22" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Trial Balance" FontSize="21" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="میزان کھاتہ جات (ٹرائل بیلنس فنانشل رپورٹ)" FontSize="14" Foreground="#94A3B8" FontFamily="{StaticResource FontJameelNooriNastaleeq}" Margin="44,2,0,0"/>
                    </StackPanel>

                    <!-- Right Graphic Emblem -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,24,0">
                        <Border Width="48" Height="48" CornerRadius="12" Background="#1E293B" BorderBrush="#334155" BorderThickness="1.5">
                            <materialDesign:PackIcon Kind="Tractor" Width="28" Height="28" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Border>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                     BOTTOM BUTTONS BAR                     -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border DockPanel.Dock="Bottom" Background="#DCDCDC" BorderBrush="#B8B8B8" BorderThickness="0,1,0,0" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <!-- Preview Button -->
                        <Button Style="{StaticResource ClassicReportButton}" Command="{Binding PreviewCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileEyeOutline" Width="16" Height="16" Foreground="#005A9E" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Preview" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Print Button -->
                        <Button Style="{StaticResource ClassicReportButton}" Command="{Binding PrintCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Printer" Width="16" Height="16" Foreground="#333333" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Print" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Close Button -->
                        <Button Style="{StaticResource ClassicReportButton}" Command="{Binding CloseCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CloseCircle" Width="16" Height="16" Foreground="#D13438" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Close" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Urdu Print Checkbox -->
                    <CheckBox Grid.Column="1" Content="Urdu Print" IsChecked="{Binding UrduPrint}" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                      FORM CONTROLS                         -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Grid Background="#F5F5F5" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Date Radios -->
                    <RowDefinition Height="Auto"/> <!-- Account Scope & Amount -->
                    <RowDefinition Height="Auto"/> <!-- Exclude Zero & Transaction Only -->
                    <RowDefinition Height="Auto"/> <!-- Parties Scope & Sorting -->
                    <RowDefinition Height="Auto"/> <!-- Extended Checkbox -->
                </Grid.RowDefinitions>

                <!-- 1. Date Radios -->
                <StackPanel Grid.Row="0" Margin="0,0,0,12" Width="480">
                    <RadioButton Content="All Dates" IsChecked="{Binding IsAllDates}" Margin="0,0,0,6" FontWeight="SemiBold"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <RadioButton Content="Single Date" IsChecked="{Binding IsSingleDate}" FontWeight="SemiBold" Width="120" VerticalAlignment="Center"/>
                        <DatePicker SelectedDate="{Binding SingleDate}" IsEnabled="{Binding IsSingleDate}" Width="150" Height="26" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Date Range" IsChecked="{Binding IsDateRange}" FontWeight="SemiBold" Width="120" VerticalAlignment="Center"/>
                        <DatePicker SelectedDate="{Binding FromDate}" IsEnabled="{Binding IsDateRange}" Width="110" Height="26" VerticalContentAlignment="Center"/>
                        <TextBlock Text="To" VerticalAlignment="Center" Margin="6,0,6,0" IsEnabled="{Binding IsDateRange}"/>
                        <DatePicker SelectedDate="{Binding ToDate}" IsEnabled="{Binding IsDateRange}" Width="110" Height="26" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- 2. Account Scope (Left) & Amount Greater Than (Right) -->
                <Grid Grid.Row="1" Margin="0,0,0,8" Width="480">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Account Scope Box -->
                    <Border Grid.Column="0" BorderBrush="#A0A0A0" BorderThickness="1" Background="White" Padding="10,6">
                        <StackPanel>
                            <RadioButton Content="Show Only Transaction Accounts" IsChecked="{Binding ShowOnlyTransactionAccounts}" Margin="0,2" FontWeight="SemiBold"/>
                            <RadioButton Content="Show Only Accounts Group" IsChecked="{Binding ShowOnlyAccountsGroup}" Margin="0,2" FontWeight="SemiBold"/>
                            <RadioButton Content="Show Both Accounts" IsChecked="{Binding ShowBothAccounts}" Margin="0,2" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <!-- Amount Greater Than -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Amount Greator Then" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding AmountGreaterThan, UpdateSourceTrigger=PropertyChanged}" Height="28" VerticalContentAlignment="Center" Padding="4" FontWeight="Bold" Foreground="#1E3A8A"/>
                    </StackPanel>
                </Grid>

                <!-- 3. Exclude Zero Balance (Left) & Show Transaction Account Only (Right) -->
                <Grid Grid.Row="2" Margin="0,0,0,8" Width="480">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0" Content="Exclude Accounts Having Zero Balance." IsChecked="{Binding ExcludeZeroBalance}" FontWeight="SemiBold"/>
                    <CheckBox Grid.Column="2" Content="Show Transaction Account Only" IsChecked="{Binding ShowTransactionAccountOnly}" FontWeight="SemiBold"/>
                </Grid>

                <!-- 4. Parties Scope (Left) & Sorting (Right) -->
                <Grid Grid.Row="3" Margin="0,0,0,6" Width="480">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Parties Scope Box -->
                    <Border Grid.Column="0" BorderBrush="#A0A0A0" BorderThickness="1" Background="White" Padding="10,6">
                        <StackPanel>
                            <RadioButton Content="Exclude Parties" IsChecked="{Binding ExcludeParties}" Margin="0,2" FontWeight="SemiBold"/>
                            <RadioButton Content="Include Parties" IsChecked="{Binding IncludeParties}" Margin="0,2" FontWeight="SemiBold"/>
                            <RadioButton Content="Only Parties" IsChecked="{Binding OnlyParties}" Margin="0,2" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <!-- Sorting Box -->
                    <Border Grid.Column="2" BorderBrush="#A0A0A0" BorderThickness="1" Background="White" Padding="10,6" VerticalAlignment="Top">
                        <StackPanel>
                            <RadioButton Content="Sort By Account Name" IsChecked="{Binding SortByAccountName}" Margin="0,3" FontWeight="SemiBold"/>
                            <RadioButton Content="Sort By Account ID" IsChecked="{Binding SortByAccountId}" Margin="0,3" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 5. Extended Checkbox -->
                <StackPanel Grid.Row="4" Margin="0,0,0,4" Width="480">
                    <CheckBox Content="Extended" IsChecked="{Binding IsExtended}" FontWeight="SemiBold"/>
                </StackPanel>

            </Grid>
        </DockPanel>
    </Grid>
</Window>
