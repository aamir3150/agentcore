<Window x:Class="MyMandiSystem.Views.BankChequesReconciliationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Bank Cheques Reconciliation" 
        Height="720" Width="1120"
        MinHeight="550" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        FontFamily="Segoe UI" FontSize="12">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="ClassicButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="85"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="10,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#BFDBFE"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <DockPanel LastChildFill="True">

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                     TOP HEADER TITLE BAR                   -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#1E3A8A" Margin="0,0,12,0" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="BankCheck" Width="22" Height="22" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Bank Cheques Reconciliation" FontSize="16" FontWeight="Bold" Foreground="#1E3A8A"/>
                        <TextBlock Text="Bank cheque clearance and ledger reconciliation management" FontSize="11" Foreground="#64748B"/>
                    </StackPanel>

                    <!-- Shortcut Legend -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="3,0">
                            <TextBlock Text="F2: Save" FontSize="11" FontWeight="SemiBold" Foreground="#2563EB"/>
                        </Border>
                        <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="3,0">
                            <TextBlock Text="F3: Clear" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                        </Border>
                        <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="3,0">
                            <TextBlock Text="F5: Load" FontSize="11" FontWeight="SemiBold" Foreground="#15803D"/>
                        </Border>
                        <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="3,0">
                            <TextBlock Text="Esc: Close" FontSize="11" FontWeight="SemiBold" Foreground="#DC2626"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                 FILTERS & BALANCES PARAMETERS CARD         -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Bank A/C No. -->
                    <TextBlock Grid.Column="0" Text="Bank A/C No:" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding BankAccounts}"
                              SelectedItem="{Binding SelectedBankAccount}"
                              DisplayMemberPath="Account.AccountNo"
                              SelectedValuePath="Account.AccountNo"
                              IsEditable="True"
                              Text="{Binding BankAccountNo, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- Bank Account Name -->
                    <TextBlock Grid.Column="2" Text="Bank Name:" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" Margin="12,0,6,0"/>
                    <TextBox Grid.Column="3" Text="{Binding BankAccountName, Mode=OneWay}"
                             IsReadOnly="True" FontWeight="Bold" Foreground="#1E3A8A" Background="#F8FAFC"/>

                    <!-- Filter Mode -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,10,0">
                        <TextBlock Text="Mode:" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <RadioButton Content="Un-Reconciled" IsChecked="{Binding IsUnReconciledFilter}" GroupName="ReconFilter" Margin="0,0,8,0" FontWeight="SemiBold" Foreground="#B45309" VerticalAlignment="Center"/>
                        <RadioButton Content="Reconciled" IsChecked="{Binding IsReconciledFilter}" GroupName="ReconFilter" Margin="0,0,8,0" FontWeight="SemiBold" Foreground="#15803D" VerticalAlignment="Center"/>
                        <RadioButton Content="All" IsChecked="{Binding IsAllFilter}" GroupName="ReconFilter" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Balances Pills -->
                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0">
                        <!-- Reconciled Balance -->
                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Reconciled: " FontSize="10.5" FontWeight="SemiBold" Foreground="#1E3A8A"/>
                                <TextBlock Text="{Binding ReconciledBalance, StringFormat='Rs. {0:N0}'}" FontSize="11.5" FontWeight="Bold" Foreground="#2563EB"/>
                            </StackPanel>
                        </Border>

                        <!-- Un-Reconciled Balance -->
                        <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="4" Padding="8,2">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Un-Reconciled: " FontSize="10.5" FontWeight="SemiBold" Foreground="#92400E"/>
                                <TextBlock Text="{Binding UnReconciledBalance, StringFormat='Rs. {0:N0}'}" FontSize="11.5" FontWeight="Bold" Foreground="#B45309"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Load Button -->
                    <Button Grid.Column="6" Style="{StaticResource ClassicButton}" Command="{Binding LoadChequesCommand}"
                            Background="#2563EB" Foreground="#FFFFFF" BorderBrush="#1D4ED8">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Load (F5)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                   BOTTOM TOOLBAR BAR                       -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border DockPanel.Dock="Bottom" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,6,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Status Message -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="70" Height="4" Margin="0,0,8,0" 
                                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#475569" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Save (F2) -->
                        <Button Style="{StaticResource ClassicButton}" Command="{Binding SaveReconciliationCommand}"
                                Background="#2563EB" Foreground="#FFFFFF" BorderBrush="#1D4ED8">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSaveOutline" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Save (F2)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Clear (F3) -->
                        <Button Style="{StaticResource ClassicButton}" Command="{Binding ClearCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Broom" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Clear (F3)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Close (Esc) -->
                        <Button Style="{StaticResource ClassicButton}" Command="{Binding CloseCommand}">
                            <TextBlock Text="Close (Esc)"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--            MAIN CONTENT: RECONCILIATION DATAGRID           -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Batch bar -->
                        <RowDefinition Height="*"/>    <!-- DataGrid -->
                    </Grid.RowDefinitions>

                    <!-- Batch Operations Bar -->
                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="10,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/> <!-- Select all -->
                                <ColumnDefinition Width="Auto"/> <!-- Batch Date -->
                                <ColumnDefinition Width="Auto"/> <!-- Set Date Button -->
                                <ColumnDefinition Width="Auto"/> <!-- Clear Date Button -->
                                <ColumnDefinition Width="*"/>    <!-- Counter -->
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelectAll}" Content="Select / Deselect All" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" Margin="0,0,16,0"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="Reconcile Date:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#475569"/>
                                <DatePicker SelectedDate="{Binding BatchReconcileDate}" Width="115"/>
                            </StackPanel>

                            <Button Grid.Column="2" Style="{StaticResource ClassicButton}" Command="{Binding ApplyBatchDateToSelectedCommand}" MinWidth="95" Margin="4,0" Content="Set for Selected"/>

                            <Button Grid.Column="3" Style="{StaticResource ClassicButton}" Command="{Binding ClearSelectedReconcileDateCommand}" MinWidth="95" Margin="4,0" Content="Clear Selected"/>

                            <TextBlock Grid.Column="4" Text="{Binding SelectedChequesCount, StringFormat='{}{0} cheque(s) selected'}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#64748B" FontSize="11.5" FontWeight="SemiBold"/>
                        </Grid>
                    </Border>

                    <!-- RECONCILIATION DATAGRID -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Cheques}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E2E8F0"
                              HeadersVisibility="Column"
                              RowHeight="26">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Height" Value="28"/>
                                <Setter Property="Padding" Value="8,0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <!-- Select Checkbox -->
                            <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="55">
                                <DataGridCheckBoxColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="Select" FontWeight="Bold"/>
                                    </DataTemplate>
                                </DataGridCheckBoxColumn.HeaderTemplate>
                            </DataGridCheckBoxColumn>

                            <!-- Voucher No -->
                            <DataGridTextColumn Header="Voucher #" Binding="{Binding VoucherNo}" Width="90" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Voucher Date -->
                            <DataGridTextColumn Header="Date" Binding="{Binding VoucherDateFormatted}" Width="95" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Cheque No -->
                            <DataGridTemplateColumn Header="Cheque #" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ChequeNo}" FontWeight="Bold" Foreground="#1E3A8A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Cheque Date -->
                            <DataGridTextColumn Header="Cheque Date" Binding="{Binding ChequeDateFormatted}" Width="95" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Account Name / Payee -->
                            <DataGridTextColumn Header="Payee / Account Name" Binding="{Binding AccountName}" Width="200" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#1E3A8A"/>
                                        <Setter Property="Padding" Value="6,0,0,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Amount -->
                            <DataGridTemplateColumn Header="Amount (PKR)" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Amount, StringFormat='{}{0:N0}'}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Status Badge -->
                            <DataGridTemplateColumn Header="Status" Width="95">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="6,1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#FEF3C7"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsReconciled}" Value="True">
                                                            <Setter Property="Background" Value="#DCFCE7"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusBadge}" FontSize="11" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#B45309"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsReconciled}" Value="True">
                                                                <Setter Property="Foreground" Value="#15803D"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Reconcile Date (Editable DatePicker) -->
                            <DataGridTemplateColumn Header="Reconcile Date" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <DatePicker SelectedDate="{Binding ReconcileDate, UpdateSourceTrigger=PropertyChanged}" Height="22" FontSize="11" Margin="2"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Narration -->
                            <DataGridTextColumn Header="Narration" Binding="{Binding Narration}" Width="*" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="6,0,0,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

        </DockPanel>
    </Grid>
</Window>
