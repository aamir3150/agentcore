<Window x:Class="MyMandiSystem.Views.ChequeDepositWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MyMandiSystem.Views"
        Title="Bank Cheque Deposit"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="#F1F5F9"
        MinWidth="820"
        MinHeight="590">
    <Window.Style>
        <Style TargetType="Window">
            <Setter Property="Width" Value="860" />
            <Setter Property="Height" Value="615" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMultiGridVisible}" Value="True">
                    <Setter Property="Width" Value="1220" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Style>
    <views:ChequeDepositView />
</Window>
