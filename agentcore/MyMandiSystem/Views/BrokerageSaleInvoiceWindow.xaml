<Window x:Class="MyMandiSystem.Views.BrokerageSaleInvoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:MyMandiSystem.Helpers"
        mc:Ignorable="d"
        Title="Brokerage Sale Invoice" 
        Height="680" Width="1040"
        MinHeight="500" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#EAEAEA"
        FontFamily="Segoe UI" FontSize="11.5">

    <Window.Resources>
        <!-- Classic Button Style -->
        <Style x:Key="ClassicButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Background" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="#707070"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="3" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="6,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#E0EEF8"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#0078D7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#CCE4F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Standard Input Style -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="23"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="3,1"/>
            <Setter Property="BorderBrush" Value="#7A7A7A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
        </Style>

        <!-- Standard ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="23"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="BorderBrush" Value="#7A7A7A"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10,6">
        <DockPanel LastChildFill="True">

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                       TOP HEADER                           -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <!-- Centered Title -->
                <TextBlock Text="Brokerage Sale Invoice" FontSize="26" FontWeight="ExtraBold" FontFamily="Georgia" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#111111"/>

                <!-- Right Crop Season -->
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Width="200">
                    <TextBlock Text="Crop Season" Margin="0,0,0,2"/>
                    <ComboBox ItemsSource="{Binding CropSeasons}" SelectedItem="{Binding SelectedCropSeason}" Height="24"/>
                </StackPanel>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                     BOTTOM BUTTONS BAR                     -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border DockPanel.Dock="Bottom" Background="#DCDCDC" BorderBrush="#B8B8B8" BorderThickness="0,1,0,0" Padding="8,8" Margin="0,6,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource ClassicButton}" Command="{Binding SaveCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSaveOutline" Width="15" Height="15" Foreground="#005A9E" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Save" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource ClassicButton}" Command="{Binding ClearCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh" Width="15" Height="15" Foreground="#005A9E" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Clear" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource ClassicButton}" Command="{Binding PrintCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Printer" Width="15" Height="15" Foreground="#333333" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Print" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource ClassicButton}" Command="{Binding OpenCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FolderOpenOutline" Width="15" Height="15" Foreground="#005A9E" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Open" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource ClassicButton}" Command="{Binding RemoveCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TrashCanOutline" Width="15" Height="15" Foreground="#107C41" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Remove" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource ClassicButton}" Command="{Binding CloseCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CloseCircle" Width="15" Height="15" Foreground="#D13438" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Close" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Send SMS Checkbox -->
                    <CheckBox Grid.Column="1" Content="Send SMS" IsChecked="{Binding SendSMS}" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                   MAIN INVOICE CONTAINER                   -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- 1. HEADER DETAILS FORM BOX -->
                    <Border BorderBrush="#A0A0A0" BorderThickness="1" Background="#ECECEC" Padding="8,6" Margin="0,0,0,6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 1: Sale IDs, Contract ID, Party ID, Date, Bill No. -->
                            <Grid Grid.Row="0" Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Sale ID"/>
                                    <TextBox Text="{Binding SaleId1}" FontWeight="Bold"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Sale ID"/>
                                    <TextBox Text="{Binding SaleId2}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Contract ID"/>
                                    <TextBox Text="{Binding ContractId}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="Party ID"/>
                                    <TextBox Text="{Binding PartyId}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="8">
                                    <TextBlock Text="Date"/>
                                    <DatePicker SelectedDate="{Binding InvoiceDate}" Height="23"/>
                                </StackPanel>

                                <StackPanel Grid.Column="10">
                                    <TextBlock Text="Bill No."/>
                                    <TextBox Text="{Binding BillNo}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Row 2: Party Name, Sector, Refree ID, Refree Name, Gate Pass No. -->
                            <Grid Grid.Row="1" Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Party Name"/>
                                    <TextBox Text="{Binding PartyName}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Sector"/>
                                    <TextBox Text="{Binding Sector}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Refree ID"/>
                                    <TextBox Text="{Binding RefreeId}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="Refree Name"/>
                                    <TextBox Text="{Binding RefreeName}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="8">
                                    <TextBlock Text="Gate Pass No."/>
                                    <TextBox Text="{Binding GatePassNo}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Row 3: Vehicle No., Town, Address, Phone, Mounds -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="240"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Vehicle No."/>
                                    <TextBox Text="{Binding VehicleNo}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Town"/>
                                    <TextBox Text="{Binding Town}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Address"/>
                                    <TextBox Text="{Binding Address}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="Phone"/>
                                    <TextBox Text="{Binding Phone}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="8">
                                    <TextBlock Text="Mounds"/>
                                    <TextBox Text="{Binding Mounds}" FontWeight="Bold" HorizontalContentAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 2. PRODUCT LINE ITEMS ENTRY & GRID -->
                    <Border BorderBrush="#A0A0A0" BorderThickness="1" Background="#ECECEC" Padding="6" Margin="0,0,0,6">
                        <StackPanel>
                            <!-- Upper Options: Load From Purchase, Checkboxes -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                                <Button Command="{Binding LoadFromPurchaseCommand}" Style="{StaticResource ClassicButton}" Height="23" Margin="0,0,16,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="DownloadOutline" Width="14" Height="14" Foreground="#005A9E" Margin="0,0,4,0"/>
                                        <TextBlock Text="Load From Purchase" FontSize="10.5"/>
                                    </StackPanel>
                                </Button>
                                <CheckBox Content="With Shortage" IsChecked="{Binding WithShortage}" Margin="0,0,24,0"/>
                                <CheckBox Content="Contract With Delivery" IsChecked="{Binding ContractWithDelivery}"/>
                            </StackPanel>

                            <!-- Single Row Input Fields -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="65"/>  <!-- Product ID -->
                                    <ColumnDefinition Width="120"/> <!-- Product Name -->
                                    <ColumnDefinition Width="40"/>  <!-- T.Qty -->
                                    <ColumnDefinition Width="40"/>  <!-- B.Qty -->
                                    <ColumnDefinition Width="40"/>  <!-- P.Qty -->
                                    <ColumnDefinition Width="46"/>  <!-- Bharti Kgs -->
                                    <ColumnDefinition Width="48"/>  <!-- Loose Weight -->
                                    <ColumnDefinition Width="54"/>  <!-- Short Type Combo -->
                                    <ColumnDefinition Width="45"/>  <!-- Shortage -->
                                    <ColumnDefinition Width="45"/>  <!-- Ded -->
                                    <ColumnDefinition Width="54"/>  <!-- Total Weight -->
                                    <ColumnDefinition Width="48"/>  <!-- Mnd Std -->
                                    <ColumnDefinition Width="80"/>  <!-- Rate Type -->
                                    <ColumnDefinition Width="54"/>  <!-- Rate -->
                                    <ColumnDefinition Width="54"/>  <!-- Rate Bardana -->
                                    <ColumnDefinition Width="*"/>   <!-- Total Value -->
                                    <ColumnDefinition Width="Auto"/> <!-- Add btn -->
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0"><TextBlock Text="Product ID"/><TextBox Text="{Binding CurrentProductId}"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="Product Name"/><TextBox Text="{Binding CurrentProductName}"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="T.Qty"/><TextBox Text="{Binding CurrentTQty}"/></StackPanel>
                                <StackPanel Grid.Column="3"><TextBlock Text="B.Qty"/><TextBox Text="{Binding CurrentBQty}"/></StackPanel>
                                <StackPanel Grid.Column="4"><TextBlock Text="P.Qty"/><TextBox Text="{Binding CurrentPQty}"/></StackPanel>
                                <StackPanel Grid.Column="5"><TextBlock Text="Bharti"/><TextBox Text="{Binding CurrentBhartiKgs}"/></StackPanel>
                                <StackPanel Grid.Column="6"><TextBlock Text="Loose Wt"/><TextBox Text="{Binding CurrentLooseWeight}"/></StackPanel>
                                <StackPanel Grid.Column="7"><TextBlock Text="Short"/><ComboBox ItemsSource="{Binding ShortTypes}" SelectedItem="{Binding SelectedShortType}"/></StackPanel>
                                <StackPanel Grid.Column="8"><TextBlock Text="Shortage"/><TextBox Text="{Binding CurrentShortage}"/></StackPanel>
                                <StackPanel Grid.Column="9"><TextBlock Text="Ded"/><TextBox Text="{Binding CurrentDeduction}"/></StackPanel>
                                <StackPanel Grid.Column="10"><TextBlock Text="Total Wt"/><TextBox Text="{Binding CurrentTotalWeight}"/></StackPanel>
                                <StackPanel Grid.Column="11"><TextBlock Text="Mnd Std"/><ComboBox ItemsSource="{Binding MoundStandards}" SelectedItem="{Binding SelectedMoundStandard}"/></StackPanel>
                                <StackPanel Grid.Column="12"><TextBlock Text="Rate Type"/><ComboBox ItemsSource="{Binding RateTypes}" SelectedItem="{Binding SelectedRateType}"/></StackPanel>
                                <StackPanel Grid.Column="13"><TextBlock Text="Rate"/><TextBox Text="{Binding CurrentRate}"/></StackPanel>
                                <StackPanel Grid.Column="14"><TextBlock Text="Br.Dana"/><TextBox Text="{Binding CurrentRateBardana}"/></StackPanel>
                                <StackPanel Grid.Column="15"><TextBlock Text="Total Value"/><TextBox Text="{Binding CurrentTotalValue}" FontWeight="Bold"/></StackPanel>
                                <Button Grid.Column="16" Content="+" Command="{Binding AddItemCommand}" Width="24" Height="23" Margin="3,14,0,0" ToolTip="Add Row"/>
                            </Grid>

                            <!-- Line Items DataGrid -->
                            <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" AutoGenerateColumns="False"
                                      Height="110" Background="White" HeadersVisibility="Column" GridLinesVisibility="All" RowHeight="22">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="P.ID" Binding="{Binding ProductId}" Width="60"/>
                                    <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="140"/>
                                    <DataGridTextColumn Header="T.Qty" Binding="{Binding TQty}" Width="50"/>
                                    <DataGridTextColumn Header="B.Qty" Binding="{Binding BQty}" Width="50"/>
                                    <DataGridTextColumn Header="P.Qty" Binding="{Binding PQty}" Width="50"/>
                                    <DataGridTextColumn Header="WT/Bag" Binding="{Binding WtPerBag}" Width="55"/>
                                    <DataGridTextColumn Header="Ext.WT" Binding="{Binding ExtWt}" Width="55"/>
                                    <DataGridTextColumn Header="Shortage" Binding="{Binding Shortage}" Width="60"/>
                                    <DataGridTextColumn Header="Ded" Binding="{Binding Deduction}" Width="50"/>
                                    <DataGridTextColumn Header="TTL Kgs" Binding="{Binding TotalKgs}" Width="65"/>
                                    <DataGridTextColumn Header="Mnd-Std" Binding="{Binding MoundStandard}" Width="60"/>
                                    <DataGridTextColumn Header="Rate Type" Binding="{Binding RateType}" Width="85"/>
                                    <DataGridTextColumn Header="Rate" Binding="{Binding Rate, StringFormat=N2}" Width="70"/>
                                    <DataGridTextColumn Header="Br.Dana" Binding="{Binding RateBardana, StringFormat=N2}" Width="65"/>
                                    <DataGridTextColumn Header="TotalValue" Binding="{Binding TotalValue, StringFormat=N2}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- 3. EXPENSES TABS & FINANCIAL TOTALS -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: TabControl for Expenses -->
                        <TabControl Grid.Column="0" Height="150" Background="#ECECEC" BorderBrush="#A0A0A0">
                            <!-- TAB 1: General Expenses -->
                            <TabItem Header="General Expenses" FontWeight="SemiBold">
                                <Grid Margin="6,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Dami & WHT Box -->
                                    <Border Grid.Column="0" BorderBrush="#A0A0A0" BorderThickness="1" Background="#F4F4F4" Padding="6,4">
                                        <StackPanel>
                                            <TextBlock Text="Dami" FontWeight="Bold" Margin="0,0,0,2"/>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0"><TextBlock Text="Type"/><ComboBox ItemsSource="{Binding DamiTypes}" SelectedItem="{Binding SelectedDamiType}"/></StackPanel>
                                                <StackPanel Grid.Column="1" Margin="3,0"><TextBlock Text="%Age"/><TextBox Text="{Binding DamiPercentage}"/></StackPanel>
                                                <StackPanel Grid.Column="2"><TextBlock Text="Value"/><TextBox Text="{Binding DamiValue}"/></StackPanel>
                                            </Grid>
                                            <CheckBox Content="Commission Minus From Balance" IsChecked="{Binding CommissionMinusFromBalance}" Margin="0,0,0,4" FontSize="10"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="75"/><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="WithHolding Tax" VerticalAlignment="Center" FontSize="10.5"/>
                                                <TextBox Grid.Column="1" Text="{Binding WhtPercentage}" Margin="2,0"/>
                                                <TextBox Grid.Column="2" Text="{Binding WhtValue}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Summary Numbers -->
                                    <Grid Grid.Column="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Total Weight Kgs" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TotalWeightKgs, StringFormat=N2}" Margin="0,1"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Gross total" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding GrossTotal, StringFormat=N2}" Margin="0,1" FontWeight="Bold"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Discount" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Discount, StringFormat=N2}" Margin="0,1"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Bardana" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Bardana, StringFormat=N2}" Margin="0,1"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Advance" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Advance, StringFormat=N2}" Margin="0,1"/>

                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Invoice Value" VerticalAlignment="Center" FontWeight="Bold"/>
                                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding InvoiceValue, StringFormat=N2}" Margin="0,1" FontWeight="Bold"/>
                                    </Grid>

                                    <!-- Ref. Commission & Vehicle Charges -->
                                    <Border Grid.Column="4" BorderBrush="#A0A0A0" BorderThickness="1" Background="#F4F4F4" Padding="6,4">
                                        <StackPanel>
                                            <!-- Ref. Commission -->
                                            <TextBlock Text="Ref.Commission" FontWeight="Bold" Margin="0,0,0,2"/>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <ComboBox Grid.Column="0" ItemsSource="{Binding RefCommissionTypes}" SelectedItem="{Binding SelectedRefCommissionType}"/>
                                                <TextBox Grid.Column="1" Text="{Binding RefCommissionPercentage}" Margin="3,0"/>
                                                <TextBox Grid.Column="2" Text="{Binding RefCommissionValue}"/>
                                            </Grid>

                                            <!-- Vehicle Charges -->
                                            <TextBlock Text="Vehicle Charges" Margin="0,0,0,2"/>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Text="{Binding VehicleCharges1}" Margin="0,0,2,0"/>
                                                <TextBox Grid.Column="1" Text="{Binding VehicleCharges2}" Margin="2,0"/>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                    <RadioButton Content="/B" IsChecked="{Binding IsVehiclePerBag}" Margin="4,0,2,0"/>
                                                    <RadioButton Content="/M" IsChecked="{Binding IsVehiclePerMound}"/>
                                                </StackPanel>
                                            </Grid>

                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="65"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Account No" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" Text="{Binding VehicleAccountNo}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </TabItem>

                            <!-- TAB 2: Multiple Expenses -->
                            <TabItem Header="Multiple Expenses" FontWeight="SemiBold">
                                <Grid Margin="10">
                                    <TextBlock Text="Additional Multiple Expenses Configuration" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Grid>
                            </TabItem>

                            <!-- TAB 3: Other Expenses -->
                            <TabItem Header="Other Expenses" FontWeight="SemiBold">
                                <Grid Margin="10">
                                    <TextBlock Text="Other Mandi &amp; Trade Expenses" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Grid>
                            </TabItem>
                        </TabControl>

                        <!-- Right: Financial Totals Box (Received, Net Value, Previous, Final) -->
                        <Border Grid.Column="1" BorderBrush="#A0A0A0" BorderThickness="1" Background="#ECECEC" Padding="8" Margin="8,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Received" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Received, StringFormat=N2}" Margin="0,2"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Net Value" VerticalAlignment="Center" FontWeight="Bold"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NetValue, StringFormat=N2}" Margin="0,2" FontWeight="Bold"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Previous Balance" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PreviousBalance, StringFormat=N2}" Margin="0,2"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Final Balance" VerticalAlignment="Center" FontWeight="Bold"/>
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding FinalBalance, StringFormat=N2}" Margin="0,2" FontWeight="Bold" Foreground="#1E3A8A"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 4. NARRATIONS, PROMISES & BIOMETRIC THUMB REGISTER -->
                    <Border BorderBrush="#A0A0A0" BorderThickness="1" Background="#ECECEC" Padding="8,6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 1: Narration & Expense Type & Flags -->
                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Narration:" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding Narration}" Margin="0,0,10,0"/>

                                <TextBlock Grid.Column="2" Text="Expense Type:" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="3" ItemsSource="{Binding ExpenseTypes}" SelectedItem="{Binding SelectedExpenseType}" Margin="0,0,10,0"/>

                                <CheckBox Grid.Column="4" Content="Is Advance Sale" IsChecked="{Binding IsAdvanceSale}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <CheckBox Grid.Column="5" Content="Markup Invoice" IsChecked="{Binding MarkupInvoice}" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Row 2: Narration In Urdu & Thumb Options -->
                            <Grid Grid.Row="1" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Narration In Urdu:" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding NarrationInUrdu}" Style="{StaticResource ModernUrduStandardTextBox}" helpers:UrduHelper.IsUrduOnly="True" Height="38" Margin="0,0,12,0"/>

                                <CheckBox Grid.Column="2" Content="Show Thumb" IsChecked="{Binding ShowThumb}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Button Grid.Column="3" Style="{StaticResource ClassicButton}" Command="{Binding ThumbRegisterCommand}" Height="23">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Fingerprint" Width="14" Height="14" Foreground="#005A9E" Margin="0,0,4,0"/>
                                        <TextBlock Text="Thumb Register" FontSize="10.5"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Row 3: Promise Section -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="75"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Promise Date" VerticalAlignment="Center"/>
                                <DatePicker Grid.Column="1" SelectedDate="{Binding PromiseDate}" Height="23" Margin="0,0,8,0"/>

                                <TextBlock Grid.Column="2" Text="Narration" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="3" Text="{Binding PromiseNarration}" Margin="0,0,8,0"/>

                                <CheckBox Grid.Column="4" Content="Add Promise" IsChecked="{Binding AddPromise}" VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>

        </DockPanel>
    </Grid>
</Window>
