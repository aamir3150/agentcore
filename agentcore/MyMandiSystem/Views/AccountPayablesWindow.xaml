<Window x:Class="MyMandiSystem.Views.AccountPayablesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="780"
        SizeToContent="Height"
        MinHeight="540"
        MaxHeight="820"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="{StaticResource BrushSurfaceBg}"
        FontFamily="Segoe UI"
        FontSize="13"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BrushSurfaceCard}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushSurfaceBorderDark}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Effect" Value="{StaticResource EffectCardShadow}" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource BrushPrimarySlate}" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>

        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource BrushPrimaryNavy}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="FilterComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="FilterTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="FilterDatePickerStyle" TargetType="DatePicker" BasedOn="{StaticResource MaterialDesignOutlinedDatePicker}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--                 AGENTCORE MODERN HEADER BANNER             -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top" Padding="20,14">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0F172A" Offset="0" />
                    <GradientStop Color="#1E293B" Offset="0.65" />
                    <GradientStop Color="#0F766E" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" Margin="0,0,14,0">
                    <materialDesign:PackIcon Kind="AccountCashOutline" Width="24" Height="24" Foreground="#2DD4BF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding HeaderTitle}" FontSize="19" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                        <Border Background="#0D9488" CornerRadius="5" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ModeBadgeText}" FontSize="10.5" FontWeight="Bold" Foreground="#FFFFFF" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding HeaderSubtitle}" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0" />
                </StackPanel>

                <Border Grid.Column="2" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="12,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="CalendarRange" Width="16" Height="16" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock Text="{Binding DateModeDisplayText}" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--                    BOTTOM ACTION BAR                       -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Bottom" Background="#FFFFFF" BorderBrush="{StaticResource BrushSurfaceBorder}" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="9,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="KeyboardOutline" Width="15" Height="15" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Enter: Next Field   |   Ctrl+Q: Close" FontSize="11.5" Foreground="#475569" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ProgressBar IsIndeterminate="True" Width="90" Height="4" Margin="14,0,0,0"
                                 Foreground="{StaticResource BrushAccentTeal}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="CmdPreview"
                            Command="{Binding PreviewCommand}"
                            MinWidth="112" Margin="0,0,10,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ModernPrimaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="EyeOutline" Width="17" Height="17" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="Preview" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="CmdPrint"
                            Command="{Binding PrintCommand}"
                            MinWidth="106" Margin="0,0,10,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ModernSuccessButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PrinterOutline" Width="17" Height="17" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="Print" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="CmdClose"
                            Command="{Binding CloseCommand}"
                            Style="{StaticResource ModernDangerButton}"
                            MinWidth="96">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CloseCircleOutline" Width="17" Height="17" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Close" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--                       MAIN FORM BODY                       -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,16,20,8">

                <!-- 1. Date Mode & Conditional Date Inputs / Crop Season -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <materialDesign:PackIcon Kind="CalendarCheckOutline" Width="17" Height="17" Foreground="{StaticResource BrushAccentTeal}" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="Report Period &amp; Season" Style="{StaticResource CardTitleStyle}" />
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- AgenSoft Date Radios (OptAllDates default True) -->
                            <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,6" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="OptAllDates" GroupName="DateMode" Content="All Dates"
                                                 IsChecked="{Binding IsAllDates}" FontWeight="SemiBold"
                                                 Foreground="{StaticResource BrushPrimaryNavy}" Margin="2,0,16,0" VerticalAlignment="Center" />
                                    <RadioButton x:Name="OptTillDate" GroupName="DateMode" Content="Till Date"
                                                 IsChecked="{Binding IsTillDate}" FontWeight="SemiBold"
                                                 Foreground="{StaticResource BrushPrimaryNavy}" Margin="0,0,16,0" VerticalAlignment="Center" />
                                    <RadioButton x:Name="OptDateRange" GroupName="DateMode" Content="Date Range"
                                                 IsChecked="{Binding IsDateRange}" FontWeight="SemiBold"
                                                 Foreground="{StaticResource BrushPrimaryNavy}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Conditional Date Pickers -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <!-- Single Date (DtpSingleDate) -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                            Visibility="{Binding ShowSingleDatePicker, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Till Date:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <DatePicker x:Name="DtpSingleDate"
                                                xml:lang="en-GB"
                                                SelectedDate="{Binding SingleDate}"
                                                Style="{StaticResource FilterDatePickerStyle}"
                                                Width="155" />
                                </StackPanel>

                                <!-- Date Range Frame (FrmDateRange) -->
                                <StackPanel x:Name="FrmDateRange" Orientation="Horizontal" VerticalAlignment="Center"
                                            Visibility="{Binding ShowDateRangeFrame, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="From:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <DatePicker x:Name="DtpFrom"
                                                xml:lang="en-GB"
                                                SelectedDate="{Binding FromDate}"
                                                Style="{StaticResource FilterDatePickerStyle}"
                                                Width="148" Margin="0,0,12,0" />

                                    <TextBlock Text="To:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <DatePicker x:Name="DtpTo"
                                                xml:lang="en-GB"
                                                SelectedDate="{Binding ToDate}"
                                                Style="{StaticResource FilterDatePickerStyle}"
                                                Width="148" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Conditional Crop Season Group (visible only if EnableCropSeason = 1) -->
                        <StackPanel x:Name="GrpCropSeason" Margin="0,12,0,0"
                                    Visibility="{Binding ShowCropSeason, Converter={StaticResource BoolToVis}}">
                            <Separator Margin="0,0,0,10" Background="#E2E8F0" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Crop Season" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0" />
                                <ComboBox x:Name="CmbCropsSeason"
                                          Grid.Column="1"
                                          ItemsSource="{Binding CropSeasons}"
                                          SelectedItem="{Binding SelectedCropSeason}"
                                          DisplayMemberPath="Name"
                                          Style="{StaticResource FilterComboBoxStyle}" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 2. Exact 2-Column AgenSoft Party & Location Filters -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <materialDesign:PackIcon Kind="FilterVariant" Width="17" Height="17" Foreground="{StaticResource BrushAccentIndigo}" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="Account, Amount &amp; Location Filters" Style="{StaticResource CardTitleStyle}" />
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Row 1 Left: Party Type -->
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Party Type" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox x:Name="CmbParties"
                                          ItemsSource="{Binding PartyTypes}"
                                          SelectedItem="{Binding SelectedPartyType}"
                                          DisplayMemberPath="Name"
                                          Style="{StaticResource FilterComboBoxStyle}" />
                            </StackPanel>

                            <!-- Row 1 Right: Party Group -->
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="Party Group" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox x:Name="cmbPartyGroup"
                                          ItemsSource="{Binding PartyGroups}"
                                          SelectedItem="{Binding SelectedPartyGroup}"
                                          DisplayMemberPath="Name"
                                          Style="{StaticResource FilterComboBoxStyle}" />
                            </StackPanel>

                            <!-- Row 2 Left: Amount Greator Then -->
                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="Amount Greator Then" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="TxtGreaterThen"
                                         Text="{Binding GreaterThanAmountText, UpdateSourceTrigger=PropertyChanged}"
                                         TextAlignment="Right"
                                         GotKeyboardFocus="TxtGreaterThen_GotKeyboardFocus"
                                         Style="{StaticResource FilterTextBoxStyle}" />
                            </StackPanel>

                            <!-- Row 2 Right: City -->
                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="City" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox x:Name="CmbCity"
                                          ItemsSource="{Binding Cities}"
                                          SelectedItem="{Binding SelectedCity}"
                                          Style="{StaticResource FilterComboBoxStyle}" />
                            </StackPanel>

                            <!-- Row 3 Left: Town Name -->
                            <StackPanel Grid.Row="4" Grid.Column="0">
                                <TextBlock Text="Town Name" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox x:Name="CmbTown"
                                          ItemsSource="{Binding Towns}"
                                          SelectedItem="{Binding SelectedTown}"
                                          DisplayMemberPath="Name"
                                          Style="{StaticResource FilterComboBoxStyle}" />
                            </StackPanel>

                            <!-- Row 3 Right: Sector Name -->
                            <StackPanel Grid.Row="4" Grid.Column="2">
                                <TextBlock Text="Sector Name" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox x:Name="CmbSector"
                                          ItemsSource="{Binding Sectors}"
                                          SelectedItem="{Binding SelectedSector}"
                                          DisplayMemberPath="Name"
                                          Style="{StaticResource FilterComboBoxStyle}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 3. Sorting & Statement Options -->
                <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,4">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <materialDesign:PackIcon Kind="TuneVariant" Width="17" Height="17" Foreground="{StaticResource BrushAccentSky}" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="Sorting &amp; Statement Options" Style="{StaticResource CardTitleStyle}" />
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Sorting Radios (Frame3) -->
                            <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="Sort Order" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,6" />
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="OptByName" GroupName="SortMode" Content="Sort By Account Name"
                                                     IsChecked="{Binding SortByName}" Margin="0,0,16,0"
                                                     Foreground="{StaticResource BrushPrimaryNavy}" FontWeight="Medium" />
                                        <RadioButton x:Name="OptByAccID" GroupName="SortMode" Content="Sort By Account ID"
                                                     IsChecked="{Binding SortByAccountId}"
                                                     Foreground="{StaticResource BrushPrimaryNavy}" FontWeight="Medium" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Output Checkboxes -->
                            <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="Report Mode &amp; Actions" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,6" />
                                    <WrapPanel Orientation="Horizontal">
                                        <CheckBox x:Name="ChkOnlyFinals" Content="Show Only Final Balance"
                                                  IsChecked="{Binding ShowOnlyFinalBalance}"
                                                  Margin="0,0,16,4" FontWeight="Medium" Foreground="{StaticResource BrushPrimaryNavy}" />
                                        <CheckBox x:Name="ChkFinalBalances" Content="Show Final Balances"
                                                  IsChecked="{Binding ShowFinalBalances}"
                                                  Visibility="{Binding ShowFinalBalancesCheckbox, Converter={StaticResource BoolToVis}}"
                                                  Margin="0,0,16,4" FontWeight="Medium" Foreground="{StaticResource BrushPrimaryNavy}" />
                                        <CheckBox x:Name="ChkUrdu" Content="Urdu Print"
                                                  IsChecked="{Binding IsUrduPrint}"
                                                  Visibility="{Binding ShowUrduCheckbox, Converter={StaticResource BoolToVis}}"
                                                  Margin="0,0,16,4" FontWeight="Medium" Foreground="{StaticResource BrushPrimaryNavy}" />
                                        <CheckBox x:Name="ChksmsEnabled" Content="Send SMS"
                                                  IsChecked="{Binding SendSms}"
                                                  Margin="0,0,4,4" FontWeight="Medium" Foreground="{StaticResource BrushPrimaryNavy}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
