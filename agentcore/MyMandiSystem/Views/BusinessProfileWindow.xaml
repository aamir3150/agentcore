<Window x:Class="MyMandiSystem.Views.BusinessProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Configuration &amp; Business Profile" 
        Width="780" 
        Height="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True">

    <Window.Resources>
        <Storyboard x:Key="FadeInStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:0.25"/>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource FadeInStoryboard}"/>
        </EventTrigger>
    </Window.Triggers>

    <Border Margin="16" CornerRadius="18" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1.5" Effect="{StaticResource EffectModalShadow}">
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="Auto"/> <!-- Tabs Header -->
                <RowDefinition Height="*"/>    <!-- Tab Body -->
                <RowDefinition Height="Auto"/> <!-- Footer Actions -->
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                       TOP TITLE BAR                        -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border Grid.Row="0" Background="{StaticResource BrushPrimaryNavy}" CornerRadius="18,18,0,0" Padding="22,14"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Cursor="SizeAll">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="#1E293B" Margin="0,0,12,0">
                        <materialDesign:PackIcon Kind="CogOutline" Width="24" Height="24" Foreground="{StaticResource BrushAccentTealLight}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="System Configuration &amp; Business Profile" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="کاروباری معلومات، پرنٹر ترتیبات اور منڈی رسید کے اردو نوٹس" 
                                   FontFamily="{StaticResource FontJameelNooriNastaleeq}" FontSize="15" Foreground="#94A3B8"/>
                    </StackPanel>

                    <Button Grid.Column="2" Click="CloseButton_Click" Cursor="Hand" Width="30" Height="30" 
                            Background="Transparent" BorderThickness="0" Padding="0">
                        <materialDesign:PackIcon Kind="Close" Width="20" Height="20" Foreground="#94A3B8"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                        TABS HEADER                         -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border Grid.Row="1" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="20,8">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="کاروباری پروفائل (Profile Info)" Style="{StaticResource MaterialDesignTabRadioButton}" 
                                 IsChecked="True" FontSize="13" FontWeight="Bold" Margin="0,0,12,0" Checked="Tab1_Checked"/>
                    <RadioButton Content="پرنٹر و سسٹم ترتیبات (Preferences)" Style="{StaticResource MaterialDesignTabRadioButton}" 
                                 FontSize="13" FontWeight="Bold" Margin="0,0,12,0" Checked="Tab2_Checked"/>
                    <RadioButton Content="رسید اردو فوٹرز (Urdu Footers)" Style="{StaticResource MaterialDesignTabRadioButton}" 
                                 FontSize="13" FontWeight="Bold" Checked="Tab3_Checked"/>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                         TAB BODY                           -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="2" Margin="24,16">
                <!-- Tab 1: Profile & Company Info -->
                <ScrollViewer x:Name="Tab1Panel" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- English & Urdu Business Name -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="Business Name (English)" 
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     Text="{Binding BusinessName, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Grid.Column="2" materialDesign:HintAssist.Hint="کاروبار / آڑھت کا نام (اردو)" 
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     FontFamily="{StaticResource FontJameelNooriNastaleeq}" FontSize="15"
                                     Text="{Binding BusinessNameUrdu, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <!-- Proprietor & Registration -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="Proprietor / مالک یا آڑھتی کا نام" 
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     Text="{Binding Proprietor, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Grid.Column="2" materialDesign:HintAssist.Hint="License / Registration No." 
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     Text="{Binding RegistrationNo, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <!-- Address & City -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="Address / دکان و منڈی کا پتہ" 
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Grid.Column="2" materialDesign:HintAssist.Hint="City / شہر" 
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     Text="{Binding City, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <!-- Phones & Mobile -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="Phone 1 (فون نمبر ۱)" 
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Grid.Column="2" materialDesign:HintAssist.Hint="Phone 2 (فون نمبر ۲)" 
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     Text="{Binding Phone2, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Grid.Column="4" materialDesign:HintAssist.Hint="Mobile / موبائل نمبر" 
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     Text="{Binding Mobile, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <!-- Tax Numbers NTN / STN -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="NTN (نیشنل ٹیکس نمبر)" 
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     Text="{Binding Ntn, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Grid.Column="2" materialDesign:HintAssist.Hint="STN / سیلز ٹیکس نمبر" 
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     Text="{Binding Stn, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Tab 2: System, Printer & Auto-Backup -->
                <ScrollViewer x:Name="Tab2Panel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Printing Options -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Printer Settings / پرنٹنگ کے اختیارات" FontWeight="Bold" FontSize="13" Foreground="#0284C7" Margin="0,0,0,10"/>
                                <CheckBox Content="Thermal Printer Receipt Mode (تھرمل پرنٹر فارمیٹ)" IsChecked="{Binding ThermalPrint}" Margin="0,0,0,8"/>
                                <CheckBox Content="Direct Print Voucher on Save (بغیر ڈائیلاگ فوری پرنٹ)" IsChecked="{Binding DirectPrintVoucher}" Margin="0,0,0,8"/>
                                <CheckBox Content="Auto Print Vouchers (خودکار پرنٹنگ)" IsChecked="{Binding AutoPrint}" Margin="0,0,0,8"/>
                                <CheckBox Content="Show Report Grid Lines (رپورٹ پر گرڈ لائنز دکھائیں)" IsChecked="{Binding ShowReportBodyLines}" Margin="0,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Automated Backup Options -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Hourly Auto-Backup / خودکار گھنٹہ وار بیک اپ" FontWeight="Bold" FontSize="13" Foreground="#0284C7" Margin="0,0,0,10"/>
                                <CheckBox Content="Enable Hourly Automatic Database Backup (گھنٹہ وار بیک اپ فعال کریں)" IsChecked="{Binding HourlyBackupEnabled}" Margin="0,0,0,10"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="Interval (Minutes)" 
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                             Text="{Binding HourlyBackupTime, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,14,0"/>
                                    <TextBox Grid.Column="1" materialDesign:HintAssist.Hint="Backup Destination Folder" 
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                             Text="{Binding BackupPath, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Tab 3: Urdu Footers -->
                <ScrollViewer x:Name="Tab3Panel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Urdu Footer Terms for Invoices / بلوں و رسیدوں پر نیچے درج ہونے والی شرائط" 
                                   FontWeight="Bold" FontSize="13" Foreground="#334155" Margin="0,0,0,10"/>

                        <!-- General Sale Footer -->
                        <TextBox materialDesign:HintAssist.Hint="جنرل سیل انوائس فوٹر (General Sale Footer)" 
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,12"
                                 FontFamily="{StaticResource FontJameelNooriNastaleeq}" FontSize="14"
                                 Text="{Binding FooterGenUrdu, UpdateSourceTrigger=PropertyChanged}"/>

                        <!-- Crops Sale Footer -->
                        <TextBox materialDesign:HintAssist.Hint="فصل خریداری و فروخت فوٹر (Crops Sale / Purchase Footer)" 
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,12"
                                 FontFamily="{StaticResource FontJameelNooriNastaleeq}" FontSize="14"
                                 Text="{Binding FooterCropUrdu, UpdateSourceTrigger=PropertyChanged}"/>

                        <!-- Pestro Footer -->
                        <TextBox materialDesign:HintAssist.Hint="پیسٹیسائڈ و کھاد فوٹر (Pesticide / Fertilizer Footer)" 
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,12"
                                 FontFamily="{StaticResource FontJameelNooriNastaleeq}" FontSize="14"
                                 Text="{Binding FooterPestUrdu, UpdateSourceTrigger=PropertyChanged}"/>

                        <!-- Brokerage Footer -->
                        <TextBox materialDesign:HintAssist.Hint="بروکریج فوٹر (Brokerage Invoice Footer)" 
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                 FontFamily="{StaticResource FontJameelNooriNastaleeq}" FontSize="14"
                                 Text="{Binding FooterBrokUrdu, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                       FOOTER ACTIONS                       -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,14" CornerRadius="0,0,18,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}" Height="38" Padding="14,0" Margin="0,0,10,0"
                                Click="CloseButton_Click" Foreground="#64748B" BorderBrush="#CBD5E1">
                            <TextBlock Text="Close / بند کریں"/>
                        </Button>

                        <Button Command="{Binding SaveCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                Background="{StaticResource BrushPrimaryNavy}" Foreground="#FFFFFF" BorderThickness="0" Height="38" Padding="20,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSaveCheck" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Save Profile / محفوظ کریں" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
