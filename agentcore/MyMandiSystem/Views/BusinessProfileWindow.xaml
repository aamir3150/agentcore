<Window x:Class="MyMandiSystem.Views.BusinessProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Business Profile &amp; Print Header Setup" 
        Width="680" 
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True">

    <Window.Resources>
        <Storyboard x:Key="FadeInStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:0.25"/>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource FadeInStoryboard}"/>
        </EventTrigger>
    </Window.Triggers>

    <Border Margin="16" CornerRadius="18" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1.5" Effect="{StaticResource EffectModalShadow}">
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="*"/>    <!-- Form Fields Body -->
                <RowDefinition Height="Auto"/> <!-- Footer Actions -->
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                       TOP TITLE BAR                        -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border Grid.Row="0" Background="{StaticResource BrushPrimaryNavy}" CornerRadius="18,18,0,0" Padding="22,14"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Cursor="SizeAll">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="#1E293B" Margin="0,0,12,0">
                        <materialDesign:PackIcon Kind="OfficeBuilding" Width="24" Height="24" Foreground="{StaticResource BrushAccentTealLight}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Business Profile &amp; Print Setup" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="کاروباری معلومات و پرنٹنگ ہیڈر کی ترتیبات" 
                                   FontFamily="{StaticResource FontJameelNooriNastaleeq}" FontSize="15" Foreground="#94A3B8"/>
                    </StackPanel>

                    <Button Grid.Column="2" Click="CloseButton_Click" Cursor="Hand" Width="30" Height="30" 
                            Background="Transparent" BorderThickness="0" Padding="0">
                        <materialDesign:PackIcon Kind="Close" Width="20" Height="20" Foreground="#94A3B8"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                       FORM FIELDS BODY                     -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <ScrollViewer Grid.Row="1" MaxHeight="560" VerticalScrollBarVisibility="Auto" Padding="24,18">
                <StackPanel>

                    <!-- Info Alert -->
                    <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="InformationOutline" Width="20" Height="20" Foreground="#16A34A" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Yahan likha gaya Naam, Pata aur Phone Number tamam Ledgers, Slips aur Invoices ke print par khud-ba-khud show hoga." 
                                       FontSize="12.5" Foreground="#166534" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- 1. Business / Firm Name (Urdu) -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Business Name in Urdu (دکان / آڑھت کا نام اردو میں) *" FontWeight="Bold" FontSize="12.5" Foreground="#1E293B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding BusinessNameUrdu, UpdateSourceTrigger=PropertyChanged}" 
                                 FontFamily="{StaticResource FontJameelNooriNastaleeq}" FontSize="18" FlowDirection="RightToLeft"
                                 Padding="10,6" MinHeight="42" Background="#FFFFFF" BorderBrush="#CBD5E1"/>
                    </StackPanel>

                    <!-- 2. Business / Firm Name (English) -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Business Name in English (کاروبار کا نام انگلش میں) *" FontWeight="Bold" FontSize="12.5" Foreground="#1E293B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding BusinessName, UpdateSourceTrigger=PropertyChanged}" 
                                 FontSize="13.5" FontWeight="SemiBold"
                                 Padding="10,8" Background="#FFFFFF" BorderBrush="#CBD5E1"/>
                    </StackPanel>

                    <!-- 3. Proprietor / Owner Name -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Proprietor / Malik Name (مالک یا آڑھتی کا نام)" FontWeight="Bold" FontSize="12.5" Foreground="#1E293B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Proprietor, UpdateSourceTrigger=PropertyChanged}" 
                                 FontSize="13" Padding="10,8" Background="#FFFFFF" BorderBrush="#CBD5E1"/>
                    </StackPanel>

                    <!-- 4. Address & Location -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Market / Shop Address (دکان کا پتہ یا غلہ منڈی)" FontWeight="Bold" FontSize="12.5" Foreground="#1E293B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" 
                                 FontSize="13" Padding="10,8" Background="#FFFFFF" BorderBrush="#CBD5E1"/>
                    </StackPanel>

                    <!-- 5. Phone / Mobile Numbers & License -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Phone -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Phone / Mobile Numbers (موبائل نمبرز) *" FontWeight="Bold" FontSize="12.5" Foreground="#1E293B" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" 
                                     FontSize="13" Padding="10,8" Background="#FFFFFF" BorderBrush="#CBD5E1"/>
                        </StackPanel>

                        <!-- License / Reg # -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Mandi License / Reg # (لائسنس یا رجسٹریشن)" FontWeight="Bold" FontSize="12.5" Foreground="#1E293B" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding RegistrationNo, UpdateSourceTrigger=PropertyChanged}" 
                                     FontSize="13" Padding="10,8" Background="#FFFFFF" BorderBrush="#CBD5E1"/>
                        </StackPanel>
                    </Grid>

                    <!-- Live Print Preview Box -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1.5" CornerRadius="10" Padding="16,12">
                        <StackPanel>
                            <TextBlock Text="پرنٹ ہیڈر کا پری ویو (Live Print Preview):" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="16,10">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding BusinessNameUrdu}" FontFamily="{StaticResource FontJameelNooriNastaleeq}" FontSize="20" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding BusinessName}" FontSize="14" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center" Margin="0,2,0,2"/>
                                    <TextBlock Text="{Binding Address, StringFormat='📍 {0}'}" FontSize="12" Foreground="#475569" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Phone, StringFormat='📞 {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="#0F766E" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                      FOOTER ACTIONS                        -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="0,0,18,18" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="22,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="1" Click="SaveButton_Click" Cursor="Hand" Style="{StaticResource ModernPrimaryButton}" Height="38" Padding="26,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSaveCheckOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Save Profile (محفوظ کریں)" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
