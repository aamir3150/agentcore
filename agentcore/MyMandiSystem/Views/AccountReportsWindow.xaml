<Window x:Class="MyMandiSystem.Views.AccountReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewmodels="clr-namespace:MyMandiSystem.ViewModels"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="850" Width="1360"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        FontFamily="Segoe UI"
        Background="#F8FAFC">

    <Window.Resources>
        <!-- Modern Card Style -->
        <Style x:Key="ModernCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.08" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Report Button Style -->
        <Style x:Key="SidebarReportBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0284C7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Body (Sidebar + Content) -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- 1. Header Banner -->
        <Border Grid.Row="0" Background="#0F172A" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#1E293B" CornerRadius="8" Width="44" Height="44" Margin="0,0,15,0">
                    <materialDesign:PackIcon Kind="ChartTimelineVariant" Width="26" Height="26" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding HeaderTitle}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        <Border Background="#0284C7" CornerRadius="4" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Mode}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding HeaderSubtitle}" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ExportCsvCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="White" BorderBrush="#475569" Margin="0,0,8,0" Height="36">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileExcel" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#22C55E"/>
                            <TextBlock Text="Export CSV" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding PrintReportCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="White" BorderBrush="#475569" Margin="0,0,8,0" Height="36">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Printer" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#38BDF8"/>
                            <TextBlock Text="Print Report" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding CloseCommand}" Style="{StaticResource MaterialDesignIconButton}" Foreground="#EF4444" Width="36" Height="36" ToolTip="Close (Esc)">
                        <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Main Body: Left Sidebar + Right Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/> <!-- Sidebar Navigation -->
                <ColumnDefinition Width="*"/>   <!-- Report Content Area -->
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR: All 26 Reports Navigator -->
            <Border Grid.Column="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- Sidebar Header -->
                    <Border DockPanel.Dock="Top" Background="#0F172A" Padding="14,10" BorderBrush="#334155" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ViewList" Width="18" Height="18" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="ACCOUNT REPORTS MENU" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Scrollable Report List -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="6,8">
                            <!-- Group 1: Ledgers -->
                            <TextBlock Text="📘 LEDGERS &amp; ACCOUNTS" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" Margin="8,8,0,4"/>
                            
                            <Button Style="{StaticResource SidebarReportBtn}" Command="{Binding SetReportModeCommand}" CommandParameter="{x:Static viewmodels:AccountReportMode.AccountLedger}">
                                <Grid Width="240">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="1." FontWeight="Bold" Foreground="#64748B" FontSize="11"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Account Ledger" FontWeight="SemiBold" Foreground="White" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource SidebarReportBtn}" Command="{Binding SetReportModeCommand}" CommandParameter="{x:Static viewmodels:AccountReportMode.AccountLedgerExtended}">
                                <Grid Width="240">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="2." FontWeight="Bold" Foreground="#64748B" FontSize="11"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Account Ledger Extended" FontWeight="SemiBold" Foreground="White" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource SidebarReportBtn}" Command="{Binding SetReportModeCommand}" CommandParameter="{x:Static viewmodels:AccountReportMode.PartyLedgerExtended}">
                                <Grid Width="240">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="3." FontWeight="Bold" Foreground="#64748B" FontSize="11"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Party Ledger Extended" FontWeight="SemiBold" Foreground="White" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- Group 2: Daily Books -->
                            <TextBlock Text="📙 DAILY &amp; CASH BOOKS" FontSize="10" FontWeight="Bold" Foreground="#FB923C" Margin="8,14,0,4"/>

                            <Button Style="{StaticResource SidebarReportBtn}" Command="{Binding SetReportModeCommand}" CommandParameter="{x:Static viewmodels:AccountReportMode.CashBook}">
                                <Grid Width="240">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="4." FontWeight="Bold" Foreground="#64748B" FontSize="11"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Cash Book" FontWeight="SemiBold" Foreground="White" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource SidebarReportBtn}" Command="{Binding SetReportModeCommand}" CommandParameter="{x:Static viewmodels:AccountReportMode.DayBook}">
                                <Grid Width="240">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="5." FontWeight="Bold" Foreground="#64748B" FontSize="11"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Day Book" FontWeight="SemiBold" Foreground="White" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource SidebarReportBtn}" Command="{Binding SetReportModeCommand}" CommandParameter="{x:Static viewmodels:AccountReportMode.DailyVouchersDetail}">
                                <Grid Width="240">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="6." FontWeight="Bold" Foreground="#64748B" FontSize="11"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Daily Vouchers Detail" FontWeight="SemiBold" Foreground="White" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource SidebarReportBtn}" Command="{Binding SetReportModeCommand}" CommandParameter="{x:Static viewmodels:AccountReportMode.GLJournal}">
                                <Grid Width="240">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="9." FontWeight="Bold" Foreground="#64748B" FontSize="11"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="G/L Journal" FontWeight="SemiBold" Foreground="White" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- Group 3: Receivables & Payables -->
                            <TextBlock Text="💳 RECEIVABLES &amp; PAYABLES" FontSize="10" FontWeight="Bold" Foreground="#A78BFA" Margin="8,14,0,4"/>

                            <Button Style="{StaticResource SidebarReportBtn}" Command="{Binding SetReportModeCommand}" CommandParameter="{x:Static viewmodels:AccountReportMode.AccountsReceivable}">
                                <Grid Width="240">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="7." FontWeight="Bold" Foreground="#64748B" FontSize="11"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Accounts Receiveable" FontWeight="SemiBold" Foreground="White" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource SidebarReportBtn}" Command="{Binding SetReportModeCommand}" CommandParameter="{x:Static viewmodels:AccountReportMode.AccountsPayable}">
                                <Grid Width="240">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="8." FontWeight="Bold" Foreground="#64748B" FontSize="11"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Accounts Payable" FontWeight="SemiBold" Foreground="White" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- Group 4: Balances & Financials -->
                            <TextBlock Text="⚖️ BALANCES &amp; STATEMENTS" FontSize="10" FontWeight="Bold" Foreground="#4ADE80" Margin="8,14,0,4"/>

                            <Button Style="{StaticResource SidebarReportBtn}" Command="{Binding SetReportModeCommand}" CommandParameter="{x:Static viewmodels:AccountReportMode.TrialBalance}">
                                <Grid Width="240">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="10." FontWeight="Bold" Foreground="#64748B" FontSize="11"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Trial Balance" FontWeight="SemiBold" Foreground="White" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource SidebarReportBtn}" Command="{Binding SetReportModeCommand}" CommandParameter="{x:Static viewmodels:AccountReportMode.AccountsBalances}">
                                <Grid Width="240">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="11." FontWeight="Bold" Foreground="#64748B" FontSize="11"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Accounts Balances" FontWeight="SemiBold" Foreground="White" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource SidebarReportBtn}" Command="{Binding SetReportModeCommand}" CommandParameter="{x:Static viewmodels:AccountReportMode.BalanceSheet}">
                                <Grid Width="240">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="12." FontWeight="Bold" Foreground="#64748B" FontSize="11"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Balance Sheet" FontWeight="SemiBold" Foreground="White" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource SidebarReportBtn}" Command="{Binding SetReportModeCommand}" CommandParameter="{x:Static viewmodels:AccountReportMode.ProfitLossStatement}">
                                <Grid Width="240">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="17." FontWeight="Bold" Foreground="#64748B" FontSize="11"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Profit and Loss Statement" FontWeight="SemiBold" Foreground="White" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource SidebarReportBtn}" Command="{Binding SetReportModeCommand}" CommandParameter="{x:Static viewmodels:AccountReportMode.MonthlyExpenseChart}">
                                <Grid Width="240">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="18." FontWeight="Bold" Foreground="#64748B" FontSize="11"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Monthly Expense Chart" FontWeight="SemiBold" Foreground="White" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- Group 5: Banking & Markup -->
                            <TextBlock Text="🏦 BANKING &amp; MARKUP" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" Margin="8,14,0,4"/>

                            <Button Style="{StaticResource SidebarReportBtn}" Command="{Binding SetReportModeCommand}" CommandParameter="{x:Static viewmodels:AccountReportMode.BankStatement}">
                                <Grid Width="240">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="13." FontWeight="Bold" Foreground="#64748B" FontSize="11"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Bank Statement" FontWeight="SemiBold" Foreground="White" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource SidebarReportBtn}" Command="{Binding SetReportModeCommand}" CommandParameter="{x:Static viewmodels:AccountReportMode.BankPosition}">
                                <Grid Width="240">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="14." FontWeight="Bold" Foreground="#64748B" FontSize="11"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Bank Position" FontWeight="SemiBold" Foreground="White" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource SidebarReportBtn}" Command="{Binding SetReportModeCommand}" CommandParameter="{x:Static viewmodels:AccountReportMode.BankMarkupCalculator}">
                                <Grid Width="240">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="15." FontWeight="Bold" Foreground="#64748B" FontSize="11"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Bank Markup Calculator" FontWeight="SemiBold" Foreground="White" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource SidebarReportBtn}" Command="{Binding SetReportModeCommand}" CommandParameter="{x:Static viewmodels:AccountReportMode.PartyMarkupCalculator}">
                                <Grid Width="240">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="16." FontWeight="Bold" Foreground="#64748B" FontSize="11"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Party Markup Calculator" FontWeight="SemiBold" Foreground="White" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- Group 6: Cheques Management -->
                            <TextBlock Text="📝 CHEQUES REGISTER" FontSize="10" FontWeight="Bold" Foreground="#F43F5E" Margin="8,14,0,4"/>

                            <Button Style="{StaticResource SidebarReportBtn}" Command="{Binding SetReportModeCommand}" CommandParameter="{x:Static viewmodels:AccountReportMode.BankChequesRegister}">
                                <Grid Width="240">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="19." FontWeight="Bold" Foreground="#64748B" FontSize="11"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Bank Cheques Register" FontWeight="SemiBold" Foreground="White" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource SidebarReportBtn}" Command="{Binding SetReportModeCommand}" CommandParameter="{x:Static viewmodels:AccountReportMode.UnclearedCheques}">
                                <Grid Width="240">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="20." FontWeight="Bold" Foreground="#64748B" FontSize="11"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Uncleared Cheques" FontWeight="SemiBold" Foreground="White" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource SidebarReportBtn}" Command="{Binding SetReportModeCommand}" CommandParameter="{x:Static viewmodels:AccountReportMode.LostCheques}">
                                <Grid Width="240">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="21." FontWeight="Bold" Foreground="#64748B" FontSize="11"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Lost Cheques" FontWeight="SemiBold" Foreground="White" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource SidebarReportBtn}" Command="{Binding SetReportModeCommand}" CommandParameter="{x:Static viewmodels:AccountReportMode.BouncedCheques}">
                                <Grid Width="240">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="22." FontWeight="Bold" Foreground="#64748B" FontSize="11"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Bounced Cheques" FontWeight="SemiBold" Foreground="White" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- Group 7: Setup & Audit -->
                            <TextBlock Text="⚙️ SETUP &amp; AUDIT" FontSize="10" FontWeight="Bold" Foreground="#E2E8F0" Margin="8,14,0,4"/>

                            <Button Style="{StaticResource SidebarReportBtn}" Command="{Binding SetReportModeCommand}" CommandParameter="{x:Static viewmodels:AccountReportMode.OpeningBalances}">
                                <Grid Width="240">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="23." FontWeight="Bold" Foreground="#64748B" FontSize="11"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Opening Balances" FontWeight="SemiBold" Foreground="White" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource SidebarReportBtn}" Command="{Binding SetReportModeCommand}" CommandParameter="{x:Static viewmodels:AccountReportMode.ChartOfAccounts}">
                                <Grid Width="240">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="24." FontWeight="Bold" Foreground="#64748B" FontSize="11"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Chart of Accounts" FontWeight="SemiBold" Foreground="White" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource SidebarReportBtn}" Command="{Binding SetReportModeCommand}" CommandParameter="{x:Static viewmodels:AccountReportMode.InsuranceRegister}">
                                <Grid Width="240">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="25." FontWeight="Bold" Foreground="#64748B" FontSize="11"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Insurance Register" FontWeight="SemiBold" Foreground="White" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource SidebarReportBtn}" Command="{Binding SetReportModeCommand}" CommandParameter="{x:Static viewmodels:AccountReportMode.UserLogRegister}">
                                <Grid Width="240">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="26." FontWeight="Bold" Foreground="#64748B" FontSize="11"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="User Log Register" FontWeight="SemiBold" Foreground="White" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Border Height="20"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- RIGHT MAIN PANEL: Filters + KPIs + Grid -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Filters -->
                    <RowDefinition Height="Auto"/> <!-- Metric KPI Cards -->
                    <RowDefinition Height="*"/>    <!-- Data Grid -->
                </Grid.RowDefinitions>

                <!-- Filter Panel -->
                <Border Grid.Row="0" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="14,8">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Date Filters -->
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsDateFilterVisible, Converter={StaticResource BoolToVis}}" Margin="0,0,14,4">
                            <CheckBox Content="All Dates" IsChecked="{Binding IsAllDates}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            
                            <TextBlock Text="From:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold" Foreground="#475569"/>
                            <DatePicker SelectedDate="{Binding FromDate}" Width="115" Height="34" Margin="0,0,10,0" Background="White"/>

                            <TextBlock Text="To:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold" Foreground="#475569"/>
                            <DatePicker SelectedDate="{Binding ToDate}" Width="115" Height="34" Margin="0,0,10,0" Background="White"/>
                        </StackPanel>

                        <!-- Account Filter -->
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsAccountFilterVisible, Converter={StaticResource BoolToVis}}" Margin="0,0,14,4">
                            <TextBlock Text="Account:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold" Foreground="#475569"/>
                            <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" DisplayMemberPath="DisplayName" Width="260" Height="34" Background="White">
                                <ComboBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ComboBox.ItemsPanel>
                            </ComboBox>
                        </StackPanel>

                        <!-- Markup Rate Filter -->
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsMarkupRateVisible, Converter={StaticResource BoolToVis}}" Margin="0,0,14,4">
                            <TextBlock Text="Markup Rate (%):" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold" Foreground="#475569"/>
                            <TextBox Text="{Binding MarkupRate, UpdateSourceTrigger=PropertyChanged}" Width="75" Height="34" Background="White" Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="6,4"/>
                        </StackPanel>

                        <!-- Category Filter -->
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsCategoryFilterVisible, Converter={StaticResource BoolToVis}}" Margin="0,0,14,4">
                            <TextBlock Text="Category:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold" Foreground="#475569"/>
                            <ComboBox ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding SelectedCategory}" Width="150" Height="34" Background="White"/>
                        </StackPanel>

                        <!-- Voucher Type Filter -->
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsVoucherTypeFilterVisible, Converter={StaticResource BoolToVis}}" Margin="0,0,14,4">
                            <TextBlock Text="Voucher Type:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold" Foreground="#475569"/>
                            <ComboBox ItemsSource="{Binding VoucherTypeOptions}" SelectedItem="{Binding SelectedVoucherType}" Width="160" Height="34" Background="White"/>
                        </StackPanel>

                        <!-- Refresh / Load Button -->
                        <Button Command="{Binding LoadReportCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#0284C7" Margin="6,0,0,4" Height="34">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Load Report" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Border>

                <!-- Metric Summary KPI Cards -->
                <Border Grid.Row="1" Background="#F8FAFC" Padding="12,6">
                    <UniformGrid Columns="4">
                        <!-- KPI Card 1 -->
                        <Border Style="{StaticResource ModernCard}" BorderThickness="4,0,0,0" BorderBrush="#0284C7">
                            <StackPanel>
                                <TextBlock Text="{Binding Kpi1Label}" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock Text="{Binding Kpi1Value}" FontSize="17" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- KPI Card 2 -->
                        <Border Style="{StaticResource ModernCard}" BorderThickness="4,0,0,0" BorderBrush="#8B5CF6">
                            <StackPanel>
                                <TextBlock Text="{Binding Kpi2Label}" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock Text="{Binding Kpi2Value}" FontSize="17" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- KPI Card 3 -->
                        <Border Style="{StaticResource ModernCard}" BorderThickness="4,0,0,0" BorderBrush="#10B981">
                            <StackPanel>
                                <TextBlock Text="{Binding Kpi3Label}" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock Text="{Binding Kpi3Value}" FontSize="17" FontWeight="Bold" Foreground="#10B981" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- KPI Card 4: Total Records -->
                        <Border Style="{StaticResource ModernCard}" BorderThickness="4,0,0,0" BorderBrush="#F59E0B">
                            <StackPanel>
                                <TextBlock Text="TOTAL RECORDS" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock Text="{Binding TotalRecords}" FontSize="17" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Border>

                <!-- DataGrid & Loading Overlay -->
                <Grid Grid.Row="2" Margin="14,4,14,8">
                    <Border Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
                        <DataGrid x:Name="ReportDataGrid" ItemsSource="{Binding ReportRows}" AutoGenerateColumns="False" 
                                  IsReadOnly="True" CanUserSortColumns="True"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                                  RowHeight="32" HeadersVisibility="Column"
                                  BorderThickness="0" Background="Transparent"
                                  AlternatingRowBackground="#F8FAFC">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F1F5F9"/>
                                    <Setter Property="Foreground" Value="#334155"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                        </DataGrid>
                    </Border>

                    <!-- Loading Overlay -->
                    <Border Background="#80FFFFFF" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" CornerRadius="8">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" Width="140" Height="6"/>
                            <TextBlock Text="Loading Report..." Margin="0,8,0,0" FontWeight="SemiBold" Foreground="#334155"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- 3. Footer -->
        <Border Grid.Row="2" Background="#0F172A" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="agentcore ERP" Foreground="#38BDF8" FontWeight="Bold" FontSize="11"/>
                    <TextBlock Text=" • Authentic AgenSoft Account Reports Engine (26 Reports)" Foreground="#94A3B8" FontSize="11" Margin="6,0,0,0"/>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="City Computers Marot — 0344-7436314" Foreground="#64748B" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Shortcuts: F5 = Load Report | Esc = Close" Foreground="#94A3B8" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
