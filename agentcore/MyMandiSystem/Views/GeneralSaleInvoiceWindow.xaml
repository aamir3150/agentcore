<Window x:Class="MyMandiSystem.Views.GeneralSaleInvoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" 
        Height="780" Width="1200"
        MinHeight="650" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        FontFamily="Segoe UI" FontSize="12">

    <Window.Resources>
        <Style x:Key="ClassicButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="8,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#10B981"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#A7F3D0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="25"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="25"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <DockPanel LastChildFill="True">

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                     TOP HEADER INFO BAR                    -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Sale ID:" VerticalAlignment="Center" FontWeight="Bold"/>
                    <TextBox Grid.Column="1" Text="{Binding SaleId}" IsReadOnly="True" FontWeight="Bold" Foreground="#047857"/>

                    <TextBlock Grid.Column="3" Text="Invoice Date:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <DatePicker Grid.Column="4" SelectedDate="{Binding SaleDate}" Height="25"/>

                    <TextBlock Grid.Column="6" Text="Vehicle No:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBox Grid.Column="7" Text="{Binding VehicleNo}"/>

                    <TextBlock Grid.Column="9" Text="Crop Season:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <ComboBox Grid.Column="10" ItemsSource="{Binding CropSeasons}" SelectedItem="{Binding SelectedCropSeason}"/>

                    <CheckBox Grid.Column="11" Content="Cash Sale" IsChecked="{Binding IsCashInvoice}" 
                              HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" Foreground="#047857"/>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                   CUSTOMER / PARTY CARD                    -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Customer / Buyer:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#047857"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableCustomers}" SelectedItem="{Binding SelectedCustomer}"
                              DisplayMemberPath="Name" IsEditable="True"/>

                    <TextBlock Grid.Column="3" Text="Address:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBox Grid.Column="4" Text="{Binding Address}" IsReadOnly="True" Background="#F8FAFC"/>

                    <TextBlock Grid.Column="6" Text="Prev. Balance:" VerticalAlignment="Center" FontWeight="Bold"/>
                    <TextBox Grid.Column="7" Text="{Binding PreviousBalance, StringFormat={}{0:N0}}" IsReadOnly="True" FontWeight="Bold" 
                             HorizontalContentAlignment="Right" Foreground="#B91C1C" Background="#FEF2F2"/>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                     ITEM ENTRY BAR                         -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border DockPanel.Dock="Top" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="75"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="85"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="95"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Labels -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Product / Item" FontWeight="Bold" Foreground="#047857"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Unit / Pack" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="0" Grid.Column="4" Text="Avail Stock" FontWeight="Bold" Foreground="#1E3A8A"/>
                    <TextBlock Grid.Row="0" Grid.Column="6" Text="Quantity" FontWeight="Bold"/>
                    <TextBlock Grid.Row="0" Grid.Column="8" Text="Bonus" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="0" Grid.Column="10" Text="Price / Rate" FontWeight="Bold"/>
                    <TextBlock Grid.Row="0" Grid.Column="12" Text="Disc %" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="0" Grid.Column="14" Text="S.Tax %" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="0" Grid.Column="16" Text="Net Line Amount" FontWeight="Bold" Foreground="#047857"/>

                    <!-- Inputs -->
                    <ComboBox Grid.Row="1" Grid.Column="0" ItemsSource="{Binding AvailableProducts}" SelectedItem="{Binding SelectedProduct}"
                              DisplayMemberPath="Name" IsEditable="True"/>
                    <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding CurrentUnitName}" IsReadOnly="True" Background="#F8FAFC"/>
                    <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding AvailableStock, StringFormat={}{0:N0}}" IsReadOnly="True" FontWeight="Bold" Foreground="#1E3A8A" Background="#EFF6FF" ToolTip="Current Available Stock"/>
                    <TextBox Grid.Row="1" Grid.Column="6" Text="{Binding CurrentQty, UpdateSourceTrigger=PropertyChanged}" FontWeight="Bold"/>
                    <TextBox Grid.Row="1" Grid.Column="8" Text="{Binding CurrentBonus, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBox Grid.Row="1" Grid.Column="10" Text="{Binding CurrentPrice, UpdateSourceTrigger=PropertyChanged}" FontWeight="Bold"/>
                    <TextBox Grid.Row="1" Grid.Column="12" Text="{Binding CurrentDiscRatio, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBox Grid.Row="1" Grid.Column="14" Text="{Binding CurrentSTRatio, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBox Grid.Row="1" Grid.Column="16" Text="{Binding CurrentLineNet, StringFormat={}{0:N0}}" IsReadOnly="True" FontWeight="Bold" Foreground="#047857" Background="#F8FAFC"/>

                    <Button Grid.Row="1" Grid.Column="18" Content="+ Add Line Item" Command="{Binding AddItemCommand}"
                            Background="#10B981" Foreground="#FFFFFF" FontWeight="Bold" BorderBrush="#059669" Height="25"/>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                   BOTTOM BUTTONS BAR                       -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border DockPanel.Dock="Bottom" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,6,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource ClassicButton}" Background="#10B981" Foreground="#FFFFFF" BorderBrush="#059669"/>
                        <Button Content="New" Command="{Binding NewCommand}" Style="{StaticResource ClassicButton}"/>
                        <Button Content="Open" Command="{Binding OpenCommand}" Style="{StaticResource ClassicButton}"/>
                        <Button Content="Delete" Command="{Binding DeleteCommand}" Style="{StaticResource ClassicButton}" Background="#EF4444" Foreground="#FFFFFF" BorderBrush="#DC2626"/>
                        <Button Content="Print" Command="{Binding PrintCommand}" Style="{StaticResource ClassicButton}"/>
                    </StackPanel>

                    <Button Content="Close" HorizontalAlignment="Right" Style="{StaticResource ClassicButton}" Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                 BOTTOM EXPENSE & TOTALS CARD               -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border DockPanel.Dock="Bottom" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,6,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Narrations -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Narration / Remarks:" FontWeight="SemiBold" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding Narration}" Height="30" Margin="0,0,0,6"/>

                        <TextBlock Text="Additional Reference:" FontWeight="SemiBold" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding NarrationUrdu}" Height="30"/>
                    </StackPanel>

                    <!-- Right: Financial Summary -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <!-- Row 0 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Gross Total:" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding GrossTotal, StringFormat={}{0:N0}}" IsReadOnly="True" HorizontalContentAlignment="Right" FontWeight="Bold"/>

                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Net Receivable:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#047857"/>
                        <TextBox Grid.Row="0" Grid.Column="4" Text="{Binding NetReceivable, StringFormat={}{0:N0}}" IsReadOnly="True" HorizontalContentAlignment="Right" 
                                 FontWeight="Bold" Foreground="#047857" FontSize="14" Background="#ECFDF5"/>

                        <!-- Row 1 -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Total Discount:" VerticalAlignment="Center" Margin="0,3,0,0"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TotalDiscount, StringFormat={}{0:N0}}" IsReadOnly="True" HorizontalContentAlignment="Right" Margin="0,3,0,0"/>

                        <TextBlock Grid.Row="1" Grid.Column="3" Text="Received Amt:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,3,0,0"/>
                        <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding ReceivedAmount, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}" 
                                 HorizontalContentAlignment="Right" FontWeight="Bold" Foreground="#15803D" Margin="0,3,0,0"/>

                        <!-- Row 2 -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Sales Tax:" VerticalAlignment="Center" Margin="0,3,0,0"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding TotalSalesTax, StringFormat={}{0:N0}}" IsReadOnly="True" HorizontalContentAlignment="Right" Margin="0,3,0,0"/>

                        <TextBlock Grid.Row="2" Grid.Column="3" Text="Rem. Balance:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,3,0,0"/>
                        <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding RemainingBalance, StringFormat={}{0:N0}}" IsReadOnly="True" 
                                 HorizontalContentAlignment="Right" FontWeight="Bold" Foreground="#B91C1C" FontSize="13" Background="#FEF2F2" Margin="0,3,0,0"/>

                        <!-- Row 3: Freight, ExpPlus, ExpMinus -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Freight:" VerticalAlignment="Center" Margin="0,3,0,0"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Freight, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Right" Margin="0,3,0,0"/>

                        <TextBlock Grid.Row="3" Grid.Column="3" Text="Expenses (+ / -):" VerticalAlignment="Center" Margin="0,3,0,0"/>
                        <Grid Grid.Row="3" Grid.Column="4" Margin="0,3,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding ExpPlus, UpdateSourceTrigger=PropertyChanged}" ToolTip="Expenses Plus (+)" HorizontalContentAlignment="Right"/>
                            <TextBox Grid.Column="2" Text="{Binding ExpMinus, UpdateSourceTrigger=PropertyChanged}" ToolTip="Expenses Minus (-)" HorizontalContentAlignment="Right"/>
                        </Grid>

                        <!-- Row 4: ComRatio & WHT / Special Discount -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Com % / Val:" VerticalAlignment="Center" Margin="0,3,0,0"/>
                        <Grid Grid.Row="4" Grid.Column="1" Margin="0,3,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="45"/>
                                <ColumnDefinition Width="2"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding ComRatio, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Right"/>
                            <TextBox Grid.Column="2" Text="{Binding CommissionAmount, StringFormat={}{0:N0}}" IsReadOnly="True" HorizontalContentAlignment="Right"/>
                        </Grid>

                        <TextBlock Grid.Row="4" Grid.Column="3" Text="Special Disc:" VerticalAlignment="Center" Margin="0,3,0,0"/>
                        <TextBox Grid.Row="4" Grid.Column="4" Text="{Binding SpecialDiscount, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Right" Margin="0,3,0,0"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                   ITEMS DATA GRID                          -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                <DataGrid ItemsSource="{Binding Items}" 
                          SelectedItem="{Binding SelectedGridItem}"
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E2E8F0"
                          RowHeight="32"
                          materialDesign:DataGridAssist.CellPadding="6,2,6,2">
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="6,2"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter VerticalAlignment="Center" SnapsToDevicePixels="True"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Height" Value="32"/>
                            <Setter Property="MinHeight" Value="32"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F8FAFC"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#E2E8F0"/>
                                    <Setter Property="Foreground" Value="#0F172A"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#1E293B"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Height" Value="30"/>
                            <Setter Property="Padding" Value="6,0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding SerialNo}" Width="35" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Code" Binding="{Binding ProductCode}" Width="75" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="6,0,0,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="*" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="6,0,0,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Unit" Binding="{Binding UnitName}" Width="85" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Avail Stock" Binding="{Binding AvailableStock, StringFormat={}{0:N0}}" Width="80" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#1E3A8A"/>
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="0,0,6,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="75">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="0,0,6,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Bonus" Binding="{Binding Bonus}" Width="55">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="0,0,6,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Price / Rate" Binding="{Binding Price, StringFormat={}{0:N2}}" Width="85">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="0,0,6,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Gross Amount" Binding="{Binding GrossAmount, StringFormat={}{0:N0}}" Width="95" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="0,0,6,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Disc %" Binding="{Binding DiscRatio}" Width="55">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="0,0,6,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Disc Val" Binding="{Binding DiscValue, StringFormat={}{0:N0}}" Width="70" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="0,0,6,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="ST %" Binding="{Binding STRatio}" Width="50">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="0,0,6,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="ST Val" Binding="{Binding STValue, StringFormat={}{0:N0}}" Width="65" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="0,0,6,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Net Amount" Binding="{Binding TotalValue, StringFormat={}{0:N0}}" Width="110" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#047857"/>
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="0,0,6,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Actions Column -->
                        <DataGridTemplateColumn Header="Action" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="✕" 
                                            Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Foreground="#DC2626" Background="Transparent" BorderThickness="0" FontWeight="Bold"
                                            Padding="4,0" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Cursor="Hand" ToolTip="Remove Item"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

        </DockPanel>
    </Grid>
