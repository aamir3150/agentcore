<Window x:Class="MyMandiSystem.Views.PromisesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="740" Width="1200"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushSurfaceBg}"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Border Margin="16" Background="#FFFFFF" CornerRadius="16" BorderBrush="{StaticResource BrushSurfaceBorder}" BorderThickness="1" Effect="{StaticResource EffectCardShadow}">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. Header Banner -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource BrushGradientIndigo}" Margin="0,0,14,0" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Handshake" Width="26" Height="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Promises &amp; Commitments Management" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryNavy}"/>
                    <TextBlock Text="Track and fulfill cash collection &amp; disbursement promises / پارٹیوں سے رقم کی وصولی اور ادائیگی کے وعدے" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#F8FAFC" BorderBrush="{StaticResource BrushSurfaceBorder}" BorderThickness="1" CornerRadius="8" Padding="8,2" Width="240" Margin="0,0,8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Grid.Column="1" 
                                     materialDesign:HintAssist.Hint="Search party, narration... / تلاش کریں" 
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                     BorderThickness="0" Background="Transparent" VerticalAlignment="Center"
                                     FontSize="12"/>
                        </Grid>
                    </Border>

                    <Button Content="+ Add Promise" Command="{Binding AddPromiseCommand}" Style="{StaticResource ModernPrimaryButton}" Height="36" Margin="0,0,6,0"/>
                    <Button Content="Edit" Command="{Binding EditPromiseCommand}" CommandParameter="{Binding SelectedPromise}" Style="{StaticResource ModernSecondaryButton}" Height="36" Margin="0,0,6,0"/>
                    <Button Content="Toggle Status" Command="{Binding ToggleFulfilledCommand}" CommandParameter="{Binding SelectedPromise}" Style="{StaticResource ModernSecondaryButton}" Height="36" Margin="0,0,6,0"/>
                    <Button Content="Delete" Command="{Binding DeletePromiseCommand}" CommandParameter="{Binding SelectedPromise}" Style="{StaticResource ModernDangerButton}" Height="36"/>
                </StackPanel>
            </Grid>

            <!-- 2. Metrics & Filter Row -->
            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Filters -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <!-- Type Filter -->
                    <Border Background="#F1F5F9" CornerRadius="8" Padding="4" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="All Types (تمام)" IsChecked="{Binding IsTypeAll}" Style="{StaticResource MaterialDesignTabRadioButton}" Margin="2,0"/>
                            <RadioButton Content="Receiving (وصولی)" IsChecked="{Binding IsTypeReceiving}" Style="{StaticResource MaterialDesignTabRadioButton}" Margin="2,0"/>
                            <RadioButton Content="Payment (ادائیگی)" IsChecked="{Binding IsTypePayment}" Style="{StaticResource MaterialDesignTabRadioButton}" Margin="2,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Status Filter -->
                    <Border Background="#F1F5F9" CornerRadius="8" Padding="4">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="All Status (تمام)" IsChecked="{Binding IsStatusAll}" Style="{StaticResource MaterialDesignTabRadioButton}" Margin="2,0"/>
                            <RadioButton Content="Pending (زیر التواء)" IsChecked="{Binding IsStatusPending}" Style="{StaticResource MaterialDesignTabRadioButton}" Margin="2,0"/>
                            <RadioButton Content="Fulfilled (مکمل)" IsChecked="{Binding IsStatusFulfilled}" Style="{StaticResource MaterialDesignTabRadioButton}" Margin="2,0"/>
                            <RadioButton Content="Overdue (میعاد گزری)" IsChecked="{Binding IsStatusOverdue}" Style="{StaticResource MaterialDesignTabRadioButton}" Margin="2,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Metric Summary Chips -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Pending Receivable: " FontSize="11" Foreground="#065F46" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalReceivable, StringFormat=₨ {0:N2}}" FontSize="12" FontWeight="Bold" Foreground="#047857" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Pending Payable: " FontSize="11" Foreground="#991B1B" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalPayable, StringFormat=₨ {0:N2}}" FontSize="12" FontWeight="Bold" Foreground="#B91C1C" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- 3. Main DataGrid + Form Drawer -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- DataGrid -->
                <Border Grid.Column="0" CornerRadius="12" BorderBrush="{StaticResource BrushSurfaceBorder}" BorderThickness="1" ClipToBounds="True">
                    <DataGrid ItemsSource="{Binding FilteredPromises}" SelectedItem="{Binding SelectedPromise}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single"
                              Style="{StaticResource ModernDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NO #" Binding="{Binding PromiseNo}" Width="65"/>
                            <DataGridTextColumn Header="TYPE / نوعیت" Binding="{Binding PromiseTypeDescription}" Width="120"/>
                            <DataGridTextColumn Header="PARTY NAME / پارٹی کا نام" Binding="{Binding Party.Name}" Width="*"/>
                            <DataGridTextColumn Header="ENTRY DATE" Binding="{Binding PromiseDate, StringFormat=dd/MM/yyyy}" Width="100"/>
                            <DataGridTextColumn Header="PROMISED DATE" Binding="{Binding DueDate, StringFormat=dd/MM/yyyy}" Width="110"/>
                            <DataGridTextColumn Header="AMOUNT (₨)" Binding="{Binding Amount, StringFormat=N2}" Width="130"/>
                            <DataGridTextColumn Header="NARRATION / وجہ" Binding="{Binding Reason}" Width="160"/>
                            <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Right Side Form Drawer -->
                <Border Grid.Column="1" Width="360" Margin="16,0,0,0" CornerRadius="14" BorderBrush="{StaticResource BrushSurfaceBorder}" 
                        BorderThickness="1" Background="#F8FAFC" Padding="18"
                        Visibility="{Binding IsFormVisible, Converter={StaticResource BoolToVis}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Promise Details / وعدہ تفصیلات" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryNavy}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Command="{Binding CancelPromiseCommand}" Style="{StaticResource MaterialDesignIconButton}" Width="28" Height="28">
                                    <materialDesign:PackIcon Kind="Close" Width="18" Height="18" Foreground="{StaticResource BrushTextSecondary}"/>
                                </Button>
                            </Grid>

                            <!-- Type Radio Buttons -->
                            <TextBlock Text="Promise Type / نوعیتِ وعدہ" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <RadioButton Content="Receiving (وصولی)" IsChecked="{Binding IsReceivingPromise}" Margin="0,0,16,0" FontWeight="SemiBold"/>
                                <RadioButton Content="Payment (ادائیگی)" IsChecked="{Binding IsPaymentPromise}" FontWeight="SemiBold"/>
                            </StackPanel>

                            <!-- Party Combo -->
                            <ComboBox materialDesign:HintAssist.Hint="Select Party / پارٹی منتخب کریں"
                                      ItemsSource="{Binding Parties}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding CurrentPromise.PartyId}"
                                      Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                      Margin="0,0,0,12"/>

                            <!-- Amount -->
                            <TextBox materialDesign:HintAssist.Hint="Promise Amount (₨ / رقم)" 
                                     Text="{Binding CurrentPromise.Amount, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" 
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                                     Margin="0,0,0,12"/>

                            <!-- Promised / Due Date -->
                            <TextBlock Text="Promised Due Date (وعدے کی تاریخ)" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,2"/>
                            <DatePicker SelectedDate="{Binding CurrentPromise.DueDate}" Margin="0,0,0,12" Background="White"/>

                            <!-- Entry Date -->
                            <TextBlock Text="Entry Date (اندراج کی تاریخ)" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,2"/>
                            <DatePicker SelectedDate="{Binding CurrentPromise.PromiseDate}" Margin="0,0,0,12" Background="White"/>

                            <!-- Narration -->
                            <TextBox materialDesign:HintAssist.Hint="Narration / تفصیل / وجہ" 
                                     Text="{Binding CurrentPromise.Reason, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                                     Margin="0,0,0,18"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Cancel" Command="{Binding CancelPromiseCommand}" Style="{StaticResource ModernSecondaryButton}" Height="34" Margin="0,0,8,0"/>
                                <Button Content="Save Promise" Command="{Binding SavePromiseCommand}" Style="{StaticResource ModernPrimaryButton}" Height="34"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
