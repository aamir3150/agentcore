<Window x:Class="MyMandiSystem.Views.PestroOpeningStockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Opening Stock (Pestro) - پیسٹرو ابتدائی اسٹاک" 
        Height="700" Width="1050"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#EAEAEA"
        FontFamily="Segoe UI" FontSize="11.5">

    <Window.Resources>
        <Style x:Key="ClassicButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="85"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Background" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="#707070"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="3" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="8,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#E0EEF8"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#059669"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#A7F3D0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="BorderBrush" Value="#7A7A7A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="BorderBrush" Value="#7A7A7A"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12,8">
        <DockPanel LastChildFill="True">

            <!-- TOP BANNER -->
            <Border DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="#C0C0C0" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Kind="Warehouse" Width="32" Height="32" Foreground="#059669" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Opening Stock (Pestro) - پیسٹرو ابتدائی اسٹاک اندراج" FontSize="18" FontWeight="Bold" Foreground="#064E3B"/>
                        <TextBlock Text="AgenSoft Authentic Batch Allocation &amp; CurrentStockPestro Synchronization" FontSize="11" Foreground="#555555"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- BOTTOM TOOLBAR -->
            <Border DockPanel.Dock="Bottom" Background="#DCDCDC" BorderBrush="#B8B8B8" BorderThickness="0,1,0,0" Padding="8,8" Margin="0,8,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource ClassicButton}" Command="{Binding SaveCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSaveOutline" Width="14" Height="14" Foreground="#059669" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Save (محفوظ کریں)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ClassicButton}" Command="{Binding DeleteAllStockForProductCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="DeleteOutline" Width="14" Height="14" Foreground="#DC2626" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Delete (حذف کریں)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ClassicButton}" Command="{Binding ClearCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14" Foreground="#4B5563" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Clear (صاف)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ClassicButton}" Command="{Binding CloseCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CloseBoxOutline" Width="14" Height="14" Foreground="#DC2626" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Close (بند کریں)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- MAIN SPLIT CONTENT -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT PANEL: PRODUCT SELECTION & FILTER -->
                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#C0C0C0" BorderThickness="1" CornerRadius="4" Padding="10">
                    <DockPanel LastChildFill="True">
                        <!-- Filters -->
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="Company (کمپنی):" FontWeight="SemiBold" Margin="0,0,0,2"/>
                            <ComboBox ItemsSource="{Binding Companies}" DisplayMemberPath="CompanyName" SelectedItem="{Binding SelectedCompany}" Height="26" Margin="0,0,0,8"/>

                            <TextBlock Text="Search Product (پروڈکٹ تلاش):" FontWeight="SemiBold" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" Height="25"/>
                        </StackPanel>

                        <!-- Products DataGrid -->
                        <Border BorderBrush="#D0D0D0" BorderThickness="1" Margin="0,4,0,0">
                            <DataGrid ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="All" HeadersVisibility="Column" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Code" Binding="{Binding ProductId}" Width="65"/>
                                    <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="*"/>
                                    <DataGridTextColumn Header="Cost" Binding="{Binding Cost, StringFormat=N2}" Width="70">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="Margin" Value="0,0,4,0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Stock Qty" Binding="{Binding Quantity, StringFormat=N0}" Width="75">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Foreground" Value="#047857"/>
                                                <Setter Property="Margin" Value="0,0,4,0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </DockPanel>
                </Border>

                <!-- SPLITTER -->
                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="#D0D0D0"/>

                <!-- RIGHT PANEL: BATCH BREAKDOWN & ENTRY -->
                <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#C0C0C0" BorderThickness="1" CornerRadius="4" Padding="12">
                    <DockPanel LastChildFill="True">

                        <!-- SELECTED PRODUCT HEADER -->
                        <Border DockPanel.Dock="Top" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Selected:" FontWeight="Bold" Foreground="#166534" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedProduct.ProductName, TargetNullValue='No Product Selected'}" FontWeight="Bold" FontSize="13" Foreground="#064E3B" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding SelectedProduct.ProductId, StringFormat='[Code: {0}]'}" Foreground="#555555" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- BATCH ENTRY INPUTS -->
                        <Border DockPanel.Dock="Top" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Labels -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Batch No (بیچ نمبر)*:" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Expiry Date (ایکسپائری):" FontWeight="SemiBold" Margin="6,0,0,3"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Quantity (تعداد)*:" FontWeight="SemiBold" Margin="6,0,0,3"/>
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="Cost Price (قیمت خرید):" FontWeight="SemiBold" Margin="6,0,0,3"/>

                                <!-- Inputs -->
                                <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding InputBatchNo, UpdateSourceTrigger=PropertyChanged}"/>
                                <DatePicker Grid.Row="1" Grid.Column="1" SelectedDate="{Binding InputExpiryDate}" Height="24" Margin="6,0,0,0"/>
                                <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding InputQuantity, UpdateSourceTrigger=PropertyChanged}" Margin="6,0,0,0" TextAlignment="Right"/>
                                <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding InputCost, UpdateSourceTrigger=PropertyChanged}" Margin="6,0,0,0" TextAlignment="Right"/>

                                <Button Grid.Row="1" Grid.Column="4" Style="{StaticResource ClassicButton}" Command="{Binding AddBatchCommand}" HorizontalAlignment="Left" Margin="10,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="PlusCircleOutline" Width="14" Height="14" Foreground="#0284C7" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Add Batch (بیچ شامل کریں)" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- TOTALS BAR -->
                        <Border DockPanel.Dock="Bottom" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Padding="10,6" Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Batch Breakdown Summary" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,20,0" VerticalAlignment="Center">
                                    <TextBlock Text="Total Quantity: " FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding TotalStockQuantity, StringFormat=N0}" FontWeight="ExtraBold" Foreground="#0F766E"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Total Value: " FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding TotalStockValue, StringFormat='Rs. {0:N2}'}" FontWeight="ExtraBold" Foreground="#1E3A8A"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- BATCHES GRID -->
                        <Border BorderBrush="#D0D0D0" BorderThickness="1">
                            <DataGrid ItemsSource="{Binding Batches}" SelectedItem="{Binding SelectedBatch}" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="All" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Batch No" Binding="{Binding BatchNo}" Width="130" FontWeight="SemiBold"/>
                                    <DataGridTextColumn Header="Expiry Date" Binding="{Binding ExpiryDate, StringFormat='dd/MM/yyyy'}" Width="120"/>
                                    <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity, StringFormat=N0}" Width="90">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Foreground" Value="#047857"/>
                                                <Setter Property="Margin" Value="0,0,4,0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Cost" Binding="{Binding Cost, StringFormat=N2}" Width="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="Margin" Value="0,0,4,0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Total Value" Binding="{Binding Value, StringFormat=N2}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Foreground" Value="#1E40AF"/>
                                                <Setter Property="Margin" Value="0,0,4,0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="Action" Width="70">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource ClassicButton}" Height="20" MinWidth="40" Margin="2" Padding="2" Command="{Binding DataContext.DeleteBatchCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                                                    <materialDesign:PackIcon Kind="TrashCanOutline" Width="12" Height="12" Foreground="#DC2626"/>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </DockPanel>
                </Border>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
