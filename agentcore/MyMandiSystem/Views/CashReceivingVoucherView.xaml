<UserControl x:Class="MyMandiSystem.Views.CashReceivingVoucherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:MyMandiSystem.Helpers"
             mc:Ignorable="d" 
             Background="{StaticResource BrushSurfaceBg}"
             d:DesignHeight="700" d:DesignWidth="960"
             TextElement.Foreground="{StaticResource BrushTextPrimary}"
             FontFamily="{DynamicResource MaterialDesignFont}">
    
    <Border Margin="10" Background="#FFFFFF" BorderBrush="{StaticResource BrushSurfaceBorder}" BorderThickness="1" CornerRadius="16" Effect="{StaticResource EffectCardShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Modern Header -->
                <RowDefinition Height="Auto"/>  <!-- Top Metadata Row -->
                <RowDefinition Height="Auto"/>  <!-- Entry Fields Row -->
                <RowDefinition Height="*"/>     <!-- DataGrid -->
                <RowDefinition Height="Auto"/>  <!-- Urdu + Totals -->
                <RowDefinition Height="Auto"/>  <!-- Denominations Grid -->
                <RowDefinition Height="Auto"/>  <!-- Action Footer -->
            </Grid.RowDefinitions>

            <!-- ═══ 1. MODERN HEADER BANNER ═══ -->
            <Border Grid.Row="0" CornerRadius="16,16,0,0" Background="{StaticResource BrushGradientEmerald}" Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="40" Height="40" CornerRadius="10" Background="#30FFFFFF" Margin="0,0,14,0" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="CashPlus" Width="22" Height="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Cash Receiving Voucher (Credit)" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Record and post cash inflows from customer accounts" FontSize="11.5" Foreground="#D1FAE5"/>
                    </StackPanel>

                    <!-- Cash In Hand Pill -->
                    <Border Grid.Column="2" Background="#20FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="10" Padding="12,6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="In Hand Cash: " FontSize="11.5" Foreground="#E6FFFA" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CashInHand}" FontSize="14" FontWeight="Black" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ═══ 2. TOP METADATA ROW ═══ -->
            <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="{StaticResource BrushSurfaceBorder}" BorderThickness="0,0,0,1" Padding="18,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Voucher No -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Voucher Number" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding VoucherNo}" FontSize="13" FontWeight="Bold" Background="#FFFFFF" Padding="8,4" BorderBrush="{StaticResource BrushSurfaceBorderDark}"/>
                    </StackPanel>

                    <!-- Voucher Date -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Posting Date" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding VoucherDate}" FontSize="13" Background="#FFFFFF" Padding="6,2"/>
                    </StackPanel>

                    <!-- Crop Season -->
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Crop Season" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding CropSeasons}" SelectedItem="{Binding CropSeason}" FontSize="13" Background="#FFFFFF" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ 3. QUICK ENTRY FIELDS ROW ═══ -->
            <Border Grid.Row="2" Background="#FFFFFF" Padding="18,12" BorderBrush="{StaticResource BrushSurfaceBorder}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>

                    <!-- A/c No -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="A/c Code" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding AccountNo, UpdateSourceTrigger=PropertyChanged}" FontSize="12.5" Padding="6,4" BorderBrush="{StaticResource BrushSurfaceBorderDark}"/>
                    </StackPanel>

                    <!-- A/c Name + Lookup -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Account Title" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"/>
                        <Grid>
                            <TextBox Text="{Binding AccountName}" IsReadOnly="True" Background="#F8FAFC" FontSize="12.5" Padding="6,4,28,4" BorderBrush="{StaticResource BrushSurfaceBorderDark}"/>
                            <Button Content="..." HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="26" Margin="1"
                                    Command="{Binding LookupAccountCommand}" FontWeight="Bold" Style="{StaticResource MaterialDesignFlatButton}" Padding="0"/>
                        </Grid>
                    </StackPanel>

                    <!-- Narration -->
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Transaction Narration / Description" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Narration}" FontSize="12.5" Padding="6,4" BorderBrush="{StaticResource BrushSurfaceBorderDark}"/>
                    </StackPanel>

                    <!-- Amount -->
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Amount (PKR)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Amount}" HorizontalContentAlignment="Right" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushAccentEmerald}" Padding="6,4" BorderBrush="{StaticResource BrushSurfaceBorderDark}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ 4. TRANSACTION DATAGRID ═══ -->
            <Border Grid.Row="3" Margin="18,12,18,8" CornerRadius="10" BorderBrush="{StaticResource BrushSurfaceBorder}" BorderThickness="1" ClipToBounds="True">
                <DataGrid ItemsSource="{Binding Details}" AutoGenerateColumns="False" CanUserAddRows="False"
                          Style="{StaticResource ModernDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="A/C CODE" Binding="{Binding AccountNo}" Width="110"/>
                        <DataGridTextColumn Header="ACCOUNT TITLE" Width="240"/>
                        <DataGridTextColumn Header="NARRATION" Binding="{Binding Narration}" Width="*"/>
                        <DataGridTextColumn Header="CREDIT AMOUNT (PKR)" Binding="{Binding Credit, StringFormat=N0}" Width="160">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="{StaticResource BrushAccentEmerald}"/>
                                    <Setter Property="Padding" Value="0,0,12,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- ═══ 5. URDU NARRATION + TOTALS ═══ -->
            <Border Grid.Row="4" Background="#F8FAFC" BorderBrush="{StaticResource BrushSurfaceBorder}" BorderThickness="0,1,0,1" Padding="18,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>

                    <!-- Urdu Narration -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Urdu Narration (تفصیل)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding NarrationUrdu}" Style="{StaticResource ModernUrduStandardTextBox}" helpers:UrduHelper.IsUrduOnly="True" Height="38" Background="#FFFFFF" BorderBrush="{StaticResource BrushSurfaceBorderDark}"/>
                    </StackPanel>

                    <!-- Total Amount Display -->
                    <TextBlock Grid.Column="2" Text="Total Amount:" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryNavy}" Margin="0,0,8,0"/>
                    <Border Grid.Column="3" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="10,6" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TotalAmount, StringFormat=N0}" HorizontalAlignment="Right" FontSize="16" FontWeight="Black" Foreground="{StaticResource BrushAccentEmerald}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ═══ 6. DENOMINATIONS CHIPS GRID ═══ -->
            <Border Grid.Row="5" Background="#FFFFFF" Padding="18,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="5,000" HorizontalAlignment="Center" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}"/>
                    <TextBlock Grid.Column="1" Text="1,000" HorizontalAlignment="Center" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}"/>
                    <TextBlock Grid.Column="2" Text="500" HorizontalAlignment="Center" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}"/>
                    <TextBlock Grid.Column="3" Text="100" HorizontalAlignment="Center" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}"/>
                    <TextBlock Grid.Column="4" Text="50" HorizontalAlignment="Center" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}"/>
                    <TextBlock Grid.Column="5" Text="20" HorizontalAlignment="Center" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}"/>
                    <TextBlock Grid.Column="6" Text="10" HorizontalAlignment="Center" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}"/>
                    <TextBlock Grid.Column="7" Text="5" HorizontalAlignment="Center" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}"/>
                    <TextBlock Grid.Column="8" Text="2" HorizontalAlignment="Center" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}"/>
                    <TextBlock Grid.Column="9" Text="1" HorizontalAlignment="Center" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}"/>

                    <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding Count5000}" HorizontalContentAlignment="Center" Margin="2,3" FontSize="11" Padding="2" BorderBrush="{StaticResource BrushSurfaceBorderDark}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Count1000}" HorizontalContentAlignment="Center" Margin="2,3" FontSize="11" Padding="2" BorderBrush="{StaticResource BrushSurfaceBorderDark}"/>
                    <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Count500}" HorizontalContentAlignment="Center" Margin="2,3" FontSize="11" Padding="2" BorderBrush="{StaticResource BrushSurfaceBorderDark}"/>
                    <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding Count100}" HorizontalContentAlignment="Center" Margin="2,3" FontSize="11" Padding="2" BorderBrush="{StaticResource BrushSurfaceBorderDark}"/>
                    <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding Count50}" HorizontalContentAlignment="Center" Margin="2,3" FontSize="11" Padding="2" BorderBrush="{StaticResource BrushSurfaceBorderDark}"/>
                    <TextBox Grid.Row="1" Grid.Column="5" Text="{Binding Count20}" HorizontalContentAlignment="Center" Margin="2,3" FontSize="11" Padding="2" BorderBrush="{StaticResource BrushSurfaceBorderDark}"/>
                    <TextBox Grid.Row="1" Grid.Column="6" Text="{Binding Count10}" HorizontalContentAlignment="Center" Margin="2,3" FontSize="11" Padding="2" BorderBrush="{StaticResource BrushSurfaceBorderDark}"/>
                    <TextBox Grid.Row="1" Grid.Column="7" Text="{Binding Count5}" HorizontalContentAlignment="Center" Margin="2,3" FontSize="11" Padding="2" BorderBrush="{StaticResource BrushSurfaceBorderDark}"/>
                    <TextBox Grid.Row="1" Grid.Column="8" Text="{Binding Count2}" HorizontalContentAlignment="Center" Margin="2,3" FontSize="11" Padding="2" BorderBrush="{StaticResource BrushSurfaceBorderDark}"/>
                    <TextBox Grid.Row="1" Grid.Column="9" Text="{Binding Count1}" HorizontalContentAlignment="Center" Margin="2,3" FontSize="11" Padding="2" BorderBrush="{StaticResource BrushSurfaceBorderDark}"/>
                </Grid>
            </Border>

            <!-- ═══ 7. ACTIONS FOOTER ═══ -->
            <Border Grid.Row="6" Background="#F1F5F9" Padding="14,10" CornerRadius="0,0,16,16" BorderBrush="{StaticResource BrushSurfaceBorder}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding SaveCommand}" Style="{StaticResource ModernSuccessButton}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSaveCheckOutline" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Save Voucher" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ClearCommand}" Style="{StaticResource ModernSecondaryButton}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Reset / Clear" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ModernSecondaryButton}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PrinterOutline" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Print" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding CloseCommand}" 
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                            Style="{StaticResource ModernDangerButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CloseCircleOutline" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Close Window" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
