<Window x:Class="MyMandiSystem.Views.CashDepositWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:MyMandiSystem.Helpers"
        mc:Ignorable="d"
        Title="Bank Cash Deposit"
        Height="780" Width="1080"
        MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        FontFamily="Segoe UI" FontSize="12"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="ClassicButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="85"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="10,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#64748B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimarySaveButton" TargetType="Button" BasedOn="{StaticResource ClassicButton}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#1D4ED8"/>
            <Setter Property="MinWidth" Value="125"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="14,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerDeleteButton" TargetType="Button" BasedOn="{StaticResource ClassicButton}">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#B91C1C"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="12,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#B91C1C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#991B1B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <DockPanel LastChildFill="True">

            <!-- ═══ 0. HEADER CARD ═══ -->
            <Border DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#1E3A8A" Margin="0,0,12,0" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="CashPlus" Width="20" Height="20" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Bank Cash Deposit" FontSize="16" FontWeight="Bold" Foreground="#1E3A8A"/>
                            <Border Background="#FEE2E2" BorderBrush="#FECDD3" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding IsExistingVoucher, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="EDITING EXISTING VOUCHER" FontSize="10" FontWeight="Bold" Foreground="#991B1B"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Record cash deposits directly into company bank accounts with real-time General Ledger sync" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Navigation Toolbar -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="StoreOutline" Width="14" Height="14" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding BranchName}" FontSize="11" Foreground="#334155" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Find #:" FontSize="11" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,4,0" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding SearchVoucherNo, UpdateSourceTrigger=PropertyChanged}" Width="75" Height="26" FontSize="11.5" FontWeight="Bold"
                                 Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#94A3B8" Padding="4,2" VerticalContentAlignment="Center" Margin="0,0,4,0">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchVoucherCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        
                        <Button Command="{Binding SearchVoucherCommand}" ToolTip="Search Voucher"
                                Style="{StaticResource ClassicButton}" Width="26" MinWidth="26" Height="26" Padding="0" Margin="0,0,4,0">
                            <materialDesign:PackIcon Kind="Magnify" Width="15" Height="15" Foreground="#334155"/>
                        </Button>

                        <Button Command="{Binding PreviousVoucherCommand}" ToolTip="Previous Voucher (&lt;)"
                                Style="{StaticResource ClassicButton}" Width="26" MinWidth="26" Height="26" Padding="0" Margin="0,0,2,0">
                            <materialDesign:PackIcon Kind="ChevronLeft" Width="18" Height="18" Foreground="#334155"/>
                        </Button>
                        <Button Command="{Binding NextVoucherCommand}" ToolTip="Next Voucher (&gt;)"
                                Style="{StaticResource ClassicButton}" Width="26" MinWidth="26" Height="26" Padding="0">
                            <materialDesign:PackIcon Kind="ChevronRight" Width="18" Height="18" Foreground="#334155"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ 1. METADATA & BALANCES CARD ═══ -->
            <Border DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Voucher No -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Voucher Number" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding VoucherNo}" IsReadOnly="True" FontSize="12.5" FontWeight="Bold" Height="26" Background="#F8FAFC" Padding="6,2" BorderBrush="#CBD5E1"/>
                    </StackPanel>

                    <!-- Voucher Date -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Voucher Date" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,2"/>
                        <DatePicker SelectedDate="{Binding VoucherDate}" FontSize="12" Height="26" Background="#FFFFFF" Padding="4,1" BorderBrush="#94A3B8"/>
                    </StackPanel>

                    <!-- Crop Season -->
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Crop Season" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,2"/>
                        <ComboBox ItemsSource="{Binding Seasons}" SelectedItem="{Binding SelectedSeason}" 
                                  DisplayMemberPath="Name" FontSize="12" Height="26" Background="#FFFFFF" Padding="6,2" BorderBrush="#94A3B8"/>
                    </StackPanel>

                    <!-- Balances: Rokar + Bank Balance -->
                    <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Rokar / Cash in Hand -->
                        <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="4" Padding="10,4" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="CashMultiple" Width="16" Height="16" Foreground="#D97706" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <StackPanel>
                                    <TextBlock Text="Cash in Hand (Rokar)" FontSize="9.5" FontWeight="SemiBold" Foreground="#92400E"/>
                                    <TextBlock Text="{Binding CashInHand, StringFormat='Rs. {0}'}" FontSize="12" FontWeight="Bold" Foreground="#B45309"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Bank Balance Badge -->
                        <Border Background="#E0F2FE" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="4" Padding="10,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Bank" Width="16" Height="16" Foreground="#0284C7" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <StackPanel>
                                    <TextBlock Text="Bank Account Balance" FontSize="9.5" FontWeight="SemiBold" Foreground="#0369A1"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding BankBalance, StringFormat='Rs. {0}'}" FontSize="12" FontWeight="Bold" Foreground="#0C4A6E"/>
                                        <TextBlock Text="{Binding BankBalanceStatus}" FontSize="10" FontWeight="Bold" Foreground="#0284C7" Margin="4,0,0,0" VerticalAlignment="Bottom"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ 3. ACTIONS FOOTER ═══ -->
            <Border DockPanel.Dock="Bottom" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Delete Button -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Command="{Binding DeleteVoucherCommand}" Style="{StaticResource DangerDeleteButton}" ToolTip="Delete Voucher">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="DeleteOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Delete" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Center: Search Bank Deposits -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" Orientation="Horizontal">
                        <Button Command="{Binding OpenSearchModalCommand}" Style="{StaticResource ClassicButton}" Margin="0,0,8,0" ToolTip="Search Bank Cash Deposits (F5)">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FolderSearchOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Find Deposits (F5)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding PrintCommand}" Style="{StaticResource ClassicButton}" ToolTip="Print Deposit Slip (Ctrl+P)">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="PrinterOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Print Slip (Ctrl+P)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Right: Save, Reset, Close -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Command="{Binding NewVoucherCommand}" Style="{StaticResource ClassicButton}" Margin="0,0,6,0" ToolTip="Reset / New Voucher (F3)">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Reset (F3)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding SaveCommand}" Style="{StaticResource PrimarySaveButton}" Margin="0,0,6,0" ToolTip="Save Voucher (F2)">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSaveOutline" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Save Voucher (F2)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding CloseCommand}" Style="{StaticResource ClassicButton}" ToolTip="Close Window (Esc)">
                            <TextBlock Text="Close (Esc)" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ 2. MAIN ENTRY BODY ═══ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- SECTION 1: BANK SELECTION CARD -->
                    <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Target Bank Account" FontSize="12" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,0,0,6"/>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Bank Account No -->
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Bank A/C # (Enter)" FontSize="10.5" Foreground="#64748B" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TxtBankAcNo" Text="{Binding BankAccountNo, UpdateSourceTrigger=PropertyChanged}" FontSize="12" FontWeight="Bold" 
                                             Height="26" Padding="4,2" Background="#FFFFFF" BorderBrush="#94A3B8"
                                             KeyDown="TxtBankAcNo_KeyDown"/>
                                </StackPanel>

                                <!-- Bank Account Name -->
                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                    <TextBlock Text="Bank Name / Title" FontSize="10.5" Foreground="#64748B" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding BankAccountName}" IsReadOnly="True" FontSize="12" FontWeight="SemiBold" 
                                             Height="26" Padding="4,2" Background="#F8FAFC" BorderBrush="#CBD5E1"/>
                                </StackPanel>

                                <!-- Lookup Button -->
                                <Button Grid.Column="2" Command="{Binding OpenBankLookupCommand}" VerticalAlignment="Bottom" Height="26" Width="36" MinWidth="36"
                                        Style="{StaticResource ClassicButton}" ToolTip="Lookup Bank (F1)">
                                    <materialDesign:PackIcon Kind="Magnify" Width="15" Height="15"/>
                                </Button>
                            </Grid>

                            <!-- Dropdown Quick Select -->
                            <ComboBox ItemsSource="{Binding BankAccounts}" SelectedItem="{Binding SelectedBank}"
                                      DisplayMemberPath="BankName" FontSize="12" Height="26" Padding="6,2" Background="#FFFFFF" BorderBrush="#94A3B8"/>
                        </StackPanel>
                    </Border>

                    <!-- SECTION 2: CASH DEPOSIT PARTICULARS -->
                    <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Deposit Slip Particulars" FontSize="12" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,0,0,6"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Slip No -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Deposit Slip #" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding SlipNo, UpdateSourceTrigger=PropertyChanged}" FontSize="12" FontWeight="Bold" 
                                             Height="26" Padding="4,2" Background="#FFFFFF" BorderBrush="#94A3B8"/>
                                </StackPanel>

                                <!-- Deposited Date -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Deposit Date" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,2"/>
                                    <DatePicker SelectedDate="{Binding DepositedDate}" FontSize="12" Height="26" Padding="4,1" Background="#FFFFFF" BorderBrush="#94A3B8"/>
                                </StackPanel>

                                <!-- Deposited By -->
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Deposited By (Person Name / Bearer)" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding DepositedBy, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Height="26" Padding="4,2" Background="#FFFFFF" BorderBrush="#94A3B8"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- SECTION 3: RECONCILIATION CHECKBOX -->
                    <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                        <CheckBox IsChecked="{Binding IsReconciled}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Reconcile this deposit now." FontWeight="Bold" FontSize="12" Foreground="#0F172A"/>
                                <TextBlock Text=" (Sets ReconcileDate to current deposit date immediately)" FontSize="11" Foreground="#64748B" Margin="4,0,0,0"/>
                            </StackPanel>
                        </CheckBox>
                    </Border>

                    <!-- SECTION 4: CASH AMOUNT & WORDS -->
                    <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Amount -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Cash Deposit Amount" FontSize="11" FontWeight="Bold" Foreground="#047857" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding Amount, StringFormat='N2', UpdateSourceTrigger=PropertyChanged}" 
                                         FontSize="16" FontWeight="Bold" Foreground="#047857"
                                         Height="30" Padding="6,2" Background="#F0FDF4" BorderBrush="#10B981"/>
                            </StackPanel>

                            <!-- Amount in Words -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="Amount in Words" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding AmountInWords}" IsReadOnly="True" FontSize="12" FontWeight="SemiBold" 
                                         Foreground="#0F172A" Height="30" Padding="6,4" Background="#F8FAFC" BorderBrush="#CBD5E1"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- SECTION 5: NARRATION (ENGLISH & URDU) -->
                    <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- English Narration -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Narration (English)" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding Narration, UpdateSourceTrigger=PropertyChanged}" 
                                         FontSize="12" Height="50" TextWrapping="Wrap" AcceptsReturn="True" 
                                         Padding="6,4" Background="#FFFFFF" BorderBrush="#94A3B8"/>
                            </StackPanel>

                            <!-- Urdu Narration -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Narration (Urdu)" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding NarrationUrdu, UpdateSourceTrigger=PropertyChanged}" 
                                         helpers:UrduHelper.IsUrduOnly="True"
                                         FontSize="15" Height="50" TextWrapping="Wrap" AcceptsReturn="True" 
                                         Padding="6,2" Background="#FFFFFF" BorderBrush="#94A3B8"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- ═══ MODAL OVERLAY 1: BANK ACCOUNT LOOKUP (F1) ═══ -->
        <Border Background="#70000000" CornerRadius="6"
                Visibility="{Binding IsAccountLookupOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Width="600" MaxHeight="520" Margin="30" Padding="14"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="BankOutline" Width="18" Height="18" Foreground="#1E3A8A" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding LookupTitle}" FontSize="14" FontWeight="Bold" Foreground="#1E3A8A"/>
                        </StackPanel>
                        <Button Command="{Binding CloseLookupCommand}" Style="{StaticResource ClassicButton}" Width="26" MinWidth="26" Height="26" Padding="0" HorizontalAlignment="Right">
                            <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Foreground="#64748B"/>
                        </Button>
                    </Grid>

                    <!-- Search Bar -->
                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,0,8">
                        <Grid>
                            <materialDesign:PackIcon Kind="Magnify" Width="16" Height="16" Foreground="#64748B" VerticalAlignment="Center" Margin="2,0,0,0"/>
                            <TextBox Text="{Binding LookupSearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                     FontSize="11.5" Margin="24,0,0,0" BorderThickness="0" Background="Transparent" Height="24"
                                     materialDesign:HintAssist.Hint="Search by Bank Account # or Name..."/>
                        </Grid>
                    </Border>

                    <!-- Accounts DataGrid -->
                    <DataGrid Grid.Row="2" ItemsSource="{Binding FilteredAccounts}" SelectedItem="{Binding SelectedLookupAccount}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              MaxHeight="320" SelectionMode="Single" HeadersVisibility="Column"
                              Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1"
                              MouseDoubleClick="LookupDataGrid_MouseDoubleClick">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Height" Value="28"/>
                                <Setter Property="Padding" Value="8,0"/>
                                <Setter Property="BorderBrush" Value="#334155"/>
                                <Setter Property="BorderThickness" Value="0,0,1,0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="A/C #" Binding="{Binding AccountNo}" Width="110"/>
                            <DataGridTextColumn Header="Bank Account Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Urdu Title" Binding="{Binding UrduName}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Actions -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Command="{Binding CloseLookupCommand}" Style="{StaticResource ClassicButton}" Margin="0,0,6,0">
                            <TextBlock Text="Cancel"/>
                        </Button>
                        <Button Command="{Binding SelectLookupAccountCommand}" CommandParameter="{Binding SelectedLookupAccount}"
                                Style="{StaticResource PrimarySaveButton}">
                            <TextBlock Text="Select Account"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- ═══ MODAL OVERLAY 2: SEARCH BANK CASH DEPOSITS ═══ -->
        <Border Background="#70000000" CornerRadius="6"
                Visibility="{Binding IsSearchListOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Width="820" MaxHeight="560" Margin="30" Padding="14"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="FolderSearchOutline" Width="18" Height="18" Foreground="#1E3A8A" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Search Bank Cash Deposits" FontSize="14" FontWeight="Bold" Foreground="#1E3A8A"/>
                        </StackPanel>
                        <Button Command="{Binding CloseSearchModalCommand}" Style="{StaticResource ClassicButton}" Width="26" MinWidth="26" Height="26" Padding="0" HorizontalAlignment="Right">
                            <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Foreground="#64748B"/>
                        </Button>
                    </Grid>

                    <!-- Search Box -->
                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,0,8">
                        <Grid>
                            <materialDesign:PackIcon Kind="Magnify" Width="16" Height="16" Foreground="#64748B" VerticalAlignment="Center" Margin="2,0,0,0"/>
                            <TextBox Text="{Binding SearchListQuery, UpdateSourceTrigger=PropertyChanged}" 
                                     FontSize="11.5" Margin="24,0,0,0" BorderThickness="0" Background="Transparent" Height="24"
                                     materialDesign:HintAssist.Hint="Search by Voucher #, Slip #, Bank Name, or Deposited By..."/>
                        </Grid>
                    </Border>

                    <!-- Grid -->
                    <DataGrid Grid.Row="2" ItemsSource="{Binding SearchListResults}" SelectedItem="{Binding SelectedSearchItem}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              MaxHeight="360" SelectionMode="Single" HeadersVisibility="Column"
                              Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1"
                              MouseDoubleClick="SearchDataGrid_MouseDoubleClick">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Height" Value="28"/>
                                <Setter Property="Padding" Value="8,0"/>
                                <Setter Property="BorderBrush" Value="#334155"/>
                                <Setter Property="BorderThickness" Value="0,0,1,0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Voucher #" Binding="{Binding VoucherNo}" Width="90"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding VoucherDate, StringFormat='dd/MM/yyyy'}" Width="100"/>
                            <DataGridTextColumn Header="Bank Account" Binding="{Binding BankAccountName}" Width="*"/>
                            <DataGridTextColumn Header="Slip #" Binding="{Binding SlipNo}" Width="100"/>
                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat='N2'}" Width="110"/>
                            <DataGridTextColumn Header="Deposited By" Binding="{Binding DepositedBy}" Width="130"/>
                            <DataGridCheckBoxColumn Header="Reconciled" Binding="{Binding IsReconciled}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Actions -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Command="{Binding CloseSearchModalCommand}" Style="{StaticResource ClassicButton}" Margin="0,0,6,0">
                            <TextBlock Text="Cancel"/>
                        </Button>
                        <Button Command="{Binding SelectSearchItemCommand}" CommandParameter="{Binding SelectedSearchItem}"
                                Style="{StaticResource PrimarySaveButton}">
                            <TextBlock Text="Load Voucher"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
