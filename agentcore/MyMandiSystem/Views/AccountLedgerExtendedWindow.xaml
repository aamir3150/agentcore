<Window x:Class="MyMandiSystem.Views.AccountLedgerExtendedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Account Ledger Extended" 
        Height="540" Width="680"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#EAEAEA"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <!-- Classic / ERP Styled Button -->
        <Style x:Key="ClassicReportButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Background" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="#707070"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="3" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="8,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#E0EEF8"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#0078D7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#CCE4F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <DockPanel LastChildFill="True">

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                       HEADER BANNER                        -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border DockPanel.Dock="Top" Height="78" Background="#3B7D23">
                <Grid>
                    <!-- Diagonal Overlay Texture Effect -->
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#4A9B2C" Offset="0"/>
                            <GradientStop Color="#2E681A" Offset="0.85"/>
                            <GradientStop Color="#1D4A0E" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>

                    <!-- Title Header -->
                    <StackPanel VerticalAlignment="Center" Margin="24,0,0,0">
                        <TextBlock Text="Account Ledger Extended" FontSize="26" FontWeight="ExtraBold" Foreground="#112200" FontFamily="Georgia">
                            <TextBlock.Effect>
                                <DropShadowEffect ShadowDepth="1" BlurRadius="2" Color="#FFFFFF" Opacity="0.5"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>

                    <!-- Right Graphic Emblem -->
                    <Border HorizontalAlignment="Right" Width="100" Height="78" Margin="0,0,16,0" ClipToBounds="True">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Width="48" Height="48" CornerRadius="8" Background="#5BA832" BorderBrush="#8AD85F" BorderThickness="1.5">
                                <materialDesign:PackIcon Kind="Tractor" Width="30" Height="30" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                     BOTTOM BUTTONS BAR                     -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border DockPanel.Dock="Bottom" Background="#DCDCDC" BorderBrush="#B8B8B8" BorderThickness="0,1,0,0" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <!-- Preview Button -->
                        <Button Style="{StaticResource ClassicReportButton}" Command="{Binding PreviewCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileEyeOutline" Width="16" Height="16" Foreground="#005A9E" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Preview" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Print Button -->
                        <Button Style="{StaticResource ClassicReportButton}" Command="{Binding PrintCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Printer" Width="16" Height="16" Foreground="#333333" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Print" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Close Button -->
                        <Button Style="{StaticResource ClassicReportButton}" Command="{Binding CloseCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CloseCircle" Width="16" Height="16" Foreground="#D13438" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Close" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Urdu Print Checkbox -->
                    <CheckBox Grid.Column="1" Content="Urdu Print" IsChecked="{Binding UrduPrint}" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                      FORM CONTROLS                         -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Grid Background="#F5F5F5" Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Crop Season Row -->
                    <RowDefinition Height="Auto"/> <!-- Account Row -->
                    <RowDefinition Height="*"/>    <!-- Dates & Options Area -->
                    <RowDefinition Height="Auto"/> <!-- Bottom Checkboxes -->
                </Grid.RowDefinitions>

                <!-- 1. Top Filters Row (Crop Season & Grouping) -->
                <Border Grid.Row="0" Background="#ECECEC" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1" Padding="24,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Crop Season" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding CropSeasons}" SelectedItem="{Binding SelectedCropSeason}" Height="28" Padding="6,2"/>

                        <CheckBox Grid.Column="2" Content="With Summary" IsChecked="{Binding WithSummary}" VerticalAlignment="Center" Margin="18,0,0,0" FontWeight="Medium"/>
                        <CheckBox Grid.Column="3" Content="Show Grouping" IsChecked="{Binding ShowGrouping}" VerticalAlignment="Center" Margin="14,0,0,0" FontWeight="Medium"/>
                    </Grid>
                </Border>

                <!-- 2. Account Selection Row -->
                <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1" Padding="24,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- A/c No. -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="A/c No." FontWeight="SemiBold" Margin="0,0,0,4"/>
                        </StackPanel>
                        
                        <TextBox Grid.Column="1" Text="{Binding AccountNo, UpdateSourceTrigger=PropertyChanged}" Height="28" VerticalContentAlignment="Center" Padding="4" FontWeight="Bold" Foreground="#1E3A8A"/>

                        <!-- Lookup Button [...] -->
                        <Button Grid.Column="2" Style="{StaticResource ClassicReportButton}" Command="{Binding OpenAccountLookupCommand}" MinWidth="32" Height="28" Margin="4,0,14,0" ToolTip="Lookup / Select Account">
                            <TextBlock Text="..." FontWeight="Black" FontSize="14"/>
                        </Button>

                        <!-- A/c Name -->
                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="A/c Name" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        </StackPanel>

                        <TextBox Grid.Column="4" Text="{Binding AccountName}" IsReadOnly="True" Background="#E8ECEF" Height="28" VerticalContentAlignment="Center" Padding="6,4" FontWeight="SemiBold" Foreground="#1F2937"/>
                    </Grid>
                </Border>

                <!-- 3. Dates Filter Options -->
                <Grid Grid.Row="2" Margin="32,16,32,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- All Dates Option -->
                    <RadioButton Grid.Row="0" Content="All Dates" IsChecked="{Binding IsAllDates}" Margin="0,6,0,10" FontWeight="SemiBold" FontSize="14"/>

                    <!-- Single Date Option -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,10">
                        <RadioButton Content="Single Date" IsChecked="{Binding IsSingleDate}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Width="140"/>
                        <DatePicker SelectedDate="{Binding SingleDate}" IsEnabled="{Binding IsSingleDate}" Width="160" Height="28" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Date Range Option -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,10">
                        <RadioButton Content="Date Range" IsChecked="{Binding IsDateRange}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Width="140"/>
                        <TextBlock Text="From:" VerticalAlignment="Center" Margin="10,0,6,0" IsEnabled="{Binding IsDateRange}"/>
                        <DatePicker SelectedDate="{Binding FromDate}" IsEnabled="{Binding IsDateRange}" Width="130" Height="28" VerticalAlignment="Center"/>
                        <TextBlock Text="To:" VerticalAlignment="Center" Margin="12,0,6,0" IsEnabled="{Binding IsDateRange}"/>
                        <DatePicker SelectedDate="{Binding ToDate}" IsEnabled="{Binding IsDateRange}" Width="130" Height="28" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- 4. Bottom Options Checkboxes -->
                <Border Grid.Row="3" Background="#F0F0F0" Padding="24,12" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <CheckBox Content="Without Opening" IsChecked="{Binding WithoutOpening}" Margin="0,0,24,0" FontWeight="Medium"/>
                        <CheckBox Content="Show Full JV Narration" IsChecked="{Binding ShowFullJVNarration}" Margin="0,0,24,0" FontWeight="Medium"/>
                        <CheckBox Content="Hide Invoice Narration" IsChecked="{Binding HideInvoiceNarration}" FontWeight="Medium"/>
                    </StackPanel>
                </Border>

            </Grid>
        </DockPanel>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--                 ACCOUNT LOOKUP MODAL OVERLAY               -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Grid Background="#66000000" Visibility="{Binding IsAccountLookupOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="520" Height="420" Background="White" CornerRadius="8" BorderBrush="#707070" BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Select Account" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" Foreground="#1E3A8A"/>

                    <!-- Search Box -->
                    <TextBox Grid.Row="1" Text="{Binding LookupSearchQuery, UpdateSourceTrigger=PropertyChanged}" Height="30" Padding="6,4" Margin="0,0,0,10"
                             materialDesign:HintAssist.Hint="Type account code or name to filter..."/>

                    <!-- Accounts List -->
                    <DataGrid Grid.Row="2" ItemsSource="{Binding FilteredAccounts}" SelectedItem="{Binding SelectedAccount}" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="28">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="A/c No." Binding="{Binding AccountNo}" Width="100"/>
                            <DataGridTextColumn Header="Account Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Urdu Name" Binding="{Binding UrduName}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Modal Actions -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Style="{StaticResource ClassicReportButton}" Content="Select" Command="{Binding SelectAccountFromLookupCommand}" CommandParameter="{Binding SelectedAccount}" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource ClassicReportButton}" Content="Cancel" Command="{Binding CloseAccountLookupCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Window>
