<Window x:Class="MyMandiSystem.Views.ChequeBookGenerationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Bank Cheque Generation" 
        Height="620" Width="920"
        MinHeight="500" MinWidth="750"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        FontFamily="Segoe UI" FontSize="12">

    <Window.Resources>
        <Style x:Key="ClassicButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="85"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="10,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#BFDBFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <DockPanel LastChildFill="True">

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                     TOP HEADER TITLE BAR                   -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#1E3A8A" Margin="0,0,12,0" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="BookPlusOutline" Width="22" Height="22" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Bank Cheque Generation" FontSize="17" FontWeight="Bold" Foreground="#1E3A8A"/>
                        <TextBlock Text="Generate new cheque book leaves into bank ledger history" FontSize="11.5" Foreground="#64748B"/>
                    </StackPanel>

                    <Border Grid.Column="2" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Total Leaves to Generate:" FontWeight="SemiBold" Foreground="#1E3A8A" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding TotalChequesCount}" FontWeight="Bold" FontSize="15" Foreground="#2563EB" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                   INPUT PARAMETERS CARD                    -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Row 1: Bank Selection -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Bank A/C No:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#1E293B"/>
                    <Grid Grid.Row="0" Grid.Column="1">
                        <ComboBox ItemsSource="{Binding BankAccounts}" SelectedItem="{Binding SelectedBankAccount}"
                                  DisplayMemberPath="Account.AccountNo" IsEditable="True"/>
                    </Grid>

                    <TextBlock Grid.Row="0" Grid.Column="3" Text="Bank Account Name:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#1E293B"/>
                    <TextBox Grid.Row="0" Grid.Column="4" Text="{Binding BankAccountName}" IsReadOnly="True" FontWeight="Bold" Background="#F8FAFC" Foreground="#1E3A8A"/>

                    <!-- Row 2: Cheque Range -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="From Cheque No:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#1E293B" Margin="0,10,0,0"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding FromChequeNo, UpdateSourceTrigger=PropertyChanged}" 
                             FontWeight="Bold" Foreground="#1E3A8A" Margin="0,10,0,0"/>

                    <TextBlock Grid.Row="1" Grid.Column="3" Text="To Cheque No:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#1E293B" Margin="0,10,0,0"/>
                    <Grid Grid.Row="1" Grid.Column="4" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding ToChequeNo, UpdateSourceTrigger=PropertyChanged}" 
                                 FontWeight="Bold" Foreground="#1E3A8A"/>
                        <TextBlock Grid.Column="2" Text="(Leading zeros will be automatically preserved)" 
                                   FontStyle="Italic" Foreground="#64748B" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                   BOTTOM TOOLBAR BAR                       -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border DockPanel.Dock="Bottom" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,8,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="Generate Cheques (F2)" Command="{Binding GenerateChequeBookCommand}" Style="{StaticResource ClassicButton}" 
                                Background="#2563EB" Foreground="#FFFFFF" BorderBrush="#1D4ED8"/>
                        <Button Content="Clear (F3)" Command="{Binding ClearFieldsCommand}" Style="{StaticResource ClassicButton}"/>
                        <Button Content="Refresh History" Command="{Binding RefreshExistingChequesCommand}" Style="{StaticResource ClassicButton}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="#047857" FontWeight="SemiBold" Margin="0,0,12,0"/>
                        <Button Content="Close (Esc)" HorizontalAlignment="Right" Style="{StaticResource ClassicButton}" Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--              CHEQUE BOOK LEAF HISTORY DATA GRID            -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="10,6">
                        <Grid>
                            <TextBlock Text="Cheque Book Leaves in Bank History:" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ExistingCheques.Count, StringFormat='Total Records: {0}'}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding ExistingCheques}" 
                              SelectedItem="{Binding SelectedCheque}"
                              AutoGenerateColumns="False" 
                              IsReadOnly="True" 
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E2E8F0"
                              RowHeight="26">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Height" Value="28"/>
                                <Setter Property="Padding" Value="8,0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Bank A/C #" Binding="{Binding AccountNo}" Width="95"/>
                            <DataGridTextColumn Header="Cheque #" Binding="{Binding ChequeNo}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#1E3A8A"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Entry Date" Binding="{Binding EntryDate, StringFormat=dd/MM/yyyy}" Width="100"/>
                            
                            <!-- Status Column -->
                            <DataGridTemplateColumn Header="Status" Width="105">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="6,1" HorizontalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#DCFCE7"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Issued">
                                                            <Setter Property="Background" Value="#FEF3C7"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                            <Setter Property="Background" Value="#FEE2E2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" FontWeight="Bold" FontSize="11">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#15803D"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Issued">
                                                                <Setter Property="Foreground" Value="#B45309"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                                <Setter Property="Foreground" Value="#B91C1C"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Issued To / Payee" Binding="{Binding Payee}" Width="*"/>
                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat={}{0:N0}}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="0,0,6,0"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Voucher #" Binding="{Binding VoucherNo}" Width="85"/>
                            <DataGridTextColumn Header="Remarks" Binding="{Binding Remarks}" Width="140"/>

                            <!-- Actions Column -->
                            <DataGridTemplateColumn Header="Action" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="✕" 
                                                    Command="{Binding DataContext.CancelChequeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Foreground="#DC2626" Background="Transparent" BorderThickness="0" FontWeight="Bold"
                                                    Padding="3,0" Cursor="Hand" ToolTip="Cancel Cheque"/>
                                            <Button Content="🗑" 
                                                    Command="{Binding DataContext.DeleteChequeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Foreground="#64748B" Background="Transparent" BorderThickness="0"
                                                    Padding="3,0" Cursor="Hand" ToolTip="Delete Cheque from History"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

        </DockPanel>
    </Grid>
</Window>

