<Window x:Class="MyMandiSystem.Views.DatabaseBackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Database Backup - agentcore ERP" 
        Width="680" 
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True">

    <Window.Resources>
        <Storyboard x:Key="FadeInStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:0.25"/>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource FadeInStoryboard}"/>
        </EventTrigger>
    </Window.Triggers>

    <Border Margin="16" CornerRadius="18" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1.5" Effect="{StaticResource EffectModalShadow}">
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="*"/>    <!-- Backup Details Body -->
                <RowDefinition Height="Auto"/> <!-- Footer Actions -->
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                       TOP TITLE BAR                        -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border Grid.Row="0" Background="{StaticResource BrushPrimaryNavy}" CornerRadius="18,18,0,0" Padding="22,14"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Cursor="SizeAll">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="#1E293B" Margin="0,0,12,0">
                        <materialDesign:PackIcon Kind="DatabaseSync" Width="24" Height="24" Foreground="{StaticResource BrushAccentTealLight}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="SQL Database Backup Utility" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="ڈیٹا بیس کا مکمل اور محفوظ بیک اپ تیار کریں" 
                                   FontFamily="{StaticResource FontJameelNooriNastaleeq}" FontSize="15" Foreground="#94A3B8"/>
                    </StackPanel>

                    <Button Grid.Column="2" Click="CloseButton_Click" Cursor="Hand" Width="30" Height="30" 
                            Background="Transparent" BorderThickness="0" Padding="0">
                        <materialDesign:PackIcon Kind="Close" Width="20" Height="20" Foreground="#94A3B8"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                    BACKUP DETAILS BODY                     -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <StackPanel Grid.Row="1" Margin="24,20">
                <!-- Info Banner -->
                <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0" Kind="DatabaseCheck" Width="22" Height="22" Foreground="#16A34A" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DatabaseName, StringFormat='Active Database: {0}'}" FontWeight="Bold" FontSize="13" Foreground="#166534"/>
                            <TextBlock Text="{Binding EstimatedSize, StringFormat='Estimated Size: {0}'}" FontSize="11" Foreground="#15803D"/>
                        </StackPanel>
                        <Border Grid.Column="2" Background="#DCFCE7" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                            <TextBlock Text="Live SQL Server" FontSize="10" FontWeight="Bold" Foreground="#166534"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Destination File Selector -->
                <TextBlock Text="Backup Destination File / محفوظ کرنے کی فائل:" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="10,8" FontSize="12"
                             Text="{Binding BackupFilePath, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Column="1" Command="{Binding BrowsePathCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="8,0,0,0" Height="38" Padding="12,0" BorderBrush="#0284C7" Foreground="#0284C7">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FolderOpenOutline" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Browse / منتخب کریں" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Status & Progress -->
                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,4">
                    <StackPanel>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,8"/>
                        <ProgressBar Value="{Binding ProgressValue}" Maximum="100" Height="8" 
                                     Foreground="{StaticResource BrushAccentTeal}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                       FOOTER ACTIONS                       -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,14" CornerRadius="0,0,18,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Command="{Binding OpenBackupFolderCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                            BorderBrush="#0284C7" Foreground="#0284C7" Height="38" Padding="14,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Folder" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Open Folder / فولڈر کھولیں" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}" Height="38" Padding="14,0" Margin="0,0,10,0"
                                Click="CloseButton_Click" Foreground="#64748B" BorderBrush="#CBD5E1">
                            <TextBlock Text="Close / بند کریں"/>
                        </Button>

                        <Button Command="{Binding StartBackupCommand}" IsEnabled="{Binding IsBackingUp, Converter={x:Null}}"
                                Background="{StaticResource BrushPrimaryNavy}" Foreground="#FFFFFF" BorderThickness="0" Height="38" Padding="20,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="PlayCircleOutline" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Start Backup / بیک اپ شروع کریں" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
