<UserControl x:Class="MyMandiSystem.Views.OpeningBalancesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MyMandiSystem.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             TextElement.Foreground="{StaticResource BrushTextPrimary}"
             TextElement.FontWeight="Regular"
             TextElement.FontSize="13"
             Background="{StaticResource BrushSurfaceBg}"
             FontFamily="{DynamicResource MaterialDesignFont}">
    
    <Border Margin="12" Background="#FFFFFF" CornerRadius="16" BorderBrush="{StaticResource BrushSurfaceBorder}" BorderThickness="1" Effect="{StaticResource EffectCardShadow}">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Header Banner -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="10" Background="{StaticResource BrushGradientIndigo}" Margin="0,0,12,0" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="ScaleBalance" Width="24" Height="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Fiscal Opening Balances &amp; Initial Stock" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryNavy}"/>
                    <TextBlock Text="Setup starting balances for general ledgers, bank accounts, and commodity inventory" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                </StackPanel>
            </Grid>

            <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" BorderThickness="0" Background="Transparent">
                
                <!-- FINANCIAL OPENING -->
                <TabItem Header="Financial Ledger Balances">
                    <Grid Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <Border CornerRadius="12" BorderBrush="{StaticResource BrushSurfaceBorder}" BorderThickness="1" ClipToBounds="True">
                            <DataGrid ItemsSource="{Binding AccountBalances}" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single"
                                      Style="{StaticResource ModernDataGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="A/C CODE" Binding="{Binding AccountNo}" IsReadOnly="True" Width="120"/>
                                    <DataGridTextColumn Header="ACCOUNT TITLE" Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                                    <DataGridTemplateColumn Header="OPENING BALANCE (PKR)" Width="220">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Balance, StringFormat=N2}" TextAlignment="Right" Padding="8,4" FontWeight="Bold" Foreground="{StaticResource BrushAccentEmerald}" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Balance, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" materialDesign:TextFieldAssist.PrefixText="₨ " TextAlignment="Right"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                            <Button Content="Save Financial Balances" Command="{Binding SaveFinancialCommand}" Style="{StaticResource ModernPrimaryButton}" Height="36"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- INVENTORY OPENING -->
                <TabItem Header="Commodity &amp; Product Stock">
                    <Grid Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <Border CornerRadius="12" BorderBrush="{StaticResource BrushSurfaceBorder}" BorderThickness="1" ClipToBounds="True">
                            <DataGrid ItemsSource="{Binding ProductStocks}" AutoGenerateColumns="False" CanUserAddRows="False"
                                      Style="{StaticResource ModernDataGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ITEM CODE" Binding="{Binding Code}" IsReadOnly="True" Width="120"/>
                                    <DataGridTextColumn Header="COMMODITY / PRODUCT NAME" Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                                    <DataGridTemplateColumn Header="OPENING QTY" Width="140">
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Qty, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Qty}" TextAlignment="Right" Padding="8,4" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="COST RATE (PKR)" Width="160">
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Rate, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Rate, StringFormat=N2}" TextAlignment="Right" Padding="8,4" FontWeight="Bold" Foreground="{StaticResource BrushAccentEmerald}" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                            <Button Content="Save Opening Stock" Command="{Binding SaveStockCommand}" Style="{StaticResource ModernPrimaryButton}" Height="36"/>
                        </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</UserControl>
