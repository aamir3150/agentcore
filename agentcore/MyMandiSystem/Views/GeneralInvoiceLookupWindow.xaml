<Window x:Class="MyMandiSystem.Views.GeneralInvoiceLookupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="General Trade Invoice Lookup" 
        Height="580" Width="950"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <Style x:Key="ClassicButton" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinWidth" Value="85"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="8,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#BFDBFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP FILTER CARD -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Search box -->
                <TextBlock Text="Search:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                         materialDesign:HintAssist.Hint="Search Invoice / Party..." ToolTip="Enter Invoice No or Party Name"/>

                <!-- Type Filter -->
                <TextBlock Grid.Column="3" Text="Filter Type:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,8,0"/>
                <ComboBox Grid.Column="4" ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding SelectedTypeOption}"/>

                <!-- Date Range row -->
                <StackPanel Grid.Row="1" Grid.ColumnSpan="6" Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                    <RadioButton Content="All Dates" IsChecked="{Binding IsAllDates}" Margin="0,0,16,0" FontWeight="SemiBold"/>
                    <RadioButton Content="Date Range:" IsChecked="{Binding IsDateRange}" Margin="0,0,8,0" FontWeight="SemiBold"/>
                    <DatePicker SelectedDate="{Binding FromDate}" IsEnabled="{Binding IsDateRange}" Width="110" Height="26" Margin="0,0,8,0"/>
                    <TextBlock Text="To:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <DatePicker SelectedDate="{Binding ToDate}" IsEnabled="{Binding IsDateRange}" Width="110" Height="26" Margin="0,0,16,0"/>
                    <TextBlock Text="Tip: Double-click row or press Enter to load" FontStyle="Italic" Foreground="#64748B" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- DATA GRID -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding FilteredInvoices}" 
                      SelectedItem="{Binding SelectedInvoice}"
                      AutoGenerateColumns="False" 
                      IsReadOnly="True" 
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E2E8F0"
                      RowHeight="30"
                      MouseDoubleClick="DataGrid_MouseDoubleClick">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#0F172A"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Height" Value="32"/>
                        <Setter Property="Padding" Value="8,0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Inv #" Binding="{Binding InvoiceNo}" Width="90"/>
                    <DataGridTextColumn Header="Date" Binding="{Binding InvoiceDate, StringFormat=dd/MM/yyyy}" Width="100"/>
                    <DataGridTextColumn Header="Invoice Type" Binding="{Binding TypeDisplay}" Width="170"/>
                    <DataGridTextColumn Header="Party / Trading Account" Binding="{Binding PartyName}" Width="*"/>
                    <DataGridTextColumn Header="Gross Amount" Binding="{Binding SubTotal, StringFormat={}{0:N0}}" Width="110"/>
                    <DataGridTextColumn Header="Discount" Binding="{Binding DiscountAmount, StringFormat={}{0:N0}}" Width="95"/>
                    <DataGridTextColumn Header="Net Amount" Binding="{Binding NetAmount, StringFormat={}{0:N0}}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#2563EB"/>
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Padding" Value="0,0,6,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Status" Binding="{Binding StatusDisplay}" Width="85"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- BOTTOM BUTTON BAR -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Select &amp; Open" Command="{Binding ConfirmCommand}" Style="{StaticResource ClassicButton}" Background="#2563EB" Foreground="#FFFFFF" BorderBrush="#1D4ED8" Margin="0,0,8,0"/>
            <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource ClassicButton}"/>
        </StackPanel>
    </Grid>
</Window>
