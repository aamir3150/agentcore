<Window x:Class="MyMandiSystem.Views.BankingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="agentcore - Bank &amp; Cheques Management"
        Width="1150" Height="780"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="SingleBorderWindow"
        Background="{StaticResource BrushSurfaceBg}"
        TextElement.Foreground="{StaticResource BrushTextPrimary}"
        TextElement.FontSize="13"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Border Margin="12" Background="#FFFFFF" CornerRadius="16" BorderBrush="{StaticResource BrushSurfaceBorder}" BorderThickness="1" Effect="{StaticResource EffectCardShadow}">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header Banner -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="42" Height="42" CornerRadius="10" Background="{StaticResource BrushGradientIndigo}" Margin="0,0,12,0" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="BankCheck" Width="24" Height="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Bank &amp; Cheques Management" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryNavy}"/>
                    <TextBlock Text="Cheque book generation, issuance, bank deposits, and clearing reconciliation (AgenSOFT Mandi Engine)" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                </StackPanel>

                <!-- Active Season Tag -->
                <Border Grid.Column="2" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="10,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CalendarCheck" Width="16" Height="16" Foreground="{StaticResource BrushAccentIndigo}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectedCropSeason.Name, FallbackValue='Active Season'}" FontWeight="SemiBold" Foreground="{StaticResource BrushAccentIndigo}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Tab Control -->
            <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" BorderThickness="0" Background="Transparent">

                <!-- ══════════════════════════════════════════════════════ -->
                <!-- TAB 0: CHEQUE BOOK GENERATION                         -->
                <!-- ══════════════════════════════════════════════════════ -->
                <TabItem Header="Cheque Book Generation">
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="380"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Generation Form -->
                        <!-- Left Generation Form -->
                        <Border Grid.Column="0" CornerRadius="14" BorderBrush="{StaticResource BrushSurfaceBorder}" BorderThickness="1" Background="#F8FAFC" Padding="18">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Grid Margin="0,0,0,14">
                                        <TextBlock Text="Generate Cheque Book" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryNavy}" VerticalAlignment="Center"/>
                                        <Button HorizontalAlignment="Right"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                Command="{Binding OpenAddBankCardCommand}"
                                                ToolTip="Add New Bank Account"
                                                Padding="8,2" Height="30" FontSize="11" FontWeight="SemiBold">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="BankPlus" Width="15" Height="15" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="+ Add Bank" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- Inline Add New Bank Account Card -->
                                    <Border Visibility="{Binding IsAddBankCardVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="Add New Bank Account (نیا بینک اکاؤنٹ)" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryNavy}" Margin="0,0,0,8"/>

                                            <TextBox materialDesign:HintAssist.Hint="Bank Name (e.g. Habib Bank Limited / Meezan)"
                                                     Text="{Binding NewBankName, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                                     Margin="0,0,0,8"/>

                                            <TextBox materialDesign:HintAssist.Hint="Branch Name (e.g. Mandi Branch)"
                                                     Text="{Binding NewBranchName, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                                     Margin="0,0,0,8"/>

                                            <TextBox materialDesign:HintAssist.Hint="Account Number (e.g. 0123-45678901)"
                                                     Text="{Binding NewAccountNumber, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                                     Margin="0,0,0,8"/>

                                            <TextBox materialDesign:HintAssist.Hint="Opening Balance (PKR)"
                                                     Text="{Binding NewBankOpeningBalance, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                                     Margin="0,0,0,12"/>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Content="Cancel"
                                                        Command="{Binding CancelAddBankCardCommand}"
                                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                                        Height="34" Margin="0,0,4,0"/>
                                                <Button Grid.Column="1" Content="Save Bank"
                                                        Command="{Binding SaveNewBankAccountCommand}"
                                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                                        Background="{StaticResource BrushAccentIndigo}"
                                                        Height="34" Margin="4,0,0,0" FontWeight="Bold"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <ComboBox materialDesign:HintAssist.Hint="Bank Account"
                                              ItemsSource="{Binding BankAccounts}"
                                              SelectedItem="{Binding SelectedGenBankAccount}"
                                              DisplayMemberPath="BankName"
                                              Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                              Margin="0,0,0,14"/>

                                    <TextBox materialDesign:HintAssist.Hint="Series Start (e.g. 100001)"
                                             Text="{Binding SeriesStart, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                             Margin="0,0,0,14"/>

                                    <TextBox materialDesign:HintAssist.Hint="Series End (e.g. 100050)"
                                             Text="{Binding SeriesEnd, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                             Margin="0,0,0,14"/>

                                    <Border Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,18">
                                        <Grid>
                                            <TextBlock Text="Total Cheque Leaves:" FontWeight="SemiBold" Foreground="{StaticResource BrushAccentIndigo}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding TotalLeaves}" FontSize="16" FontWeight="Black" Foreground="{StaticResource BrushPrimaryNavy}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <Button Content="Generate Cheque Book"
                                            Command="{Binding GenerateChequeBookCommand}"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Background="{StaticResource BrushAccentIndigo}"
                                            Height="42"
                                            FontWeight="Bold"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- Right Cheque Books Grid -->
                        <Border Grid.Column="2" CornerRadius="14" BorderBrush="{StaticResource BrushSurfaceBorder}" BorderThickness="1" Background="#FFFFFF" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Existing Cheque Books for Selected Bank" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryNavy}" Margin="0,0,0,10"/>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding ExistingChequeBooks}" AutoGenerateColumns="False" IsReadOnly="True"
                                          GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowHeight="28">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Book ID" Binding="{Binding Id}" Width="80"/>
                                        <DataGridTextColumn Header="Series Start" Binding="{Binding SeriesStart, StringFormat=D6}" Width="120"/>
                                        <DataGridTextColumn Header="Series End" Binding="{Binding SeriesEnd, StringFormat=D6}" Width="120"/>
                                        <DataGridTextColumn Header="Total Leaves" Binding="{Binding Cheques.Count}" Width="100"/>
                                        <DataGridTextColumn Header="Active" Binding="{Binding IsActive}" Width="80"/>
                                        <DataGridTextColumn Header="Created Date" Binding="{Binding CreatedAt, StringFormat=d}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ══════════════════════════════════════════════════════ -->
                <!-- TAB 1: CHEQUE ISSUING                                 -->
                <!-- ══════════════════════════════════════════════════════ -->
                <TabItem Header="Cheque Issuing">
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="420"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Issuing Form Card -->
                        <Border Grid.Column="0" CornerRadius="14" BorderBrush="{StaticResource BrushSurfaceBorder}" BorderThickness="1" Background="#F8FAFC" Padding="18">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Issue Cheque (Bank Payment)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryNavy}" Margin="0,0,0,12"/>

                                    <ComboBox materialDesign:HintAssist.Hint="Bank Account"
                                              ItemsSource="{Binding BankAccounts}"
                                              SelectedItem="{Binding SelectedIssueBankAccount}"
                                              DisplayMemberPath="BankName"
                                              Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                              Margin="0,0,0,10"/>

                                    <ComboBox materialDesign:HintAssist.Hint="Available Cheque Leaf"
                                              ItemsSource="{Binding AvailableCheques}"
                                              SelectedItem="{Binding SelectedAvailableCheque}"
                                              DisplayMemberPath="ChequeNo"
                                              Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                              Margin="0,0,0,10"/>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="Party ID / No" Text="{Binding SelectedPartyId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>
                                        <TextBox Grid.Column="2" materialDesign:HintAssist.Hint="Party Name" Text="{Binding PartyName}" IsReadOnly="True" Style="{StaticResource MaterialDesignFloatingHintTextBox}" FontWeight="SemiBold"/>
                                    </Grid>

                                    <TextBox materialDesign:HintAssist.Hint="Amount (Rs.)"
                                             Text="{Binding IssueAmount, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                             FontWeight="Bold"
                                             FontSize="15"
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                             Margin="0,0,0,10"/>

                                    <DatePicker materialDesign:HintAssist.Hint="Issue Date"
                                                SelectedDate="{Binding IssueDate}"
                                                Style="{StaticResource MaterialDesignFloatingHintDatePicker}"
                                                Margin="0,0,0,10"/>

                                    <TextBox materialDesign:HintAssist.Hint="Received By (Person / Bearer)"
                                             Text="{Binding ReceivedBy}"
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                             Margin="0,0,0,10"/>

                                    <TextBox materialDesign:HintAssist.Hint="Narration"
                                             Text="{Binding Narration}"
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                             Margin="0,0,0,16"/>

                                    <Button Content="Issue &amp; Post to GL"
                                            Command="{Binding IssueChequeCommand}"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Background="{StaticResource BrushAccentIndigo}"
                                            Height="42"
                                            FontWeight="Bold"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- Available Cheques Leaf Grid -->
                        <Border Grid.Column="2" CornerRadius="14" BorderBrush="{StaticResource BrushSurfaceBorder}" BorderThickness="1" Background="#FFFFFF" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Available Blank Cheques in Active Cheque Book" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryNavy}" Margin="0,0,0,10"/>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding AvailableCheques}" SelectedItem="{Binding SelectedAvailableCheque}" AutoGenerateColumns="False" IsReadOnly="True"
                                          GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowHeight="26">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Cheque No" Binding="{Binding ChequeNo}" Width="140"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                                        <DataGridTextColumn Header="Book ID" Binding="{Binding ChequeBookId}" Width="90"/>
                                        <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt, StringFormat=d}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ══════════════════════════════════════════════════════ -->
                <!-- TAB 2: BANK DEPOSITS (CASH & CHEQUES)                 -->
                <!-- ══════════════════════════════════════════════════════ -->
                <TabItem Header="Bank Deposits (Cash / Cheque)">
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="420"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Deposit Form -->
                        <Border Grid.Column="0" CornerRadius="14" BorderBrush="{StaticResource BrushSurfaceBorder}" BorderThickness="1" Background="#F8FAFC" Padding="18">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Deposit to Bank Account" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryNavy}" Margin="0,0,0,12"/>

                                    <ComboBox materialDesign:HintAssist.Hint="Bank Account"
                                              ItemsSource="{Binding BankAccounts}"
                                              SelectedItem="{Binding SelectedDepositBankAccount}"
                                              DisplayMemberPath="BankName"
                                              Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                              Margin="0,0,0,10"/>

                                    <ComboBox materialDesign:HintAssist.Hint="Deposit Type"
                                              ItemsSource="{Binding DepositTypes}"
                                              SelectedItem="{Binding SelectedDepositType}"
                                              Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                              Margin="0,0,0,10"/>

                                    <!-- Cheque Specific Fields -->
                                    <StackPanel Visibility="{Binding IsChequeDepositMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="Party ID" Text="{Binding DepositPartyId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>
                                            <TextBox Grid.Column="2" materialDesign:HintAssist.Hint="Party Name" Text="{Binding DepositPartyName}" IsReadOnly="True" Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="Cheque No" Text="{Binding DepositChequeNo}" Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>
                                            <DatePicker Grid.Column="2" materialDesign:HintAssist.Hint="Cheque Date" SelectedDate="{Binding DepositChequeDate}" Style="{StaticResource MaterialDesignFloatingHintDatePicker}"/>
                                        </Grid>
                                    </StackPanel>

                                    <TextBox materialDesign:HintAssist.Hint="Deposit Amount (Rs.)"
                                             Text="{Binding DepositAmount, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                             FontWeight="Bold"
                                             FontSize="15"
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                             Margin="0,0,0,10"/>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="Deposit Slip No" Text="{Binding DepositSlipNo}" Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>
                                        <DatePicker Grid.Column="2" materialDesign:HintAssist.Hint="Deposit Date" SelectedDate="{Binding DepositDate}" Style="{StaticResource MaterialDesignFloatingHintDatePicker}"/>
                                    </Grid>

                                    <TextBox materialDesign:HintAssist.Hint="Narration / Remarks"
                                             Text="{Binding DepositNarration}"
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                             Margin="0,0,0,16"/>

                                    <Button Content="Deposit &amp; Save"
                                            Command="{Binding DepositCommand}"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Background="{StaticResource BrushPrimaryNavy}"
                                            Height="42"
                                            FontWeight="Bold"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- Bank Accounts Balances Preview Card -->
                        <Border Grid.Column="2" CornerRadius="14" BorderBrush="{StaticResource BrushSurfaceBorder}" BorderThickness="1" Background="#FFFFFF" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <TextBlock Text="Bank Accounts &amp; Running Balances" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryNavy}" VerticalAlignment="Center"/>
                                    <Button HorizontalAlignment="Right"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Command="{Binding OpenAddBankCardCommand}"
                                            ToolTip="Add New Bank Account"
                                            Padding="8,2" Height="28" FontSize="11" FontWeight="SemiBold">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="BankPlus" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="+ Add Bank" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding BankAccounts}" AutoGenerateColumns="False" IsReadOnly="True"
                                          GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowHeight="28">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Bank Name" Binding="{Binding BankName}" Width="160"/>
                                        <DataGridTextColumn Header="Branch" Binding="{Binding BranchName}" Width="140"/>
                                        <DataGridTextColumn Header="A/C Number" Binding="{Binding AccountNumber}" Width="140"/>
                                        <DataGridTextColumn Header="Current Balance" Binding="{Binding CurrentBalance, StringFormat=N2}" Width="*" FontWeight="Bold"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ══════════════════════════════════════════════════════ -->
                <!-- TAB 3: RECONCILIATION (CHEQUES & DEPOSITS)            -->
                <!-- ══════════════════════════════════════════════════════ -->
                <TabItem Header="Reconciliation (Cheques &amp; Deposits)">
                    <Grid Margin="0,14,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Toggle Bar: Cheques vs Deposits -->
                        <Border Grid.Row="0" Background="#F1F5F9" CornerRadius="10" Padding="8,4" Margin="0,0,0,12" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="Issued Cheques Clearance (چیکز ادائیگی کلیئرنس)" 
                                             IsChecked="{Binding IsReconcilingCheques}" 
                                             GroupName="ReconMode" 
                                             FontWeight="Bold" 
                                             Foreground="{StaticResource BrushPrimaryNavy}"
                                             Margin="0,0,16,0"/>
                                <RadioButton Content="Bank Deposits Clearance (بینک ڈپازٹ کلیئرنس)" 
                                             IsChecked="{Binding IsReconcilingDeposits}" 
                                             GroupName="ReconMode" 
                                             FontWeight="Bold" 
                                             Foreground="{StaticResource BrushPrimaryNavy}"/>
                            </StackPanel>
                        </Border>

                        <!-- 1. Uncleared Cheques Grid -->
                        <Border Grid.Row="1" Visibility="{Binding IsReconcilingCheques, Converter={StaticResource BooleanToVisibilityConverter}}"
                                CornerRadius="14" BorderBrush="{StaticResource BrushSurfaceBorder}" BorderThickness="1" Background="#FFFFFF" Padding="14" Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Uncleared Issued Cheques (Pending Bank Clearance / واجب الادا جاری کردہ چیکز)" FontSize="14" FontWeight="Bold" Foreground="#92400E" Margin="0,0,0,10"/>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding UnclearedCheques}" SelectedItem="{Binding SelectedUnclearedCheque}" AutoGenerateColumns="False" IsReadOnly="True"
                                          GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowHeight="28">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Cheque No" Binding="{Binding ChequeNo}" Width="110" FontWeight="Bold"/>
                                        <DataGridTextColumn Header="Bank Name" Binding="{Binding ChequeBook.BankAccount.BankName}" Width="150"/>
                                        <DataGridTextColumn Header="Issued To Party" Binding="{Binding IssuedToParty.Name}" Width="180"/>
                                        <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" Width="130" FontWeight="Bold"/>
                                        <DataGridTextColumn Header="Issue Date" Binding="{Binding IssueDate, StringFormat=d}" Width="110"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <!-- 2. Uncleared Deposits Grid -->
                        <Border Grid.Row="1" Visibility="{Binding IsReconcilingDeposits, Converter={StaticResource BooleanToVisibilityConverter}}"
                                CornerRadius="14" BorderBrush="{StaticResource BrushSurfaceBorder}" BorderThickness="1" Background="#FFFFFF" Padding="14" Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Uncleared Bank Deposits (Pending Realization / بینک میں جمع شدہ چیکز و رقم)" FontSize="14" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,10"/>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding UnclearedDeposits}" SelectedItem="{Binding SelectedUnclearedDeposit}" AutoGenerateColumns="False" IsReadOnly="True"
                                          GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowHeight="28">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Slip / Reference" Binding="{Binding ReferenceNo}" Width="160" FontWeight="Bold"/>
                                        <DataGridTextColumn Header="Deposit Type" Binding="{Binding DepositType}" Width="110"/>
                                        <DataGridTextColumn Header="Bank Name" Binding="{Binding BankAccount.BankName}" Width="160"/>
                                        <DataGridTextColumn Header="A/C Number" Binding="{Binding BankAccount.AccountNumber}" Width="130"/>
                                        <DataGridTextColumn Header="Deposit Date" Binding="{Binding DepositDate, StringFormat=d}" Width="110"/>
                                        <DataGridTextColumn Header="Amount (Rs.)" Binding="{Binding Amount, StringFormat=N2}" Width="130" FontWeight="Bold"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <!-- Action Bar for Selected Cheque -->
                        <Border Grid.Row="2" Visibility="{Binding IsReconcilingCheques, Converter={StaticResource BooleanToVisibilityConverter}}"
                                CornerRadius="14" BorderBrush="{StaticResource BrushSurfaceBorder}" BorderThickness="1" Background="#F8FAFC" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Clearance Date:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                <DatePicker Grid.Column="1" SelectedDate="{Binding ClearanceDate}" Style="{StaticResource MaterialDesignFloatingHintDatePicker}" Margin="0,0,8,0"/>
                                <Button Grid.Column="2" Content="Mark Cleared" Command="{Binding ClearChequeCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#15803D" FontWeight="Bold"/>

                                <TextBox Grid.Column="4" materialDesign:HintAssist.Hint="Bounce Reason" Text="{Binding BounceReason}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,10,0"/>
                                <Button Grid.Column="5" Content="Bounce Cheque" Command="{Binding BounceChequeCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#B91C1C" FontWeight="Bold"/>
                            </Grid>
                        </Border>

                        <!-- Action Bar for Selected Deposit -->
                        <Border Grid.Row="2" Visibility="{Binding IsReconcilingDeposits, Converter={StaticResource BooleanToVisibilityConverter}}"
                                CornerRadius="14" BorderBrush="{StaticResource BrushSurfaceBorder}" BorderThickness="1" Background="#F8FAFC" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Reconciliation Date:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                <DatePicker Grid.Column="1" SelectedDate="{Binding DepositClearanceDate}" Style="{StaticResource MaterialDesignFloatingHintDatePicker}" Margin="0,0,12,0"/>
                                <Button Grid.Column="2" Content="Mark Deposit Cleared" Command="{Binding ClearDepositCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#1D4ED8" FontWeight="Bold"/>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ══════════════════════════════════════════════════════ -->
                <!-- TAB 4: BANK CHEQUES EDITING & REGISTER (AgenSoft Parity) -->
                <!-- ══════════════════════════════════════════════════════ -->
                <TabItem Header="Bank Cheques Editing (بینک چیکس ایڈیٹنگ)">
                    <Grid Margin="0,14,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Filter Bar for Cheque Book History & Register -->
                        <Border Grid.Row="0" CornerRadius="12" Background="#F1F5F9" Padding="12" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox Grid.Column="0" materialDesign:HintAssist.Hint="Bank Account (بینک اکاؤنٹ)"
                                          ItemsSource="{Binding BankAccounts}"
                                          SelectedItem="{Binding SelectedHistoryBank}"
                                          DisplayMemberPath="BankName"
                                          Style="{StaticResource MaterialDesignFloatingHintComboBox}"/>

                                <DatePicker Grid.Column="2" materialDesign:HintAssist.Hint="Entry Date (تاریخ اندراج)"
                                            SelectedDate="{Binding HistoryEntryDate}"
                                            Style="{StaticResource MaterialDesignFloatingHintDatePicker}"/>

                                <Button Grid.Column="4" Content="Filter History" Command="{Binding LoadHistoryCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}" Background="{StaticResource BrushPrimaryNavy}" VerticalAlignment="Bottom"/>

                                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Register Status:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                    <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatusFilter}" Width="120"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Main Split: Unused Leaves Editing vs Issued Register -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: BankChequeBookHistory (Unused Cheques Editing) -->
                            <Border Grid.Column="0" CornerRadius="14" BorderBrush="{StaticResource BrushSurfaceBorder}" BorderThickness="1" Background="#FFFFFF" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Unused Cheque Book Leaves (چیک بک لیوز - دستیاب / منسوخ)" FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8"/>
                                    <DataGrid Grid.Row="1" ItemsSource="{Binding HistoryCheques}" SelectedItem="{Binding SelectedHistoryCheque}" AutoGenerateColumns="False" IsReadOnly="True"
                                              GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowHeight="26">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Cheque No" Binding="{Binding ChequeNo}" Width="100" FontWeight="Bold"/>
                                            <DataGridTextColumn Header="Bank Name" Binding="{Binding AccountName}" Width="140"/>
                                            <DataGridTextColumn Header="Entry Date" Binding="{Binding EntryDate, StringFormat=d}" Width="95"/>
                                            <DataGridCheckBoxColumn Header="Cancelled" Binding="{Binding IsCancelled}" Width="75"/>
                                            <DataGridTextColumn Header="Remarks" Binding="{Binding Remarks}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>

                            <!-- Right: All Issued Cheques Register -->
                            <Border Grid.Column="2" CornerRadius="14" BorderBrush="{StaticResource BrushSurfaceBorder}" BorderThickness="1" Background="#FFFFFF" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Issued Cheques Register (جاری کردہ چیکز رجسٹر)" FontSize="13" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,0,0,8"/>
                                    <DataGrid Grid.Row="1" ItemsSource="{Binding AllIssuedCheques}" SelectedItem="{Binding SelectedRegisterCheque}" AutoGenerateColumns="False" IsReadOnly="True"
                                              GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowHeight="26">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Cheque No" Binding="{Binding ChequeNo}" Width="95" FontWeight="Bold"/>
                                            <DataGridTextColumn Header="Party" Binding="{Binding IssuedToParty.Name}" Width="130"/>
                                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" Width="100" FontWeight="Bold"/>
                                            <DataGridTextColumn Header="Issue Date" Binding="{Binding IssueDate, StringFormat=d}" Width="90"/>
                                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Actions Bar -->
                        <Border Grid.Row="2" CornerRadius="14" BorderBrush="{StaticResource BrushSurfaceBorder}" BorderThickness="1" Background="#F8FAFC" Padding="12" Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Cheque Leaf Action:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                <TextBox Grid.Column="1" materialDesign:HintAssist.Hint="Cancellation Reason / Remarks (وجہ منسوخی)" Text="{Binding HistoryCancelRemarks}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,12,0"/>
                                <Button Grid.Column="2" Content="Cancel Selected Leaf" Command="{Binding CancelHistoryChequeCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#DC2626" FontWeight="Bold"/>
                                <Button Grid.Column="4" Content="Delete Unused Cheque" Command="{Binding DeleteHistoryChequeCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#7F1D1D" FontWeight="Bold"/>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

            </TabControl>
        </Grid>
    </Border>
</Window>
