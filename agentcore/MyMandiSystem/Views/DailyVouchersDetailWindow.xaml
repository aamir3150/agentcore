<Window x:Class="MyMandiSystem.Views.DailyVouchersDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Daily Vouchers Detail" 
        Height="480" Width="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#EAEAEA"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <!-- Classic / ERP Styled Button -->
        <Style x:Key="ClassicReportButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Background" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="#707070"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="3" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="8,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#E0EEF8"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#0078D7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#CCE4F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <DockPanel LastChildFill="True">

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                       HEADER BANNER                        -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border DockPanel.Dock="Top" Height="78" Background="#3B7D23">
                <Grid>
                    <!-- Diagonal Overlay Texture Effect -->
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#4A9B2C" Offset="0"/>
                            <GradientStop Color="#2E681A" Offset="0.85"/>
                            <GradientStop Color="#1D4A0E" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>

                    <!-- Title Header -->
                    <StackPanel VerticalAlignment="Center" Margin="24,0,0,0">
                        <TextBlock Text="Daily Vouchers Detail" FontSize="26" FontWeight="ExtraBold" Foreground="#112200" FontFamily="Georgia">
                            <TextBlock.Effect>
                                <DropShadowEffect ShadowDepth="1" BlurRadius="2" Color="#FFFFFF" Opacity="0.5"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>

                    <!-- Right Graphic Emblem -->
                    <Border HorizontalAlignment="Right" Width="100" Height="78" Margin="0,0,16,0" ClipToBounds="True">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Width="48" Height="48" CornerRadius="8" Background="#5BA832" BorderBrush="#8AD85F" BorderThickness="1.5">
                                <materialDesign:PackIcon Kind="Tractor" Width="30" Height="30" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                     BOTTOM BUTTONS BAR                     -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border DockPanel.Dock="Bottom" Background="#DCDCDC" BorderBrush="#B8B8B8" BorderThickness="0,1,0,0" Padding="14,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <!-- Preview Button -->
                    <Button Style="{StaticResource ClassicReportButton}" Command="{Binding PreviewCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileEyeOutline" Width="16" Height="16" Foreground="#005A9E" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Preview" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Print Button -->
                    <Button Style="{StaticResource ClassicReportButton}" Command="{Binding PrintCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Printer" Width="16" Height="16" Foreground="#333333" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Print" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Close Button -->
                    <Button Style="{StaticResource ClassicReportButton}" Command="{Binding CloseCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CloseCircle" Width="16" Height="16" Foreground="#D13438" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Close" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--                      FORM CONTROLS                         -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Grid Background="#F5F5F5" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Dates Area -->
                    <RowDefinition Height="Auto"/> <!-- Checkboxes & Voucher Type Area -->
                </Grid.RowDefinitions>

                <!-- 1. Date Radios -->
                <StackPanel Grid.Row="0" Margin="0,0,0,20" Width="440">
                    <!-- All Dates -->
                    <RadioButton Content="All Dates" IsChecked="{Binding IsAllDates}" Margin="0,0,0,10" FontWeight="SemiBold" FontSize="13.5"/>

                    <!-- Single Date -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <RadioButton Content="Single Date" IsChecked="{Binding IsSingleDate}" FontWeight="SemiBold" FontSize="13.5" Width="130" VerticalAlignment="Center"/>
                        <DatePicker SelectedDate="{Binding SingleDate}" IsEnabled="{Binding IsSingleDate}" Width="160" Height="28" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Date Range -->
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Date Range" IsChecked="{Binding IsDateRange}" FontWeight="SemiBold" FontSize="13.5" Width="130" VerticalAlignment="Center"/>
                        <DatePicker SelectedDate="{Binding FromDate}" IsEnabled="{Binding IsDateRange}" Width="120" Height="28" VerticalContentAlignment="Center"/>
                        <TextBlock Text="To" VerticalAlignment="Center" Margin="8,0,8,0" IsEnabled="{Binding IsDateRange}"/>
                        <DatePicker SelectedDate="{Binding ToDate}" IsEnabled="{Binding IsDateRange}" Width="120" Height="28" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- 2. Checkboxes & Voucher Type -->
                <StackPanel Grid.Row="1" Margin="0,0,0,10" Width="440">
                    <!-- Row 1: Include Bank Vouchers (Left) | Exclude Accounts Vouchers (Right) -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" Content="Include Bank Vouchers also" IsChecked="{Binding IncludeBankVouchersAlso}" FontWeight="SemiBold"/>
                        <CheckBox Grid.Column="1" Content="Exclude Accounts Vouchers" IsChecked="{Binding ExcludeAccountsVouchers}" FontWeight="SemiBold"/>
                    </Grid>

                    <!-- Row 2: Include Invoices -->
                    <CheckBox Content="Include Invoices" IsChecked="{Binding IncludeInvoices}" Margin="0,0,0,14" FontWeight="SemiBold"/>

                    <!-- Row 3: Voucher Type -->
                    <StackPanel>
                        <TextBlock Text="Voucher Type" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding VoucherTypes}" SelectedItem="{Binding SelectedVoucherType}" Height="28" Padding="6,2"/>
                    </StackPanel>
                </StackPanel>

            </Grid>
        </DockPanel>
    </Grid>
</Window>
