<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="clr-namespace:MyMandiSystem.Core.PrintModels;assembly=MyMandiSystem.Core"
    xmlns:pc="clr-namespace:MyMandiSystem.Printing.Controls"
    xmlns:cv="clr-namespace:MyMandiSystem.Printing.Converters">

    <cv:AmountInWordsConverter x:Key="AmountInWords"/>
    <cv:PrintDateConverter x:Key="PrintDateConverter"/>

    <DataTemplate DataType="{x:Type m:CreditVoucherSlip}">
        <Border Background="White" Padding="24,20" BorderBrush="#0F172A" BorderThickness="1.5">
            <StackPanel>
                <pc:PrintHeader Title="MAAL UDHAAR SLIP (مال ادھار پرچی)"/>

                <!-- Party & Voucher Information -->
                <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,4,0,10" Background="#F8FAFC">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Party Name & Phone -->
                        <StackPanel Grid.Column="0">
                            <TextBlock FontSize="15" FontWeight="Bold" Foreground="#0F172A">
                                <Run Text="{Binding PartyName}"/>
                                <Run Text=" "/>
                                <Run Text="{Binding PartyUrduName}" FontFamily="pack://application:,,,/agentcore;component/Resources/Fonts/#Jameel Noori Nastaleeq, Jameel Noori Nastaleeq, Nafees Nastaleeq, Arial" FontSize="17"/>
                            </TextBlock>
                            <TextBlock Text="{Binding PartyPhone, StringFormat='Phone: {0}'}" FontSize="11" Foreground="#475569" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding PartyAddress, StringFormat='Address: {0}'}" FontSize="11" Foreground="#475569" Margin="0,1,0,0"/>
                        </StackPanel>

                        <!-- Voucher No & Date -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border Background="#0F172A" CornerRadius="3" Padding="6,2" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding VoucherNo, StringFormat='Voucher # {0}'}" FontWeight="Bold" Foreground="White" FontSize="11.5"/>
                            </Border>
                            <TextBlock Text="{Binding Date, Converter={StaticResource PrintDateConverter}, StringFormat='Date: {0}'}" 
                                       FontSize="11" Foreground="#334155" Margin="0,4,0,0" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Items Table Header -->
                <Border Background="#1E293B" Padding="8,5" Margin="0,0,0,2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="#" FontWeight="Bold" Foreground="White" FontSize="11"/>
                        <TextBlock Grid.Column="1" Text="Item / جنس" FontWeight="Bold" Foreground="White" FontSize="11"/>
                        <TextBlock Grid.Column="2" Text="Qty / وزن" FontWeight="Bold" Foreground="White" FontSize="11" TextAlignment="Right"/>
                        <TextBlock Grid.Column="3" Text="Unit" FontWeight="Bold" Foreground="White" FontSize="11" TextAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="Rate / ریٹ" FontWeight="Bold" Foreground="White" FontSize="11" TextAlignment="Right"/>
                        <TextBlock Grid.Column="5" Text="Total / رقم" FontWeight="Bold" Foreground="White" FontSize="11" TextAlignment="Right"/>
                    </Grid>
                </Border>

                <!-- Items Table Lines -->
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="8,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="•" Foreground="#64748B" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Product}" FontWeight="SemiBold" FontSize="11.5" Foreground="#0F172A"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Qty, StringFormat='{}{0:N2}'}" FontSize="11.5" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Unit}" FontSize="10.5" Foreground="#64748B" TextAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Rate, StringFormat='{}{0:N2}'}" FontSize="11.5" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="5" Text="{Binding Amount, StringFormat='{}{0:N0}'}" FontWeight="SemiBold" FontSize="11.5" TextAlignment="Right"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Remarks & Total -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>

                    <!-- Remarks / In Words -->
                    <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Top">
                        <TextBlock Text="{Binding TotalAmount, Converter={StaticResource AmountInWords}}" 
                                   FontStyle="Italic" FontWeight="SemiBold" FontSize="11.5" Foreground="#0F766E" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Remarks, StringFormat='Remarks: {0}'}" 
                                   FontSize="11" Foreground="#475569" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Total Amount Box -->
                    <Border Grid.Column="1" Background="#F1F5F9" BorderBrush="#0F172A" BorderThickness="1.5" CornerRadius="4" Padding="10,6">
                        <Grid>
                            <TextBlock Text="Total (کل رقم):" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalAmount, StringFormat='Rs. {0:N0}'}" 
                                       FontWeight="Bold" FontSize="15" Foreground="#0F172A" 
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Signature Block -->
                <pc:SignatureBlock Labels="دستخط کسان (Kisaan),دستخط منشی (Munshi),دستخط مینیجر (Manager)" Margin="0,45,0,12"/>

                <!-- Footer -->
                <pc:PrintFooter CopyLabel="Office Copy / دفتری کاپی"/>
            </StackPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>
