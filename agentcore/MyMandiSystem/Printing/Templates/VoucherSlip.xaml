<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="clr-namespace:MyMandiSystem.Core.PrintModels;assembly=MyMandiSystem.Core"
    xmlns:pc="clr-namespace:MyMandiSystem.Printing.Controls"
    xmlns:cv="clr-namespace:MyMandiSystem.Printing.Converters">

    <cv:AmountInWordsConverter x:Key="AmountInWords"/>
    <cv:PrintDateConverter x:Key="PrintDateConverter"/>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <DataTemplate DataType="{x:Type m:VoucherSlip}">
        <Border Background="White" Padding="24,20" BorderBrush="#0F172A" BorderThickness="1.5">
            <StackPanel>
                <pc:PrintHeader Title="{Binding VoucherType, StringFormat='{}{0} VOUCHER'}" ShowUrduCompany="False" />

                <!-- Voucher Header Info -->
                <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,4,0,10" Background="#F8FAFC">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Account Details -->
                        <StackPanel Grid.Column="0">
                            <TextBlock FontSize="14" FontWeight="Bold" Foreground="#0F172A">
                                <Run Text="{Binding AccountName, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Text="{Binding AccountNo, StringFormat='A/C No: {0}'}" FontSize="11" Foreground="#475569" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Voucher # & Date -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border Background="#0F172A" CornerRadius="3" Padding="6,2" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding VoucherNo, StringFormat='Voucher # {0}'}" FontWeight="Bold" Foreground="White" FontSize="11.5"/>
                            </Border>
                            <TextBlock Text="{Binding Date, Converter={StaticResource PrintDateConverter}, StringFormat='Date: {0}'}" 
                                       FontSize="11" Foreground="#334155" Margin="0,4,0,0" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Details Table Header -->
                <Border Background="#1E293B" CornerRadius="4,4,0,0" Padding="8,6" Margin="0,4,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="A/C No" FontWeight="Bold" Foreground="White" FontSize="11"/>
                        <TextBlock Grid.Column="1" Text="Account Title" FontWeight="Bold" Foreground="White" FontSize="11"/>
                        <TextBlock Grid.Column="2" Text="Debit" FontWeight="Bold" Foreground="White" FontSize="11" TextAlignment="Right"/>
                        <TextBlock Grid.Column="3" Text="Credit" FontWeight="Bold" Foreground="White" FontSize="11" TextAlignment="Right"/>
                    </Grid>
                </Border>

                <!-- Details lines -->
                <ItemsControl ItemsSource="{Binding Details}" Margin="0,0,0,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#CBD5E1" BorderThickness="1,0,1,1" Padding="8,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding AccountNo}" FontSize="11" Foreground="#475569" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding AccountName}" FontSize="11.5" FontWeight="SemiBold" Foreground="#0F172A"/>
                                        <TextBlock Text="{Binding Narration}" FontSize="10" Foreground="#64748B" FontStyle="Italic" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Debit, StringFormat='{}{0:N0}'}" FontSize="11.5" FontWeight="SemiBold" Foreground="#BE123C" TextAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Credit, StringFormat='{}{0:N0}'}" FontSize="11.5" FontWeight="SemiBold" Foreground="#047857" TextAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Amount Box & Narration -->
                <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="{Binding Narration, StringFormat='Narration: {0}'}" 
                                       FontSize="11.5" Foreground="#334155" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Amount, Converter={StaticResource AmountInWords}}" 
                                       FontStyle="Italic" FontWeight="SemiBold" FontSize="11.5" Foreground="#0F766E" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#0F172A" CornerRadius="4" Padding="14,6" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Amount, StringFormat='Total: Rs. {0:N0}'}" 
                                       FontWeight="Bold" FontSize="15" Foreground="White"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Currency Denominations (Notes Breakdown) -->
                <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,0,10" Background="#F8FAFC"
                        Visibility="{Binding HasDenominations, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Currency Denominations:" FontSize="10.5" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,3"/>
                        <WrapPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Count5000, StringFormat='5000: {0}  |  '}" FontSize="10" FontWeight="SemiBold" Foreground="#475569"/>
                            <TextBlock Text="{Binding Count1000, StringFormat='1000: {0}  |  '}" FontSize="10" FontWeight="SemiBold" Foreground="#475569"/>
                            <TextBlock Text="{Binding Count500, StringFormat='500: {0}  |  '}" FontSize="10" FontWeight="SemiBold" Foreground="#475569"/>
                            <TextBlock Text="{Binding Count100, StringFormat='100: {0}  |  '}" FontSize="10" FontWeight="SemiBold" Foreground="#475569"/>
                            <TextBlock Text="{Binding Count50, StringFormat='50: {0}  |  '}" FontSize="10" FontWeight="SemiBold" Foreground="#475569"/>
                            <TextBlock Text="{Binding Count20, StringFormat='20: {0}  |  '}" FontSize="10" FontWeight="SemiBold" Foreground="#475569"/>
                            <TextBlock Text="{Binding Count10, StringFormat='10: {0}  |  '}" FontSize="10" FontWeight="SemiBold" Foreground="#475569"/>
                            <TextBlock Text="{Binding Count5, StringFormat='5: {0}  |  '}" FontSize="10" FontWeight="SemiBold" Foreground="#475569"/>
                            <TextBlock Text="{Binding Count2, StringFormat='2: {0}  |  '}" FontSize="10" FontWeight="SemiBold" Foreground="#475569"/>
                            <TextBlock Text="{Binding Count1, StringFormat='1: {0}'}" FontSize="10" FontWeight="SemiBold" Foreground="#475569"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Signatures -->
                <pc:SignatureBlock Labels="Prepared By,Checked By,Signature" Margin="0,50,0,14"/>

                <!-- Footer -->
                <pc:PrintFooter CopyLabel="Original Voucher"/>
            </StackPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>
