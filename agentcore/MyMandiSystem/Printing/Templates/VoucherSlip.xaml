<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="clr-namespace:MyMandiSystem.Core.PrintModels;assembly=MyMandiSystem.Core"
    xmlns:pc="clr-namespace:MyMandiSystem.Printing.Controls"
    xmlns:cv="clr-namespace:MyMandiSystem.Printing.Converters">

    <cv:AmountInWordsConverter x:Key="AmountInWords"/>
    <cv:PrintDateConverter x:Key="PrintDateConverter"/>

    <DataTemplate DataType="{x:Type m:VoucherSlip}">
        <Border Background="White" Padding="24,20" BorderBrush="#0F172A" BorderThickness="1.5">
            <StackPanel>
                <pc:PrintHeader Title="{Binding VoucherType, StringFormat='{}{0} VOUCHER'}" 
                                Subtitle="{Binding VoucherTypeUrdu}"/>

                <!-- Voucher Header Info -->
                <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,4,0,10" Background="#F8FAFC">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Account Details -->
                        <StackPanel Grid.Column="0">
                            <TextBlock FontSize="14" FontWeight="Bold" Foreground="#0F172A">
                                <Run Text="{Binding AccountName}"/>
                                <Run Text=" "/>
                                <Run Text="{Binding AccountUrduName}" FontFamily="pack://application:,,,/agentcore;component/Resources/Fonts/#Jameel Noori Nastaleeq, Jameel Noori Nastaleeq, Nafees Nastaleeq, Arial" FontSize="16"/>
                            </TextBlock>
                            <TextBlock Text="{Binding AccountNo, StringFormat='A/C No: {0}'}" FontSize="11" Foreground="#475569" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Voucher # & Date -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border Background="#0F172A" CornerRadius="3" Padding="6,2" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding VoucherNo, StringFormat='Voucher # {0}'}" FontWeight="Bold" Foreground="White" FontSize="11.5"/>
                            </Border>
                            <TextBlock Text="{Binding Date, Converter={StaticResource PrintDateConverter}, StringFormat='Date: {0}'}" 
                                       FontSize="11" Foreground="#334155" Margin="0,4,0,0" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- If has multiple details lines -->
                <ItemsControl ItemsSource="{Binding Details}" Margin="0,0,0,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="6,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding AccountNo}" FontSize="11" Foreground="#64748B"/>
                                    <TextBlock Grid.Column="1" Text="{Binding AccountName}" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Debit, StringFormat='{}{0:N0}'}" FontSize="11" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Credit, StringFormat='{}{0:N0}'}" FontSize="11" TextAlignment="Right"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Amount Box & Narration -->
                <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="{Binding Narration, StringFormat='Narration: {0}'}" 
                                       FontSize="11.5" Foreground="#334155" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Amount, Converter={StaticResource AmountInWords}}" 
                                       FontStyle="Italic" FontWeight="SemiBold" FontSize="11.5" Foreground="#0F766E" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#0F172A" CornerRadius="4" Padding="12,6" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Amount, StringFormat='Rs. {0:N0}'}" 
                                       FontWeight="Bold" FontSize="16" Foreground="White"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Signatures -->
                <pc:SignatureBlock Labels="وصول کنندہ (Receiver),منشی / کیشئر (Prepared By)" Margin="0,50,0,14"/>

                <!-- Footer -->
                <pc:PrintFooter CopyLabel="Original Voucher / اصل واؤچر"/>
            </StackPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>
