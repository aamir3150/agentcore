<Window x:Class="agentcore.DbTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="agentcore - Standalone Database Administrator (phpMyAdmin Style)"
        Height="880" Width="1360"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="ModernTabItem" TargetType="TabItem">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border" BorderThickness="0,0,0,3" BorderBrush="Transparent" Background="Transparent" Padding="{TemplateBinding Padding}" Margin="0,0,12,0" Cursor="Hand">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#0284C7"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#0284C7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- View visibility switcher based on IsViewingSingleTable -->
        <Style x:Key="VisibleWhenSingleTable" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsViewingSingleTable}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="VisibleWhenDatabaseOverview" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsViewingSingleTable}" Value="False">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 1. Top Header Bar -->
            <RowDefinition Height="*"/>    <!-- 2. Main Work Area (Left Sidebar + Right Content) -->
            <RowDefinition Height="Auto"/> <!-- 3. Bottom Status Bar -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--                   1. TOP CONTROL HEADER                    -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#0F172A" Padding="18,10" Effect="{StaticResource EffectCardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Title & phpMyAdmin Badge -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="8" Background="#1E293B" Margin="0,0,12,0" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="DatabaseCog" Width="22" Height="22" Foreground="{StaticResource BrushAccentTealLight}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="agentcore Database Administrator" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <Border Background="#0284C7" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="phpMyAdmin Style" FontSize="10.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="سٹی کمپیوٹرز مروٹ — خود مختار ڈیٹا بیس ساخت و سالانہ کلوزنگ ٹول" 
                                   FontFamily="{StaticResource FontJameelNooriNastaleeq}" FontSize="15" Foreground="#94A3B8"/>
                    </StackPanel>
                </StackPanel>

                <!-- Center: Connection Badges -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Server Badge -->
                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="8" Height="8" CornerRadius="4" Background="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Server: " Foreground="#94A3B8" FontSize="12"/>
                            <TextBlock Text="{Binding ServerName}" Foreground="#F8FAFC" FontWeight="Bold" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <!-- Active DB Badge -->
                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Database" Width="14" Height="14" Foreground="#38BDF8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="DB: " Foreground="#94A3B8" FontSize="12"/>
                            <TextBlock Text="{Binding CurrentActiveDatabase}" Foreground="#38BDF8" FontWeight="Bold" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <!-- Financial Year Badge -->
                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="10,5">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CalendarCheck" Width="14" Height="14" Foreground="#F59E0B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Year: " Foreground="#94A3B8" FontSize="12"/>
                            <TextBlock Text="{Binding CurrentFinancialYear}" Foreground="#F59E0B" FontWeight="Bold" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: Exit Button -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="ExitButton_Click" Cursor="Hand" Height="34" Padding="14,0" Background="#1E293B" Foreground="#CBD5E1" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Close" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Exit Tool" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--                   2. MAIN WORK AREA                        -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/> <!-- Left Persistent Sidebar (Tables tree) -->
                <ColumnDefinition Width="*"/>   <!-- Right Content Area (phpMyAdmin tabs) -->
            </Grid.ColumnDefinitions>

            <!-- ────────────────────────────────────────────────────────── -->
            <!-- LEFT SIDEBAR: PHPMYADMIN TABLES TREE LIST                  -->
            <!-- ────────────────────────────────────────────────────────── -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="12,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Database Selector -->
                        <RowDefinition Height="Auto"/> <!-- Quick Action Buttons -->
                        <RowDefinition Height="Auto"/> <!-- Filter Tables Box -->
                        <RowDefinition Height="*"/>    <!-- Tables ListBox -->
                        <RowDefinition Height="Auto"/> <!-- Bottom Info -->
                    </Grid.RowDefinitions>

                    <!-- Row 0: Database Selector -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="DATABASE (ڈیٹا بیس)" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding Databases}" SelectedItem="{Binding SelectedDatabase}" DisplayMemberPath="DatabaseName"
                                      Height="34" Padding="8,4" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" FontSize="12.5"/>
                            <Button Grid.Column="1" Command="{Binding RefreshDatabasesAndTablesCommand}" Height="34" Width="34" Margin="6,0,0,0"
                                    Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" ToolTip="Reload Databases">
                                <materialDesign:PackIcon Kind="Refresh" Width="15" Height="15" Foreground="#475569"/>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Row 1: Quick Database Level Actions -->
                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="6" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Command="{Binding LoadDatabaseOverviewCommand}" 
                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="TableHeadersEye" Width="14" Height="14" Foreground="#0284C7" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Structure" FontSize="11" FontWeight="SemiBold" Foreground="#0284C7" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Command="{Binding OpenQueryForTableCommand}" CommandParameter="Accounts"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="ConsoleLine" Width="14" Height="14" Foreground="#7C3AED" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="SQL Query" FontSize="11" FontWeight="SemiBold" Foreground="#7C3AED" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Row 2: Search Tables Box -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,8">
                        <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="8,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="Magnify" Width="15" Height="15" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Grid.Column="1" Text="{Binding TableSearchText, UpdateSourceTrigger=PropertyChanged}" 
                                         BorderThickness="0" Background="Transparent" FontSize="12" VerticalAlignment="Center"
                                         materialDesign:HintAssist.Hint="Filter tables (تلاش)..."/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Row 3: Tables List with Row Count & Quick Click -->
                    <ListBox Grid.Row="3" ItemsSource="{Binding FilteredTables}" SelectedItem="{Binding SelectedTable}" 
                             BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6" Margin="0,1" CornerRadius="6" Background="#FFFFFF" BorderBrush="#F1F5F9" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Table Icon -->
                                        <materialDesign:PackIcon Kind="Table" Width="15" Height="15" Foreground="#0284C7" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        
                                        <!-- Table Name & Category -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TableName}" FontWeight="SemiBold" FontSize="12" Foreground="#1E293B"/>
                                        </StackPanel>
                                        
                                        <!-- Row Count Badge -->
                                        <Border Grid.Column="2" CornerRadius="8" Background="#F1F5F9" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding RowCount, StringFormat='{}{0:N0}'}" FontSize="10.5" FontWeight="Bold" Foreground="#475569"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Row 4: Bottom Sidebar Info -->
                    <Border Grid.Row="4" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="8,8,8,0" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding FilteredTables.Count, StringFormat='{}Tables: {0}'}" FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                            <TextBlock Text="SQL Server 2022 Express" FontSize="10" Foreground="#94A3B8"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ────────────────────────────────────────────────────────── -->
            <!-- RIGHT CONTENT AREA: PHPMYADMIN TABS                        -->
            <!-- ────────────────────────────────────────────────────────── -->
            <Grid Grid.Column="1" Margin="14,10,14,10">
                <TabControl SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent" BorderThickness="0">

                    <!-- ══════════════════════════════════════════════════════ -->
                    <!-- TAB 0: STRUCTURE (ساخت) - phpMyAdmin Style             -->
                    <!-- ══════════════════════════════════════════════════════ -->
                    <TabItem Style="{StaticResource ModernTabItem}">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TableHeadersEye" Width="17" Height="17" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Structure (ساخت)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </TabItem.Header>

                        <Grid Margin="0,8,0,0">
                            <!-- ────────────────────────────────────────────── -->
                            <!-- VIEW A: DATABASE-LEVEL ALL TABLES STRUCTURE    -->
                            <!-- (Visible when IsViewingSingleTable == False)   -->
                            <!-- ────────────────────────────────────────────── -->
                            <Grid Style="{StaticResource VisibleWhenDatabaseOverview}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Overview Stat Banner -->
                                    <RowDefinition Height="Auto"/> <!-- Search & Actions Bar -->
                                    <RowDefinition Height="*"/>    <!-- Tables Overview DataGrid -->
                                    <RowDefinition Height="Auto"/> <!-- Footer Totals Summary -->
                                </Grid.RowDefinitions>

                                <!-- Row 0: Top Overview Banner -->
                                <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14,10" Margin="0,0,0,10" Effect="{StaticResource EffectCardShadow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="34" Height="34" CornerRadius="8" Background="#E0F2FE" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="DatabaseSearchOutline" Width="18" Height="18" Foreground="#0284C7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Database Structure: " FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                                                    <TextBlock Text="{Binding SelectedDatabase.DatabaseName}" FontSize="14" FontWeight="Bold" Foreground="#0284C7"/>
                                                </StackPanel>
                                                <TextBlock Text="ڈیٹا بیس کے تمام ٹیبلز، فیلڈز اور ریکارڈز کی تفصیل" 
                                                           FontFamily="{StaticResource FontJameelNooriNastaleeq}" FontSize="13.5" Foreground="#64748B"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Stats Badges -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="#F1F5F9" CornerRadius="6" Padding="10,6" Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Tables: " Foreground="#64748B" FontSize="11.5"/>
                                                    <TextBlock Text="{Binding DatabaseOverview.TotalTables}" FontWeight="Bold" Foreground="#0F172A" FontSize="11.5"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#F1F5F9" CornerRadius="6" Padding="10,6" Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Total Rows: " Foreground="#64748B" FontSize="11.5"/>
                                                    <TextBlock Text="{Binding DatabaseOverview.TotalRows, StringFormat='{}{0:N0}'}" FontWeight="Bold" Foreground="#0F172A" FontSize="11.5"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#F1F5F9" CornerRadius="6" Padding="10,6">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Total Size: " Foreground="#64748B" FontSize="11.5"/>
                                                    <TextBlock Text="{Binding DatabaseOverview.TotalSpaceMb, StringFormat='{}{0:F2} MB'}" FontWeight="Bold" Foreground="#0284C7" FontSize="11.5"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Row 1: Search & Actions Filter -->
                                <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10,6" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Search Table -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="FilterVariant" Width="16" Height="16" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBox Text="{Binding StructureSearchText, UpdateSourceTrigger=PropertyChanged}" 
                                                     Width="300" BorderThickness="0" Background="Transparent" FontSize="12.5"
                                                     materialDesign:HintAssist.Hint="Filter tables in structure view..."/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Command="{Binding LoadDatabaseOverviewCommand}" 
                                                Height="30" Padding="10,0" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBlock Text="Refresh Overview" FontSize="11.5" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Row 2: Tables Overview DataGrid (phpMyAdmin Table List) -->
                                <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="4">
                                    <DataGrid ItemsSource="{Binding FilteredDetailedTables}" 
                                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                              Background="Transparent" BorderThickness="0"
                                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                              HorizontalGridLinesBrush="#F1F5F9" RowHeight="36">
                                        <DataGrid.Columns>
                                            <!-- Table Name -->
                                            <DataGridTemplateColumn Header="Table" Width="2*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                                                            <materialDesign:PackIcon Kind="Table" Width="15" Height="15" Foreground="#0284C7" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding TableName}" FontWeight="Bold" Foreground="#0F172A" FontSize="12.5" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- Action Buttons (phpMyAdmin Style: Browse, Structure, SQL) -->
                                            <DataGridTemplateColumn Header="Action" Width="220">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <!-- Browse Button -->
                                                            <Button Command="{Binding DataContext.BrowseTableDataCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                    CommandParameter="{Binding TableName}"
                                                                    Height="26" Padding="8,0" Margin="0,0,4,0" Background="#E0F2FE" Foreground="#0284C7" BorderThickness="0" Cursor="Hand" ToolTip="Browse Records">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <materialDesign:PackIcon Kind="TableEye" Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                                    <TextBlock Text="Browse" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Button>

                                                            <!-- Structure Button -->
                                                            <Button Command="{Binding DataContext.ViewTableStructureCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                    CommandParameter="{Binding TableName}"
                                                                    Height="26" Padding="8,0" Margin="0,0,4,0" Background="#FEF3C7" Foreground="#D97706" BorderThickness="0" Cursor="Hand" ToolTip="View Schema Structure">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <materialDesign:PackIcon Kind="TableHeadersEye" Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                                    <TextBlock Text="Structure" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Button>

                                                            <!-- SQL Button -->
                                                            <Button Command="{Binding DataContext.OpenQueryForTableCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                    CommandParameter="{Binding TableName}"
                                                                    Height="26" Padding="8,0" Background="#F3E8FF" Foreground="#7C3AED" BorderThickness="0" Cursor="Hand" ToolTip="Query Table">
                                                                <materialDesign:PackIcon Kind="ConsoleLine" Width="13" Height="13" VerticalAlignment="Center"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- Rows Count -->
                                            <DataGridTextColumn Header="Rows" Binding="{Binding RowCount, StringFormat='{}{0:N0}'}" Width="100">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                        <Setter Property="Foreground" Value="#0F172A"/>
                                                        <Setter Property="Margin" Value="0,0,8,0"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <!-- Columns Count -->
                                            <DataGridTextColumn Header="Cols" Binding="{Binding ColumnCount}" Width="60">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                                        <Setter Property="Foreground" Value="#475569"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <!-- Engine / Type -->
                                            <DataGridTextColumn Header="Type / Engine" Binding="{Binding EngineType}" Width="110">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#64748B"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <!-- Total Size -->
                                            <DataGridTextColumn Header="Size" Binding="{Binding DisplaySize}" Width="90">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                        <Setter Property="Foreground" Value="#0284C7"/>
                                                        <Setter Property="Margin" Value="0,0,8,0"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <!-- Category -->
                                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="140">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#64748B"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <!-- Collation -->
                                            <DataGridTextColumn Header="Collation" Binding="{Binding Collation}" Width="1*">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                                        <Setter Property="FontSize" Value="11"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>

                                <!-- Row 3: Footer Totals Summary (Matching phpMyAdmin table footer) -->
                                <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FilteredDetailedTables.Count, StringFormat='{}Showing {0} table(s)'}" FontWeight="Bold" Foreground="#334155" FontSize="12"/>
                                            <TextBlock Text=" • کل ٹیبلز" FontFamily="{StaticResource FontJameelNooriNastaleeq}" FontSize="13" Foreground="#64748B" Margin="6,0,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Total Rows: " Foreground="#64748B" FontSize="11.5"/>
                                            <TextBlock Text="{Binding DatabaseOverview.TotalRows, StringFormat='{}{0:N0}'}" FontWeight="Bold" Foreground="#0F172A" FontSize="11.5" Margin="0,0,14,0"/>
                                            <TextBlock Text="Total Space: " Foreground="#64748B" FontSize="11.5"/>
                                            <TextBlock Text="{Binding DatabaseOverview.TotalSpaceMb, StringFormat='{}{0:F2} MB'}" FontWeight="Bold" Foreground="#0284C7" FontSize="11.5"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- ────────────────────────────────────────────── -->
                            <!-- VIEW B: SINGLE TABLE STRUCTURE & FIELD SCHEMA  -->
                            <!-- (Visible when IsViewingSingleTable == True)    -->
                            <!-- ────────────────────────────────────────────── -->
                            <Grid Style="{StaticResource VisibleWhenSingleTable}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Back button & Table info bar -->
                                    <RowDefinition Height="2*"/>   <!-- Columns Schema DataGrid -->
                                    <RowDefinition Height="1*"/>   <!-- Indexes & Foreign Keys Split -->
                                </Grid.RowDefinitions>

                                <!-- Row 0: Back Button & Table Info Header -->
                                <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12,10" Margin="0,0,0,10" Effect="{StaticResource EffectCardShadow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Back Button -->
                                        <Button Grid.Column="0" Command="{Binding BackToDatabaseOverviewCommand}" 
                                                Height="34" Padding="12,0" Margin="0,0,12,0" Background="#F1F5F9" Foreground="#0F172A" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="ArrowLeft" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="All Tables (تمام ٹیبلز)" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Table Name Title -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Table Structure: " FontSize="14" FontWeight="Bold" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding CurrentTableStructure.TableName}" FontSize="15" FontWeight="Bold" Foreground="#0284C7"/>
                                                <Border Background="#E0F2FE" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CurrentTableStructure.RowCount, StringFormat='{}{0:N0} Rows'}" FontSize="11" FontWeight="Bold" Foreground="#0284C7"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="ٹیبل کے کالمز، ڈیٹا ٹائپس، پرائمری کی اور اشاریہ جات (Indexes)" 
                                                       FontFamily="{StaticResource FontJameelNooriNastaleeq}" FontSize="13.5" Foreground="#94A3B8"/>
                                        </StackPanel>

                                        <!-- Actions: Browse Data, SQL Query, Export -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Browse Table Data -->
                                            <Button Command="{Binding BrowseTableDataCommand}" CommandParameter="{Binding CurrentTableStructure.TableName}"
                                                    Height="34" Padding="12,0" Margin="0,0,6,0" Background="#0284C7" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="TableEye" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Browse Data" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- Query Table -->
                                            <Button Command="{Binding OpenQueryForTableCommand}" CommandParameter="{Binding CurrentTableStructure.TableName}"
                                                    Height="34" Padding="12,0" Margin="0,0,6,0" Background="#7C3AED" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="ConsoleLine" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Run SQL" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- Export Table -->
                                            <Button Command="{Binding ExportCurrentTableCommand}" 
                                                    Height="34" Padding="12,0" Background="#10B981" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="FileExportOutline" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Export CSV" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Row 1: Columns Definition DataGrid (phpMyAdmin Field Grid) -->
                                <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="4" Margin="0,0,0,8">
                                    <DataGrid ItemsSource="{Binding TableColumns}" 
                                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                              Background="Transparent" BorderThickness="0"
                                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                              HorizontalGridLinesBrush="#F1F5F9" RowHeight="34">
                                        <DataGrid.Columns>
                                            <!-- # Ordinal Position -->
                                            <DataGridTextColumn Header="#" Binding="{Binding OrdinalPosition}" Width="45">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <!-- Column Name -->
                                            <DataGridTemplateColumn Header="Name" Width="2*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                                                            <!-- PK Icon -->
                                                            <materialDesign:PackIcon Kind="KeyVariant" Width="14" Height="14" Foreground="#D97706" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                                     Visibility="{Binding IsPrimaryKey, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                            <!-- FK Icon -->
                                                            <materialDesign:PackIcon Kind="LinkVariant" Width="14" Height="14" Foreground="#7C3AED" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                                     Visibility="{Binding IsForeignKey, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                            <TextBlock Text="{Binding ColumnName}" FontWeight="Bold" Foreground="#0F172A" FontSize="12.5" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- Full Type -->
                                            <DataGridTextColumn Header="Type" Binding="{Binding FullDataType}" Width="1.5*">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#0284C7"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                        <Setter Property="FontFamily" Value="Consolas, Segoe UI"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <!-- Nullable -->
                                            <DataGridTemplateColumn Header="Null" Width="80">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsNullable}" Value="True">
                                                                            <Setter Property="Background" Value="#DCFCE7"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding NullableText}" FontWeight="Bold" FontSize="11">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#B91C1C"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsNullable}" Value="True">
                                                                                <Setter Property="Foreground" Value="#15803D"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- Default Value -->
                                            <DataGridTextColumn Header="Default" Binding="{Binding DefaultValue}" Width="1*">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#64748B"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <!-- Key Badge -->
                                            <DataGridTextColumn Header="Key" Binding="{Binding KeyBadge}" Width="120">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="Foreground" Value="#D97706"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <!-- Extra -->
                                            <DataGridTextColumn Header="Extra" Binding="{Binding Extra}" Width="120">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#7C3AED"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <!-- Collation -->
                                            <DataGridTextColumn Header="Collation" Binding="{Binding Collation}" Width="1.5*">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                                        <Setter Property="FontSize" Value="11"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>

                                <!-- Row 2: Split View for Indexes & Foreign Keys -->
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Indexes Card -->
                                    <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10" Margin="0,0,6,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                                <materialDesign:PackIcon Kind="KeyChain" Width="16" Height="16" Foreground="#D97706" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Indexes (اشاریہ جات)" FontWeight="Bold" FontSize="12.5" Foreground="#0F172A"/>
                                            </StackPanel>
                                            <DataGrid Grid.Row="1" ItemsSource="{Binding TableIndexes}" 
                                                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                                      Background="Transparent" BorderThickness="0" HeadersVisibility="Column"
                                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" RowHeight="28">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Index Name" Binding="{Binding IndexName}" Width="1.5*"/>
                                                    <DataGridTextColumn Header="Type" Binding="{Binding IndexType}" Width="1*"/>
                                                    <DataGridCheckBoxColumn Header="Unique" Binding="{Binding IsUnique}" Width="65"/>
                                                    <DataGridTextColumn Header="Columns" Binding="{Binding Columns}" Width="1.5*"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                    </Border>

                                    <!-- Right: Foreign Keys Card -->
                                    <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10" Margin="6,0,0,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                                <materialDesign:PackIcon Kind="LinkVariant" Width="16" Height="16" Foreground="#7C3AED" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Foreign Keys &amp; Relations (تعلقات)" FontWeight="Bold" FontSize="12.5" Foreground="#0F172A"/>
                                            </StackPanel>
                                            <DataGrid Grid.Row="1" ItemsSource="{Binding TableForeignKeys}" 
                                                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                                      Background="Transparent" BorderThickness="0" HeadersVisibility="Column"
                                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" RowHeight="28">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Constraint" Binding="{Binding ConstraintName}" Width="1.2*"/>
                                                    <DataGridTextColumn Header="Column" Binding="{Binding ColumnName}" Width="1*"/>
                                                    <DataGridTextColumn Header="References" Binding="{Binding ReferencedTable}" Width="1*"/>
                                                    <DataGridTextColumn Header="On Delete" Binding="{Binding OnDeleteAction}" Width="90"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- ══════════════════════════════════════════════════════ -->
                    <!-- TAB 1: BROWSE DATA (ڈیٹا براؤز)                        -->
                    <!-- ══════════════════════════════════════════════════════ -->
                    <TabItem Style="{StaticResource ModernTabItem}">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TableEye" Width="17" Height="17" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Browse Data (ڈیٹا براؤز)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </TabItem.Header>

                        <Grid Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Top Action & Filter Toolbar -->
                                <RowDefinition Height="*"/>    <!-- Data Records DataGrid -->
                            </Grid.RowDefinitions>

                            <!-- Row 0: Toolbar -->
                            <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14,10" Margin="0,0,0,10" Effect="{StaticResource EffectCardShadow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Table Badge -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="Table" Width="20" Height="20" Foreground="#0284C7" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding SelectedTable.TableName, TargetNullValue='No Table Selected'}" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                        <Button Command="{Binding ViewTableStructureCommand}" CommandParameter="{Binding SelectedTable.TableName}"
                                                Height="28" Padding="8,0" Margin="10,0,0,0" Background="#FEF3C7" Foreground="#D97706" BorderThickness="0" Cursor="Hand" ToolTip="Switch to Structure View">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="TableHeadersEye" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBlock Text="View Structure" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <!-- Row Filter -->
                                    <Border Grid.Column="1" HorizontalAlignment="Right" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="8,3" Width="300" Margin="0,0,12,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Kind="FilterOutline" Width="15" Height="15" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBox Grid.Column="1" Text="{Binding RowFilterText, UpdateSourceTrigger=PropertyChanged}" 
                                                     BorderThickness="0" Background="Transparent" FontSize="12.5" VerticalAlignment="Center"
                                                     materialDesign:HintAssist.Hint="Filter rows in table..."/>
                                        </Grid>
                                    </Border>

                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Reload -->
                                        <Button Command="{Binding LoadSelectedTableDataCommand}" Height="34" Padding="12,0" Margin="0,0,8,0"
                                                Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Refresh" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBlock Text="Refresh" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Export CSV -->
                                        <Button Command="{Binding ExportCurrentTableCommand}" Height="34" Padding="14,0"
                                                Background="#10B981" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="FileExportOutline" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="Export CSV" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Row 1: DataGrid -->
                            <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="4" Effect="{StaticResource EffectCardShadow}">
                                <DataGrid ItemsSource="{Binding TableDataView}" 
                                          AutoGenerateColumns="True" CanUserAddRows="False" IsReadOnly="True"
                                          Background="Transparent" BorderThickness="0"
                                          HeadersVisibility="Column" GridLinesVisibility="All"
                                          HorizontalGridLinesBrush="#F1F5F9" VerticalGridLinesBrush="#F1F5F9"
                                          ScrollViewer.CanContentScroll="True"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- ══════════════════════════════════════════════════════ -->
                    <!-- TAB 2: SQL QUERY RUNNER (کوئری ایڈیٹر)                   -->
                    <!-- ══════════════════════════════════════════════════════ -->
                    <TabItem Style="{StaticResource ModernTabItem}">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ConsoleLine" Width="17" Height="17" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="SQL Query (کوئری ایڈیٹر)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </TabItem.Header>

                        <Grid Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Preset Buttons -->
                                <RowDefinition Height="180"/>  <!-- Query Editor Box -->
                                <RowDefinition Height="Auto"/> <!-- Execute Button & Status -->
                                <RowDefinition Height="*"/>    <!-- Query Results DataGrid -->
                            </Grid.RowDefinitions>

                            <!-- Row 0: SQL Preset Buttons -->
                            <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10,8" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Quick Templates:" FontWeight="Bold" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Button Command="{Binding ApplySqlPresetCommand}" CommandParameter="SELECT"
                                            Height="28" Padding="10,0" Margin="0,0,6,0" Background="#E0F2FE" Foreground="#0284C7" BorderThickness="0" Cursor="Hand">
                                        <TextBlock Text="SELECT * FROM Table" FontSize="11" FontWeight="Bold"/>
                                    </Button>
                                    <Button Command="{Binding ApplySqlPresetCommand}" CommandParameter="COUNT"
                                            Height="28" Padding="10,0" Margin="0,0,6,0" Background="#FEF3C7" Foreground="#D97706" BorderThickness="0" Cursor="Hand">
                                        <TextBlock Text="SELECT COUNT(*)" FontSize="11" FontWeight="Bold"/>
                                    </Button>
                                    <Button Command="{Binding ApplySqlPresetCommand}" CommandParameter="INSERT"
                                            Height="28" Padding="10,0" Margin="0,0,6,0" Background="#F1F5F9" Foreground="#334155" BorderThickness="0" Cursor="Hand">
                                        <TextBlock Text="INSERT INTO" FontSize="11" FontWeight="SemiBold"/>
                                    </Button>
                                    <Button Command="{Binding ApplySqlPresetCommand}" CommandParameter="UPDATE"
                                            Height="28" Padding="10,0" Margin="0,0,6,0" Background="#F1F5F9" Foreground="#334155" BorderThickness="0" Cursor="Hand">
                                        <TextBlock Text="UPDATE" FontSize="11" FontWeight="SemiBold"/>
                                    </Button>
                                    <Button Command="{Binding ApplySqlPresetCommand}" CommandParameter="DELETE"
                                            Height="28" Padding="10,0" Background="#FEE2E2" Foreground="#B91C1C" BorderThickness="0" Cursor="Hand">
                                        <TextBlock Text="DELETE" FontSize="11" FontWeight="Bold"/>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Row 1: Monospace SQL Editor -->
                            <Border Grid.Row="1" Background="#0F172A" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                <TextBox Text="{Binding CustomSqlQuery, UpdateSourceTrigger=PropertyChanged}" 
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         FontFamily="Consolas, Cascadia Code, Courier New" FontSize="13.5"
                                         Foreground="#38BDF8" Background="Transparent" BorderThickness="0"
                                         CaretBrush="#FFFFFF" VerticalScrollBarVisibility="Auto"/>
                            </Border>

                            <!-- Row 2: Execute Button & Status -->
                            <Grid Grid.Row="2" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Command="{Binding ExecuteCustomQueryCommand}" 
                                        Height="36" Padding="18,0" Background="#0284C7" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Play" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Execute Query (چلائیں)" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Grid.Column="1" Text="{Binding QueryStatusText}" Foreground="#475569" FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="14,0,0,0"/>
                            </Grid>

                            <!-- Row 3: Result DataGrid -->
                            <Border Grid.Row="3" Background="#FFFFFF" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="4" Effect="{StaticResource EffectCardShadow}">
                                <DataGrid ItemsSource="{Binding QueryResultView}" 
                                          AutoGenerateColumns="True" CanUserAddRows="False" IsReadOnly="True"
                                          Background="Transparent" BorderThickness="0"
                                          HeadersVisibility="Column" GridLinesVisibility="All"
                                          HorizontalGridLinesBrush="#F1F5F9" VerticalGridLinesBrush="#F1F5F9"
                                          ScrollViewer.CanContentScroll="True"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- ══════════════════════════════════════════════════════ -->
                    <!-- TAB 3: YEAR-END CLOSING (سالانہ اختتام و ریکارڈ لاک)    -->
                    <!-- ══════════════════════════════════════════════════════ -->
                    <TabItem Style="{StaticResource ModernTabItem}">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CalendarSync" Width="17" Height="17" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Year-End Closing (سالانہ کلوزنگ)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </TabItem.Header>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                            <StackPanel>
                                <!-- Banner Notice -->
                                <Border Background="#FEF3C7" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Grid.Column="0" Kind="AlertCircleOutline" Width="26" Height="26" Foreground="#D97706" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="مالی سال کا اختتام اور بیلنس فارورڈ مینیجر (Year-End Rollover)" FontSize="15" FontWeight="Bold" Foreground="#92400E"/>
                                            <TextBlock Text="اس ٹول سے پرانے سال کا ریکارڈ لاک کر کے نیا مالی سال بنایا جاتا ہے۔ تمام کھاتہ داروں اور پراڈکٹس کے کلوزنگ بیلنسز نئے سال میں اوپننگ بن جاتے ہیں، جبکہ واؤچرز اور انوائسز صفر سے شروع ہوتی ہیں۔" 
                                                       FontFamily="{StaticResource FontJameelNooriNastaleeq}" FontSize="14.5" Foreground="#78350F" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Two Cards: Pre-Check & Action Configuration -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left Card: Pre-Check Audit -->
                                    <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="18" Margin="0,0,8,0" Effect="{StaticResource EffectCardShadow}">
                                        <StackPanel>
                                            <TextBlock Text="1. سالانہ آڈٹ اور تسلی (PRE-CHECK AUDIT)" FontSize="12" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,12"/>
                                            
                                            <Grid Margin="0,0,0,8">
                                                <TextBlock Text="موجودہ مالی سال:" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding PreCheck.CurrentYearCode}" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,8">
                                                <TextBlock Text="کل فعال کھاتہ جات:" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding PreCheck.ActiveAccountsCount, StringFormat='{}{0:N0}'}" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,8">
                                                <TextBlock Text="کل پراڈکٹس / آئٹمز:" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding PreCheck.ActiveProductsCount, StringFormat='{}{0:N0}'}" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,8">
                                                <TextBlock Text="نامکمل واؤچرز:" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding PreCheck.UnpostedVouchersCount, StringFormat='{}{0:N0}'}" FontWeight="Bold" Foreground="#EF4444" HorizontalAlignment="Right"/>
                                            </Grid>

                                            <!-- Trial Balance Matching Status -->
                                            <Border CornerRadius="8" Padding="12,8" Margin="0,8,0,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#DCFCE7"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PreCheck.IsTrialBalanceBalanced}" Value="False">
                                                                <Setter Property="Background" Value="#FEE2E2"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="CheckCircle" Width="18" Height="18" Foreground="#16A34A" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="ٹرائل بیلنس مکمل طور پر متوازن اور درست ہے" FontWeight="SemiBold" Foreground="#15803D" VerticalAlignment="Center"
                                                               FontFamily="{StaticResource FontJameelNooriNastaleeq}" FontSize="14"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- Right Card: New Year Parameters -->
                                    <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="18" Margin="8,0,0,0" Effect="{StaticResource EffectCardShadow}">
                                        <StackPanel>
                                            <TextBlock Text="2. نئے سال کی ترتیبات (TARGET FINANCIAL YEAR)" FontSize="12" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,12"/>

                                            <TextBlock Text="نیا سال کوڈ (مثلاً: 2026-27):" FontSize="11.5" Foreground="#475569" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding NewYearCode, UpdateSourceTrigger=PropertyChanged}" 
                                                     Height="36" Padding="8,6" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,0,10"/>

                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock Text="آغاز تاریخ:" FontSize="11.5" Foreground="#475569" Margin="0,0,0,4"/>
                                                    <DatePicker SelectedDate="{Binding NewStartDate}" Height="36"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                    <TextBlock Text="اختتامی تاریخ:" FontSize="11.5" Foreground="#475569" Margin="0,0,0,4"/>
                                                    <DatePicker SelectedDate="{Binding NewEndDate}" Height="36"/>
                                                </StackPanel>
                                            </Grid>

                                            <CheckBox IsChecked="{Binding LockPreviousYear}" Margin="0,0,0,12" VerticalAlignment="Center">
                                                <TextBlock Text="پرانے مالی سال کو مستقل لاک کر دیں (صرف ریڈ آنلی رہے)" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A"/>
                                            </CheckBox>

                                            <!-- Execute Button -->
                                            <Button Command="{Binding ExecuteYearEndRolloverCommand}" 
                                                    IsEnabled="{Binding IsYearEndNotRunning}"
                                                    Height="40" Background="#0284C7" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="CalendarPlus" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBlock Text="نیا مالی سال بنائیں اور بیلنس منتقل کریں" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"
                                                               FontFamily="{StaticResource FontJameelNooriNastaleeq}"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Live Log Stream -->
                                <Border Background="#FFFFFF" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16" Margin="0,0,0,14" Effect="{StaticResource EffectCardShadow}">
                                    <StackPanel>
                                        <TextBlock Text="عمل درآمد لاگ (ACTIVITY LOG)" FontSize="11.5" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,8"/>
                                        <Border Background="#0F172A" CornerRadius="8" Padding="12" Height="140">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding YearEndLogs}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}" Foreground="#38BDF8" FontFamily="Consolas" FontSize="11.5" Margin="0,2"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Databases Switcher Section -->
                                <Border Background="#FFFFFF" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16" Effect="{StaticResource EffectCardShadow}">
                                    <StackPanel>
                                        <TextBlock Text="3. فعال مالی سال تبدیل کریں (SWITCH FINANCIAL YEAR)" FontSize="12" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,10"/>
                                        <ListBox ItemsSource="{Binding Databases}" BorderThickness="0" Background="Transparent">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="12,10" Margin="0,4" CornerRadius="8" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <materialDesign:PackIcon Kind="Database" Width="18" Height="18" Foreground="#0284C7" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                            
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DatabaseName}" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                                                                <TextBlock Text="{Binding YearCode, StringFormat='{}Financial Year: {0}'}" FontSize="11" Foreground="#64748B"/>
                                                            </StackPanel>

                                                            <!-- Status Badge -->
                                                            <Border Grid.Column="2" CornerRadius="6" Padding="10,4" VerticalAlignment="Center" Margin="0,0,12,0">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="#FEF3C7"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCurrentYear}" Value="True">
                                                                                <Setter Property="Background" Value="#DCFCE7"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                                                <Setter Property="Background" Value="#FEE2E2"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding StatusText}" FontWeight="Bold" FontSize="11.5">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="#D97706"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsCurrentYear}" Value="True">
                                                                                    <Setter Property="Foreground" Value="#15803D"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                                                    <Setter Property="Foreground" Value="#B91C1C"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>

                                                            <!-- Switch Button -->
                                                            <Button Grid.Column="3" 
                                                                    Command="{Binding DataContext.SwitchFinancialYearCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                    CommandParameter="{Binding}"
                                                                    Height="32" Padding="14,0" Background="#0284C7" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <materialDesign:PackIcon Kind="SwapHorizontal" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                    <TextBlock Text="Switch Year" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                </TabControl>
            </Grid>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--                   3. BOTTOM STATUS BAR                     -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="#0F172A" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding DataStatusText}" Foreground="#94A3B8" FontSize="11.5" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="agentcore ERP • Standalone Administrator Database Tool" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Border>

    </Grid>
</Window>
