<Application x:Class="agentcore.DbTool.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="Blue" SecondaryColor="Amber" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="FontJameelNooriNastaleeq">Jameel Noori Nastaleeq, Urdu Typesetting, Arial</FontFamily>
            <SolidColorBrush x:Key="BrushAccentTealLight" Color="#38BDF8"/>
            <DropShadowEffect x:Key="EffectCardShadow" BlurRadius="12" Direction="270" ShadowDepth="2" Opacity="0.08" Color="#000000"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
